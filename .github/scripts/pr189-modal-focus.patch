+    // DEBUG-pr189-modal-oct26: diagnostic branch only; unchanged focus/time contract.
+    private fun awaitDiagnosticModalFocus(owner: () -> View?) {
+        try {
+            compose.waitUntil(timeoutMillis = 10_000) {
+                compose.runOnUiThread {
+                    owner()?.hasWindowFocus() == true &&
+                        !compose.activity.window.decorView.hasWindowFocus()
+                }
+            }
+        } catch (failure: ComposeTimeoutException) {
+            val facts = compose.runOnUiThread {
+                val modal = owner()
+                "modal(present=${modal != null}, attached=${modal?.isAttachedToWindow}, " +
+                    "windowFocus=${modal?.hasWindowFocus()}, rootIsSelf=${modal?.rootView === modal})"
+            }
+            withNativeInputDiagnostics("Diagnostic initial modal focus timeout; $facts") {
+                throw failure
+            }
+        }
+    }
+
     companion object {
         private const val INITIAL_MODAL = "native-input.initial-modal"
     }
