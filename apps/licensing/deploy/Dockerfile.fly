ARG NODE_IMAGE
FROM ${NODE_IMAGE}
WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node src ./src
# Bootstrap owns the new volume and mounts bounded memory scratch, then drops to node.
USER root
ENV NODE_ENV=production
EXPOSE 8080
CMD ["node","src/fly-bootstrap.mjs"]
