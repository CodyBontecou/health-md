.PHONY: install start typecheck test e2e qualification check ci build dry-run

install:
	npm ci

start:
	npm start

typecheck:
	npm run typecheck

test:
	npm test

e2e:
	npm run test:e2e

qualification:
	npm run check:qualification

check:
	npm run check

ci:
	npm run check:ci

build:
	npm run build

dry-run:
	npm run dry-run
