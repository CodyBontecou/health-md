[Unit]
Description=Health.md write-only API Endpoint HTTPS proxy (loopback origin)
After=network-online.target healthmd-cloud-ingest.service
Requires=healthmd-cloud-ingest.service

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/sbin/nginx -c /etc/healthmd-cloud-ingest/proxy.conf -g 'daemon off;'
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
InaccessiblePaths=/etc/healthmd-cloud-mvp /etc/healthmd-cloud-mcp /var/lib/healthmd-cloud-mvp

[Install]
WantedBy=multi-user.target
