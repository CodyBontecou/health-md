worker_processes 1;
events { worker_connections 64; }
pid /tmp/healthmd-ingest-nginx.pid;
error_log /dev/null crit;
http {
  access_log off;
  server_tokens off;
  client_max_body_size 25m;
  client_body_buffer_size 16k;
  proxy_buffering off;
  proxy_request_buffering off;
  server {
    listen 127.0.0.1:18794;
    server_name api.healthmd.app;
    if ($host != api.healthmd.app) { return 421; }
    location = /api/v1/exports {
      proxy_pass http://127.0.0.1:18793;
      proxy_set_header Host api.healthmd.app;
      proxy_set_header X-Forwarded-Host api.healthmd.app;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Cookie "";
      proxy_hide_header Server;
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options "nosniff" always;
      proxy_connect_timeout 2s;
      proxy_read_timeout 60s;
    }
    location = /health {
      proxy_pass http://127.0.0.1:18793;
      proxy_set_header Host api.healthmd.app;
      proxy_set_header X-Forwarded-Host api.healthmd.app;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_hide_header Server;
      add_header Cache-Control "no-store" always;
      proxy_connect_timeout 2s;
    }
    location / { return 404; }
  }
}
