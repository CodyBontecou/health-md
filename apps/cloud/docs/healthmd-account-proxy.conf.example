worker_processes 1;
events { worker_connections 64; }
pid /tmp/healthmd-account-nginx.pid;
error_log /dev/null crit;
http {
  access_log off;
  server_tokens off;
  client_max_body_size 8k;
  client_body_buffer_size 16k;
  proxy_buffering off;
  proxy_request_buffering off;
  server {
    listen 127.0.0.1:18792;
    server_name account.healthmd.app;
    if ($host != account.healthmd.app) { return 421; }
    location / {
      proxy_pass http://127.0.0.1:18791;
      proxy_set_header Host account.healthmd.app;
      proxy_set_header X-Forwarded-Host account.healthmd.app;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_hide_header Server;
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options "nosniff" always;
      proxy_connect_timeout 2s;
      proxy_read_timeout 30s;
    }
  }
}
