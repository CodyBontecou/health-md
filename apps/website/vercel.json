{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.healthmd.app" }],
      "destination": "https://healthmd.app/:path*",
      "permanent": true
    },
    { "source": "/docs", "destination": "/docs/", "permanent": true },
    { "source": "/es", "destination": "/es/", "permanent": true },
    { "source": "/es/docs", "destination": "/es/docs/", "permanent": true },
    { "source": "/de", "destination": "/de/", "permanent": true },
    { "source": "/de/docs", "destination": "/de/docs/", "permanent": true },
    { "source": "/fr", "destination": "/fr/", "permanent": true },
    { "source": "/fr/docs", "destination": "/fr/docs/", "permanent": true },
    { "source": "/pt-br", "destination": "/pt-br/", "permanent": true },
    { "source": "/pt-br/docs", "destination": "/pt-br/docs/", "permanent": true },
    { "source": "/it", "destination": "/it/", "permanent": true },
    { "source": "/it/docs", "destination": "/it/docs/", "permanent": true },
    { "source": "/nl", "destination": "/nl/", "permanent": true },
    { "source": "/nl/docs", "destination": "/nl/docs/", "permanent": true },
    { "source": "/ja", "destination": "/ja/", "permanent": true },
    { "source": "/ja/docs", "destination": "/ja/docs/", "permanent": true },
    { "source": "/ko", "destination": "/ko/", "permanent": true },
    { "source": "/ko/docs", "destination": "/ko/docs/", "permanent": true },
    { "source": "/zh-hans", "destination": "/zh-hans/", "permanent": true },
    { "source": "/zh-hans/docs", "destination": "/zh-hans/docs/", "permanent": true },
    { "source": "/docs/sitemap-index.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/docs/sitemap-0.xml", "destination": "/sitemap-0.xml", "permanent": true },
    { "source": "/docs/data-reference", "destination": "/docs/reference/", "permanent": true },
    { "source": "/docs/data-reference/", "destination": "/docs/reference/", "permanent": true },
    { "source": "/blog", "destination": "/blog/", "permanent": true },
    { "source": "/visualizations", "destination": "/visualizations/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://img-host.costream.workers.dev https://cloudflareinsights.com https://static.cloudflareinsights.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" }
      ]
    }
  ]
}
