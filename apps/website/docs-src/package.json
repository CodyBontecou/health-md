{
  "name": "healthmd-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "reference:sync": "node scripts/sync-export-reference.mjs --write",
    "reference:check": "node scripts/sync-export-reference.mjs --check",
    "reference:verify": "node scripts/sync-export-reference.mjs --verify",
    "agent-assets:sync": "node scripts/sync-agent-assets.mjs --write",
    "agent-assets:check": "node scripts/sync-agent-assets.mjs --check",
    "build": "npm run reference:verify && npm run agent-assets:check && astro build && node scripts/stage-public-paths.mjs",
    "check": "npm run build && node scripts/check-built-links.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.5",
    "astro": "7.1.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
