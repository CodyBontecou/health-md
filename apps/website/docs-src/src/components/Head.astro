---
import DefaultHead from '@astrojs/starlight/components/Head.astro';

import {
  defaultLocale,
  localeFor,
} from '../../../i18n/locales.mjs';
import { markdownPathForDocsPath } from '../../lib/docs-metadata.mjs';
import {
  docsPathForSlug,
  englishDocsPath,
  localeFromPathname,
  translatedLocalesForDoc,
} from '../../../i18n/routes.mjs';

const route = Astro.locals.starlightRoute;
const { entry, head, lang, siteTitle, isFallback, lastUpdated } = route;
const routeLocaleCode = localeFromPathname(Astro.url.pathname);
const routeLocale = localeFor(routeLocaleCode);
const contentLocale = isFallback ? localeFor(defaultLocale) : routeLocale;
const translationLocales = isFallback ? [] : translatedLocalesForDoc(Astro.url.pathname);
const site = Astro.site ?? new URL('https://healthmd.app');
const englishPath = englishDocsPath(Astro.url.pathname);
const englishCanonical = new URL(englishPath, site).href;
const pageCanonical = isFallback ? englishCanonical : new URL(Astro.url.pathname, site).href;
const markdownPath = englishPath.startsWith('/docs/')
  ? markdownPathForDocsPath(isFallback ? englishPath : Astro.url.pathname)
  : undefined;
const markdownURL = markdownPath ? new URL(markdownPath, site).href : undefined;
const dateModified = entry.data.lastUpdated instanceof Date
  ? entry.data.lastUpdated.toISOString()
  : lastUpdated?.toISOString();

const canonicalEntry = head.find(
  ({ tag, attrs }) => tag === 'link' && attrs?.rel === 'canonical',
);
if (canonicalEntry?.attrs) canonicalEntry.attrs.href = pageCanonical;

for (let index = head.length - 1; index >= 0; index -= 1) {
  const item = head[index];
  if (item?.tag === 'link' && item.attrs?.rel === 'alternate' && item.attrs.hreflang) {
    head.splice(index, 1);
  }
}
for (const localeCode of translationLocales) {
  const locale = localeFor(localeCode);
  const slug = englishPath.replace(/^\/docs\/?/, '').replace(/\/$/, '');
  head.push({
    tag: 'link',
    attrs: {
      rel: 'alternate',
      hreflang: locale.lang,
      href: new URL(docsPathForSlug(slug, localeCode), site).href,
    },
  });
}
if (!isFallback) {
  head.push({
    tag: 'link',
    attrs: { rel: 'alternate', hreflang: 'x-default', href: englishCanonical },
  });
}
if (isFallback && !head.some(({ tag, attrs }) => tag === 'meta' && attrs?.name === 'robots')) {
  head.push({ tag: 'meta', attrs: { name: 'robots', content: 'noindex,follow' } });
}

const imageUrl = new URL(contentLocale.assets.docsOgImage, site).href;
for (const item of head) {
  if (item.tag !== 'meta' || !item.attrs) continue;
  if (item.attrs.property === 'og:locale') item.attrs.content = contentLocale.ogLocale;
  if (item.attrs.property === 'og:url') item.attrs.content = pageCanonical;
  if (item.attrs.property === 'og:image' || item.attrs.name === 'twitter:image') {
    item.attrs.content = imageUrl;
  }
  if (item.attrs.property === 'og:image:alt' || item.attrs.name === 'twitter:image:alt') {
    item.attrs.content = contentLocale.ui.docsOgImageAlt;
  }
}
for (const localeCode of translationLocales) {
  const locale = localeFor(localeCode);
  if (locale.code === contentLocale.code) continue;
  head.push({
    tag: 'meta',
    attrs: { property: 'og:locale:alternate', content: locale.ogLocale },
  });
}

const meta = (attribute: 'name' | 'property', value: string) => {
  const content = head.find(
    ({ tag, attrs }) => tag === 'meta' && attrs?.[attribute] === value,
  )?.attrs?.content;
  return typeof content === 'string' ? content : undefined;
};
const description = meta('name', 'description');
const image = meta('property', 'og:image');
const noindex = meta('name', 'robots')?.includes('noindex') ?? false;
const canonicalURL = new URL(pageCanonical);
const pathParts = canonicalURL.pathname.split('/').filter(Boolean);
const pretty = (value: string) => decodeURIComponent(value)
  .replaceAll('-', ' ')
  .replace(/\b\w/g, (character) => character.toUpperCase());
const docsPart = pathParts.indexOf('docs');
const breadcrumbs = pathParts.map((part, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: index === docsPart
    ? `${siteTitle} ${contentLocale.ui.docsBreadcrumb}`
    : index === pathParts.length - 1
      ? entry.data.title
      : index === 0 && routeLocaleCode !== defaultLocale
        ? routeLocale.label
        : pretty(part),
  item: new URL(`/${pathParts.slice(0, index + 1).join('/')}/`, canonicalURL).href,
}));
const jsonLD = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${pageCanonical}#article`,
      headline: entry.data.title,
      description,
      url: pageCanonical,
      image,
      inLanguage: contentLocale.lang,
      ...(dateModified ? { dateModified } : {}),
      publisher: {
        '@type': 'Organization',
        name: 'Health.md',
        url: 'https://healthmd.app/',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs,
    },
  ],
}).replace(/</g, '\\u003c');
---

<DefaultHead />
{markdownURL && (
  <link rel="alternate" type="text/markdown" href={markdownURL} title={`${entry.data.title} — Markdown`} />
)}
{dateModified && <meta property="article:modified_time" content={dateModified} />}
{!meta('name', 'twitter:title') && <meta name="twitter:title" content={entry.data.title} />}
{description && !meta('name', 'twitter:description') && (
  <meta name="twitter:description" content={description} />
)}
{!noindex && <script is:inline type="application/ld+json" set:html={jsonLD}></script>}
