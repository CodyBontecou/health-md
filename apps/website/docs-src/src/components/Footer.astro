---
import Default from '@astrojs/starlight/components/Footer.astro';

const { lang } = Astro.locals.starlightRoute;
const isSpanish = lang === 'es' || lang.startsWith('es-');
---
<Default><slot /></Default>
<div class="healthmd-footer-note">
  <p>
    © 2026 health.md · {isSpanish ? 'Creado por' : 'Built by'} <a href="https://isolated.tech">isolated.tech</a>
    · <a href={isSpanish ? '/es/privacy-policy.html' : '/privacy-policy.html'}>{isSpanish ? 'Privacidad' : 'Privacy'}</a>
    · <a href={isSpanish ? '/es/terms-of-service.html' : '/terms-of-service.html'}>{isSpanish ? 'Términos' : 'Terms'}</a>
  </p>
</div>
