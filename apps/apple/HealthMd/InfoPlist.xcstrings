    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md reads the health data you select for local exports and, only when you enable Hosted Account, an encrypted consent-limited copy for remote queries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md lee los datos de salud que selecciones para exportaciones locales y, solo cuando activas la Cuenta alojada, una copia cifrada y limitada por tu consentimiento para consultas remotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md lit les données de santé que vous sélectionnez pour les exportations locales et, uniquement si vous activez le compte hébergé, une copie chiffrée limitée par votre consentement pour les requêtes à distance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md liest die von Ihnen ausgewählten Gesundheitsdaten für lokale Exporte und, nur wenn Sie das gehostete Konto aktivieren, eine verschlüsselte, auf Ihre Einwilligung beschränkte Kopie für Remote-Abfragen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md legge i dati sanitari selezionati per le esportazioni locali e, solo quando abiliti l'account ospitato, una copia crittografata e limitata dal consenso per le query remote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Health.md lê os dados de saúde selecionados para exportações locais e, somente quando você ativa a Conta hospedada, uma cópia criptografada e limitada pelo seu consentimento para consultas remotas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md leest de gezondheidsgegevens die je selecteert voor lokale exports en, alleen wanneer je Hosted Account inschakelt, een versleutelde kopie binnen je toestemming voor externe zoekopdrachten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdは、選択したヘルスデータをローカル書き出しに使用し、Hosted Accountを有効にした場合に限り、同意範囲内の暗号化コピーをリモート照会に使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 선택한 건강 데이터를 로컬 내보내기에 사용하며, Hosted Account를 활성화한 경우에만 동의 범위로 제한된 암호화 사본을 원격 쿼리에 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 会读取您选择的健康数据用于本地导出；仅当您启用托管账户时，才会将受您同意范围限制的加密副本用于远程查询。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md may need to update health data metadata as part of the export process."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md puede necesitar actualizar los metadatos de datos de salud como parte del proceso de exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md peut avoir besoin de mettre à jour les métadonnées de santé dans le cadre du processus d'exportation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md muss möglicherweise Gesundheitsdaten-Metadaten im Rahmen des Exportvorgangs aktualisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md potrebbe dover aggiornare i metadati dei dati sanitari come parte del processo di esportazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md pode precisar atualizar metadados de saúde como parte do processo de exportação."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md moet mogelijk metadata van gezondheidsgegevens bijwerken als onderdeel van het exportproces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdはエクスポート処理の一環として、ヘルスデータのメタデータを更新する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 내보내기 과정에서 건강 데이터 메타데이터를 업데이트해야 할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 可能需要在导出过程中更新健康数据的元信息。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md uses your local network to connect to the Mac app or an explicitly paired healthmd command for private exports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md usa tu red local para sincronizar datos de salud entre tu iPhone y Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md utilise votre réseau local pour synchroniser les données de santé entre votre iPhone et votre Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md verwendet Ihr lokales Netzwerk, um Gesundheitsdaten zwischen Ihrem iPhone und Mac zu synchronisieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md utilizza la rete locale per sincronizzare i dati sanitari tra il tuo iPhone e il Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md usa sua rede local para sincronizar dados de saúde entre seu iPhone e Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md gebruikt je lokale netwerk om gezondheidsgegevens te synchroniseren tussen je iPhone en Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdはローカルネットワークを使用して、iPhoneとMac間でヘルスデータを同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 iPhone과 Mac 간에 건강 데이터를 동기화하기 위해 로컬 네트워크를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 使用本地网络在您的 iPhone 和 Mac 之间同步健康数据。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
