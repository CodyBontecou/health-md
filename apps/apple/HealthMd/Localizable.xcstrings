    "Unlock your iPhone, open Health.md, and retry. Scheduled HealthKit reads cannot finish while the iPhone is locked." : {
      "comment" : "Recovery: device locked",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperren Sie Ihr iPhone, öffnen Sie Health.md und versuchen Sie es erneut. Geplante HealthKit-Abfragen können nicht abgeschlossen werden, solange das iPhone gesperrt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock your iPhone, open Health.md, and retry. Scheduled HealthKit reads cannot finish while the iPhone is locked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquee su iPhone, abra Health.md y vuelva a intentarlo. Las lecturas programadas de HealthKit no pueden finalizar mientras el iPhone esté bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez votre iPhone, ouvrez Health.md et réessayez. Les lectures HealthKit planifiées ne peuvent pas se terminer tant que l’iPhone est verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca il tuo iPhone, apri Health.md e riprova. Le letture HealthKit pianificate non possono terminare mentre iPhone è bloccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone のロックを解除し、Health.md を開いて、再試行してください。 iPhone がロックされている間は、スケジュールされた HealthKit 読み取りを完了できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone를 잠금 해제하고 Health.md를 연 후 다시 시도하세요. iPhone가 잠겨 있는 동안에는 예약된 HealthKit 읽기를 완료할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel uw iPhone, open Health.md en probeer het opnieuw. Geplande HealthKit-lezingen kunnen niet worden voltooid terwijl de iPhone is vergrendeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie seu iPhone, abra Health.md e tente novamente. As leituras HealthKit agendadas não podem ser concluídas enquanto iPhone estiver bloqueado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁您的 iPhone，打开 Health.md，然后重试。当 iPhone 锁定时，计划的 HealthKit 读取无法完成。"
          }
        }
      }
    },
