    "Lifetime plans are one-time purchases charged to your Apple ID." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lebenslange Tarife sind einmalige Käufe, die über deine Apple ID abgerechnet werden."}},
        "es": {"stringUnit":{"state":"translated","value":"Los planes de por vida son compras de pago único que se cobran a tu Apple ID."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les offres à vie sont des achats uniques facturés à votre identifiant Apple."}},
        "it": {"stringUnit":{"state":"translated","value":"I piani a vita sono acquisti una tantum addebitati al tuo ID Apple."}},
        "ja": {"stringUnit":{"state":"translated","value":"買い切りプランは、Apple ID に一度だけ請求されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"평생 요금제는 Apple ID로 한 번만 결제하는 상품입니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Levenslange abonnementen zijn eenmalige aankopen die via je Apple ID worden afgerekend."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os planos vitalícios são compras únicas cobradas no seu Apple ID."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"终身方案为一次性购买，费用通过你的 Apple ID 收取。"}}
      }
    },
    "Lifetime plans are one-time purchases charged to your Apple ID. Terms and Privacy links are available." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lebenslange Tarife sind einmalige Käufe, die über deine Apple ID abgerechnet werden. Links zu Nutzungsbedingungen und Datenschutz sind verfügbar."}},
        "es": {"stringUnit":{"state":"translated","value":"Los planes de por vida son compras de pago único que se cobran a tu Apple ID. Hay enlaces disponibles a las condiciones y la política de privacidad."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les offres à vie sont des achats uniques facturés à votre identifiant Apple. Des liens vers les conditions et la politique de confidentialité sont disponibles."}},
        "it": {"stringUnit":{"state":"translated","value":"I piani a vita sono acquisti una tantum addebitati al tuo ID Apple. Sono disponibili i link ai termini e alla privacy."}},
        "ja": {"stringUnit":{"state":"translated","value":"買い切りプランは、Apple ID に一度だけ請求されます。利用規約とプライバシーへのリンクを確認できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"평생 요금제는 Apple ID로 한 번만 결제하는 상품입니다. 이용약관 및 개인정보 처리방침 링크를 확인할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Levenslange abonnementen zijn eenmalige aankopen die via je Apple ID worden afgerekend. Links naar de voorwaarden en het privacybeleid zijn beschikbaar."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os planos vitalícios são compras únicas cobradas no seu Apple ID. Há links disponíveis para os Termos e a Política de Privacidade."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"终身方案为一次性购买，费用通过你的 Apple ID 收取。提供条款和隐私政策链接。"}}
      }
    },
