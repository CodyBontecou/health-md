        }
      }
    },
    "This removes the old iPhone→Mac cache from this Mac. It does not affect Health data on iPhone or exported files.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the old iPhone→Mac cache from this Mac. It does not affect Health data on iPhone or exported files."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der alte iPhone→Mac-Cache aus diesem Mac entfernt. Es wirkt sich nicht auf Gesundheitsdaten auf iPhone oder exportierten Dateien aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el antiguo caché iPhone→Mac de este Mac. No afecta los datos de salud en iPhone ni los archivos exportados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'ancien cache iPhone → Mac de ce Mac. Cela n’affecte pas les données de santé sur iPhone ou les fichiers exportés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò rimuove la vecchia cache iPhone→Mac da questo Mac. Non influisce sui dati sanitari su iPhone o sui file esportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、古い iPhone→Mac キャッシュがこの Mac から削除されます。 iPhone のヘルス データやエクスポートされたファイルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 이 Mac에서 이전 iPhone→Mac 캐시가 제거됩니다. iPhone 또는 내보낸 파일의 건강 데이터에는 영향을 미치지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de oude iPhone → Mac-cache uit deze Mac verwijderd. Het heeft geen invloed op gezondheidsgegevens op iPhone of geëxporteerde bestanden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o cache iPhone→Mac antigo deste Mac. Isso não afeta os dados de saúde em iPhone ou arquivos exportados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此 Mac 删除旧的 iPhone→Mac 缓存。它不会影响 iPhone 上的健康数据或已导出的文件。"
          }
        }
      }
    },
    "This removes the old iPhone→Mac cache from this Mac. It does not affect Health data on iPhone or files already exported to your destination folder.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the old iPhone→Mac cache from this Mac. It does not affect Health data on iPhone or files already exported to your destination folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der alte iPhone→Mac-Cache aus diesem Mac entfernt. Es wirkt sich nicht auf Gesundheitsdaten auf iPhone oder Dateien aus, die bereits in Ihren Zielordner exportiert wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el antiguo caché iPhone→Mac de este Mac. No afecta los datos de salud en iPhone ni los archivos ya exportados a su carpeta de destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'ancien cache iPhone → Mac de ce Mac. Cela n'affecte pas les données de santé sur iPhone ou les fichiers déjà exportés vers votre dossier de destination."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò rimuove la vecchia cache iPhone→Mac da questo Mac. Non influisce sui dati sanitari su iPhone o sui file già esportati nella cartella di destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、古い iPhone→Mac キャッシュがこの Mac から削除されます。 iPhone のヘルスデータや、宛先フォルダーに既にエクスポートされているファイルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 이 Mac에서 이전 iPhone→Mac 캐시가 제거됩니다. iPhone의 건강 데이터 또는 이미 대상 폴더로 내보낸 파일에는 영향을 미치지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de oude iPhone → Mac-cache uit deze Mac verwijderd. Het heeft geen invloed op gezondheidsgegevens op iPhone of op bestanden die al naar uw doelmap zijn geëxporteerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o cache iPhone→Mac antigo deste Mac. Isso não afeta os dados de saúde em iPhone ou arquivos já exportados para sua pasta de destino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此 Mac 删除旧的 iPhone→Mac 缓存。它不会影响 iPhone 上的健康数据或已经导出到目标文件夹的文件。"
          }
        }
      }
    },
    "This version of Health.md cannot read the query-context store contract.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Health.md cannot read the query-context store contract."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von Health.md kann den Abfragekontext-Speichervertrag nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Health.md no puede leer el contrato del almacén de contexto de consulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de Health.md ne peut pas lire le contrat de magasin de contexte de requête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di Health.md non è in grado di leggere il contratto dell'archivio nel contesto della query."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの Health.md は、クエリ コンテキスト ストア コントラクトを読み取ることができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Health.md 버전은 쿼리 컨텍스트 저장소 계약을 읽을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van Health.md kan het query-contextopslagcontract niet lezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do Health.md não pode ler o contrato de armazenamento de contexto de consulta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Health.md 无法读取查询上下文存储合约。"
          }
        }
      }
    },
    "This version of Health.md cannot read the stored context-day contract.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Health.md cannot read the stored context-day contract."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von Health.md kann den gespeicherten Kontext-Tagesvertrag nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Health.md no puede leer el contrato de día de contexto almacenado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de Health.md ne peut pas lire le contrat contextuel stocké."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di Health.md non è in grado di leggere il contratto del giorno contesto archiviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの Health.md は、保存されているコンテキストデイ コントラクトを読み取ることができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Health.md 버전은 저장된 컨텍스트 일 계약을 읽을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van Health.md kan het opgeslagen context-dagcontract niet lezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do Health.md não pode ler o contrato de dia de contexto armazenado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Health.md 无法读取存储的上下文日合约。"
          }
        }
      }
    },
    "This will remove all health data cached on this Mac. You can re-sync from your iPhone at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermit werden alle auf diesem Mac zwischengespeicherten Gesundheitsdaten entfernt. Sie können jederzeit erneut von Ihrem iPhone synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove all health data cached on this Mac. You can re-sync from your iPhone at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará todos los datos de salud almacenados en caché en este Mac. Puedes volver a sincronizar desde tu iPhone en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera toutes les données de santé mises en cache sur ce Mac. Vous pouvez resynchroniser depuis votre iPhone à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuoverà tutti i dati sanitari memorizzati su questo Mac. Puoi sincronizzare nuovamente dal tuo iPhone in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにキャッシュされたすべてのヘルスデータが削除されます。iPhoneからいつでも再同期できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 캐시된 모든 건강 데이터가 삭제됩니다. 언제든지 iPhone에서 다시 동기화할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert alle gezondheidsgegevens die op deze Mac zijn opgeslagen. Je kunt op elk moment opnieuw synchroniseren vanaf je iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá todos os dados de saúde armazenados em cache neste Mac. Você pode sincronizar novamente pelo seu iPhone a qualquer momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除缓存在此 Mac 上的所有健康数据。您可以随时从 iPhone 重新同步。"
          }
        }
      }
    },
    "This will sync your entire health data history from your iPhone. Depending on how much data you have, this could take several minutes.\n\nMake sure Health.md stays open on your iPhone during the sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermit wird Ihr gesamter Gesundheitsdatenverlauf von Ihrem iPhone synchronisiert. Je nach Datenmenge kann dies einige Minuten dauern.\n\nStellen Sie sicher, dass Health.md während der Synchronisierung auf Ihrem iPhone geöffnet bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will sync your entire health data history from your iPhone. Depending on how much data you have, this could take several minutes.\n\nMake sure Health.md stays open on your iPhone during the sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sincronizará todo tu historial de datos de salud desde tu iPhone. Dependiendo de la cantidad de datos que tengas, esto podría tardar varios minutos.\n\nAsegúrate de que Health.md permanezca abierto en tu iPhone durante la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela synchronisera l'intégralité de votre historique de données de santé depuis votre iPhone. Selon la quantité de données, cela peut prendre plusieurs minutes.\n\nAssurez-vous que Health.md reste ouvert sur votre iPhone pendant la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione sincronizzerà l'intera cronologia dei dati sanitari dal tuo iPhone. A seconda della quantità di dati, potrebbe richiedere diversi minuti.\n\nAssicurati che Health.md rimanga aperto sul tuo iPhone durante la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneからすべてのヘルスデータ履歴を同期します。データ量によっては数分かかる場合があります。\n\n同期中はiPhoneでHealth.mdを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 전체 건강 데이터 기록을 동기화합니다. 데이터 양에 따라 몇 분 정도 걸릴 수 있습니다.\n\n동기화 중에 iPhone에서 Health.md가 열려 있는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit synchroniseert je volledige gezondheidsgeschiedenis vanaf je iPhone. Afhankelijk van de hoeveelheid gegevens kan dit enkele minuten duren.\n\nZorg dat Health.md geopend blijft op je iPhone tijdens het synchroniseren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso sincronizará todo o seu histórico de dados de saúde do seu iPhone. Dependendo da quantidade de dados, isso pode levar vários minutos.\n\nCertifique-se de que o Health.md permaneça aberto no seu iPhone durante a sincronização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从您的 iPhone 同步全部健康数据历史记录。根据数据量大小，这可能需要几分钟时间。\n\n请确保同步期间 Health.md 在 iPhone 上保持打开状态。"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhrzeit"
          }
