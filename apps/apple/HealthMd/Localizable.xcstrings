    "Start Setup" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Einrichtung starten"}},
        "es": {"stringUnit":{"state":"translated","value":"Iniciar configuración"}},
        "fr": {"stringUnit":{"state":"translated","value":"Commencer la configuration"}},
        "it": {"stringUnit":{"state":"translated","value":"Avvia la configurazione"}},
        "ja": {"stringUnit":{"state":"translated","value":"設定を開始"}},
