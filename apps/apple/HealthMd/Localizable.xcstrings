    "Open Health.md and retry while the app is visible. If it happens again, export a smaller date range.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Health.md and retry while the app is visible. If it happens again, export a smaller date range."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Health.md und versuchen Sie es erneut, während die App sichtbar ist. Wenn es erneut auftritt, exportieren Sie einen kleineren Datumsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Health.md y vuelva a intentarlo mientras la aplicación esté visible. Si vuelve a suceder, exporte un rango de fechas más pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Health.md et réessayez pendant que l'application est visible. Si cela se reproduit, exportez une plage de dates plus petite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Health.md e riprova mentre l'app è visibile. Se il problema si ripete, esporta un intervallo di date più piccolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md を開いて、アプリが表示されている間に再試行してください。再度同じ問題が発生する場合は、より狭い日付範囲をエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md를 열고 앱이 표시되는 동안 다시 시도하세요. 이런 일이 다시 발생하면 더 작은 날짜 범위를 내보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Health.md en probeer het opnieuw terwijl de app zichtbaar is. Als het opnieuw gebeurt, exporteer dan een kleiner datumbereik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Health.md e tente novamente enquanto o aplicativo estiver visível. Se isso acontecer novamente, exporte um intervalo de datas menor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Health.md 并在应用程序可见时重试。如果再次发生这种情况，请导出较小的日期范围。"
          }
        }
      }
    },
    "Open Health.md on Mac. The CLI talks to the running app, not directly to iPhone.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Health.md on Mac. The CLI talks to the running app, not directly to iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Health.md auf Mac. Der CLI kommuniziert mit der laufenden App, nicht direkt mit iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Health.md en Mac. El CLI se comunica con la aplicación en ejecución, no directamente con el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Health.md sur Mac. Le CLI communique avec l'application en cours d'exécution, pas directement avec le iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Health.md su Mac. CLI comunica con l'app in esecuzione, non direttamente con iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で Health.md を開きます。 CLI は、iPhone と直接通信するのではなく、実行中のアプリと通信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Health.md를 엽니다. CLI는 iPhone와 직접 통신하지 않고 실행 중인 앱과 통신합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Health.md op Mac. De CLI praat met de actieve app, niet rechtstreeks met iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Health.md em Mac. O CLI se comunica com o aplicativo em execução, não diretamente com o iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在Mac上打开Health.md。 CLI 与正在运行的应用程序对话，而不是直接与 iPhone 对话。"
          }
        }
      }
    },
