    "Simpler Health access" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Einfacherer Zugriff auf Gesundheitsdaten"}},
        "es": {"stringUnit":{"state":"translated","value":"Acceso más sencillo a Salud"}},
        "fr": {"stringUnit":{"state":"translated","value":"Accès simplifié aux données de santé"}},
        "it": {"stringUnit":{"state":"translated","value":"Accesso più semplice ai dati sanitari"}},
        "ja": {"stringUnit":{"state":"translated","value":"より簡単なヘルスケアへのアクセス"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 간편한 건강 데이터 접근"}},
        "nl": {"stringUnit":{"state":"translated","value":"Eenvoudigere toegang tot Gezondheid"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Acesso ao Saúde mais simples"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更简便的健康数据访问"}}
      }
    },
    "Simpler lifetime unlock options" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Einfachere Optionen zur dauerhaften Freischaltung"}},
        "es": {"stringUnit":{"state":"translated","value":"Opciones más sencillas de desbloqueo de por vida"}},
        "fr": {"stringUnit":{"state":"translated","value":"Options simplifiées de déverrouillage à vie"}},
        "it": {"stringUnit":{"state":"translated","value":"Opzioni più semplici per lo sblocco a vita"}},
        "ja": {"stringUnit":{"state":"translated","value":"よりシンプルな永久アンロックの選択肢"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 간편한 평생 잠금 해제 옵션"}},
