    "Install the healthmd command from the Mac app, check readiness, and trigger iPhone Apple Health exports from scripts or automations." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Installiere den Befehl healthmd über die Mac-App, prüfe die Bereitschaft und starte Apple Health-Exporte vom iPhone per Skript oder Automation."}},
        "es": {"stringUnit":{"state":"translated","value":"Instala el comando healthmd desde la app para Mac, comprueba que todo esté listo e inicia exportaciones de Apple Health del iPhone desde scripts o automatizaciones."}},
        "fr": {"stringUnit":{"state":"translated","value":"Installez la commande healthmd depuis l’app Mac, vérifiez que tout est prêt et déclenchez des exportations Apple Health de l’iPhone depuis des scripts ou des automatisations."}},
        "it": {"stringUnit":{"state":"translated","value":"Installa il comando healthmd dall'app per Mac, verifica che sia tutto pronto e avvia le esportazioni Apple Health dall'iPhone tramite script o automazioni."}},
        "ja": {"stringUnit":{"state":"translated","value":"Mac アプリから healthmd コマンドをインストールすると、準備状況の確認や、スクリプト・オートメーションからの iPhone の Apple Health エクスポートの実行ができます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac 앱에서 healthmd 명령을 설치하고 준비 상태를 확인한 후, 스크립트나 자동화로 iPhone의 Apple Health 내보내기를 실행하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Installeer het commando healthmd vanuit de Mac-app, controleer of alles gereed is en start Apple Health-exports op je iPhone via scripts of automatiseringen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Instale o comando healthmd pelo app para Mac, verifique se está tudo pronto e acione exportações do Apple Health no iPhone por scripts ou automações."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"从 Mac App 安装 healthmd 命令，检查就绪状态，并通过脚本或自动化触发 iPhone 上的 Apple Health 导出。"}}
      }
    },
