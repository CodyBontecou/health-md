    "Reports are generated on your device and stay private until you explicitly share or save them." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Berichte werden auf deinem Gerät erstellt und bleiben privat, bis du sie ausdrücklich teilst oder speicherst."}},
        "es": {"stringUnit":{"state":"translated","value":"Los informes se generan en tu dispositivo y permanecen privados hasta que los compartas o guardes explícitamente."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les rapports sont générés sur votre appareil et restent privés tant que vous ne les partagez ou ne les enregistrez pas explicitement."}},
        "it": {"stringUnit":{"state":"translated","value":"I report vengono generati sul tuo dispositivo e rimangono privati finché non scegli esplicitamente di condividerli o salvarli."}},
        "ja": {"stringUnit":{"state":"translated","value":"レポートはデバイス上で生成され、自分で共有または保存するまで非公開のままです。"}},
        "ko": {"stringUnit":{"state":"translated","value":"보고서는 기기에서 생성되며, 직접 공유하거나 저장하기 전까지 비공개로 유지됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Rapporten worden op je apparaat gegenereerd en blijven privé totdat je ze uitdrukkelijk deelt of opslaat."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os relatórios são gerados no seu dispositivo e permanecem privados até que você os compartilhe ou salve explicitamente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"报告在你的设备上生成，在你主动分享或保存之前始终保密。"}}
      }
    },
