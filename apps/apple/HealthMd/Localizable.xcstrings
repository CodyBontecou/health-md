    "Download the desktop app to sync and review your health data on Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie die Desktop-App herunter, um Ihre Gesundheitsdaten auf dem Mac zu synchronisieren und zu überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the desktop app to sync and review your health data on Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga la aplicación de escritorio para sincronizar y revisar tus datos de salud en Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez l'application de bureau pour synchroniser et consulter vos données de santé sur Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica l'app desktop per sincronizzare e consultare i tuoi dati sanitari su Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップアプリをダウンロードして、Macでヘルスデータを同期・確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 건강 데이터를 동기화하고 확인하려면 데스크톱 앱을 다운로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download de desktop-app om je gezondheidsgegevens te synchroniseren en te bekijken op Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o aplicativo para desktop para sincronizar e revisar seus dados de saúde no Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载桌面应用，在 Mac 上同步和查看您的健康数据。"
          }
        }
      }
    },
