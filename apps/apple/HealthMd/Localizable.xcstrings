    "Fixed a Family Lifetime plan configuration bug that could prevent restoring access on another Apple Family device." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ein Konfigurationsfehler beim dauerhaften Familientarif wurde behoben, der die Wiederherstellung des Zugriffs auf einem anderen Gerät der Apple-Familie verhindern konnte."}},
        "es": {"stringUnit":{"state":"translated","value":"Se ha corregido un error de configuración del plan familiar de por vida que podía impedir restaurar el acceso en otro dispositivo del grupo familiar de Apple."}},
        "fr": {"stringUnit":{"state":"translated","value":"Correction d’un bug de configuration de l’offre familiale à vie qui pouvait empêcher la restauration de l’accès sur un autre appareil du groupe familial Apple."}},
        "it": {"stringUnit":{"state":"translated","value":"Corretto un bug di configurazione del piano famiglia a vita che poteva impedire il ripristino dell'accesso su un altro dispositivo del gruppo Famiglia Apple."}},
        "ja": {"stringUnit":{"state":"translated","value":"Appleのファミリー共有に参加する別のデバイスでアクセスを復元できない場合があった、ファミリー買い切りプランの設定不具合を修正しました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"다른 Apple 가족 기기에서 이용 권한을 복원하지 못할 수 있었던 가족 평생 요금제 구성 버그를 수정했습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Een configuratiefout in het levenslange gezinsabonnement is opgelost die het herstellen van toegang op een ander apparaat binnen het Apple-gezin kon verhinderen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Corrigido um erro de configuração do plano vitalício familiar que podia impedir a restauração do acesso em outro dispositivo da família Apple."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"修复了家庭终身方案的配置错误，该错误可能导致无法在另一台 Apple 家庭设备上恢复访问权限。"}}
      }
    },
