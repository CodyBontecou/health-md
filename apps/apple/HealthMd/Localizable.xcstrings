    "Clinician-ready reports" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Berichte für medizinisches Fachpersonal"}},
        "es": {"stringUnit":{"state":"translated","value":"Informes listos para profesionales sanitarios"}},
