    "Leave empty for flat structure, or use placeholders below": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen für flache Struktur oder Platzhalter unten verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty for flat structure, or use placeholders below"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja vacío para estructura plana, o usa los marcadores de abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour une structure plate, ou utilisez les espaces réservés ci-dessous"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per una struttura piatta, oppure usa i segnaposto qui sotto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フラット構造にする場合は空のままにするか、以下のプレースホルダを使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랫 구조로 하려면 비워 두거나 아래 자리 표시자를 사용하세요"
          }
        },
        "nl": {
          "stringUnit": {
