    "Go to the Sync tab to connect your iPhone and download health data.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to the Sync tab to connect your iPhone and download health data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zur Registerkarte „Synchronisieren“, um Ihr iPhone zu verbinden und Gesundheitsdaten herunterzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaya a la pestaña Sincronizar para conectar su iPhone y descargar datos de salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accédez à l'onglet Sync pour connecter votre iPhone et télécharger les données de santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai alla scheda Sincronizzazione per connettere il tuo iPhone e scaricare i dati sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[同期] タブに移動して、iPhone に接続し、健康データをダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 탭으로 이동하여 iPhone를 연결하고 건강 데이터를 다운로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga naar het tabblad Synchroniseren om uw iPhone te verbinden en gezondheidsgegevens te downloaden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá para a guia Sincronizar para conectar seu iPhone e baixar dados de saúde."
          }
