        "ko": {"stringUnit":{"state":"translated","value":"Health.md가 파일을 저장할 Obsidian 또는 파일 앱의 하위 폴더를 설정하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Stel de submap in Obsidian of Bestanden in waarnaar Health.md schrijft."}},
