        "de": {"stringUnit":{"state":"translated","value":"Nach einem abgeschlossenen Export erscheint wieder die Erfolgsmeldung mit den Aktionen „Vorschau“ und „Durchsuchen“ statt einer roten Fehlermeldung."}},
        "es": {"stringUnit":{"state":"translated","value":"Al completarse una exportación, vuelve a aparecer el aviso de éxito con las acciones Vista previa y Explorar, en lugar de un error en rojo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Une exportation terminée affiche de nouveau la notification de réussite avec les actions Aperçu et Parcourir, au lieu d’une erreur en rouge."}},
        "it": {"stringUnit":{"state":"translated","value":"Al termine dell’esportazione viene nuovamente mostrata la notifica di successo con le azioni Anteprima e Sfoglia, anziché un errore rosso."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポート完了時に、赤いエラーではなく、「プレビュー」と「参照」の操作を含む成功通知が再び表示されるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기가 완료되면 빨간색 오류 대신 미리보기 및 찾아보기 작업이 포함된 성공 알림이 다시 표시됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Na een voltooide export verschijnt weer de succesmelding met de acties Voorvertoning en Bladeren, in plaats van een rode foutmelding."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Uma exportação concluída volta a mostrar a notificação de sucesso com as ações Pré-visualizar e Explorar, em vez de um erro vermelho."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"导出完成后会再次显示带有“预览”和“浏览”操作的成功提示，而非红色错误提示。"}}
      }
    },
    "A faster first export" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ein schnellerer erster Export"}},
        "es": {"stringUnit":{"state":"translated","value":"Una primera exportación más rápida"}},
        "fr": {"stringUnit":{"state":"translated","value":"Une première exportation plus rapide"}},
        "it": {"stringUnit":{"state":"translated","value":"Una prima esportazione più veloce"}},
        "ja": {"stringUnit":{"state":"translated","value":"初回エクスポートを高速化"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 빨라진 첫 내보내기"}},
        "nl": {"stringUnit":{"state":"translated","value":"Een snellere eerste export"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Primeira exportação mais rápida"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更快完成首次导出"}}
