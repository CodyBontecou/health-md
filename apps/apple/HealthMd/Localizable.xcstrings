    "Only categories with enabled metrics in your export settings are shown. Enable more metrics in Health Metrics settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur Kategorien angezeigt, für die in Ihren Exporteinstellungen Metriken aktiviert sind. Aktivieren Sie weitere Metriken in den Einstellungen für Gesundheitsmetriken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only categories with enabled metrics in your export settings are shown. Enable more metrics in Health Metrics settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran las categorías con métricas activadas en tus ajustes de exportación. Activa más métricas en los ajustes de Métricas de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les catégories avec des indicateurs activés dans vos paramètres d'exportation sont affichées. Activez plus d'indicateurs dans les réglages des indicateurs de santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono mostrate solo le categorie con metriche abilitate nelle impostazioni di esportazione. Abilita più metriche nelle impostazioni Metriche Sanitarie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポート設定で有効な指標があるカテゴリのみ表示されます。ヘルス指標設定でより多くの指標を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기 설정에서 활성화된 항목이 있는 카테고리만 표시됩니다. 건강 항목 설정에서 더 많은 항목을 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen categorieën met ingeschakelde meetwaarden in je exportinstellingen worden getoond. Schakel meer meetwaarden in via Gezondheidsmeetwaarden-instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas categorias com métricas ativadas nas suas configurações de exportação são exibidas. Ative mais métricas nas configurações de Métricas de Saúde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅显示在导出设置中已启用指标的类别。可在健康指标设置中启用更多指标。"
          }
        }
      }
    },
    "Only metrics enabled in Export Settings → Health Metrics appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier werden nur Metriken angezeigt, die unter Exporteinstellungen → Gesundheitsmetriken aktiviert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí solo aparecen las métricas habilitadas en Ajustes de exportación → Métricas de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les indicateurs activés dans Paramètres d’exportation → Indicateurs de santé apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui vengono mostrate solo le metriche abilitate in Impostazioni di esportazione → Metriche sanitarie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「エクスポート設定」→「ヘルス指標」で有効にした指標のみがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기 설정 → 건강 항목에서 활성화된 항목만 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier verschijnen alleen meetwaarden die zijn ingeschakeld bij Exportinstellingen → Gezondheidsmeetwaarden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente as métricas ativadas em Configurações de Exportação → Métricas de Saúde aparecem aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里只显示在“导出设置” → “健康指标”中启用的指标。"
          }
        }
      }
    },
    "Only send Apple Health data to endpoints you control or trust. API exports use your selected metrics and Data Detail setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden Sie Apple Health-Daten nur an Endpunkte, die Sie kontrollieren oder denen Sie vertrauen. API-Exporte verwenden Ihre ausgewählten Metriken und die Einstellung für Detailgrad der Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only send Apple Health data to endpoints you control or trust. API exports use your selected metrics and Data Detail setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía datos de Apple Health solo a endpoints que controles o en los que confíes. Las exportaciones por API usan las métricas seleccionadas y el ajuste Nivel de detalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’envoyez les données Apple Health qu’à des points de terminaison que vous contrôlez ou auxquels vous faites confiance. Les exportations API utilisent les mesures sélectionnées et le réglage Niveau de détail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia i dati di Apple Health solo a endpoint che controlli o di cui ti fidi. Le esportazioni API usano le metriche selezionate e l’impostazione Dettaglio dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthデータは、管理している、または信頼できるエンドポイントにのみ送信してください。APIエクスポートでは、選択した指標とデータの詳細度設定が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health 데이터는 직접 관리하거나 신뢰하는 엔드포인트에만 보내세요. API 내보내기는 선택한 지표와 데이터 상세 수준 설정을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur Apple Health-gegevens alleen naar eindpunten die je beheert of vertrouwt. API-exports gebruiken de geselecteerde metingen en de instelling Gegevensdetail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie dados do Apple Health apenas para endpoints que você controla ou nos quais confia. As exportações por API usam as métricas selecionadas e a configuração Nível de detalhe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅将 Apple Health 数据发送到您控制或信任的端点。API 导出会使用您选择的指标和“数据详细程度”设置。"
          }
        }
      }
    },
    "Only summary files will be written for the full touched week/month/year windows." : {
      "comment" : "macOS production UI",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur Zusammenfassungsdateien für die vollständigen betroffenen Wochen-, Monats- oder Jahreszeiträume erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only summary files will be written for the full touched week/month/year windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se escribirán archivos de resumen para las ventanas completas de semana/mes/año tocadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les fichiers récapitulatifs seront écrits pour les fenêtres semaine/mois/année entièrement touchées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno scritti solo file di riepilogo per l'intera finestra della settimana/mese/anno interessata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチされた週/月/年のウィンドウ全体については、概要ファイルのみが書き込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 터치된 주/월/연도 창에 대한 요약 파일만 작성됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden alleen samenvattingsbestanden geschreven voor de volledige week-/maand-/jaarvensters."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente arquivos de resumo serão gravados para as janelas completas da semana/mês/ano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅针对完整触及的周/月/年窗口写入摘要文件。"
          }
        }
      }
    },
    "Only the range summary will be written for the requested dates." : {
