    "Exporting Yesterday after waking now includes the sleep session that started the previous night." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wenn du nach dem Aufwachen den gestrigen Tag exportierst, ist jetzt auch die in der vergangenen Nacht begonnene Schlafphase enthalten."}},
        "es": {"stringUnit":{"state":"translated","value":"Al exportar ayer después de despertar, ahora se incluye la sesión de sueño que comenzó la noche anterior."}},
        "fr": {"stringUnit":{"state":"translated","value":"L’exportation de la journée d’hier après le réveil inclut désormais la session de sommeil commencée la veille au soir."}},
        "it": {"stringUnit":{"state":"translated","value":"L'esportazione dei dati di ieri dopo il risveglio ora include la sessione di sonno iniziata la notte precedente."}},
        "ja": {"stringUnit":{"state":"translated","value":"起床後に昨日のデータをエクスポートすると、前夜に始まった睡眠セッションも含まれるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 잠에서 깬 후 어제 데이터를 내보내면 전날 밤에 시작된 수면 세션도 포함됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Als je na het ontwaken gisteren exporteert, wordt nu ook de slaapsessie meegenomen die de avond ervoor begon."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Exportar ontem após acordar agora inclui a sessão de sono iniciada na noite anterior."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"现在，醒来后导出昨天的数据时，会包含前一晚开始的睡眠记录。"}}
      }
    },
