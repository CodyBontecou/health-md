    "Optimized for Obsidian Bases. All metrics are stored as frontmatter properties for querying, filtering, and sorting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimized for Obsidian Bases. All metrics are stored as frontmatter properties for querying, filtering, and sorting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimiert für Obsidian Bases. Alle Metriken werden als Frontmatter-Eigenschaften zum Abfragen, Filtern und Sortieren gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimizado para Obsidian Bases. Todas las métricas se almacenan como propiedades frontmatter para consultar, filtrar y ordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimisé pour Obsidian Bases. Toutes les métriques sont stockées en tant que propriétés frontmatter pour la recherche, le filtrage et le tri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimizzato per Obsidian Bases. Tutte le metriche vengono memorizzate come proprietà frontmatter per interrogazione, filtro e ordinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian Bases に最適化。すべての指標がフロントマタープロパティとして保存され、クエリ、フィルタリング、ソートが可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian Bases에 최적화. 모든 지표가 프론트매터 속성으로 저장되어 쿼리, 필터링, 정렬이 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geoptimaliseerd voor Obsidian Bases. Alle metingen worden opgeslagen als frontmatter-eigenschappen voor zoekopdrachten, filteren en sorteren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Otimizado para Obsidian Bases. Todas as métricas são armazenadas como propriedades frontmatter para consulta, filtragem e ordenação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对 Obsidian Bases 优化。所有指标作为 frontmatter 属性存储，可用于查询、筛选和排序。"
          }
        }
      }
    },
