    "Weekly, monthly, and yearly estimates and progress now reflect their complete calendar windows." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wöchentliche, monatliche und jährliche Schätzungen und Fortschrittsangaben berücksichtigen jetzt die vollständigen Kalenderzeiträume."}},
        "es": {"stringUnit":{"state":"translated","value":"Las estimaciones y el progreso semanales, mensuales y anuales ahora reflejan sus periodos naturales completos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les estimations et la progression hebdomadaires, mensuelles et annuelles reflètent désormais leurs périodes calendaires complètes."}},
        "it": {"stringUnit":{"state":"translated","value":"Le stime e i progressi settimanali, mensili e annuali ora rispecchiano i rispettivi periodi di calendario completi."}},
        "ja": {"stringUnit":{"state":"translated","value":"週次・月次・年次の推定値と進捗に、暦上の各期間全体が反映されるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"주간, 월간, 연간 추정치와 진행 상황에 이제 해당 달력 기간 전체가 반영됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Wekelijkse, maandelijkse en jaarlijkse schattingen en voortgang weerspiegelen nu hun volledige kalenderperioden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As estimativas e o progresso semanais, mensais e anuais agora refletem seus períodos completos no calendário."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"每周、每月和每年的估算值及进度现在均反映完整的日历周期。"}}
      }
    },
    "Weekly, monthly, and yearly roll-up summaries now write correctly inside archived and zipped exports." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wöchentliche, monatliche und jährliche Zusammenfassungen werden jetzt korrekt in archivierte und ZIP-komprimierte Exporte geschrieben."}},
        "es": {"stringUnit":{"state":"translated","value":"Los resúmenes semanales, mensuales y anuales ahora se escriben correctamente dentro de las exportaciones archivadas y comprimidas en Zip."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les synthèses hebdomadaires, mensuelles et annuelles sont désormais correctement écrites dans les exports archivés et compressés en Zip."}},
        "it": {"stringUnit":{"state":"translated","value":"I riepiloghi aggregati settimanali, mensili e annuali ora vengono scritti correttamente nelle esportazioni archiviate e compresse in Zip."}},
        "ja": {"stringUnit":{"state":"translated","value":"週次・月次・年次の集計サマリーが、アーカイブおよびZip圧縮されたエクスポート内に正しく書き込まれるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 아카이브 및 Zip 압축 내보내기 안에 주간, 월간, 연간 집계 요약이 올바르게 기록됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Wekelijkse, maandelijkse en jaarlijkse periodeoverzichten worden nu correct geschreven in gearchiveerde en gezipte exports."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os resumos consolidados semanais, mensais e anuais agora são gravados corretamente em exportações arquivadas e compactadas em Zip."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"每周、每月和每年的汇总摘要现在可正确写入归档及压缩导出。"}}
      }
    },
    "Weekly, monthly, and yearly roll-ups" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wöchentliche, monatliche und jährliche Zusammenfassungen"}},
        "es": {"stringUnit":{"state":"translated","value":"Resúmenes semanales, mensuales y anuales"}},
        "fr": {"stringUnit":{"state":"translated","value":"Synthèses hebdomadaires, mensuelles et annuelles"}},
        "it": {"stringUnit":{"state":"translated","value":"Riepiloghi settimanali, mensili e annuali"}},
        "ja": {"stringUnit":{"state":"translated","value":"週次・月次・年次の集計"}},
        "ko": {"stringUnit":{"state":"translated","value":"주간, 월간, 연간 집계"}},
        "nl": {"stringUnit":{"state":"translated","value":"Wekelijkse, maandelijkse en jaarlijkse periodeoverzichten"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Consolidações semanais, mensais e anuais"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"每周、每月和每年汇总"}}
      }
    },
    "Weekly, monthly, and yearly summary files now land correctly in archived and zipped exports across iPhone, iPad, and Mac." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wöchentliche, monatliche und jährliche Zusammenfassungsdateien werden jetzt auf iPhone, iPad und Mac korrekt in archivierte und ZIP-komprimierte Exporte aufgenommen."}},
        "es": {"stringUnit":{"state":"translated","value":"Los archivos de resumen semanales, mensuales y anuales ahora se incluyen correctamente en las exportaciones archivadas y comprimidas en Zip en iPhone, iPad y Mac."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les fichiers de synthèse hebdomadaire, mensuelle et annuelle sont désormais correctement inclus dans les exports archivés et compressés en Zip sur iPhone, iPad et Mac."}},
        "it": {"stringUnit":{"state":"translated","value":"I file di riepilogo settimanali, mensili e annuali ora vengono inseriti correttamente nelle esportazioni archiviate e compresse in Zip su iPhone, iPad e Mac."}},
        "ja": {"stringUnit":{"state":"translated","value":"iPhone、iPad、Macで、週次・月次・年次のサマリーファイルが、アーカイブおよびZip圧縮されたエクスポート内に正しく保存されるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 iPhone, iPad, Mac의 아카이브 및 Zip 압축 내보내기에 주간, 월간, 연간 요약 파일이 올바르게 포함됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Wekelijkse, maandelijkse en jaarlijkse samenvattingsbestanden worden nu correct opgenomen in gearchiveerde en gezipte exports op iPhone, iPad en Mac."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os arquivos de resumo semanais, mensais e anuais agora são incluídos corretamente em exportações arquivadas e compactadas em Zip no iPhone, iPad e Mac."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在 iPhone、iPad 和 Mac 上，每周、每月和每年的摘要文件现在可正确写入归档及压缩导出。"}}
      }
    },
