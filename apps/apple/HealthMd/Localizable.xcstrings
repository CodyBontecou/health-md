    "Make Your Body Part of Obsidian" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Mach deinen Körper zum Teil von Obsidian"}},
        "es": {"stringUnit":{"state":"translated","value":"Haz que tu cuerpo forme parte de Obsidian"}},
        "fr": {"stringUnit":{"state":"translated","value":"Intégrez votre corps à Obsidian"}},
        "it": {"stringUnit":{"state":"translated","value":"Porta il tuo corpo in Obsidian"}},
        "ja": {"stringUnit":{"state":"translated","value":"体のデータをObsidianの一部に"}},
        "ko": {"stringUnit":{"state":"translated","value":"내 몸의 데이터를 Obsidian에 담으세요"}},
        "nl": {"stringUnit":{"state":"translated","value":"Maak je lichaam onderdeel van Obsidian"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Integre seu corpo ao Obsidian"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"让身体数据融入 Obsidian"}}
      }
    },
    "Make your next export easier. Choose a daily schedule to keep saving new health notes without repeating these steps." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Mach deinen nächsten Export einfacher. Wähle einen täglichen Zeitplan, um weiter neue Gesundheitsnotizen zu speichern, ohne diese Schritte zu wiederholen."}},
        "es": {"stringUnit":{"state":"translated","value":"Facilita tu próxima exportación. Elige una programación diaria para seguir guardando nuevas notas de salud sin repetir estos pasos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Simplifiez votre prochain export. Choisissez une programmation quotidienne pour continuer à enregistrer de nouvelles notes de santé sans répéter ces étapes."}},
        "it": {"stringUnit":{"state":"translated","value":"Semplifica la prossima esportazione. Scegli una programmazione giornaliera per continuare a salvare nuove note sulla salute senza ripetere questi passaggi."}},
        "ja": {"stringUnit":{"state":"translated","value":"次回のエクスポートをもっと簡単に。毎日のスケジュールを設定すれば、この手順を繰り返さずに新しい健康ノートを保存し続けられます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"다음 내보내기를 더 간편하게 하세요. 매일 실행하는 일정을 선택하면 이 단계를 반복하지 않고 새 건강 노트를 계속 저장할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Maak je volgende export eenvoudiger. Kies een dagelijks schema om nieuwe gezondheidsnotities te blijven opslaan zonder deze stappen te herhalen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Facilite sua próxima exportação. Escolha um agendamento diário para continuar salvando novas notas de saúde sem repetir estas etapas."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"让下次导出更轻松。选择每日计划，即可持续保存新的健康笔记，无需重复这些步骤。"}}
      }
    },
    "More accessible throughout" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Durchgehend barriereärmer"}},
        "es": {"stringUnit":{"state":"translated","value":"Mayor accesibilidad en toda la app"}},
        "fr": {"stringUnit":{"state":"translated","value":"Une meilleure accessibilité partout"}},
        "it": {"stringUnit":{"state":"translated","value":"Maggiore accessibilità in tutta l’app"}},
        "ja": {"stringUnit":{"state":"translated","value":"アプリ全体のアクセシビリティを向上"}},
        "ko": {"stringUnit":{"state":"translated","value":"앱 전반의 접근성 개선"}},
        "nl": {"stringUnit":{"state":"translated","value":"Overal toegankelijker"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Mais acessível em todo o app"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"全面提升无障碍体验"}}
      }
    },
    "Move export profiles between devices in one small file, review changes before applying them, and undo once. Shared files contain no health data or credentials." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Übertrage Exportprofile in einer kleinen Datei zwischen Geräten, prüfe Änderungen vor dem Übernehmen und mache sie einmal rückgängig. Geteilte Dateien enthalten keine Gesundheits- oder Zugangsdaten."}},
        "es": {"stringUnit":{"state":"translated","value":"Transfiere perfiles de exportación entre dispositivos en un pequeño archivo, revisa los cambios antes de aplicarlos y deshazlos una vez. Los archivos compartidos no contienen datos de salud ni credenciales."}},
        "fr": {"stringUnit":{"state":"translated","value":"Transférez vos profils d’export entre appareils dans un petit fichier, vérifiez les modifications avant de les appliquer et annulez-les une fois si nécessaire. Les fichiers partagés ne contiennent ni données de santé ni identifiants."}},
        "it": {"stringUnit":{"state":"translated","value":"Trasferisci i profili di esportazione tra dispositivi con un unico piccolo file, controlla le modifiche prima di applicarle e annullale una volta. I file condivisi non contengono dati sanitari né credenziali."}},
        "ja": {"stringUnit":{"state":"translated","value":"小さなファイル1つでデバイス間でエクスポートプロファイルを移動し、適用前に変更を確認できます。取り消しは1回可能です。共有ファイルに健康データや認証情報は含まれません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"작은 파일 하나로 기기 간에 내보내기 프로필을 옮기고, 적용 전에 변경 사항을 검토하며, 한 번 실행 취소할 수 있습니다. 공유 파일에는 건강 데이터나 인증 정보가 포함되지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Zet exportprofielen over tussen apparaten in één klein bestand, bekijk wijzigingen voordat je ze toepast en maak ze één keer ongedaan. Gedeelde bestanden bevatten geen gezondheidsgegevens of inloggegevens."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Transfira perfis de exportação entre dispositivos em um pequeno arquivo, revise as alterações antes de aplicá-las e desfaça uma vez. Os arquivos compartilhados não contêm dados de saúde nem credenciais."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"通过一个小文件在设备间转移导出配置，应用前可查看更改，并可撤销一次。共享文件不包含健康数据或凭据。"}}
      }
    },
    "New Gateway" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Neues Gateway"}},
