    "Allow camera access in Settings to scan a Direct CLI pairing QR securely inside Health.md." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erlaube in den Einstellungen den Kamerazugriff, um einen Direct CLI-Kopplungs-QR-Code sicher in Health.md zu scannen."}},
        "es": {"stringUnit":{"state":"translated","value":"Permite el acceso a la cámara en Ajustes para escanear de forma segura un QR de enlace de Direct CLI dentro de Health.md."}},
        "fr": {"stringUnit":{"state":"translated","value":"Autorisez l’accès à l’appareil photo dans Réglages pour scanner en toute sécurité un code QR de jumelage Direct CLI dans Health.md."}},
        "it": {"stringUnit":{"state":"translated","value":"Consenti l’accesso alla fotocamera in Impostazioni per scansionare in sicurezza un codice QR di abbinamento Direct CLI all’interno di Health.md."}},
        "ja": {"stringUnit":{"state":"translated","value":"Health.md内でDirect CLIペアリング用QRコードを安全にスキャンするには、「設定」でカメラへのアクセスを許可してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Health.md 안에서 Direct CLI 페어링 QR을 안전하게 스캔하려면 설정에서 카메라 접근을 허용하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Sta cameratoegang toe in Instellingen om een Direct CLI-koppelings-QR-code veilig binnen Health.md te scannen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Permita o acesso à câmera nos Ajustes para ler um QR de pareamento Direct CLI com segurança no Health.md."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请在“设置”中允许访问相机，以便在 Health.md 内安全扫描 Direct CLI 配对二维码。"}}
      }
    },
