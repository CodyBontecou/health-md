    "Missing bundled skill file %@." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlende gebündelte Skilldatei %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missing bundled skill file %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el archivo de habilidades incluido %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichier de compétences groupé manquant %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File delle abilità in bundle mancante %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バンドルされたスキル ファイル %1$@ がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번들 스킬 파일 %1$@가 누락되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontbrekend gebundeld vaardigheidsbestand %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivo de habilidade agrupado %1$@ ausente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少捆绑技能文件 %1$@。"
          }
        }
      }
    },
    "Missing data can mean the requested day has no WHOOP score yet, a permission was not approved, or WHOOP is rate limiting requests. Reconnect after revoked or missing access. Rate-limited exports keep an error in the sidecar so you can retry later." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Fehlende Daten können bedeuten, dass für den angefragten Tag noch kein WHOOP-Score vorliegt, eine Berechtigung nicht erteilt wurde oder WHOOP die Anfragerate begrenzt. Verbinde dich bei widerrufenem oder fehlendem Zugriff erneut. Bei Exporten mit begrenzter Anfragerate bleibt ein Fehler in der Sidecar-Datei erhalten, damit du es später erneut versuchen kannst."}},
        "es": {"stringUnit":{"state":"translated","value":"La falta de datos puede indicar que el día solicitado aún no tiene una puntuación de WHOOP, que no se aprobó un permiso o que WHOOP está limitando la frecuencia de las solicitudes. Vuelve a conectarte si el acceso se ha revocado o falta. Las exportaciones limitadas por frecuencia conservan un error en el archivo auxiliar para que puedas volver a intentarlo más tarde."}},
        "fr": {"stringUnit":{"state":"translated","value":"Des données manquantes peuvent signifier que le jour demandé n’a pas encore de score WHOOP, qu’une autorisation n’a pas été accordée ou que WHOOP limite la fréquence des requêtes. Reconnectez-vous si l’accès a été révoqué ou n’a pas été accordé. Les exportations soumises à cette limite conservent une erreur dans le fichier annexe pour vous permettre de réessayer plus tard."}},
        "it": {"stringUnit":{"state":"translated","value":"L'assenza di dati può indicare che per il giorno richiesto non è ancora disponibile un punteggio WHOOP, che un'autorizzazione non è stata approvata o che WHOOP sta limitando la frequenza delle richieste. Riconnettiti se l'accesso è stato revocato o manca. Le esportazioni soggette a limiti di frequenza conservano un errore nel sidecar, così puoi riprovare più tardi."}},
        "ja": {"stringUnit":{"state":"translated","value":"データがない場合、指定日の WHOOP スコアがまだない、権限が承認されていない、または WHOOP がリクエストをレート制限している可能性があります。アクセス権が取り消された場合や不足している場合は、再接続してください。レート制限されたエクスポートでは、後で再試行できるようサイドカーにエラーが記録されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"데이터가 없는 경우 요청한 날짜의 WHOOP 점수가 아직 없거나, 권한이 승인되지 않았거나, WHOOP이 요청 빈도를 제한하고 있을 수 있습니다. 접근 권한이 취소되었거나 없으면 다시 연결하세요. 요청 빈도가 제한된 내보내기는 나중에 다시 시도할 수 있도록 사이드카에 오류를 남깁니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Ontbrekende gegevens kunnen betekenen dat de aangevraagde dag nog geen WHOOP-score heeft, dat een toestemming niet is verleend of dat WHOOP het aantal aanvragen beperkt. Maak opnieuw verbinding als toegang is ingetrokken of ontbreekt. Exports die door een aanvraaglimiet worden beperkt, bewaren een fout in de sidecar, zodat je het later opnieuw kunt proberen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Dados ausentes podem indicar que o dia solicitado ainda não tem pontuação WHOOP, que uma permissão não foi aprovada ou que o WHOOP está limitando a frequência das solicitações. Reconecte se o acesso estiver revogado ou ausente. Exportações limitadas por frequência mantêm um erro no arquivo auxiliar para que você possa tentar novamente mais tarde."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"数据缺失可能表示所请求的日期尚无 WHOOP 评分、某项权限未获批准，或 WHOOP 正在限制请求频率。访问权限被撤销或缺失时，请重新连接。因频率限制而受阻的导出会在附属记录中保留错误，以便你稍后重试。"}}
      }
    },
    "Missing permissions: %@. Reconnect to approve them." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Fehlende Berechtigungen: %@. Verbinde dich erneut, um sie zu erteilen."}},
        "es": {"stringUnit":{"state":"translated","value":"Faltan permisos: %@. Vuelve a conectarte para aprobarlos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Autorisations manquantes : %@. Reconnectez-vous pour les accorder."}},
        "it": {"stringUnit":{"state":"translated","value":"Autorizzazioni mancanti: %@. Riconnettiti per approvarle."}},
        "ja": {"stringUnit":{"state":"translated","value":"不足している権限: %@。再接続して承認してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"누락된 권한: %@. 다시 연결하여 승인하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Ontbrekende toestemmingen: %@. Maak opnieuw verbinding om ze te verlenen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Permissões ausentes: %@. Reconecte para aprová-las."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"缺少权限：%@。请重新连接以批准这些权限。"}}
      }
    },
