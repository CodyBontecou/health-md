    "Preserve original Apple Health samples with their sources, devices, timestamps, metadata, relationships, and available attachments." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Bewahre ursprüngliche Apple Health-Messwerte samt Quellen, Geräten, Zeitstempeln, Metadaten, Beziehungen und verfügbaren Anhängen."}},
        "es": {"stringUnit":{"state":"translated","value":"Conserva las muestras originales de Apple Health con sus fuentes, dispositivos, marcas de tiempo, metadatos, relaciones y archivos adjuntos disponibles."}},
        "fr": {"stringUnit":{"state":"translated","value":"Conservez les échantillons Apple Health d’origine avec leurs sources, appareils, horodatages, métadonnées, relations et pièces jointes disponibles."}},
        "it": {"stringUnit":{"state":"translated","value":"Conserva i campioni originali di Apple Health con fonti, dispositivi, timestamp, metadati, relazioni e allegati disponibili."}},
        "ja": {"stringUnit":{"state":"translated","value":"元の Apple Health サンプルを、ソース、デバイス、タイムスタンプ、メタデータ、関連情報、利用可能な添付ファイルとともに保持します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"원본 Apple Health 샘플을 출처, 기기, 타임스탬프, 메타데이터, 관계 및 사용 가능한 첨부 파일과 함께 보존하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Bewaar oorspronkelijke Apple Health-registraties met hun bronnen, apparaten, tijdstempels, metadata, relaties en beschikbare bijlagen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Preserve as amostras originais do Apple Health com suas fontes, dispositivos, registros de data e hora, metadados, relações e anexos disponíveis."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"保留原始 Apple Health 样本及其来源、设备、时间戳、元数据、关联关系和可用附件。"}}
      }
    },
