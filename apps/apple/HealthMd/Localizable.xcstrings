    "clinician_report_intro": {
      "comment": "Clinician Report V1 localized vocabulary. Managed by scripts/validate-clinician-report-localizations.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Zeitraum und Messwerte aus, sehen Sie sich eine sachliche Übersicht in der Vorschau an und erstellen Sie anschließend vollständig auf diesem Gerät eine PDF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a period and measurements, preview a factual summary, then generate a PDF entirely on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un período y mediciones, previsualice un resumen objetivo y genere un PDF íntegramente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une période et des mesures, prévisualisez un résumé factuel, puis générez un PDF entièrement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un periodo e le misurazioni, visualizza l’anteprima di un riepilogo oggettivo, quindi genera un PDF interamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間と測定項目を選択して客観的なサマリーをプレビューし、このデバイス上だけで PDF を生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간과 측정 항목을 선택하고 객관적인 요약을 미리 본 다음 이 기기에서만 PDF를 생성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een periode en metingen, bekijk een feitelijke samenvatting en genereer vervolgens volledig op dit apparaat een PDF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um período e as medições, visualize um resumo objetivo e gere um PDF inteiramente neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择时间段和测量项目，预览客观摘要，然后完全在此设备上生成 PDF。"
          }
        }
      }
    },
