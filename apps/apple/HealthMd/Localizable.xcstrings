    "Every encrypted owner day earlier than this date will be permanently removed. The boundary date and newer days remain." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle verschlüsselten Eigentümer-Tage vor diesem Datum werden dauerhaft entfernt. Das Stichtagsdatum und spätere Tage bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every encrypted owner day earlier than this date will be permanently removed. The boundary date and newer days remain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día del propietario cifrado anterior a esta fecha se eliminará permanentemente. La fecha límite y los días más nuevos permanecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour de propriétaire chiffré précédant cette date sera définitivement supprimé. La date limite et les jours plus récents restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni proprietario crittografato il giorno precedente a questa data verrà rimosso definitivamente. Rimangono la data limite e i giorni più recenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この日付より 1 日前の暗号化された所有者はすべて完全に削除されます。境界日以降の日付が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 날짜 이전의 모든 암호화된 소유자 날짜는 영구적으로 제거됩니다. 경계 날짜와 최신 날짜가 남아 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke versleutelde eigenaarsdag vóór deze datum wordt permanent verwijderd. De grensdatum en nieuwere dagen blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada proprietário criptografado um dia antes desta data será removido permanentemente. A data limite e os dias mais recentes permanecem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "早于该日期的每个加密所有者日都将被永久删除。边界日期和较新的日期仍然存在。"
          }
        }
      }
    },
    "Every HealthKit workout type" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Jeder HealthKit-Trainingstyp"}},
        "es": {"stringUnit":{"state":"translated","value":"Todos los tipos de entrenamiento de HealthKit"}},
        "fr": {"stringUnit":{"state":"translated","value":"Tous les types d’entraînement HealthKit"}},
        "it": {"stringUnit":{"state":"translated","value":"Tutti i tipi di allenamento HealthKit"}},
        "ja": {"stringUnit":{"state":"translated","value":"HealthKitのすべてのワークアウトタイプ"}},
        "ko": {"stringUnit":{"state":"translated","value":"모든 HealthKit 운동 유형"}},
        "nl": {"stringUnit":{"state":"translated","value":"Elk HealthKit-work-outtype"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Todos os tipos de treino do HealthKit"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"所有 HealthKit 体能训练类型"}}
      }
    },
    "Every imported destination is unbound and every imported schedule is disabled. Profiles stay blocked until their destination is explicitly rebound on this device." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Alle importierten Ziele sind ohne Zuordnung und alle importierten Zeitpläne sind deaktiviert. Profile bleiben gesperrt, bis ihr Ziel auf diesem Gerät ausdrücklich neu zugeordnet wird."}},
        "es": {"stringUnit":{"state":"translated","value":"Todos los destinos importados quedan sin vincular y todas las programaciones importadas quedan deshabilitadas. Los perfiles permanecen bloqueados hasta que su destino se vuelva a vincular explícitamente en este dispositivo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Chaque destination importée est dissociée et chaque planification importée est désactivée. Les profils restent bloqués tant que leur destination n’a pas été explicitement réassociée sur cet appareil."}},
        "it": {"stringUnit":{"state":"translated","value":"Ogni destinazione importata è scollegata e ogni pianificazione importata è disabilitata. I profili restano bloccati finché la loro destinazione non viene ricollegata esplicitamente su questo dispositivo."}},
        "ja": {"stringUnit":{"state":"translated","value":"インポートしたすべての保存先は未接続で、すべてのスケジュールは無効です。このデバイスで保存先を明示的に再接続するまで、プロファイルはブロックされたままです。"}},
        "ko": {"stringUnit":{"state":"translated","value":"가져온 모든 대상은 연결이 해제되어 있으며, 가져온 모든 일정은 비활성화됩니다. 이 기기에서 대상을 명시적으로 다시 연결할 때까지 프로필은 차단된 상태로 유지됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Elke geïmporteerde bestemming is ontkoppeld en elk geïmporteerd schema is uitgeschakeld. Profielen blijven geblokkeerd totdat hun bestemming expliciet opnieuw is gekoppeld op dit apparaat."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Todos os destinos importados ficam sem vínculo e todos os agendamentos importados ficam desativados. Os perfis permanecem bloqueados até que seu destino seja explicitamente vinculado novamente neste dispositivo."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"所有导入的目标位置均未绑定，所有导入的计划均已禁用。只有在此设备上明确重新绑定目标位置后，配置方案才会解除阻止。"}}
      }
    },
    "Every saved export configuration in one place. Activate a profile to edit it in the Export tab; schedules run even when this screen is closed." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Alle gespeicherten Exportkonfigurationen an einem Ort. Aktiviere ein Profil, um es im Tab „Exportieren“ zu bearbeiten. Zeitpläne werden auch ausgeführt, wenn diese Ansicht geschlossen ist."}},
        "es": {"stringUnit":{"state":"translated","value":"Todas las configuraciones de exportación guardadas en un solo lugar. Activa un perfil para editarlo en la pestaña Exportar; las programaciones se ejecutan aunque esta pantalla esté cerrada."}},
        "fr": {"stringUnit":{"state":"translated","value":"Toutes vos configurations d’exportation enregistrées au même endroit. Activez un profil pour le modifier dans l’onglet Exporter ; les planifications s’exécutent même lorsque cet écran est fermé."}},
        "it": {"stringUnit":{"state":"translated","value":"Tutte le configurazioni di esportazione salvate in un unico posto. Attiva un profilo per modificarlo nella scheda Esporta; le pianificazioni vengono eseguite anche quando questa schermata è chiusa."}},
        "ja": {"stringUnit":{"state":"translated","value":"保存したすべてのエクスポート設定をまとめて管理できます。プロファイルを有効化すると、エクスポートタブで編集できます。この画面を閉じても、スケジュールは実行されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"저장된 모든 내보내기 구성을 한곳에서 관리하세요. 프로필을 활성화하면 내보내기 탭에서 편집할 수 있습니다. 이 화면을 닫아도 일정은 실행됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Alle opgeslagen exportconfiguraties op één plek. Activeer een profiel om het te bewerken op het tabblad Exporteren; schema's worden ook uitgevoerd wanneer dit scherm gesloten is."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Todas as configurações de exportação salvas em um só lugar. Ative um perfil para editá-lo na aba Exportar; os agendamentos são executados mesmo com esta tela fechada."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"集中管理所有已保存的导出配置。激活配置方案后，可在“导出”标签页中编辑；即使关闭此页面，计划仍会运行。"}}
      }
    },
