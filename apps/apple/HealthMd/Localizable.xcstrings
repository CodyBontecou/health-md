      }
    },
    "This export is too large for rich preview. The complete source is shown instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Export ist zu groß für die formatierte Vorschau. Stattdessen wird der vollständige Quelltext angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exportación es demasiado grande para la vista previa enriquecida. Se muestra el código fuente completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette exportation est trop volumineuse pour l’aperçu enrichi. Le texte source complet est affiché à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa esportazione è troppo grande per l’anteprima avanzata. Viene mostrato il testo sorgente completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書き出しはリッチプレビューには大きすぎるため、完全なソースを表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 내보내기는 서식 있는 미리보기에 너무 큽니다. 대신 전체 원본을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze export is te groot voor een opgemaakte voorvertoning. In plaats daarvan wordt de volledige bron weergegeven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exportação é grande demais para a pré-visualização avançada. O conteúdo completo é exibido no modo fonte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此导出文件过大，无法使用富文本预览，因此改为显示完整源文本。"
          }
        }
      }
    },
