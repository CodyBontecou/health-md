    "Exports update YAML frontmatter in the daily notes you already keep, while normal export files still follow your selected formats.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exportaciones actualizan el frontmatter YAML de tus notas diarias, mientras los archivos normales mantienen los formatos elegidos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte aktualisieren das YAML-Frontmatter Ihrer bestehenden täglichen Notizen; reguläre Exportdateien werden weiterhin in den von Ihnen ausgewählten Formaten erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
