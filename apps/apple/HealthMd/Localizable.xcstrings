    "Tune presentation settings without changing Health.md’s export schema." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Darstellung an, ohne das Exportschema von Health.md zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la presentación sin cambiar el esquema de exportación de Health.md."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez les réglages de présentation sans modifier le schéma d’exportation de Health.md."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola le impostazioni di presentazione senza modificare lo schema di esportazione di Health.md."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.mdのエクスポートスキーマを変更せずに表示設定を調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md의 내보내기 스키마를 변경하지 않고 표시 설정을 조정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de weergave aan zonder het exportschema van Health.md te wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste as configurações de apresentação sem alterar o esquema de exportação do Health.md."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整呈现设置，而不更改 Health.md 的导出数据结构。"
          }
        }
      }
    },
    "Turn off Prevent Accidental Changes in Settings to edit your configuration." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Deaktiviere „Versehentliche Änderungen verhindern“ in den Einstellungen, um deine Konfiguration zu bearbeiten."}},
        "es": {"stringUnit":{"state":"translated","value":"Desactiva Evitar cambios accidentales en Ajustes para editar tu configuración."}},
        "fr": {"stringUnit":{"state":"translated","value":"Désactivez « Empêcher les modifications accidentelles » dans les réglages pour modifier votre configuration."}},
        "it": {"stringUnit":{"state":"translated","value":"Disattiva Impedisci modifiche accidentali nelle Impostazioni per modificare la configurazione."}},
        "ja": {"stringUnit":{"state":"translated","value":"設定を編集するには、「設定」で「誤操作による変更を防止」をオフにしてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"구성을 편집하려면 설정에서 실수로 변경 방지를 끄세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Schakel Onbedoelde wijzigingen voorkomen uit in Instellingen om je configuratie te bewerken."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Desative Impedir alterações acidentais em Ajustes para editar sua configuração."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请在设置中关闭“防止意外更改”，以编辑配置。"}}
      }
    },
    "Turn off to omit these two tables from Markdown exports and daily notes while keeping readable workout summaries. Structured data and source capture are unchanged." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Deaktivieren, um diese beiden Tabellen in Markdown-Exporten und täglichen Notizen wegzulassen. Lesbare Trainingszusammenfassungen bleiben erhalten. Strukturierte Daten und Quelldatenerfassung bleiben unverändert." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn off to omit these two tables from Markdown exports and daily notes while keeping readable workout summaries. Structured data and source capture are unchanged." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactiva para omitir estas dos tablas en las exportaciones Markdown y notas diarias, conservando los resúmenes legibles del entrenamiento. Los datos estructurados y la captura de datos de origen no cambian." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactivez pour omettre ces deux tableaux des exports Markdown et des notes quotidiennes, tout en conservant les résumés lisibles des entraînements. Les données structurées et la capture des données sources restent inchangées." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Disattiva per omettere queste due tabelle dalle esportazioni Markdown e dalle note giornaliere, mantenendo i riepiloghi leggibili degli allenamenti. I dati strutturati e l’acquisizione dei dati di origine non cambiano." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフにすると、読みやすいワークアウトの概要を残したまま、Markdownエクスポートとデイリーノートからこの2つの表を省略します。構造化データとソースデータの取得は変わりません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "끄면 읽기 쉬운 운동 요약은 유지하고 Markdown 내보내기와 일일 노트에서 이 두 표를 제외합니다. 구조화된 데이터와 원본 데이터 수집은 변경되지 않습니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Schakel uit om deze twee tabellen weg te laten uit Markdown-exports en dagelijkse notities, met behoud van leesbare trainingssamenvattingen. Gestructureerde gegevens en brongegevensverzameling blijven ongewijzigd." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desative para omitir estas duas tabelas das exportações Markdown e notas diárias, mantendo os resumos legíveis dos treinos. Os dados estruturados e a captura de dados de origem não mudam." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭后，Markdown导出和每日笔记将省略这两个表格，同时保留可读的体能训练摘要。结构化数据和源数据采集不变。" } }
      }
    },
    "Turn off to keep generated output free of %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren Sie dies, damit die generierte Ausgabe frei von %@ bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo para no incluir %@ en los archivos generados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez cette option pour exclure %@ de la sortie générée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva questa opzione per escludere %@ dall’output generato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を含まない出力を生成するにはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 없이 출력을 생성하려면 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel dit uit om de gegenereerde uitvoer vrij van %@ te houden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative para que a saída gerada não inclua %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，生成的输出中将不包含 %@。"
          }
        }
      }
    },
    "Turn on “Allow paired computers to send wake requests” under Sync → Direct CLI Access to let a waiting CLI command send one visible notification while its wake window holds — tap it and the command completes. Everything is opt-in, and your health data never touches the notifications worker." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Aktiviere „Gekoppelten Computern das Senden von Aufweckanfragen erlauben“ unter Synchronisierung → Direkter CLI-Zugriff. So kann ein wartender CLI-Befehl während seines Aufweckzeitfensters eine sichtbare Mitteilung senden. Tippe darauf, damit der Befehl abgeschlossen wird. Alles erfordert deine ausdrückliche Zustimmung, und deine Gesundheitsdaten gelangen niemals zum Benachrichtigungs-Worker."}},
        "es": {"stringUnit":{"state":"translated","value":"Activa «Permitir que los ordenadores enlazados envíen solicitudes de activación» en Sincronización → Direct CLI Access para que un comando de la CLI en espera pueda enviar una notificación visible mientras su ventana de activación siga vigente. Tócala y el comando se completará. Todo requiere tu autorización expresa y tus datos de salud nunca pasan por el servicio de notificaciones."}},
        "fr": {"stringUnit":{"state":"translated","value":"Activez « Autoriser les ordinateurs jumelés à envoyer des demandes de réveil » dans Synchronisation → Accès CLI direct pour permettre à une commande CLI en attente d’envoyer une seule notification visible pendant sa fenêtre de réveil. Touchez-la pour que la commande aboutisse. Tout nécessite votre accord explicite, et vos données de santé ne transitent jamais par le service de notifications."}},
        "it": {"stringUnit":{"state":"translated","value":"Attiva “Consenti ai computer abbinati di inviare richieste di risveglio” in Sincronizzazione → Accesso CLI diretto per consentire a un comando CLI in attesa di inviare una notifica visibile durante la sua finestra di risveglio: toccala per completare il comando. Tutto richiede un’attivazione esplicita e i tuoi dati sanitari non passano mai dal servizio di gestione delle notifiche."}},
        "ja": {"stringUnit":{"state":"translated","value":"「同期 → Direct CLI Access」で「ペアリング済みコンピュータからの起動リクエストを許可」をオンにすると、待機中のCLIコマンドが起動待機時間内に表示通知を1回送信できます。通知をタップするとコマンドが完了します。すべて明示的な有効化が必要で、ヘルスデータが通知ワーカーに渡ることは一切ありません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"동기화 → Direct CLI Access에서 “페어링된 컴퓨터의 깨우기 요청 허용”을 켜면 대기 중인 CLI 명령이 깨우기 허용 시간 동안 표시되는 알림을 한 번 보낼 수 있습니다. 알림을 탭하면 명령이 완료됩니다. 모든 기능은 직접 동의해야 활성화되며, 건강 데이터는 알림 워커에 절대 전달되지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Schakel ‘Gekoppelde computers mogen wekverzoeken versturen’ in onder Synchronisatie → Direct CLI-toegang, zodat een wachtende CLI-opdracht één zichtbare melding kan sturen zolang het wekvenster open is — tik erop om de opdracht te voltooien. Alles vereist je uitdrukkelijke toestemming en je gezondheidsgegevens komen nooit bij de meldingsworker terecht."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Ative “Permitir que computadores emparelhados enviem solicitações de ativação” em Sincronização → Acesso direto via CLI para permitir que um comando da CLI em espera envie uma notificação visível enquanto sua janela de ativação estiver válida — toque nela para concluir o comando. Tudo depende da sua adesão, e seus dados de saúde nunca passam pelo serviço de notificações."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在“同步 → Direct CLI Access”中开启“允许已配对的电脑发送唤醒请求”，即可让等待中的 CLI 命令在唤醒窗口有效期间发送一条可见通知；轻点通知即可完成命令。所有功能均需主动启用，您的健康数据绝不会经过通知工作程序。"}}
      }
    },
    "Turn on Zip Export Files to write one archive instead of loose files for the formats you selected." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Aktiviere „Exportdateien als ZIP“, um für die ausgewählten Formate ein Archiv statt einzelner Dateien zu schreiben."}},
        "es": {"stringUnit":{"state":"translated","value":"Activa Comprimir archivos de exportación en Zip para crear un único archivo comprimido en lugar de archivos sueltos para los formatos seleccionados."}},
        "fr": {"stringUnit":{"state":"translated","value":"Activez « Compresser les fichiers exportés en Zip » pour créer une archive au lieu de fichiers séparés pour les formats sélectionnés."}},
        "it": {"stringUnit":{"state":"translated","value":"Attiva Comprimi i file di esportazione in Zip per scrivere un unico archivio invece di file separati per i formati selezionati."}},
        "ja": {"stringUnit":{"state":"translated","value":"「エクスポートファイルをZip圧縮」をオンにすると、選択した形式を個別のファイルではなく1つのアーカイブに書き込みます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기 파일 Zip 압축을 켜면 선택한 형식을 개별 파일 대신 하나의 압축 파일로 기록합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Schakel Exportbestanden zippen in om voor je geselecteerde indelingen één archief te schrijven in plaats van losse bestanden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Ative Compactar arquivos de exportação em Zip para gravar um único arquivo compactado em vez de arquivos avulsos nos formatos selecionados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"开启“压缩导出文件”，将所选格式写入一个压缩包，而非分散的文件。"}}
      }
    },
    "Turn Scheduled Export On or Off" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplanten Export ein- oder ausschalten"}},
        "es": {"stringUnit":{"state":"translated","value":"Activar o desactivar la exportación programada"}},
        "fr": {"stringUnit":{"state":"translated","value":"Activer ou désactiver l’exportation programmée"}},
        "it": {"stringUnit":{"state":"translated","value":"Attiva o disattiva l’esportazione pianificata"}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュールエクスポートのオン／オフを切り替え"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 내보내기 켜기 또는 끄기"}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande export in- of uitschakelen"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Ativar ou desativar a exportação agendada"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"开启或关闭定时导出"}}
      }
    },
    "Turn selected Apple Health metrics into a focused report for the last 7, 30, or 90 days—or a custom date range." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erstelle aus ausgewählten Apple Health-Metriken einen gezielten Bericht für die letzten 7, 30 oder 90 Tage oder einen eigenen Zeitraum."}},
        "es": {"stringUnit":{"state":"translated","value":"Convierte las métricas seleccionadas de Apple Health en un informe específico de los últimos 7, 30 o 90 días, o de un intervalo de fechas personalizado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Transformez les indicateurs Apple Health sélectionnés en un rapport ciblé sur les 7, 30 ou 90 derniers jours, ou sur une période personnalisée."}},
        "it": {"stringUnit":{"state":"translated","value":"Trasforma le metriche Apple Health selezionate in un report mirato sugli ultimi 7, 30 o 90 giorni, oppure su un intervallo di date personalizzato."}},
        "ja": {"stringUnit":{"state":"translated","value":"選択したApple Healthの指標から、過去7日、30日、90日、または任意の期間の要点を絞ったレポートを作成します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"선택한 Apple Health 항목을 최근 7일, 30일, 90일 또는 사용자 지정 기간의 핵심 보고서로 만드세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Maak van geselecteerde Apple Health-meetwaarden een gericht rapport over de afgelopen 7, 30 of 90 dagen, of een aangepaste periode."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Transforme métricas selecionadas do Apple Health em um relatório focado nos últimos 7, 30 ou 90 dias — ou em um intervalo de datas personalizado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"将选定的 Apple Health 指标汇成专题报告，涵盖最近 7、30 或 90 天，也可自定日期范围。"}}
      }
    },
    "Turn this on to create one timestamped Markdown file per selected event when you run an export." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie dies, um bei einem Export für jedes ausgewählte Ereignis eine Markdown-Datei mit Zeitstempel zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo para crear un archivo Markdown con fecha y hora por cada evento seleccionado al exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette option pour créer un fichier Markdown horodaté par événement sélectionné lors d’une exportation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva questa opzione per creare un file Markdown con data e ora per ogni evento selezionato quando esegui un’esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、エクスポート実行時に選択したイベントごとにタイムスタンプ付きのMarkdownファイルを1つ作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 내보내기를 실행할 때 선택한 이벤트마다 타임스탬프가 포함된 Markdown 파일을 하나씩 생성합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel dit in om bij een export één Markdown-bestand met tijdstempel per geselecteerde gebeurtenis aan te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative esta opção para criar um arquivo Markdown com data e hora para cada evento selecionado ao executar uma exportação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启此选项后，每次运行导出时都会为每个所选事件创建一个带时间戳的 Markdown 文件。"
          }
        }
      }
    },
