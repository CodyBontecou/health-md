        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez cette app Mac comme destination locale pour les exportations lancées depuis Health.md sur iPhone. L’app Mac ne vend pas l’accès et ne le restreint pas."
