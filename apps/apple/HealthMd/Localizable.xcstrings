    "Schedule exports so your health journal stays current automatically." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Plane Exporte, damit dein Gesundheitstagebuch automatisch aktuell bleibt."}},
        "es": {"stringUnit":{"state":"translated","value":"Programa exportaciones para mantener tu diario de salud actualizado automáticamente."}},
        "fr": {"stringUnit":{"state":"translated","value":"Planifiez les exports pour que votre journal de santé reste à jour automatiquement."}},
        "it": {"stringUnit":{"state":"translated","value":"Programma le esportazioni per mantenere aggiornato automaticamente il tuo diario della salute."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートを予約して、健康日誌を自動で最新に保ちましょう。"}},
        "ko": {"stringUnit":{"state":"translated","value":"건강 일지가 자동으로 최신 상태를 유지하도록 내보내기를 예약하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Plan exports zodat je gezondheidsdagboek automatisch up-to-date blijft."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Agende exportações para manter seu diário de saúde atualizado automaticamente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"设置定时导出，让健康日志自动保持更新。"}}
      }
    },
    "Scheduled JSON exports POST to %@. Tap to edit." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante JSON-Exporte werden per POST an %@ gesendet. Zum Bearbeiten tippen."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones JSON programadas se envían mediante POST a %@. Toca para editar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exports JSON planifiés sont envoyés par POST à %@. Touchez pour modifier."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni JSON programmate vengono inviate tramite POST a %@. Tocca per modificare."}},
        "ja": {"stringUnit":{"state":"translated","value":"定期実行のJSONエクスポートは%@にPOSTします。タップして編集。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약된 JSON 내보내기는 %@에 POST로 전송됩니다. 탭하여 편집하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande JSON-exports worden via POST naar %@ verzonden. Tik om te bewerken."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As exportações JSON agendadas são enviadas via POST para %@. Toque para editar."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"定时 JSON 导出通过 POST 发送至 %@。轻点以编辑。"}}
      }
    },
    "Scheduled exports are paused. Manual exports remain available from the Export tab." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante Exporte sind pausiert. Manuelle Exporte sind weiterhin im Tab „Export“ verfügbar."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones programadas están en pausa. Las exportaciones manuales siguen disponibles en la pestaña Exportar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exports planifiés sont en pause. Les exports manuels restent disponibles dans l’onglet Exporter."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni programmate sono in pausa. Le esportazioni manuali restano disponibili nella scheda Esporta."}},
        "ja": {"stringUnit":{"state":"translated","value":"定期エクスポートは一時停止中です。「エクスポート」タブから手動でエクスポートできます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 내보내기가 일시 중지되었습니다. 내보내기 탭에서 수동 내보내기는 계속 사용할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande exports zijn gepauzeerd. Handmatig exporteren blijft beschikbaar via het tabblad Exporteren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As exportações agendadas estão pausadas. As exportações manuais continuam disponíveis na aba Exportar."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"定时导出已暂停。你仍可在“导出”标签页手动导出。"}}
      }
    },
    "Scheduled exports upload artifacts to %@." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante Exporte laden Artefakte zu %@ hoch."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones programadas suben los archivos generados a %@."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exports planifiés téléversent les artefacts vers %@."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni programmate caricano gli artefatti su %@."}},
        "ja": {"stringUnit":{"state":"translated","value":"定期エクスポートは生成ファイルを%@にアップロードします。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 내보내기는 결과 파일을 %@에 업로드합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande exports uploaden bestanden naar %@."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As exportações agendadas enviam artefatos para %@."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"定时导出会将生成的文件上传至 %@。"}}
      }
    },
    "Scheduled exports upload artifacts to your Agent Data gateway." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante Exporte laden Artefakte zu deinem Agent Data-Gateway hoch."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones programadas suben los archivos generados a tu pasarela de Agent Data."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exports planifiés téléversent les artefacts vers votre passerelle Agent Data."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni programmate caricano gli artefatti sul tuo gateway Agent Data."}},
        "ja": {"stringUnit":{"state":"translated","value":"定期エクスポートは生成ファイルをお使いのAgent Dataゲートウェイにアップロードします。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 내보내기는 결과 파일을 Agent Data 게이트웨이에 업로드합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande exports uploaden bestanden naar je Agent Data-gateway."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As exportações agendadas enviam artefatos para seu gateway Agent Data."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"定时导出会将生成的文件上传至你的 Agent Data 网关。"}}
      }
    },
    "See the Health Note Reveal" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Sieh, wie deine Gesundheitsnotiz entsteht"}},
        "es": {"stringUnit":{"state":"translated","value":"Descubre tu nota de salud"}},
        "fr": {"stringUnit":{"state":"translated","value":"Découvrez votre note de santé"}},
