    "Nearby discovers the pairing command on the same local network. It never falls back to Manual IP." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"„In der Nähe“ findet den Kopplungsbefehl im selben lokalen Netzwerk. Es wird niemals auf „Manuelle IP“ zurückgegriffen."}},
        "es": {"stringUnit":{"state":"translated","value":"Cerca detecta el comando de enlace en la misma red local. Nunca recurre a IP manual como alternativa."}},
        "fr": {"stringUnit":{"state":"translated","value":"À proximité détecte la commande de jumelage sur le même réseau local. Cette option ne bascule jamais vers IP manuelle."}},
        "it": {"stringUnit":{"state":"translated","value":"Nelle vicinanze rileva il comando di abbinamento sulla stessa rete locale. Non passa mai automaticamente a IP manuale."}},
        "ja": {"stringUnit":{"state":"translated","value":"「近くのデバイス」は、同じローカルネットワーク上のペアリングコマンドを検出します。手動 IP に自動で切り替わることはありません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"주변 기기는 같은 로컬 네트워크에서 페어링 명령을 검색합니다. 수동 IP로 자동 전환하지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"In de buurt vindt het koppelcommando op hetzelfde lokale netwerk. Er wordt nooit teruggevallen op Handmatig IP-adres."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Por perto encontra o comando de pareamento na mesma rede local. Nunca recorre ao IP manual como alternativa."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"“附近”会在同一局域网中发现配对命令，绝不会回退到“手动 IP”。"}}
      }
    },
