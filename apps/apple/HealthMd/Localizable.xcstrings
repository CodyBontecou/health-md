            "value": "Samenvatting van het datumbereik"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumo do intervalo de datas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期范围摘要"
          }
        }
      }
    },
    "Range summary only": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Range summary only"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Zeitraumzusammenfassung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo resumen del rango de fechas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumé de la plage de dates uniquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo riepilogo dell'intervallo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間の概要のみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜 범위 요약만"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen samenvatting van het datumbereik"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente resumo do intervalo de datas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅日期范围摘要"
          }
        }
      }
    },
    "Skips daily files and side effects. Health.md still fetches the requested range to build the summary.": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips daily files and side effects. Health.md still fetches the requested range to build the summary."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt tägliche Dateien und Nebeneffekte. Health.md ruft den angeforderten Zeitraum weiterhin ab, um die Zusammenfassung zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite los archivos diarios y los efectos secundarios. Health.md seguirá obteniendo el rango de fechas solicitado para crear el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore les fichiers quotidiens et les effets secondaires. Health.md récupère toujours la plage de dates demandée pour créer le résumé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora i file giornalieri e gli effetti collaterali. Health.md recupera comunque l'intervallo richiesto per creare il riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日次ファイルと副作用をスキップします。Health.md は概要を作成するために、指定した期間を引き続き取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 파일과 부수 효과를 건너뜁니다. Health.md는 요약을 만들기 위해 요청한 날짜 범위를 계속 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat dagelijkse bestanden en neveneffecten over. Health.md haalt nog steeds het gevraagde datumbereik op om de samenvatting te maken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora arquivos diários e efeitos colaterais. O Health.md ainda busca o intervalo solicitado para criar o resumo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过每日文件和副作用。Health.md 仍会获取请求的日期范围来构建摘要。"
          }
        }
      }
    },
    "Skips daily files when the range summary is enabled.": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips daily files when the range summary is enabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt tägliche Dateien, wenn die Zeitraumzusammenfassung aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite los archivos diarios cuando el resumen del rango de fechas está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore les fichiers quotidiens lorsque le résumé de la plage de dates est activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora i file giornalieri quando è abilitato il riepilogo dell'intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間の概要が有効な場合は、日次ファイルをスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜 범위 요약이 활성화되면 일일 파일을 건너뜁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat dagelijkse bestanden over wanneer de samenvatting van het datumbereik is ingeschakeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora arquivos diários quando o resumo do intervalo está ativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用日期范围摘要时跳过每日文件。"
          }
        }
      }
    },
    "When enabled, Health.md summarizes the full requested range but skips daily files, daily-note injection, and individual entries.": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Health.md summarizes the full requested range but skips daily files, daily-note injection, and individual entries."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, fasst Health.md den gesamten angeforderten Zeitraum zusammen, überspringt aber tägliche Dateien, die Einfügung in tägliche Notizen und einzelne Einträge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está activado, Health.md resume todo el rango de fechas solicitado, pero omite los archivos diarios, la inserción en notas diarias y las entradas individuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est activée, Health.md résume toute la plage de dates demandée, mais ignore les fichiers quotidiens, l’insertion dans les notes quotidiennes et les entrées individuelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è abilitato, Health.md riepiloga l'intero intervallo richiesto, ma ignora i file giornalieri, l'inserimento nelle note giornaliere e le singole voci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、Health.md は指定した期間全体を要約しますが、日次ファイル、デイリーノートへの挿入、個別エントリはスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 Health.md가 요청한 전체 날짜 범위를 요약하지만 일일 파일, 일일 노트 삽입 및 개별 항목은 건너뜁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer dit is ingeschakeld, vat Health.md het volledige gevraagde datumbereik samen, maar worden dagelijkse bestanden, invoeging in dagelijkse notities en afzonderlijke vermeldingen overgeslagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Health.md resume todo o intervalo solicitado, mas ignora arquivos diários, inserção em notas diárias e entradas individuais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Health.md 会汇总请求的完整日期范围，但会跳过每日文件、每日笔记注入和单独条目。"
          }
        }
      }
    },
