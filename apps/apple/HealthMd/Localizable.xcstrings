        "ja": {"stringUnit":{"state":"translated","value":"更新リクエスト"}},
        "ko": {"stringUnit":{"state":"translated","value":"새로고침 요청"}},
        "nl": {"stringUnit":{"state":"translated","value":"Vernieuwingsverzoek"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Solicitação de atualização"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"刷新请求"}}
      }
    },
    "Refresh explicit owner dates in the paired computer's encrypted context, without export files or file quota. Requires open, authenticated apps." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Explizit angegebene zugeordnete Datumswerte im verschlüsselten Kontext des gekoppelten Computers aktualisieren, ohne Exportdateien oder Dateikontingent. Erfordert geöffnete, authentifizierte Apps."}},
        "es": {"stringUnit":{"state":"translated","value":"Actualiza las fechas explícitas del propietario en el contexto cifrado del ordenador enlazado, sin archivos de exportación ni cuota de archivos. Requiere que las apps estén abiertas y autenticadas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Actualisez les dates explicites du propriétaire dans le contexte chiffré de l’ordinateur jumelé, sans fichiers d’export ni quota de fichiers. Les apps doivent être ouvertes et authentifiées."}},
        "it": {"stringUnit":{"state":"translated","value":"Aggiorna le date esplicite del proprietario nel contesto crittografato del computer abbinato, senza file di esportazione né consumo della quota file. Richiede app aperte e autenticate."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートファイルやファイル割り当て枠を使わず、ペアリング済みコンピュータの暗号化コンテキスト内で、明示された所有者の日付を更新します。両方のアプリが開かれ、認証済みである必要があります。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기 파일이나 파일 할당량을 사용하지 않고 페어링된 컴퓨터의 암호화된 컨텍스트에서 명시적 소유자 날짜를 새로고침합니다. 앱이 열려 있고 인증되어 있어야 합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Vernieuw expliciete eigenaarsdatums in de versleutelde context van de gekoppelde computer, zonder exportbestanden of bestandsquotum. Vereist geopende apps waarin je bent aangemeld."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Atualize as datas explícitas do proprietário no contexto criptografado do computador emparelhado, sem arquivos de exportação nem cota de arquivos. Requer apps abertos e autenticados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"刷新配对电脑加密上下文中明确指定的归属日期，不生成导出文件，也不占用文件配额。需要两端 App 均已打开并通过身份验证。"}}
      }
    },
    "Refresh windows are best effort; iOS may delay background runs. Each run exports the profile's metrics and formats to its own destination. Scheduled exports require an active trial or subscription, or Lifetime access." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Aktualisierungszeitfenster werden nach Möglichkeit eingehalten; iOS kann Hintergrundausführungen verzögern. Jeder Durchlauf exportiert die Messwerte und Formate des Profils an dessen eigenes Ziel. Geplante Exporte erfordern eine aktive Testphase oder ein aktives Abo oder lebenslangen Zugriff."}},
        "es": {"stringUnit":{"state":"translated","value":"Se intentará respetar los intervalos de actualización, pero iOS puede retrasar las ejecuciones en segundo plano. Cada ejecución exporta las métricas y los formatos del perfil a su propio destino. Las exportaciones programadas requieren una prueba o suscripción activa, o acceso de por vida."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les créneaux d’actualisation ne sont pas garantis ; iOS peut retarder les exécutions en arrière-plan. Chaque exécution exporte les mesures et formats du profil vers sa propre destination. Les exports planifiés nécessitent une période d’essai ou un abonnement en cours de validité, ou un accès à vie."}},
        "it": {"stringUnit":{"state":"translated","value":"Gli intervalli di aggiornamento non sono garantiti: iOS può ritardare le esecuzioni in background. Ogni esecuzione esporta le metriche e i formati del profilo nella relativa destinazione. Le esportazioni programmate richiedono una prova o un abbonamento attivo, oppure l’accesso a vita."}},
        "ja": {"stringUnit":{"state":"translated","value":"更新時間帯は目安です。iOSによりバックグラウンド実行が遅れることがあります。各実行では、プロファイルの指標と形式で、そのプロファイルの保存先にエクスポートします。定期エクスポートには、有効なトライアルまたはサブスクリプション、もしくは永久アクセスが必要です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"새로 고침 시간은 최대한 준수되지만 iOS에서 백그라운드 실행을 지연시킬 수 있습니다. 각 실행은 프로필의 지표와 형식을 해당 대상으로 내보냅니다. 예약 내보내기에는 활성 체험판이나 구독 또는 평생 이용 권한이 필요합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Verversmomenten zijn niet gegarandeerd; iOS kan uitvoeringen op de achtergrond uitstellen. Elke uitvoering exporteert de meetgegevens en indelingen van het profiel naar de eigen bestemming. Geplande exports vereisen een actieve proefperiode of een actief abonnement, of levenslange toegang."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As janelas de atualização não são garantidas; o iOS pode atrasar execuções em segundo plano. Cada execução exporta as métricas e os formatos do perfil para seu próprio destino. As exportações agendadas exigem um período de teste ou uma assinatura ativa, ou acesso vitalício."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"系统会尽量在刷新时段内执行，但 iOS 可能延迟后台运行。每次运行都会将该配置的指标按所选格式导出到其各自的目标位置。定时导出需要有效的试用或订阅，或终身访问权限。"}}
      }
    },
    "Repeat exports and clearer privacy information" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erneute Exporte und klarere Datenschutzhinweise"}},
        "es": {"stringUnit":{"state":"translated","value":"Exportaciones recurrentes e información de privacidad más clara"}},
        "fr": {"stringUnit":{"state":"translated","value":"Exports répétés et informations de confidentialité plus claires"}},
        "it": {"stringUnit":{"state":"translated","value":"Esportazioni ripetute e informazioni sulla privacy più chiare"}},
        "ja": {"stringUnit":{"state":"translated","value":"再エクスポートと、より明確なプライバシー情報"}},
        "ko": {"stringUnit":{"state":"translated","value":"반복 내보내기와 더 명확한 개인정보 보호 안내"}},
        "nl": {"stringUnit":{"state":"translated","value":"Opnieuw exporteren en duidelijkere privacyinformatie"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Exportações repetidas e informações de privacidade mais claras"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"再次导出与更清晰的隐私信息"}}
      }
    },
    "Request saved; context refresh is pending. Use Get Mac Context Refresh Status with this request." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Anfrage gespeichert; Kontextaktualisierung steht aus. Verwende „Status der Mac-Kontextaktualisierung abrufen“ mit dieser Anfrage."}},
        "es": {"stringUnit":{"state":"translated","value":"Solicitud guardada; la actualización del contexto está pendiente. Usa Obtener el estado de actualización del contexto del Mac con esta solicitud."}},
        "fr": {"stringUnit":{"state":"translated","value":"Demande enregistrée ; l’actualisation du contexte est en attente. Utilisez « Obtenir l’état d’actualisation du contexte du Mac » avec cette demande."}},
        "it": {"stringUnit":{"state":"translated","value":"Richiesta salvata; aggiornamento del contesto in attesa. Usa Ottieni stato aggiornamento contesto Mac con questa richiesta."}},
        "ja": {"stringUnit":{"state":"translated","value":"リクエストを保存しました。コンテキストの更新は保留中です。このリクエストで「Macコンテキスト更新状況を取得」を使用してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"요청이 저장되었으며 컨텍스트 새로고침이 대기 중입니다. 이 요청으로 ‘Mac 컨텍스트 새로고침 상태 가져오기’를 사용하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Verzoek opgeslagen; contextvernieuwing is in afwachting. Gebruik 'Status van Mac-contextvernieuwing ophalen' met dit verzoek."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Solicitação salva; a atualização do contexto está pendente. Use Obter status da atualização do contexto do Mac com esta solicitação."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请求已保存；上下文刷新待处理。请使用此请求执行“获取 Mac 上下文刷新状态”。"}}
      }
    },
    "Requests Apple’s optional rating dialog" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Fordert Apples optionalen Bewertungsdialog an"}},
        "es": {"stringUnit":{"state":"translated","value":"Solicita el diálogo opcional de valoración de Apple"}},
        "fr": {"stringUnit":{"state":"translated","value":"Demande l’affichage de la boîte de dialogue facultative de notation d’Apple"}},
        "it": {"stringUnit":{"state":"translated","value":"Richiede la finestra facoltativa di valutazione di Apple"}},
        "ja": {"stringUnit":{"state":"translated","value":"Appleの任意の評価ダイアログの表示をリクエストします"}},
        "ko": {"stringUnit":{"state":"translated","value":"참여가 선택 사항인 Apple 평가 대화상자를 요청합니다"}},
        "nl": {"stringUnit":{"state":"translated","value":"Vraagt het optionele beoordelingsvenster van Apple aan"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Solicita a caixa de diálogo opcional de avaliação da Apple"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请求显示 Apple 的可选评分对话框"}}
      }
    },
    "Review Health Access" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Gesundheitsdatenzugriff prüfen"}},
        "es": {"stringUnit":{"state":"translated","value":"Revisar el acceso a los datos de salud"}},
        "fr": {"stringUnit":{"state":"translated","value":"Vérifier l’accès aux données de santé"}},
        "it": {"stringUnit":{"state":"translated","value":"Controlla accesso ai dati sanitari"}},
        "ja": {"stringUnit":{"state":"translated","value":"健康データへのアクセスを確認"}},
        "ko": {"stringUnit":{"state":"translated","value":"건강 데이터 접근 권한 검토"}},
        "nl": {"stringUnit":{"state":"translated","value":"Toegang tot gezondheidsgegevens controleren"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Revisar acesso aos dados de saúde"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"检查健康访问权限"}}
      }
    },
    "Safer setup sharing and dependable exports" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Sichereres Teilen von Konfigurationen und zuverlässige Exporte"}},
        "es": {"stringUnit":{"state":"translated","value":"Configuraciones compartidas más seguras y exportaciones fiables"}},
        "fr": {"stringUnit":{"state":"translated","value":"Partage de configuration plus sûr et exports fiables"}},
        "it": {"stringUnit":{"state":"translated","value":"Condivisione delle configurazioni più sicura ed esportazioni affidabili"}},
        "ja": {"stringUnit":{"state":"translated","value":"より安全な設定共有と、信頼できるエクスポート"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 안전한 설정 공유와 안정적인 내보내기"}},
        "nl": {"stringUnit":{"state":"translated","value":"Veiliger configuraties delen en betrouwbare exports"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Compartilhamento de configurações mais seguro e exportações confiáveis"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更安全的设置共享与更可靠的导出"}}
      }
    },
    "Save Reviewed ZIP…" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geprüfte ZIP speichern…"}},
        "es": {"stringUnit":{"state":"translated","value":"Guardar ZIP revisado…"}},
        "fr": {"stringUnit":{"state":"translated","value":"Enregistrer le ZIP vérifié…"}},
        "it": {"stringUnit":{"state":"translated","value":"Salva ZIP revisionato…"}},
        "ja": {"stringUnit":{"state":"translated","value":"確認済みZIPを保存…"}},
        "ko": {"stringUnit":{"state":"translated","value":"검토한 ZIP 저장…"}},
        "nl": {"stringUnit":{"state":"translated","value":"Gecontroleerde ZIP opslaan…"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Salvar ZIP revisado…"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"保存已审核的 ZIP…"}}
      }
    },
    "Saved Connected Mac profile name. Empty selects the active saved profile; no live-settings fallback." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Gespeicherter Profilname des verbundenen Mac. Leer wählt das aktive gespeicherte Profil; kein Rückgriff auf Live-Einstellungen."}},
        "es": {"stringUnit":{"state":"translated","value":"Nombre del perfil guardado del Mac conectado. Si se deja vacío, se selecciona el perfil guardado activo; no se recurre a la configuración en uso."}},
        "fr": {"stringUnit":{"state":"translated","value":"Nom du profil Mac connecté enregistré. Si ce champ est vide, le profil enregistré actif est sélectionné ; aucun recours aux réglages en cours."}},
        "it": {"stringUnit":{"state":"translated","value":"Nome del profilo Mac connesso salvato. Se vuoto, seleziona il profilo salvato attivo; le impostazioni correnti non vengono usate come alternativa."}},
        "ja": {"stringUnit":{"state":"translated","value":"保存済みの接続先Macプロファイル名。空欄の場合はアクティブな保存済みプロファイルを選択します。現在の設定へのフォールバックはありません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"저장된 연결된 Mac 프로필의 이름입니다. 비워 두면 현재 활성화된 저장 프로필이 선택되며, 실시간 설정으로 대체되지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Opgeslagen profielnaam voor de verbonden Mac. Leeg selecteert het actieve opgeslagen profiel; er wordt niet teruggevallen op actuele instellingen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Nome do perfil salvo do Mac conectado. Se vazio, seleciona o perfil salvo ativo; não usa as configurações atuais como alternativa."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已保存的已连接 Mac 配置名称。留空将选择当前启用的已保存配置；不会回退到实时设置。"}}
      }
    },
    "Schedule recovery and clearer reminders" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wiederherstellung von Zeitplänen und klarere Erinnerungen"}},
        "es": {"stringUnit":{"state":"translated","value":"Recuperación de programaciones y recordatorios más claros"}},
        "fr": {"stringUnit":{"state":"translated","value":"Rétablissement des programmations et rappels plus clairs"}},
        "it": {"stringUnit":{"state":"translated","value":"Ripristino delle programmazioni e promemoria più chiari"}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュールの復旧と、より明確なリマインダー"}},
        "ko": {"stringUnit":{"state":"translated","value":"일정 복구와 더 명확한 미리 알림"}},
        "nl": {"stringUnit":{"state":"translated","value":"Schemaherstel en duidelijkere herinneringen"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Recuperação de agendamentos e lembretes mais claros"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划恢复与更清晰的提醒"}}
      }
    },
    "Scheduled profiles now refresh the full lookback you chose on every run. Optional Today Refresh can update today’s in-progress export every 3, 6, or 12 hours." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante Profile aktualisieren jetzt bei jedem Durchlauf den gesamten gewählten Rückblickzeitraum. Die optionale heutige Aktualisierung kann den noch laufenden Export für heute alle 3, 6 oder 12 Stunden aktualisieren."}},
        "es": {"stringUnit":{"state":"translated","value":"Los perfiles programados ahora actualizan todo el periodo retrospectivo elegido en cada ejecución. La actualización opcional de hoy puede actualizar la exportación en curso de hoy cada 3, 6 o 12 horas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les profils programmés actualisent désormais toute la période rétrospective choisie à chaque exécution. L’actualisation facultative du jour peut mettre à jour l’export en cours d’aujourd’hui toutes les 3, 6 ou 12 heures."}},
        "it": {"stringUnit":{"state":"translated","value":"I profili programmati ora aggiornano a ogni esecuzione l’intero periodo retrospettivo scelto. L’aggiornamento facoltativo di oggi può aggiornare l’esportazione in corso di oggi ogni 3, 6 o 12 ore."}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュール済みプロファイルは、毎回、選択した過去の全期間を更新するようになりました。任意の「今日のデータを更新」では、今日の進行中のエクスポートを3、6、12時間ごとに更新できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 예약된 프로필은 실행할 때마다 선택한 전체 조회 기간을 새로 고칩니다. 선택 기능인 오늘 새로 고침을 사용하면 진행 중인 오늘의 내보내기를 3시간, 6시간 또는 12시간마다 업데이트할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande profielen verversen nu bij elke uitvoering de volledige gekozen terugblikperiode. Met de optionele functie Today Refresh kan de lopende export van vandaag elke 3, 6 of 12 uur worden bijgewerkt."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os perfis agendados agora atualizam todo o período retroativo escolhido a cada execução. A opção Atualização de hoje pode atualizar a exportação de hoje em andamento a cada 3, 6 ou 12 horas."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划配置现在每次运行都会刷新您选择的完整回溯范围。可选的“今日刷新”可每隔 3、6 或 12 小时更新今天尚在进行中的导出。"}}
      }
    },
    "Scheduled runs use the same free allowance. You review the settings before turning them on." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante Durchläufe nutzen dasselbe kostenlose Kontingent. Du prüfst die Einstellungen, bevor du sie aktivierst."}},
        "es": {"stringUnit":{"state":"translated","value":"Las ejecuciones programadas usan el mismo cupo gratuito. Puedes revisar los ajustes antes de activarlas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exécutions programmées utilisent le même quota gratuit. Vous vérifiez les réglages avant de les activer."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esecuzioni programmate utilizzano la stessa quota gratuita. Puoi controllare le impostazioni prima di attivarle."}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュール実行も同じ無料枠を使用します。有効にする前に設定を確認できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 실행도 동일한 무료 제공 횟수를 사용합니다. 활성화하기 전에 설정을 검토할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande uitvoeringen gebruiken hetzelfde gratis tegoed. Je bekijkt de instellingen voordat je ze inschakelt."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As execuções agendadas usam a mesma cota gratuita. Você revisa as configurações antes de ativá-las."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划运行使用同一免费额度。启用前，您可以查看设置。"}}
      }
    },
    "Schedules keep your full lookback" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Zeitpläne behalten deinen gesamten Rückblickzeitraum bei"}},
        "es": {"stringUnit":{"state":"translated","value":"Las programaciones conservan todo tu periodo retrospectivo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Les programmations conservent toute la période rétrospective"}},
        "it": {"stringUnit":{"state":"translated","value":"Le programmazioni mantengono l’intero periodo retrospettivo"}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュールで指定した過去の全期間を維持"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 실행에서도 전체 조회 기간 유지"}},
        "nl": {"stringUnit":{"state":"translated","value":"Schema’s behouden je volledige terugblikperiode"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os agendamentos mantêm todo o período retroativo"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划保留完整回溯范围"}}
      }
    },
    "Schedules restored" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Zeitpläne wiederhergestellt"}},
        "es": {"stringUnit":{"state":"translated","value":"Programaciones restauradas"}},
        "fr": {"stringUnit":{"state":"translated","value":"Programmations rétablies"}},
        "it": {"stringUnit":{"state":"translated","value":"Programmazioni ripristinate"}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュールの復元"}},
        "ko": {"stringUnit":{"state":"translated","value":"일정 복원"}},
        "nl": {"stringUnit":{"state":"translated","value":"Schema’s hersteld"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Agendamentos restaurados"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划已恢复"}}
      }
    },
    "Search Event IDs or Fields" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ereignis-IDs oder Felder suchen"}},
        "es": {"stringUnit":{"state":"translated","value":"Buscar identificadores de eventos o campos"}},
        "fr": {"stringUnit":{"state":"translated","value":"Rechercher des identifiants d’événement ou des champs"}},
        "it": {"stringUnit":{"state":"translated","value":"Cerca ID evento o campi"}},
        "ja": {"stringUnit":{"state":"translated","value":"イベントIDまたはフィールドを検索"}},
        "ko": {"stringUnit":{"state":"translated","value":"이벤트 ID 또는 필드 검색"}},
        "nl": {"stringUnit":{"state":"translated","value":"Zoeken in gebeurtenis-ID's of velden"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Buscar IDs de eventos ou campos"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"搜索事件 ID 或字段"}}
      }
    },
    "See Lifetime Access" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lebenslangen Zugriff ansehen"}},
        "es": {"stringUnit":{"state":"translated","value":"Ver acceso de por vida"}},
        "fr": {"stringUnit":{"state":"translated","value":"Voir l’accès à vie"}},
