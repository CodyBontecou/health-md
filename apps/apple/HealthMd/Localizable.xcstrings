        "zh-Hans": {"stringUnit":{"state":"translated","value":"条款"}},
        "en": {"stringUnit":{"state":"translated","value":"Terms"}}
      }
    },
    "That QR is not a valid Direct CLI pairing code. Scan the fresh QR shown by healthmd." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dieser QR-Code ist kein gültiger Kopplungscode für den direkten CLI-Zugriff. Scanne den neuen QR-Code, den healthmd anzeigt."}},
        "es": {"stringUnit":{"state":"translated","value":"Ese QR no es un código de enlace válido de Direct CLI. Escanea el nuevo QR que muestra healthmd."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ce QR code n’est pas un code de jumelage valide pour l’accès CLI direct. Scannez le nouveau QR code affiché par healthmd."}},
        "it": {"stringUnit":{"state":"translated","value":"Questo QR non è un codice di abbinamento Direct CLI valido. Scansiona il nuovo QR mostrato da healthmd."}},
        "ja": {"stringUnit":{"state":"translated","value":"このQRコードは有効なDirect CLIのペアリングコードではありません。healthmdに表示された新しいQRコードをスキャンしてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"유효한 Direct CLI 페어링 QR 코드가 아닙니다. healthmd에 표시된 새 QR 코드를 스캔하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Die QR-code is geen geldige Direct CLI-koppelcode. Scan de nieuwe QR-code die healthmd toont."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Esse QR não é um código de emparelhamento válido para o acesso direto via CLI. Escaneie o novo QR exibido pelo healthmd."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"此二维码不是有效的 Direct CLI 配对码。请扫描 healthmd 显示的新二维码。"}}
      }
    },
    "The app never mutates `/usr/local/bin` or shell files without your action." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App verändert niemals `/usr/local/bin` oder Shell-Dateien ohne Ihr Zutun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app never mutates `/usr/local/bin` or shell files without your action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación nunca muta `/usr/local/bin` o archivos de shell sin su acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application ne mute jamais `/usr/local/bin` ou les fichiers shell sans votre action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app non modifica mai `/usr/local/bin` o i file della shell senza la tua azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーのアクションがなければ、アプリが `/usr/local/bin` やシェル ファイルを変更することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 사용자의 조치 없이 `/usr/local/bin` 또는 셸 파일을 변경하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app muteert nooit `/usr/local/bin`- of shell-bestanden zonder uw actie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo nunca altera `/usr/local/bin` ou arquivos shell sem sua ação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有您的操作，该应用程序永远不会改变 `/usr/local/bin` 或 shell 文件。"
          }
        }
      }
    },
    "The background export task was terminated by iOS before completing." : {
      "comment" : "Detailed error: task expired",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrund-Exportaufgabe wurde von iOS vor dem Abschluss beendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarea de exportación en segundo plano fue terminada por iOS antes de completarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tâche d'exportation en arrière-plan a été interrompue par iOS avant d'être terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
