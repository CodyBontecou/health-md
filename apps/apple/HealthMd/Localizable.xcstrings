    "Double tap to stop tracking individual entry files for %@" : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Doppeltippen, um die Verfolgung von Einzeleintragsdateien für %@ zu beenden"}},
      "es":{"stringUnit":{"state":"translated","value":"Toca dos veces para dejar de registrar archivos de entradas individuales de %@"}},
      "fr":{"stringUnit":{"state":"translated","value":"Touchez deux fois pour arrêter le suivi des fichiers d’entrées individuelles pour %@"}},
      "it":{"stringUnit":{"state":"translated","value":"Tocca due volte per interrompere il monitoraggio dei file delle voci individuali per %@"}},
      "ja":{"stringUnit":{"state":"translated","value":"ダブルタップして%@の個別エントリファイルの追跡を停止します"}},
      "ko":{"stringUnit":{"state":"translated","value":"이중 탭하여 %@의 개별 항목 파일 추적을 중지합니다"}},
      "nl":{"stringUnit":{"state":"translated","value":"Tik dubbel om het bijhouden van afzonderlijke itembestanden voor %@ te stoppen"}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Toque duas vezes para parar de monitorar os arquivos de entradas individuais de %@"}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"轻点两下以停止跟踪%@的单条记录文件"}}
    }},
    "Double tap to track individual entry files for %@" : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Doppeltippen, um Einzeleintragsdateien für %@ zu verfolgen"}},
      "es":{"stringUnit":{"state":"translated","value":"Toca dos veces para registrar archivos de entradas individuales de %@"}},
      "fr":{"stringUnit":{"state":"translated","value":"Touchez deux fois pour suivre les fichiers d’entrées individuelles pour %@"}},
      "it":{"stringUnit":{"state":"translated","value":"Tocca due volte per monitorare i file delle voci individuali per %@"}},
      "ja":{"stringUnit":{"state":"translated","value":"ダブルタップして%@の個別エントリファイルを追跡します"}},
      "ko":{"stringUnit":{"state":"translated","value":"이중 탭하여 %@의 개별 항목 파일을 추적합니다"}},
      "nl":{"stringUnit":{"state":"translated","value":"Tik dubbel om afzonderlijke itembestanden voor %@ bij te houden"}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Toque duas vezes para monitorar os arquivos de entradas individuais de %@"}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"轻点两下以跟踪%@的单条记录文件"}}
    }},
    "Disables individual tracking for every metric." : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Deaktiviert die Einzelverfolgung für jede Metrik."}},
      "es":{"stringUnit":{"state":"translated","value":"Desactiva el registro individual de todas las métricas."}},
      "fr":{"stringUnit":{"state":"translated","value":"Désactive le suivi individuel pour chaque indicateur."}},
      "it":{"stringUnit":{"state":"translated","value":"Disattiva il monitoraggio individuale per ogni metrica."}},
      "ja":{"stringUnit":{"state":"translated","value":"すべての指標の個別追跡を無効にします。"}},
      "ko":{"stringUnit":{"state":"translated","value":"모든 항목의 개별 추적을 비활성화합니다."}},
      "nl":{"stringUnit":{"state":"translated","value":"Schakelt het afzonderlijk bijhouden van elke meetwaarde uit."}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Desativa o monitoramento individual de todas as métricas."}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"停用每个指标的单独跟踪。"}}
    }},
    "Enter the folder path for individual entry files." : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Geben Sie den Ordnerpfad für Einzeleintragsdateien ein."}},
      "es":{"stringUnit":{"state":"translated","value":"Introduce la ruta de la carpeta de los archivos de entradas individuales."}},
      "fr":{"stringUnit":{"state":"translated","value":"Saisissez le chemin du dossier des fichiers d’entrées individuelles."}},
      "it":{"stringUnit":{"state":"translated","value":"Inserisci il percorso della cartella per i file delle voci individuali."}},
      "ja":{"stringUnit":{"state":"translated","value":"個別エントリファイルのフォルダパスを入力してください。"}},
      "ko":{"stringUnit":{"state":"translated","value":"개별 항목 파일의 폴더 경로를 입력하세요."}},
      "nl":{"stringUnit":{"state":"translated","value":"Voer het mappad voor afzonderlijke itembestanden in."}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Insira o caminho da pasta para os arquivos de entradas individuais."}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"输入单条记录文件的文件夹路径。"}}
    }},
    "Enter the filename template for individual entry files." : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Geben Sie die Dateinamenvorlage für Einzeleintragsdateien ein."}},
      "es":{"stringUnit":{"state":"translated","value":"Introduce la plantilla de nombre de archivo para las entradas individuales."}},
      "fr":{"stringUnit":{"state":"translated","value":"Saisissez le modèle de nom de fichier des entrées individuelles."}},
      "it":{"stringUnit":{"state":"translated","value":"Inserisci il modello di nome file per le voci individuali."}},
      "ja":{"stringUnit":{"state":"translated","value":"個別エントリファイルのファイル名テンプレートを入力してください。"}},
      "ko":{"stringUnit":{"state":"translated","value":"개별 항목 파일의 파일명 템플릿을 입력하세요."}},
      "nl":{"stringUnit":{"state":"translated","value":"Voer de bestandsnaamsjabloon voor afzonderlijke items in."}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Insira o modelo de nome de arquivo para as entradas individuais."}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"输入单条记录文件的文件名模板。"}}
    }},
