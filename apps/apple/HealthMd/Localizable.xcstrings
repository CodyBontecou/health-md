    "Schedule paused. Its cadence is remembered and resumes when enabled." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Zeitplan pausiert. Der Rhythmus bleibt gespeichert und wird bei Aktivierung fortgesetzt."}},
        "es": {"stringUnit":{"state":"translated","value":"Programación en pausa. Se conserva su frecuencia y se reanuda al activarla."}},
        "fr": {"stringUnit":{"state":"translated","value":"Planification en pause. Sa fréquence est conservée et sera rétablie à la réactivation."}},
        "it": {"stringUnit":{"state":"translated","value":"Pianificazione in pausa. La frequenza viene conservata e riprende all’attivazione."}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュールは一時停止中です。実行間隔は保持され、有効にすると再開します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약이 일시 정지되었습니다. 실행 주기는 유지되며 활성화하면 다시 시작됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Planning gepauzeerd. Het interval blijft bewaard en de planning wordt hervat zodra deze wordt ingeschakeld."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Agendamento pausado. Sua frequência é mantida e será retomada quando ativado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划已暂停。执行频率已保留，启用后将恢复。"}}
      }
    },
