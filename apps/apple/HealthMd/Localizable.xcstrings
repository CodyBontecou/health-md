            "value": "Désactivé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit"
          }
        },
