        "pt-BR": {"stringUnit":{"state":"translated","value":"Iniciar configuração"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"开始设置"}}
      }
    },
    "Start with a flat layout or date-based folders." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Beginne mit einer flachen Struktur oder datumsbasierten Ordnern."}},
        "es": {"stringUnit":{"state":"translated","value":"Empieza con una estructura sin subcarpetas o con carpetas por fecha."}},
        "fr": {"stringUnit":{"state":"translated","value":"Commencez par une structure sans sous-dossiers ou des dossiers par date."}},
        "it": {"stringUnit":{"state":"translated","value":"Inizia con una struttura senza sottocartelle o con cartelle per data."}},
        "ja": {"stringUnit":{"state":"translated","value":"階層なしの構成、または日付別フォルダで始めましょう。"}},
        "ko": {"stringUnit":{"state":"translated","value":"하위 폴더 없는 구조 또는 날짜별 폴더로 시작하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Begin met een platte structuur of mappen op basis van datums."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Comece com uma estrutura sem subpastas ou com pastas por data."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"从平铺布局或按日期组织的文件夹开始。"}}
      }
    },
    "Stay Local" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lokal bleiben"}},
        "es": {"stringUnit":{"state":"translated","value":"Mantén los datos en local"}},
        "fr": {"stringUnit":{"state":"translated","value":"Restez en local"}},
        "it": {"stringUnit":{"state":"translated","value":"Mantieni tutto in locale"}},
        "ja": {"stringUnit":{"state":"translated","value":"ローカルで完結"}},
        "ko": {"stringUnit":{"state":"translated","value":"로컬로만 보관"}},
        "nl": {"stringUnit":{"state":"translated","value":"Houd alles lokaal"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Mantenha tudo local"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"保持本地存储"}}
      }
    },
    "Tap a token to append it as the next folder segment." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Tippe auf einen Platzhalter, um ihn als nächsten Ordnerabschnitt anzuhängen."}},
        "es": {"stringUnit":{"state":"translated","value":"Toca un marcador para añadirlo como el siguiente segmento de la ruta de carpetas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Touchez un jeton pour l’ajouter comme prochain segment de dossier."}},
        "it": {"stringUnit":{"state":"translated","value":"Tocca un token per aggiungerlo come segmento successivo del percorso della cartella."}},
        "ja": {"stringUnit":{"state":"translated","value":"トークンをタップすると、次のフォルダ階層として追加されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"토큰을 탭하면 다음 폴더 경로 요소로 추가됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Tik op een token om het als volgend mapsegment toe te voegen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Toque em um marcador para adicioná-lo como o próximo segmento de pasta."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"轻点一个标记，将其追加为下一级文件夹。"}}
      }
    },
    "Tap a token to append it to the format." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Tippe auf einen Platzhalter, um ihn an das Format anzuhängen."}},
        "es": {"stringUnit":{"state":"translated","value":"Toca un marcador para añadirlo al formato."}},
        "fr": {"stringUnit":{"state":"translated","value":"Touchez un jeton pour l’ajouter au format."}},
        "it": {"stringUnit":{"state":"translated","value":"Tocca un token per aggiungerlo al formato."}},
        "ja": {"stringUnit":{"state":"translated","value":"トークンをタップすると、書式の末尾に追加されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"토큰을 탭하면 형식 끝에 추가됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Tik op een token om het aan de indeling toe te voegen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Toque em um marcador para adicioná-lo ao final do formato."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"轻点一个标记，将其追加到格式中。"}}
      }
    },
    "The Mac writes files using the setup you choose on iPhone." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der Mac schreibt Dateien mit den Einstellungen, die du auf dem iPhone auswählst."}},
        "es": {"stringUnit":{"state":"translated","value":"El Mac escribe los archivos con la configuración que elijas en el iPhone."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le Mac écrit les fichiers selon la configuration choisie sur l’iPhone."}},
        "it": {"stringUnit":{"state":"translated","value":"Il Mac scrive i file usando la configurazione che scegli su iPhone."}},
        "ja": {"stringUnit":{"state":"translated","value":"MacはiPhoneで選択した設定に従ってファイルを書き込みます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac은 iPhone에서 선택한 설정에 따라 파일을 저장합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De Mac schrijft bestanden met de instellingen die je op je iPhone kiest."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O Mac grava os arquivos usando a configuração que você escolhe no iPhone."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Mac 会按照你在 iPhone 上选择的设置写入文件。"}}
      }
    },
    "This is where today’s Markdown export would be written." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Hier würde der heutige Markdown-Export gespeichert."}},
        "es": {"stringUnit":{"state":"translated","value":"Aquí se escribiría la exportación Markdown de hoy."}},
        "fr": {"stringUnit":{"state":"translated","value":"Voici où l’export Markdown du jour serait écrit."}},
        "it": {"stringUnit":{"state":"translated","value":"Qui verrebbe scritta l’esportazione Markdown di oggi."}},
        "ja": {"stringUnit":{"state":"translated","value":"今日のMarkdownエクスポートはここに書き込まれます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"오늘의 Markdown 내보내기는 이 위치에 저장됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Hier zou de Markdown-export van vandaag worden opgeslagen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"É aqui que a exportação Markdown de hoje seria gravada."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"今天的 Markdown 导出文件将写入此位置。"}}
      }
    },
    "This preview uses today’s date and the primary Markdown format." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Diese Vorschau verwendet das heutige Datum und das primäre Markdown-Format."}},
        "es": {"stringUnit":{"state":"translated","value":"Esta vista previa usa la fecha de hoy y el formato Markdown principal."}},
        "fr": {"stringUnit":{"state":"translated","value":"Cet aperçu utilise la date du jour et le format Markdown principal."}},
        "it": {"stringUnit":{"state":"translated","value":"Questa anteprima usa la data di oggi e il formato Markdown principale."}},
        "ja": {"stringUnit":{"state":"translated","value":"このプレビューには今日の日付とメインのMarkdown形式を使用しています。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 미리보기는 오늘 날짜와 기본 Markdown 형식을 사용합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Dit voorbeeld gebruikt de datum van vandaag en de primaire Markdown-indeling."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Esta prévia usa a data de hoje e o formato Markdown principal."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"此预览使用今天的日期和主要 Markdown 格式。"}}
      }
    },
    "To preview your export, connect Apple Health so Health.md can read your data." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Verbinde Apple Health, damit Health.md deine Daten lesen und eine Exportvorschau anzeigen kann."}},
        "es": {"stringUnit":{"state":"translated","value":"Para ver una vista previa de tu exportación, conecta Apple Health para que Health.md pueda leer tus datos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Pour prévisualiser votre export, connectez Apple Health afin que Health.md puisse lire vos données."}},
        "it": {"stringUnit":{"state":"translated","value":"Per visualizzare l’anteprima dell’esportazione, connetti Apple Health per consentire a Health.md di leggere i tuoi dati."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートをプレビューするには、Apple Healthを接続してHealth.mdがデータを読み取れるようにしてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기를 미리 보려면 Apple Health를 연결하여 Health.md가 데이터를 읽을 수 있게 하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Verbind Apple Health zodat Health.md je gegevens kan lezen en je een voorbeeld van je export kunt bekijken."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Para ver uma prévia da exportação, conecte o Apple Health para que o Health.md possa ler seus dados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"要预览导出内容，请连接 Apple Health，以便 Health.md 读取你的数据。"}}
      }
    },
    "Use placeholders to build a readable, predictable file name." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Verwende Platzhalter für einen lesbaren, vorhersehbaren Dateinamen."}},
        "es": {"stringUnit":{"state":"translated","value":"Usa marcadores de posición para crear un nombre de archivo legible y predecible."}},
        "fr": {"stringUnit":{"state":"translated","value":"Utilisez des espaces réservés pour créer un nom de fichier lisible et prévisible."}},
        "it": {"stringUnit":{"state":"translated","value":"Usa i segnaposto per creare un nome file leggibile e prevedibile."}},
        "ja": {"stringUnit":{"state":"translated","value":"プレースホルダーを使って、読みやすく予測しやすいファイル名を作成します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"자리표시자를 사용하여 읽기 쉽고 예측 가능한 파일 이름을 만드세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Gebruik tijdelijke aanduidingen om een leesbare, voorspelbare bestandsnaam samen te stellen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Use marcadores para criar um nome de arquivo legível e previsível."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"使用占位符构建易读且有规律的文件名。"}}
      }
    },
    "Use placeholders to control the Markdown body." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Verwende Platzhalter, um den Markdown-Inhalt zu gestalten."}},
        "es": {"stringUnit":{"state":"translated","value":"Usa marcadores de posición para controlar el cuerpo del Markdown."}},
        "fr": {"stringUnit":{"state":"translated","value":"Utilisez des espaces réservés pour définir le corps du document Markdown."}},
        "it": {"stringUnit":{"state":"translated","value":"Usa i segnaposto per definire il corpo del documento Markdown."}},
        "ja": {"stringUnit":{"state":"translated","value":"プレースホルダーを使ってMarkdown本文を設定します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"자리표시자를 사용하여 Markdown 본문을 구성하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Gebruik tijdelijke aanduidingen om de inhoud van de Markdown-tekst te bepalen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Use marcadores para controlar o corpo do Markdown."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"使用占位符控制 Markdown 正文。"}}
      }
    },
    "Wake Up to a Daily Note" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wache mit einer täglichen Notiz auf"}},
        "es": {"stringUnit":{"state":"translated","value":"Despierta con una nota diaria"}},
        "fr": {"stringUnit":{"state":"translated","value":"Retrouvez votre note quotidienne au réveil"}},
        "it": {"stringUnit":{"state":"translated","value":"Svegliati con una nota giornaliera"}},
        "ja": {"stringUnit":{"state":"translated","value":"目覚めたら、その日のノートを"}},
        "ko": {"stringUnit":{"state":"translated","value":"매일 아침 준비된 일일 노트"}},
        "nl": {"stringUnit":{"state":"translated","value":"Word wakker met een dagelijkse notitie"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Acorde com uma nota diária"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"醒来即有每日笔记"}}
      }
    },
    "Watch Apple Health readings become a readable Markdown, CSV, JSON, or Obsidian file." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Sieh, wie aus Apple Health-Messwerten eine lesbare Markdown-, CSV-, JSON- oder Obsidian-Datei wird."}},
        "es": {"stringUnit":{"state":"translated","value":"Mira cómo las mediciones de Apple Health se convierten en un archivo legible de Markdown, CSV, JSON u Obsidian."}},
        "fr": {"stringUnit":{"state":"translated","value":"Voyez les mesures Apple Health se transformer en fichier lisible au format Markdown, CSV, JSON ou Obsidian."}},
        "it": {"stringUnit":{"state":"translated","value":"Guarda le rilevazioni di Apple Health trasformarsi in un file leggibile in formato Markdown, CSV, JSON o Obsidian."}},
        "ja": {"stringUnit":{"state":"translated","value":"Apple Healthの測定値が、読みやすいMarkdown、CSV、JSON、またはObsidianのファイルに変わる様子をご覧ください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Apple Health 측정값이 읽기 쉬운 Markdown, CSV, JSON 또는 Obsidian 파일로 바뀌는 모습을 확인하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Zie hoe Apple Health-metingen een leesbaar Markdown-, CSV-, JSON- of Obsidian-bestand worden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Veja os registros do Apple Health se transformarem em um arquivo legível de Markdown, CSV, JSON ou Obsidian."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"看看 Apple Health 数据如何变成易读的 Markdown、CSV、JSON 或 Obsidian 文件。"}}
      }
    },
    "You Stay in Control" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Du behältst die Kontrolle"}},
        "es": {"stringUnit":{"state":"translated","value":"Tú mantienes el control"}},
        "fr": {"stringUnit":{"state":"translated","value":"Vous gardez le contrôle"}},
        "it": {"stringUnit":{"state":"translated","value":"Il controllo resta a te"}},
        "ja": {"stringUnit":{"state":"translated","value":"管理するのはあなた自身"}},
        "ko": {"stringUnit":{"state":"translated","value":"제어 권한은 언제나 나에게"}},
        "nl": {"stringUnit":{"state":"translated","value":"Jij houdt de controle"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Você mantém o controle"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"始终由你掌控"}}
      }
    },
    "You can continue now and connect before your first export." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Du kannst jetzt fortfahren und die Verbindung vor deinem ersten Export herstellen."}},
        "es": {"stringUnit":{"state":"translated","value":"Puedes continuar ahora y conectar antes de tu primera exportación."}},
        "fr": {"stringUnit":{"state":"translated","value":"Vous pouvez continuer maintenant et vous connecter avant votre premier export."}},
        "it": {"stringUnit":{"state":"translated","value":"Puoi continuare ora ed effettuare la connessione prima della tua prima esportazione."}},
        "ja": {"stringUnit":{"state":"translated","value":"今はこのまま進み、初回エクスポートの前に接続できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"지금 계속 진행하고 첫 내보내기 전에 연결할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Je kunt nu doorgaan en verbinding maken vóór je eerste export."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Você pode continuar agora e conectar antes da sua primeira exportação."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"你可以现在继续，在首次导出前再连接。"}}
      }
    },
    "Your Health Archive Is Ready" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dein Gesundheitsarchiv ist bereit"}},
        "es": {"stringUnit":{"state":"translated","value":"Tu archivo de salud está listo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Vos archives de santé sont prêtes"}},
        "it": {"stringUnit":{"state":"translated","value":"Il tuo archivio della salute è pronto"}},
        "ja": {"stringUnit":{"state":"translated","value":"健康アーカイブの準備ができました"}},
        "ko": {"stringUnit":{"state":"translated","value":"건강 아카이브가 준비되었습니다"}},
        "nl": {"stringUnit":{"state":"translated","value":"Je gezondheidsarchief is klaar"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Seu arquivo de saúde está pronto"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"你的健康档案已就绪"}}
      }
    },
    "Your iPhone must be unlocked when Health.md reads Health data. If data is locked, tap the notification to run the export." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dein iPhone muss entsperrt sein, wenn Health.md Gesundheitsdaten liest. Wenn die Daten gesperrt sind, tippe auf die Mitteilung, um den Export auszuführen."}},
        "es": {"stringUnit":{"state":"translated","value":"Tu iPhone debe estar desbloqueado cuando Health.md lea los datos de Salud. Si los datos están bloqueados, toca la notificación para ejecutar la exportación."}},
        "fr": {"stringUnit":{"state":"translated","value":"Votre iPhone doit être déverrouillé lorsque Health.md lit les données de Santé. Si les données sont verrouillées, touchez la notification pour lancer l’export."}},
        "it": {"stringUnit":{"state":"translated","value":"Il tuo iPhone deve essere sbloccato quando Health.md legge i dati di Salute. Se i dati sono bloccati, tocca la notifica per eseguire l’esportazione."}},
        "ja": {"stringUnit":{"state":"translated","value":"Health.mdがヘルスケアデータを読み取る際は、iPhoneのロックを解除する必要があります。データがロックされている場合は、通知をタップしてエクスポートを実行してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Health.md가 건강 데이터를 읽을 때는 iPhone이 잠금 해제되어 있어야 합니다. 데이터가 잠겨 있으면 알림을 탭하여 내보내기를 실행하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Je iPhone moet ontgrendeld zijn wanneer Health.md gezondheidsgegevens leest. Als de gegevens vergrendeld zijn, tik je op de melding om de export uit te voeren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Seu iPhone deve estar desbloqueado quando o Health.md ler os dados do app Saúde. Se os dados estiverem bloqueados, toque na notificação para executar a exportação."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Health.md 读取健康数据时，iPhone 必须处于解锁状态。如果数据已锁定，请轻点通知以运行导出。"}}
      }
    },
    "You’re ready to generate real previews and exports." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Du kannst jetzt Vorschauen und Exporte mit echten Daten erstellen."}},
        "es": {"stringUnit":{"state":"translated","value":"Ya puedes generar vistas previas y exportaciones reales."}},
        "fr": {"stringUnit":{"state":"translated","value":"Vous pouvez maintenant générer des aperçus et des exports de vos données réelles."}},
        "it": {"stringUnit":{"state":"translated","value":"Tutto pronto per generare anteprime ed esportazioni con dati reali."}},
        "ja": {"stringUnit":{"state":"translated","value":"実際のデータでプレビューとエクスポートを生成する準備ができました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"실제 데이터로 미리보기와 내보내기를 생성할 준비가 되었습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Je kunt nu voorbeelden en exports met echte gegevens maken."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Tudo pronto para gerar prévias e exportações reais."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"现在可以生成实际数据的预览和导出文件了。"}}
      }
    },
    "iOS Managed" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Von iOS verwaltet"}},
        "es": {"stringUnit":{"state":"translated","value":"Gestionado por iOS"}},
        "fr": {"stringUnit":{"state":"translated","value":"Géré par iOS"}},
        "it": {"stringUnit":{"state":"translated","value":"Gestito da iOS"}},
        "ja": {"stringUnit":{"state":"translated","value":"iOSが管理"}},
        "ko": {"stringUnit":{"state":"translated","value":"iOS에서 관리"}},
        "nl": {"stringUnit":{"state":"translated","value":"Beheerd door iOS"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Gerenciado pelo iOS"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"由 iOS 管理"}}
      }
    },
    "iOS lets you approve or deny each health category." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"In iOS kannst du den Zugriff für jede Gesundheitskategorie erlauben oder verweigern."}},
        "es": {"stringUnit":{"state":"translated","value":"iOS te permite autorizar o denegar el acceso a cada categoría de salud."}},
        "fr": {"stringUnit":{"state":"translated","value":"iOS vous permet d’autoriser ou de refuser l’accès à chaque catégorie de santé."}},
        "it": {"stringUnit":{"state":"translated","value":"iOS ti consente di autorizzare o negare l’accesso a ogni categoria di dati sanitari."}},
        "ja": {"stringUnit":{"state":"translated","value":"iOSでは、健康データのカテゴリごとにアクセスを許可または拒否できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"iOS에서 각 건강 카테고리에 대한 접근을 허용하거나 거부할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"In iOS kun je toegang tot elke gezondheidscategorie toestaan of weigeren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O iOS permite que você autorize ou negue o acesso a cada categoria de saúde."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"iOS 允许你逐项批准或拒绝对健康数据类别的访问。"}}
      }
    },
    "iOS uses this as the target time for notifications and background scheduling." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"iOS verwendet dies als Zielzeit für Mitteilungen und geplante Hintergrundaktivitäten."}},
        "es": {"stringUnit":{"state":"translated","value":"iOS usa esta hora como referencia para las notificaciones y la programación en segundo plano."}},
        "fr": {"stringUnit":{"state":"translated","value":"iOS utilise cette heure comme horaire cible pour les notifications et la planification en arrière-plan."}},
        "it": {"stringUnit":{"state":"translated","value":"iOS usa questo orario come riferimento per le notifiche e le attività programmate in background."}},
        "ja": {"stringUnit":{"state":"translated","value":"iOSはこの時刻を、通知とバックグラウンド実行の目標時刻として使用します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"iOS는 이 시간을 알림 및 백그라운드 실행 예약의 목표 시간으로 사용합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"iOS gebruikt dit als beoogd tijdstip voor meldingen en achtergrondplanning."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O iOS usa esse horário como referência para notificações e agendamentos em segundo plano."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"iOS 将此时间用作通知和后台调度的目标时间。"}}
      }
    },
