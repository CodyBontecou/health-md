    "Leave a review to help more people make their health data their own." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Hilf mit einer Rezension mehr Menschen, ihre Gesundheitsdaten selbst in die Hand zu nehmen."}},
        "es": {"stringUnit":{"state":"translated","value":"Deja una reseña para ayudar a más personas a tomar el control de sus datos de salud."}},
        "fr": {"stringUnit":{"state":"translated","value":"Laissez un avis pour aider davantage de personnes à s’approprier leurs données de santé."}},
        "it": {"stringUnit":{"state":"translated","value":"Lascia una recensione per aiutare più persone a prendere il controllo dei propri dati sanitari."}},
        "ja": {"stringUnit":{"state":"translated","value":"より多くの人が自分の健康データを活用できるよう、レビューでご協力ください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 많은 사람이 자신의 건강 데이터를 직접 활용할 수 있도록 리뷰를 남겨 주세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Schrijf een recensie en help meer mensen hun gezondheidsgegevens in eigen hand te nemen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Deixe uma avaliação para ajudar mais pessoas a assumir o controle dos próprios dados de saúde."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"留下评价，帮助更多人掌握自己的健康数据。"}}
      }
    },
