    "Full Access offers Individual Lifetime, Family Lifetime, and Family Upgrade purchases for this release." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Für den Vollzugriff bietet diese Version eine dauerhafte Einzelfreischaltung, eine dauerhafte Familienfreischaltung und ein Familienupgrade als Kaufoptionen."}},
        "es": {"stringUnit":{"state":"translated","value":"El acceso completo ofrece compras de los planes individual de por vida, familiar de por vida y ampliación familiar en esta versión."}},
        "fr": {"stringUnit":{"state":"translated","value":"Pour cette version, l’accès complet propose les achats Individuel à vie, Famille à vie et Mise à niveau familiale."}},
        "it": {"stringUnit":{"state":"translated","value":"Per questa versione, l'accesso completo offre acquisti a vita individuali, a vita per la famiglia e upgrade famiglia."}},
        "ja": {"stringUnit":{"state":"translated","value":"このリリースのフルアクセスでは、個人買い切り、ファミリー買い切り、ファミリーアップグレードを購入できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이번 릴리스에서는 전체 이용 권한을 위한 개인 평생 이용권, 가족 평생 이용권, 가족 업그레이드를 구매할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Volledige toegang biedt in deze versie aankopen voor levenslange individuele toegang, levenslange gezinstoegang en een gezinsupgrade."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O Acesso Completo oferece as compras Vitalício Individual, Vitalício Familiar e Atualização Familiar nesta versão."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"本版本的完整访问权限提供个人终身、家庭终身和家庭升级购买选项。"}}
      }
    },
    "Full Access uses Individual Lifetime, Family Lifetime, and Family Upgrade purchases." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der Vollzugriff erfolgt über den Kauf einer dauerhaften Einzelfreischaltung, einer dauerhaften Familienfreischaltung oder eines Familienupgrades."}},
        "es": {"stringUnit":{"state":"translated","value":"El acceso completo utiliza compras de los planes individual de por vida, familiar de por vida y ampliación familiar."}},
        "fr": {"stringUnit":{"state":"translated","value":"L’accès complet repose sur les achats Individuel à vie, Famille à vie et Mise à niveau familiale."}},
        "it": {"stringUnit":{"state":"translated","value":"L'accesso completo prevede acquisti a vita individuali, a vita per la famiglia e upgrade famiglia."}},
        "ja": {"stringUnit":{"state":"translated","value":"フルアクセスは、個人買い切り、ファミリー買い切り、ファミリーアップグレードの購入で利用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"전체 이용 권한은 개인 평생 이용권, 가족 평생 이용권, 가족 업그레이드 구매를 통해 제공됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Volledige toegang maakt gebruik van aankopen voor levenslange individuele toegang, levenslange gezinstoegang en een gezinsupgrade."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O Acesso Completo usa as compras Vitalício Individual, Vitalício Familiar e Atualização Familiar."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"完整访问权限采用个人终身、家庭终身和家庭升级购买方式。"}}
      }
    },
