    "Unlock Health.md for automated scheduled exports.": {
      "comment": "Notification body prompting upgrade",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md für automatische geplante Exporte freischalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea Health.md para exportaciones programadas automáticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez Health.md pour les exportations planifiées automatiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca Health.md per le esportazioni pianificate automatiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdのロックを解除して自動スケジュールエクスポートを利用しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 예약 내보내기를 위해 Health.md를 잠금 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel Health.md voor automatische geplande exports."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o Health.md para exportações agendadas automáticas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 Health.md 以使用自动计划导出。"
          }
        }
      }
    },
    "Unlock iPhone, open Health.md, and wait for the Mac Destination connection.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock iPhone, open Health.md, and wait for the Mac Destination connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie iPhone, öffnen Sie Health.md und warten Sie auf die Zielverbindung Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquee iPhone, abra Health.md y espere la conexión de destino Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez iPhone, ouvrez Health.md et attendez la connexion de destination Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca iPhone, apri Health.md e attendi la connessione di destinazione Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone のロックを解除し、Health.md を開き、Mac 宛先接続を待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone를 잠금 해제하고, Health.md를 열고, Mac 대상 연결을 기다립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel iPhone, open Health.md en wacht op de Mac-bestemmingsverbinding."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie iPhone, abra Health.md e aguarde a conexão de destino Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁iPhone，打开Health.md，并等待Mac 目标位置连接。"
          }
        }
      }
