    "%lld cached days from the old sync flow. New exports are received directly.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld cached days from the old sync flow. New exports are received directly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld zwischengespeicherte Tage aus dem alten Synchronisierungsfluss. Neue Exporte werden direkt entgegengenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld días almacenados en caché del flujo de sincronización anterior. Las nuevas exportaciones se reciben directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld a mis en cache les jours de l'ancien flux de synchronisation. Les nouvelles exportations sont reçues directement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld giorni memorizzati nella cache dal vecchio flusso di sincronizzazione. Le nuove esportazioni vengono ricevute direttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld は古い同期フローからキャッシュされた日数です。新しいエクスポートは直接受信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 동기화 흐름에서 캐시된 날짜 %1$lld일. 새 내보내기는 직접 수신됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld heeft dagen uit de oude synchronisatiestroom in het cachegeheugen opgeslagen. Nieuwe export wordt direct ontvangen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld armazenou em cache dias do antigo fluxo de sincronização. Novas exportações são recebidas diretamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧同步流程中缓存了 %1$lld 天。新的导出会直接接收。"
          }
        }
      }
    },
