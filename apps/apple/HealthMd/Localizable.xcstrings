    "On your Mac, open Mac Destination, enable Manual IP Connections, and generate a pairing code.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Mac, abre Destino Mac, habilita las conexiones IP manuales y genera un código de emparejamiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie auf Ihrem Mac „Mac-Ziel“, aktivieren Sie „Manuelle IP-Verbindungen“ und erzeugen Sie einen Kopplungscode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, ouvrez Destination Mac, activez les connexions IP manuelles et générez un code de jumelage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul Mac, apri Destinazione Mac, abilita Connessioni IP manuali e genera un codice di abbinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで「Macのエクスポート先」を開き、「手動IP接続」を有効にしてペアリングコードを生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Mac 내보내기 대상을 열고 수동 IP 연결을 활성화한 다음 페어링 코드를 생성하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Mac-bestemming op je Mac, schakel Handmatige IP-verbindingen in en genereer een koppelingscode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac, abra “Destino no Mac”, ative “Conexões IP manuais” e gere um código de emparelhamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上，打开“Mac 目标位置”，启用“手动 IP 连接”，并生成配对码。"
          }
        }
      }
    },
    "Only categories with enabled metrics in your export settings are shown. Enable more metrics in Health Metrics settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Kategorien mit aktivierten Metriken in Ihren Exporteinstellungen angezeigt. Aktivieren Sie weitere Metriken in den Gesundheitsmetriken-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only categories with enabled metrics in your export settings are shown. Enable more metrics in Health Metrics settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las categorías con métricas activadas en tus ajustes de exportación. Activa más métricas en los ajustes de Métricas de salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les catégories avec des indicateurs activés dans vos paramètres d'exportation sont affichées. Activez plus d'indicateurs dans les réglages des indicateurs de santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono mostrate solo le categorie con metriche abilitate nelle impostazioni di esportazione. Abilita più metriche nelle impostazioni Metriche Sanitarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート設定で有効な指標があるカテゴリのみ表示されます。ヘルス指標設定でより多くの指標を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기 설정에서 활성화된 항목이 있는 카테고리만 표시됩니다. 건강 항목 설정에서 더 많은 항목을 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen categorieën met ingeschakelde meetwaarden in je exportinstellingen worden getoond. Schakel meer meetwaarden in via Gezondheidsmeetwaarden-instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas categorias com métricas ativadas nas suas configurações de exportação são exibidas. Ative mais métricas nas configurações de Métricas de Saúde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示在导出设置中已启用指标的类别。可在健康指标设置中启用更多指标。"
          }
        }
      }
    },
    "Only metrics enabled in Export Settings → Health Metrics appear here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo aparecen las métricas habilitadas en Ajustes de exportación → Métricas de salud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden nur Metriken angezeigt, die unter Exporteinstellungen → Gesundheitsmetriken aktiviert sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les indicateurs activés dans Paramètres d’exportation → Indicateurs de santé apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vengono mostrate solo le metriche abilitate in Impostazioni di esportazione → Metriche sanitarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「エクスポート設定」→「ヘルス指標」で有効にした指標のみがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기 설정 → 건강 항목에서 활성화된 항목만 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier verschijnen alleen meetwaarden die zijn ingeschakeld bij Exportinstellingen → Gezondheidsmeetwaarden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as métricas ativadas em Configurações de Exportação → Métricas de Saúde aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只显示在“导出设置” → “健康指标”中启用的指标。"
          }
        }
      }
    },
    "Only summary files will be written for the full touched week/month/year windows.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only summary files will be written for the full touched week/month/year windows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Zusammenfassungsdateien für die gesamten berührten Wochen-/Monats-/Jahresfenster geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se escribirán archivos de resumen para las ventanas completas de semana/mes/año tocadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers récapitulatifs seront écrits pour les fenêtres semaine/mois/année entièrement touchées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno scritti solo file di riepilogo per l'intera finestra della settimana/mese/anno interessata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチされた週/月/年のウィンドウ全体については、概要ファイルのみが書き込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 터치된 주/월/연도 창에 대한 요약 파일만 작성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden alleen samenvattingsbestanden geschreven voor de volledige week-/maand-/jaarvensters."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente arquivos de resumo serão gravados para as janelas completas da semana/mês/ano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅针对完整触及的周/月/年窗口写入摘要文件。"
          }
        }
      }
    },
