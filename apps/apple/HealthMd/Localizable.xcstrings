    "Granular samples preserve HealthKit metadata so downstream notes and analysis keep more of the original signal." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Detaillierte Messwerte bewahren HealthKit-Metadaten, damit nachgelagerte Notizen und Analysen mehr der ursprünglichen Informationen erhalten."}},
        "es": {"stringUnit":{"state":"translated","value":"Las muestras detalladas conservan los metadatos de HealthKit para que las notas y los análisis posteriores mantengan más información de la señal original."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les échantillons détaillés préservent les métadonnées HealthKit afin que les notes et analyses ultérieures conservent davantage du signal d’origine."}},
        "it": {"stringUnit":{"state":"translated","value":"I campioni granulari conservano i metadati HealthKit, così le note e le analisi successive mantengono più informazioni del segnale originale."}},
        "ja": {"stringUnit":{"state":"translated","value":"詳細なサンプルにはHealthKitのメタデータが保持されるため、後続のノートや分析で元の情報をより多く活用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"세분화된 샘플은 HealthKit 메타데이터를 보존하여 이후 노트와 분석에 원본 정보를 더 많이 유지합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Gedetailleerde metingen behouden HealthKit-metadata, zodat daarop gebaseerde notities en analyses meer van het oorspronkelijke signaal behouden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As amostras granulares preservam os metadados do HealthKit para que notas e análises posteriores mantenham mais do sinal original."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"细粒度样本保留 HealthKit 元数据，让后续笔记和分析保留更多原始信息。"}}
      }
    },
