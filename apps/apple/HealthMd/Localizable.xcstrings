    "Individual tracking is enabled, but no metrics are selected below. Pick at least one metric to create entry files.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento individual está activado, pero no hay métricas seleccionadas. Elige al menos una para crear archivos de entradas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einzelerfassung ist aktiviert, aber unten sind keine Metriken ausgewählt. Wählen Sie mindestens eine Metrik aus, um Eintragsdateien zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi individuel est activé, mais aucun indicateur n’est sélectionné ci-dessous. Choisissez-en au moins un pour créer des fichiers d’entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il monitoraggio individuale è attivo, ma qui sotto non è selezionata alcuna metrica. Scegline almeno una per creare i file delle voci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個別トラッキングは有効ですが、下で指標が選択されていません。エントリファイルを作成するには、1つ以上の指標を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개별 추적이 활성화되어 있지만 아래에서 선택한 항목이 없습니다. 항목 파일을 만들려면 하나 이상의 항목을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Individueel bijhouden is ingeschakeld, maar hieronder zijn geen meetwaarden geselecteerd. Kies ten minste één meetwaarde om bestanden voor vermeldingen aan te maken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreamento individual está ativado, mas nenhuma métrica foi selecionada abaixo. Escolha pelo menos uma métrica para criar arquivos de entrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
