      }
    },
    "This metric requires additional Apple permission before Health.md can export it." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Für diese Metrik ist eine zusätzliche Apple-Berechtigung erforderlich, bevor Health.md sie exportieren kann."}},
        "es" : {"stringUnit":{"state":"translated","value":"Esta métrica requiere un permiso adicional de Apple para que Health.md pueda exportarla."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Cette mesure nécessite une autorisation Apple supplémentaire pour que Health.md puisse l’exporter."}},
        "it" : {"stringUnit":{"state":"translated","value":"Questa metrica richiede un’autorizzazione aggiuntiva di Apple prima che Health.md possa esportarla."}},
        "ja" : {"stringUnit":{"state":"translated","value":"Health.mdでこの指標を書き出すには、Appleの追加の許可が必要です。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"Health.md가 이 지표를 내보내려면 Apple의 추가 권한이 필요합니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Voor deze meting is extra toestemming van Apple nodig voordat Health.md deze kan exporteren."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Esta métrica exige uma permissão adicional da Apple para que o Health.md possa exportá-la."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"Health.md 需要获得 Apple 的额外授权才能导出此指标。"}}
      }
    },
    "This plan contains invalid items and cannot be applied." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dieser Plan enthält ungültige Elemente und kann nicht angewendet werden."}},
        "es": {"stringUnit":{"state":"translated","value":"Este plan contiene elementos no válidos y no se puede aplicar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ce plan contient des éléments non valides et ne peut pas être appliqué."}},
        "it": {"stringUnit":{"state":"translated","value":"Questo piano contiene elementi non validi e non può essere applicato."}},
        "ja": {"stringUnit":{"state":"translated","value":"このプランには無効な項目があるため適用できません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 계획에는 유효하지 않은 항목이 있어 적용할 수 없습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Dit plan bevat ongeldige onderdelen en kan niet worden toegepast."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Este plano contém itens inválidos e não pode ser aplicado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"此计划包含无效项目，无法应用。"}}
      }
    },
    "This profile contains invalid items and stays review-only." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dieses Profil enthält ungültige Elemente und bleibt auf die Prüfung beschränkt."}},
        "es": {"stringUnit":{"state":"translated","value":"Este perfil contiene elementos no válidos y solo se puede revisar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ce profil contient des éléments non valides et reste consultable uniquement."}},
        "it": {"stringUnit":{"state":"translated","value":"Questo profilo contiene elementi non validi e resta disponibile solo per la revisione."}},
        "ja": {"stringUnit":{"state":"translated","value":"このプロファイルには無効な項目があるため、確認のみ可能です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 프로필에는 유효하지 않은 항목이 있어 검토만 가능합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Dit profiel bevat ongeldige onderdelen en blijft alleen ter controle beschikbaar."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Este perfil contém itens inválidos e continua disponível apenas para revisão."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"此配置包含无效项目，仍仅供检查。"}}
      }
    },
    "This profile has no schedule yet. It runs only when you export manually." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dieses Profil hat noch keinen Zeitplan. Es wird nur bei einem manuellen Export ausgeführt."}},
        "es": {"stringUnit":{"state":"translated","value":"Este perfil aún no tiene una programación. Solo se ejecuta cuando exportas manualmente."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ce profil n’a pas encore de programmation. Il s’exécute uniquement lors d’une exportation manuelle."}},
        "it": {"stringUnit":{"state":"translated","value":"Questo profilo non ha ancora una pianificazione. Viene eseguito solo quando esporti manualmente."}},
        "ja": {"stringUnit":{"state":"translated","value":"このプロファイルにはまだスケジュールがありません。手動でエクスポートしたときのみ実行されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 프로필에는 아직 일정이 없습니다. 수동으로 내보낼 때만 실행됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Dit profiel heeft nog geen schema. Het wordt alleen uitgevoerd wanneer je handmatig exporteert."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Este perfil ainda não tem agendamento. Ele só é executado quando você exporta manualmente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"此配置尚未设置计划，仅在手动导出时运行。"}}
      }
    },
    "This profile no longer exists." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dieses Profil existiert nicht mehr."}},
        "es": {"stringUnit":{"state":"translated","value":"Este perfil ya no existe."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ce profil n’existe plus."}},
        "it": {"stringUnit":{"state":"translated","value":"Questo profilo non esiste più."}},
        "ja": {"stringUnit":{"state":"translated","value":"このプロファイルはもう存在しません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 프로필은 더 이상 존재하지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Dit profiel bestaat niet meer."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Este perfil não existe mais."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"此配置已不存在。"}}
      }
    },
    "This profile writes the same files as %@. The later run overwrites the earlier one. Give each profile its own folder or filename template to keep them separate." : {
      "comment": "Detail warning that this profile's output files overlap other profiles; the interpolated value is a comma-separated profile name list",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil schreibt dieselben Dateien wie %@. Die spätere Ausführung überschreibt die frühere. Weise jedem Profil einen eigenen Ordner oder eine eigene Dateinamenvorlage zu, um sie getrennt zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil escribe los mismos archivos que %@. La ejecución posterior sobrescribe la anterior. Asigna a cada perfil su propia carpeta o plantilla de nombre de archivo para mantenerlos separados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil écrit les mêmes fichiers que %@. L’exécution suivante écrase la précédente. Attribuez à chaque profil son propre dossier ou modèle de nom de fichier pour les garder séparés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo scrive gli stessi file di %@. L’esecuzione successiva sovrascrive quella precedente. Assegna a ogni profilo una cartella o un modello del nome file diverso per mantenerli separati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルは%@と同じファイルに書き込みます。後の実行で以前のファイルが上書きされます。別々に保存するには、各プロファイルに異なるフォルダまたはファイル名テンプレートを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필은 %@와 동일한 파일에 기록합니다. 나중에 실행한 결과가 이전 결과를 덮어씁니다. 각각 별도로 유지하려면 프로필마다 다른 폴더나 파일 이름 템플릿을 지정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit profiel schrijft dezelfde bestanden als %@. De latere uitvoering overschrijft de eerdere. Geef elk profiel een eigen map of bestandsnaamsjabloon om ze gescheiden te houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil grava os mesmos arquivos que %@. A execução posterior substitui a anterior. Defina uma pasta ou um modelo de nome de arquivo exclusivo para cada perfil para mantê-los separados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置与 %@ 写入相同的文件。后运行的导出会覆盖先前的文件。请为每个配置设置独立的文件夹或文件名模板，以保持文件分离。"
          }
        }
      }
    },
    "This removes every compact context day and its dedicated Keychain key. Exported files and Apple Health remain unchanged." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle kompakten Kontexttage und deren zugehörige Schlüsselbund-Schlüssel entfernt. Exportierte Dateien und Apple Health bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes every compact context day and its dedicated Keychain key. Exported files and Apple Health remain unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina cada día de contexto compacto y su clave Keychain dedicada. Los archivos exportados y Apple Health permanecen sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime chaque jour de contexte compact et sa clé dédiée Keychain. Les fichiers exportés et Apple Health restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi tutti i giorni di contesto compatti e la relativa chiave Keychain dedicata. I file esportati e Apple Health rimangono invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、すべてのコンパクト コンテキスト日とその専用の Keychain キーが削除されます。エクスポートされたファイルと Apple Health は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 모든 컴팩트 컨텍스트 데이와 전용 Keychain 키가 제거됩니다. 내보낸 파일과 Apple Health는 변경되지 않은 상태로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt elke compacte contextdag en de speciale Keychain-sleutel verwijderd. Geëxporteerde bestanden en Apple Health blijven ongewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove todos os dias de contexto compacto e sua chave Keychain dedicada. Os arquivos exportados e Apple Health permanecem inalterados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除每个紧凑上下文日及其专用 Keychain 密钥。导出的文件和 Apple Health 保持不变。"
          }
        }
      }
    },
    "This removes recorded iPhone→Mac sync and export events from this Mac. Your synced health data and exported files are not affected." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden aufgezeichnete iPhone→Mac-Synchronisierungs- und Exportereignisse von diesem Mac entfernt. Ihre synchronisierten Gesundheitsdaten und exportierten Dateien bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes recorded iPhone→Mac sync and export events from this Mac. Your synced health data and exported files are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina los eventos de sincronización y exportación iPhone→Mac registrados de este Mac. Sus datos de salud sincronizados y archivos exportados no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les événements de synchronisation et d'exportation iPhone → Mac enregistrés de ce Mac. Vos données de santé synchronisées et vos fichiers exportés ne sont pas affectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
