          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台导出任务在完成前被 iOS 终止。"
          }
        }
      }
    },
    "The day to export. Time-of-day is ignored." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der zu exportierende Tag. Die Uhrzeit wird ignoriert."}},
        "es": {"stringUnit":{"state":"translated","value":"El día que se exportará. Se ignora la hora."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le jour à exporter. L’heure est ignorée."}},
        "it": {"stringUnit":{"state":"translated","value":"Il giorno da esportare. L’ora viene ignorata."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートする日付。時刻は無視されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보낼 날짜입니다. 시간은 무시됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De dag om te exporteren. Het tijdstip wordt genegeerd."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O dia a exportar. O horário é ignorado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"要导出的日期。忽略具体时间。"}}
      }
    },
    "The day to summarize. Time-of-day is ignored." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der zusammenzufassende Tag. Die Uhrzeit wird ignoriert."}},
        "es": {"stringUnit":{"state":"translated","value":"El día que se resumirá. Se ignora la hora."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le jour à résumer. L’heure est ignorée."}},
        "it": {"stringUnit":{"state":"translated","value":"Il giorno da riepilogare. L’ora viene ignorata."}},
        "ja": {"stringUnit":{"state":"translated","value":"サマリーを作成する日付。時刻は無視されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"요약할 날짜입니다. 시간은 무시됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De dag om samen te vatten. Het tijdstip wordt genegeerd."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O dia a resumir. O horário é ignorado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"要汇总的日期。忽略具体时间。"}}
      }
    },
    "The duplicate writes the same files as %@. Later runs overwrite earlier ones. Undo, then change its folder or filename template if you want separate files." : {
      "comment": "Warning when a duplicated export profile overlaps another profile's output files; the interpolated value is a comma-separated profile name list",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Duplikat schreibt dieselben Dateien wie %@. Spätere Ausführungen überschreiben frühere. Mache den Vorgang rückgängig und ändere dann den Ordner oder die Dateinamenvorlage, wenn du separate Dateien möchtest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El duplicado escribe los mismos archivos que %@. Las ejecuciones posteriores sobrescriben las anteriores. Deshaz la duplicación y cambia su carpeta o plantilla de nombre de archivo si quieres archivos separados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie écrit les mêmes fichiers que %@. Les exécutions suivantes écrasent les précédentes. Annulez, puis modifiez son dossier ou son modèle de nom de fichier si vous souhaitez des fichiers distincts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il duplicato scrive gli stessi file di %@. Le esecuzioni successive sovrascrivono quelle precedenti. Annulla, poi cambia la cartella o il modello del nome file se vuoi file separati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複製は%@と同じファイルに書き込みます。後の実行で以前のファイルが上書きされます。別々のファイルにするには、取り消してからフォルダまたはファイル名テンプレートを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복제본이 %@와 동일한 파일에 기록합니다. 나중에 실행한 결과가 이전 결과를 덮어씁니다. 별도 파일을 원하면 실행 취소 후 폴더나 파일 이름 템플릿을 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het duplicaat schrijft dezelfde bestanden als %@. Latere uitvoeringen overschrijven eerdere. Maak dit ongedaan en wijzig daarna de map of het bestandsnaamsjabloon als je aparte bestanden wilt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia grava os mesmos arquivos que %@. Execuções posteriores substituem as anteriores. Desfaça e altere a pasta ou o modelo de nome de arquivo da cópia se quiser arquivos separados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本与 %@ 写入相同的文件。后运行的导出会覆盖先前的文件。如需独立文件，请撤销，然后更改其文件夹或文件名模板。"
          }
        }
      }
    },
    "The encrypted Health.md query-context index does not match its day blob." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der verschlüsselte Health.md Query-Context-Index stimmt nicht mit seinem Tages-Blob überein."
          }
        },
