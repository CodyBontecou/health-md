    "Export schema v7 reports missing permissions, unavailable records, and partial captures so incomplete exports no longer look complete." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Exportschema v7 meldet fehlende Berechtigungen, nicht verfügbare Datensätze und unvollständige Erfassungen, damit unvollständige Exporte nicht mehr vollständig erscheinen."}},
        "es": {"stringUnit":{"state":"translated","value":"El esquema de exportación v7 informa de permisos ausentes, registros no disponibles y capturas parciales para que las exportaciones incompletas ya no parezcan completas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le schéma d’exportation v7 signale les autorisations manquantes, les enregistrements indisponibles et les captures partielles, afin que les exportations incomplètes ne paraissent plus complètes."}},
        "it": {"stringUnit":{"state":"translated","value":"Lo schema di esportazione v7 segnala autorizzazioni mancanti, record non disponibili e acquisizioni parziali, così le esportazioni incomplete non appaiono più complete."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートスキーマv7では、権限の不足、利用できないレコード、部分的な取得を報告します。不完全なエクスポートが完全なものに見えることはなくなります。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기 스키마 v7은 누락된 권한, 사용할 수 없는 기록, 부분적으로 수집된 데이터를 표시하여 불완전한 내보내기가 완전한 것처럼 보이지 않도록 합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Exportschema v7 meldt ontbrekende machtigingen, niet-beschikbare records en gedeeltelijke vastleggingen, zodat onvolledige exports niet meer volledig lijken."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O esquema de exportação v7 informa permissões ausentes, registros indisponíveis e capturas parciais para que exportações incompletas não pareçam mais completas."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"导出架构 v7 会报告缺失的权限、不可用的记录和部分采集情况，让不完整的导出不再看起来像完整导出。"}}
      }
    },
    "Export screens stay responsive" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Exportansichten bleiben bedienbar"}},
        "es": {"stringUnit":{"state":"translated","value":"Las pantallas de exportación siguen respondiendo"}},
