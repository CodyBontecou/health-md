    "Write selected metrics into daily note frontmatter, with optional Markdown sections for the note body.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade las métricas seleccionadas al frontmatter de las notas diarias, con secciones Markdown opcionales en el cuerpo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Metriken in das Frontmatter täglicher Notizen schreiben, mit optionalen Markdown-Abschnitten für den Notizinhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les indicateurs sélectionnés au frontmatter des notes quotidiennes, avec des sections Markdown facultatives dans le corps des notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi le metriche selezionate nel frontmatter delle note giornaliere, con sezioni Markdown facoltative nel corpo delle note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した指標をデイリーノートのフロントマターに書き込み、必要に応じてノート本文にMarkdownセクションを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목을 일일 노트의 프론트매터에 기록하고, 필요하면 노트 본문에 Markdown 섹션을 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf geselecteerde meetwaarden naar de frontmatter van dagelijkse notities, met optionele Markdown-secties voor de notitietekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave as métricas selecionadas no frontmatter das notas diárias, com seções opcionais em Markdown no corpo da nota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选指标写入每日笔记的 frontmatter，并可选择在笔记正文中添加 Markdown 章节。"
          }
        }
      }
    },
    "Writes the machine-readable key and unit legend alongside exports or inside ZIP archives": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes the machine-readable key and unit legend alongside exports or inside ZIP archives"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt den maschinenlesbaren Schlüssel und die Einheitenlegende zusammen mit Exporten oder in ZIP-Archive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la clave legible por máquina y la leyenda de la unidad junto con las exportaciones o dentro de archivos ZIP"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit la clé lisible par machine et la légende de l'unité à côté des exportations ou dans les archives ZIP"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive la chiave leggibile dalla macchina e la legenda dell'unità accanto alle esportazioni o all'interno degli archivi ZIP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機械可読なキーと単位凡例をエクスポートと一緒に、または ZIP アーカイブ内に書き込みます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기와 함께 또는 ZIP 아카이브 내부에 기계 판독 가능한 키와 단위 범례를 기록합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijft de machinaal leesbare sleutel en eenheidslegenda naast exports of in ZIP-archieven"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava a chave legível por máquina e a legenda da unidade junto com as exportações ou dentro de arquivos ZIP"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在导出文件旁或 ZIP 压缩包内写入机器可读的字段键和单位说明"
          }
        }
      }
    },
