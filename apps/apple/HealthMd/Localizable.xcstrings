    "Off · Enable the range summary to write one summary per format." : {
      "comment" : "Apple range-summary UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus · Aktivieren Sie die Zeitraumzusammenfassung, um eine Zusammenfassung pro Format zu schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off · Enable the range summary to write one summary per format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado · Activa el resumen del rango de fechas para escribir un resumen por formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé · Activez le résumé de la plage de dates pour écrire un résumé par format."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato · Attiva il riepilogo dell'intervallo per scrivere un riepilogo per formato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ · 形式ごとに概要を1つ書き出すには、期間の概要を有効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔 · 형식별로 요약 하나를 작성하려면 날짜 범위 요약을 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit · Schakel de samenvatting van het datumbereik in om één samenvatting per indeling te schrijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado · Ative o resumo do intervalo para gravar um resumo por formato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭 · 启用日期范围摘要，以便每种格式写入一份摘要。"
          }
        }
      }
    },
    "Off. Turn on automation to configure timing, lookback, and reminder behavior." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus. Aktivieren Sie die Automatisierung, um Zeitplan, Rückblickzeitraum und Erinnerungsoptionen festzulegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado. Activa la automatización para configurar el horario, el periodo y los recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé. Activez l’automatisation pour configurer la planification, la période couverte et le fonctionnement des rappels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivata. Attiva l’automazione per configurare frequenza, periodo da includere e comportamento dei promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフです。自動化をオンにすると、実行タイミング、遡る期間、リマインダーの動作を設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼져 있습니다. 자동화를 켜면 실행 시점, 이전 데이터 범위 및 알림 동작을 설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit. Schakel automatisering in om planning, terugkijkperiode en herinneringsopties in te stellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado. Ative a automação para configurar o horário, a janela retroativa e o comportamento dos lembretes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭。开启自动化以设置时间、回溯范围和提醒行为。"
          }
        }
      }
    },
