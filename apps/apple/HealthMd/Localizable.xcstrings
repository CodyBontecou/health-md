      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Teil dieses Berichts waren Datensätze auf Quellenebene aus Apple Health nicht verfügbar; sofern verfügbar, werden Übersichtswerte verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source-level Apple Health records were unavailable for part of this report; summary values are used where available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de Apple Health por fuente no estaban disponibles para una parte de este informe; se utilizan valores resumidos cuando están disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements Apple Health par source étaient indisponibles pour une partie de ce rapport ; les valeurs récapitulatives sont utilisées lorsqu’elles sont disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I record Apple Health a livello di origine non erano disponibili per una parte di questo report; ove disponibili, vengono utilizzati i valori di riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートの一部で Apple Health のソース単位の記録を利用できなかったため、利用可能な箇所ではサマリー値を使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보고서의 일부에서 출처별 Apple Health 기록을 사용할 수 없어, 가능한 경우 요약 값을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een deel van dit rapport waren Apple Health-records op bronniveau niet beschikbaar; waar beschikbaar worden samenvattingswaarden gebruikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros do Apple Health por fonte não estavam disponíveis em parte deste relatório; os valores resumidos são usados quando disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本报告的部分 Apple Health 来源级记录不可用；如有可用的摘要值，则使用摘要值。"
          }
        }
      }
    },
    "clinician_report_error_prepare_android": {
      "comment": "Clinician Report V1 localized vocabulary. Managed by scripts/validate-clinician-report-localizations.py.",
