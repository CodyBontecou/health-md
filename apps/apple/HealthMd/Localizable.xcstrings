        "ja": {"stringUnit":{"state":"translated","value":"healthmd とペアリング"}},
        "ko": {"stringUnit":{"state":"translated","value":"healthmd와 페어링"}},
        "nl": {"stringUnit":{"state":"translated","value":"Koppelen met healthmd"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Emparelhar com healthmd"}},
