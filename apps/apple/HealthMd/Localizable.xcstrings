    "Keeps credentials, history and completed exports. Requires confirmation." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Behält Zugangsdaten, Verlauf und abgeschlossene Exporte bei. Erfordert eine Bestätigung."}},
        "es": {"stringUnit":{"state":"translated","value":"Conserva las credenciales, el historial y las exportaciones completadas. Requiere confirmación."}},
        "fr": {"stringUnit":{"state":"translated","value":"Conserve les identifiants, l’historique et les exports terminés. Confirmation requise."}},
        "it": {"stringUnit":{"state":"translated","value":"Mantiene credenziali, cronologia ed esportazioni completate. Richiede conferma."}},
        "ja": {"stringUnit":{"state":"translated","value":"認証情報、履歴、完了したエクスポートは保持されます。確認が必要です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"인증 정보, 기록 및 완료된 내보내기는 유지됩니다. 확인이 필요합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Behoudt inloggegevens, geschiedenis en voltooide exports. Bevestiging vereist."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Mantém credenciais, histórico e exportações concluídas. Exige confirmação."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"保留凭据、历史记录和已完成的导出。需要确认。"}}
      }
    },
