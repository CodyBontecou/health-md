    "Let Health.md on Mac receive iPhone-configured exports over your local network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Health.md en el Mac reciba por la red local las exportaciones configuradas en el iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie Health.md auf dem Mac über Ihr lokales Netzwerk Exporte empfangen, die auf dem iPhone konfiguriert wurden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Health.md sur Mac à recevoir, via votre réseau local, les exportations configurées sur l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Health.md sul Mac di ricevere, tramite la rete locale, le esportazioni configurate sull’iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacのHealth.mdが、iPhoneで設定したエクスポートをローカルネットワーク経由で受信できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 Health.md가 로컬 네트워크를 통해 iPhone에서 설정한 내보내기를 수신하도록 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Health.md op de Mac via je lokale netwerk exports ontvangen die op de iPhone zijn geconfigureerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o Health.md no Mac receba, pela rede local, exportações configuradas no iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Mac 上的 Health.md 通过本地网络接收在 iPhone 上配置的导出。"
          }
        }
      }
    },
    "Let the healthmd command connect while this iPhone app is open, without running the Mac app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el comando healthmd se conecte mientras esta app del iPhone está abierta, sin ejecutar la app del Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie den Befehl healthmd eine Verbindung herstellen, während diese iPhone-App geöffnet ist, ohne die Mac-App auszuführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la commande healthmd à se connecter pendant que cette app iPhone est ouverte, sans lancer l’app Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti al comando healthmd di connettersi mentre questa app per iPhone è aperta, senza eseguire l’app per Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneアプリを開いている間は、Macアプリを起動せずにhealthmdコマンドから接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone 앱이 열려 있는 동안에는 Mac 앱을 실행하지 않아도 healthmd 명령으로 연결할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de opdracht healthmd verbinding maken terwijl deze iPhone-app geopend is, zonder de Mac-app uit te voeren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que o comando healthmd se conecte enquanto este app estiver aberto no iPhone, sem executar o app para Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 healthmd 命令在此 iPhone 应用保持打开时连接，而无需运行 Mac 应用。"
          }
        }
      }
    },
