    "clinician_report_warning_apple_read_failure_date" : {
      "comment" : "Clinician Report V1 localized vocabulary. Managed by scripts/validate-clinician-report-localizations.py.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige ausgewählte Daten aus Apple Health konnten für %1$@ nicht gelesen werden. Leere Abschnitte können auf fehlenden Zugriff oder darauf zurückzuführen sein, dass keine Datensätze zurückgegeben wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some selected Apple Health data could not be read for %1$@. Empty sections may reflect unavailable access or no records returned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer algunos datos de Apple Health seleccionados para %1$@. Las secciones vacías pueden deberse a que el acceso no está disponible o a que no se devolvieron registros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données Apple Health sélectionnées n’ont pas pu être lues pour le %1$@. Les sections vides peuvent indiquer un accès indisponible ou l’absence d’enregistrements renvoyés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere alcuni dati Apple Health selezionati per il giorno %1$@. Le sezioni vuote possono indicare un accesso non disponibile o l’assenza di record restituiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@について、選択した Apple Health データの一部を読み取れませんでした。空欄のセクションは、アクセスできないか、記録が返されなかったことを示す場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 선택한 Apple Health 데이터 중 일부를 읽을 수 없습니다. 빈 섹션은 접근할 수 없거나 반환된 기록이 없음을 나타낼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige geselecteerde gegevens uit Apple Health konden voor %1$@ niet worden gelezen. Lege secties kunnen het gevolg zijn van ontbrekende toegang of het ontbreken van geretourneerde records."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler alguns dados selecionados do Apple Health em %1$@. Seções vazias podem indicar acesso indisponível ou nenhum registro retornado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@ 的部分所选 Apple Health 数据。空白部分可能表示无法访问或未返回任何记录。"
          }
        }
      }
    },
