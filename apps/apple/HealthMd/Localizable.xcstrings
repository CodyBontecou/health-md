    "Connected by manual IP / Tailscale; check destination readiness below" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über manuelle IP-Adresse / Tailscale verbunden; prüfen Sie unten, ob das Ziel bereit ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
