        "zh-Hans": {"stringUnit":{"state":"translated","value":"跳过每日导出文件，仅写入已启用的汇总摘要"}}
      }
    },
    "Skips daily files and side effects. Health.md still fetches the full touched periods to build the enabled summaries." : {
      "comment" : "macOS production UI",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt Tagesdateien und Nebeneffekte. Health.md ruft dennoch die gesamten betroffenen Zeiträume ab, um die aktivierten Zusammenfassungen zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skips daily files and side effects. Health.md still fetches the full touched periods to build the enabled summaries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta archivos diarios y efectos secundarios. Health.md todavía recupera todos los períodos tocados para crear los resúmenes habilitados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore les fichiers quotidiens et les effets secondaires. Health.md récupère toujours l'intégralité des périodes touchées pour créer les résumés activés."
