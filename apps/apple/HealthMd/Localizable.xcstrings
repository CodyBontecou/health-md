        "fr": {"stringUnit":{"state":"translated","value":"Exportations de distances en unités impériales plus claires"}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni delle distanze in unità imperiali sono più chiare"}},
        "ja": {"stringUnit":{"state":"translated","value":"ヤード・ポンド法の距離エクスポートがより明確に"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 명확해진 영미식 거리 내보내기"}},
        "nl": {"stringUnit":{"state":"translated","value":"Duidelijkere afstandsexports in imperiale eenheden"}},
