    "Discard Pending Recovery?" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ausstehende Wiederherstellung verwerfen?"}},
        "es": {"stringUnit":{"state":"translated","value":"¿Descartar la recuperación pendiente?"}},
