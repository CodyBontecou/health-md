    "Double tap to disable daily note injection" : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Doppeltippen, um die tägliche Notizeinfügung zu deaktivieren"}},
        "es" : {"stringUnit":{"state":"translated","value":"Toca dos veces para desactivar la inyección en notas diarias"}},
        "fr" : {"stringUnit":{"state":"translated","value":"Touchez deux fois pour désactiver l’injection dans les notes quotidiennes"}},
        "it" : {"stringUnit":{"state":"translated","value":"Tocca due volte per disattivare l’iniezione nelle note giornaliere"}},
        "ja" : {"stringUnit":{"state":"translated","value":"ダブルタップしてデイリーノート注入を無効にします"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이중 탭하여 일일 노트 주입을 비활성화하세요"}},
        "nl" : {"stringUnit":{"state":"translated","value":"Tik dubbel om dagelijkse notitie-injectie uit te schakelen"}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Toque duas vezes para desativar a injeção em notas diárias"}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"轻点两下以停用每日笔记注入"}}
      }
    },
    "Double tap to enable daily note injection" : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Doppeltippen, um die tägliche Notizeinfügung zu aktivieren"}},
        "es" : {"stringUnit":{"state":"translated","value":"Toca dos veces para activar la inyección en notas diarias"}},
        "fr" : {"stringUnit":{"state":"translated","value":"Touchez deux fois pour activer l’injection dans les notes quotidiennes"}},
        "it" : {"stringUnit":{"state":"translated","value":"Tocca due volte per attivare l’iniezione nelle note giornaliere"}},
        "ja" : {"stringUnit":{"state":"translated","value":"ダブルタップしてデイリーノート注入を有効にします"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이중 탭하여 일일 노트 주입을 활성화하세요"}},
        "nl" : {"stringUnit":{"state":"translated","value":"Tik dubbel om dagelijkse notitie-injectie in te schakelen"}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Toque duas vezes para ativar a injeção em notas diárias"}},
