    "Returns a snapshot of a day's headline health metrics — steps, active calories, sleep, heart rate, and more — without writing to your vault." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Gibt eine Momentaufnahme der wichtigsten Gesundheitsmetriken eines Tages zurück – Schritte, Aktivitätskalorien, Schlaf, Herzfrequenz und mehr –, ohne in deinen Vault zu schreiben."}},
        "es": {"stringUnit":{"state":"translated","value":"Devuelve un resumen de las principales métricas de salud de un día —pasos, calorías activas, sueño, frecuencia cardíaca y más— sin escribir en tu bóveda."}},
        "fr": {"stringUnit":{"state":"translated","value":"Renvoie un aperçu des principaux indicateurs de santé d’une journée — pas, calories actives, sommeil, fréquence cardiaque, etc. — sans rien écrire dans votre coffre."}},
        "it": {"stringUnit":{"state":"translated","value":"Restituisce una panoramica delle principali metriche sanitarie di un giorno — passi, calorie attive, sonno, frequenza cardiaca e altro — senza scrivere nel tuo vault."}},
        "ja": {"stringUnit":{"state":"translated","value":"保管庫に書き込まずに、歩数、アクティブカロリー、睡眠、心拍数など、その日の主要なヘルス指標のスナップショットを返します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"보관함에 기록하지 않고 걸음 수, 활동 칼로리, 수면, 심박수 등 하루의 주요 건강 항목을 요약하여 반환합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geeft een momentopname van de belangrijkste gezondheidsmeetwaarden van een dag — stappen, actieve calorieën, slaap, hartslag en meer — zonder naar je kluis te schrijven."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Retorna um resumo das principais métricas de saúde de um dia — passos, calorias ativas, sono, frequência cardíaca e mais — sem gravar no seu cofre."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"返回某一天主要健康指标的快照，包括步数、活动热量、睡眠、心率等，不会写入你的笔记库。"}}
      }
    },
    "Returns details of the most recent Health.md export — timestamp, success, days exported, and any failure reason." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Gibt Details zum letzten Health.md-Export zurück: Zeitstempel, Erfolg, exportierte Tage und gegebenenfalls den Fehlergrund."}},
        "es": {"stringUnit":{"state":"translated","value":"Devuelve los detalles de la exportación más reciente de Health.md: fecha y hora, resultado, días exportados y cualquier motivo de error."}},
        "fr": {"stringUnit":{"state":"translated","value":"Renvoie les détails de la dernière exportation Health.md — horodatage, réussite, jours exportés et motif d’échec éventuel."}},
        "it": {"stringUnit":{"state":"translated","value":"Restituisce i dettagli dell’esportazione Health.md più recente: data e ora, esito, giorni esportati ed eventuale motivo dell’errore."}},
        "ja": {"stringUnit":{"state":"translated","value":"直近のHealth.mdエクスポートの詳細（日時、成功状況、エクスポートした日数、失敗した場合の理由）を返します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"가장 최근 Health.md 내보내기의 타임스탬프, 성공 여부, 내보낸 일수, 실패 사유 등의 세부 정보를 반환합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geeft details over de meest recente Health.md-export — tijdstempel, successtatus, geëxporteerde dagen en een eventuele foutreden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Retorna detalhes da exportação mais recente do Health.md — data e hora, sucesso, dias exportados e o motivo de qualquer falha."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"返回最近一次 Health.md 导出的详细信息，包括时间戳、是否成功、导出天数及失败原因。"}}
      }
    },
