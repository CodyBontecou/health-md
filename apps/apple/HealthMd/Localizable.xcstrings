        "fr": {"stringUnit":{"state":"translated","value":"Votre achat existant inclut un accès à vie offert à myself.md."}},
        "it": {"stringUnit":{"state":"translated","value":"Il tuo acquisto esistente include l’accesso gratuito a vita a myself.md."}},
        "ja": {"stringUnit":{"state":"translated","value":"既存の購入には、myself.mdへの無料の永久アクセスが含まれます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"기존 구매에 myself.md 무료 평생 이용 권한이 포함됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Je bestaande aankoop omvat gratis levenslange toegang tot myself.md."}},
