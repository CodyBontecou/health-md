          "stringUnit": {
            "state": "translated",
            "value": "Health.md は、クエリ コンテキスト暗号化キーを Keychain に保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 쿼리 컨텍스트 암호화 키를 Keychain에 저장할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kan de coderingssleutel voor de querycontext niet opslaan in Keychain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md não pôde salvar a chave de criptografia do contexto de consulta em Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 无法将查询上下文加密密钥保存在 Keychain 中。"
          }
        }
      }
    },
    "Health.md encountered an unexpected error during export. Any system message captured at the time appears in the Technical details section.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md encountered an unexpected error during export. Any system message captured at the time appears in the Technical details section."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md hat beim Export einen unerwarteten Fehler festgestellt. Alle zu diesem Zeitpunkt erfassten Systemmeldungen werden im Abschnitt „Technische Details“ angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md encontró un error inesperado durante la exportación. Cualquier mensaje del sistema capturado en ese momento aparece en la sección Detalles técnicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md a rencontré une erreur inattendue lors de l'exportation. Tout message système capturé à ce moment-là apparaît dans la section Détails techniques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md ha riscontrato un errore imprevisto durante l'esportazione. Qualsiasi messaggio di sistema catturato in quel momento appare nella sezione Dettagli tecnici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md はエクスポート中に予期しないエラーが発生しました。その時点でキャプチャされたシステム メッセージはすべて、[技術詳細] セクションに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md를 내보내는 중에 예기치 않은 오류가 발생했습니다. 당시 캡처된 모든 시스템 메시지는 기술 세부 정보 섹션에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md heeft tijdens het exporteren een onverwachte fout aangetroffen. Elk systeembericht dat op dat moment wordt vastgelegd, verschijnt in het gedeelte Technische details."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md encontrou um erro inesperado durante a exportação. Qualquer mensagem do sistema capturada naquele momento aparece na seção Detalhes técnicos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 在导出过程中遇到意外错误。当时捕获的任何系统消息都会显示在“技术详细信息”部分中。"
          }
        }
      }
    },
