    "clinician_report_disclaimer": {
      "comment": "Clinician Report V1 localized vocabulary. Managed by scripts/validate-clinician-report-localizations.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bericht fasst Gesundheitsdaten zusammen, die von der Patientin oder dem Patienten ausgewählt und freigegeben wurden. Health.md stellt keine Diagnosen und gibt keine medizinische Beratung. Die Vollständigkeit der Daten hängt von verbundenen Geräten, Apps, Berechtigungen und dem Aufzeichnungsverhalten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report summarizes health data selected and authorized by the patient. Health.md does not diagnose conditions or provide medical advice. Data completeness depends on connected devices, applications, permissions, and recording behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe resume los datos de salud seleccionados y autorizados por el paciente. Health.md no diagnostica enfermedades ni proporciona asesoramiento médico. La integridad de los datos depende de los dispositivos conectados, las aplicaciones, los permisos y los hábitos de registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rapport résume les données de santé sélectionnées et autorisées par le patient. Health.md ne diagnostique aucune maladie et ne fournit aucun conseil médical. L’exhaustivité des données dépend des appareils connectés, des applications, des autorisations et des pratiques d’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo report riepiloga i dati sanitari selezionati e autorizzati dal paziente. Health.md non diagnostica patologie né fornisce consulenza medica. La completezza dei dati dipende dai dispositivi connessi, dalle applicazioni, dalle autorizzazioni e dalle modalità di registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートは、患者が選択し許可した健康データをまとめたものです。Health.md は病状の診断や医療上の助言を行いません。データの完全性は、接続されたデバイス、アプリケーション、アクセス権、および記録状況によって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보고서는 환자가 선택하고 승인한 건강 데이터를 요약합니다. Health.md는 질환을 진단하거나 의학적 조언을 제공하지 않습니다. 데이터의 완전성은 연결된 기기, 애플리케이션, 권한 및 기록 방식에 따라 달라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit rapport bevat een samenvatting van gezondheidsgegevens die door de patiënt zijn geselecteerd en goedgekeurd. Health.md stelt geen diagnoses en geeft geen medisch advies. De volledigheid van de gegevens hangt af van gekoppelde apparaten, apps, machtigingen en registratiegedrag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relatório resume os dados de saúde selecionados e autorizados pelo paciente. O Health.md não diagnostica condições nem fornece orientação médica. A integridade dos dados depende dos dispositivos conectados, aplicativos, permissões e práticas de registro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本报告汇总了患者选择并授权的健康数据。Health.md 不会诊断疾病，也不提供医疗建议。数据完整性取决于已连接的设备、应用程序、权限和记录情况。"
          }
        }
      }
    },
