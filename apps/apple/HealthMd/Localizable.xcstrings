    "Could not access the selected export folder. Reconnect or re-select it in Health.md.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access the selected export folder. Reconnect or re-select it in Health.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den ausgewählten Exportordner konnte nicht zugegriffen werden. Verbinden Sie es erneut oder wählen Sie es in Health.md erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a la carpeta de exportación seleccionada. Vuelva a conectarlo o selecciónelo en Health.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
