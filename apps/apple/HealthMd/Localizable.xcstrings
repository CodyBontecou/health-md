    "A Mac binding is saved. Refresh shortcuts require that same authenticated Mac." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Eine Mac-Bindung ist gespeichert. Aktualisierungskurzbefehle erfordern denselben authentifizierten Mac."}},
        "es": {"stringUnit":{"state":"translated","value":"Hay una vinculación con un Mac guardada. Los atajos de actualización requieren ese mismo Mac autenticado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Une association à un Mac est enregistrée. Les raccourcis d’actualisation nécessitent ce même Mac authentifié."}},
        "it": {"stringUnit":{"state":"translated","value":"È stata salvata un’associazione con un Mac. I comandi rapidi di aggiornamento richiedono lo stesso Mac autenticato."}},
        "ja": {"stringUnit":{"state":"translated","value":"Macとの紐付けが保存されています。更新ショートカットには、その同じ認証済みMacが必要です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac 연결이 저장되어 있습니다. 새로 고침 단축어에는 동일한 인증된 Mac이 필요합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Er is een Mac-koppeling opgeslagen. Verversopdrachten vereisen diezelfde geauthenticeerde Mac."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Um vínculo com um Mac está salvo. Os atalhos de atualização exigem esse mesmo Mac autenticado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已保存 Mac 绑定。刷新快捷指令需要使用同一台已认证的 Mac。"}}
      }
    },
    "A faster start and gentler upgrade reminders" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Schnellerer Einstieg und dezentere Upgrade-Erinnerungen"}},
        "es": {"stringUnit":{"state":"translated","value":"Un inicio más rápido y recordatorios más discretos para mejorar el plan"}},
        "fr": {"stringUnit":{"state":"translated","value":"Un démarrage plus rapide et des rappels de mise à niveau plus discrets"}},
        "it": {"stringUnit":{"state":"translated","value":"Un avvio più rapido e promemoria di upgrade più discreti"}},
        "ja": {"stringUnit":{"state":"translated","value":"よりすばやい開始と、控えめなアップグレード案内"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 빠른 시작과 부담을 줄인 업그레이드 안내"}},
        "nl": {"stringUnit":{"state":"translated","value":"Sneller beginnen en minder opdringerige upgradeherinneringen"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Um início mais rápido e lembretes de upgrade mais discretos"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更快上手，更温和的升级提醒"}}
      }
    },
    "Accurate export reminders" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Korrekte Exporterinnerungen"}},
        "es": {"stringUnit":{"state":"translated","value":"Recordatorios de exportación precisos"}},
        "fr": {"stringUnit":{"state":"translated","value":"Rappels d’export précis"}},
        "it": {"stringUnit":{"state":"translated","value":"Promemoria di esportazione accurati"}},
        "ja": {"stringUnit":{"state":"translated","value":"正確なエクスポートリマインダー"}},
        "ko": {"stringUnit":{"state":"translated","value":"정확한 내보내기 미리 알림"}},
        "nl": {"stringUnit":{"state":"translated","value":"Nauwkeurige exportherinneringen"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Lembretes de exportação precisos"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"准确的导出提醒"}}
