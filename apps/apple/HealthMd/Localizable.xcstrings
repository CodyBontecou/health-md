    "Use {YR} for years such as 26 in export filenames, folder templates, and Daily Note Injection." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Verwende {YR} für Jahreszahlen wie 26 in Exportdateinamen, Ordnervorlagen und beim Einfügen in tägliche Notizen."}},
        "es": {"stringUnit":{"state":"translated","value":"Usa {YR} para años como 26 en nombres de archivos de exportación, plantillas de carpetas e Inyección en nota diaria."}},
        "fr": {"stringUnit":{"state":"translated","value":"Utilisez {YR} pour les années telles que 26 dans les noms de fichiers d’exportation, les modèles de dossiers et l’injection dans les notes quotidiennes."}},
        "it": {"stringUnit":{"state":"translated","value":"Usa {YR} per anni come 26 nei nomi dei file di esportazione, nei modelli delle cartelle e in Inserimento nella nota giornaliera."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートのファイル名、フォルダテンプレート、デイリーノートへの挿入で、年を26のような2桁で表すには{YR}を使用してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기 파일 이름, 폴더 템플릿 및 일일 노트 주입에서 26과 같은 연도를 표시하려면 {YR}를 사용하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Gebruik {YR} voor jaartallen zoals 26 in exportbestandsnamen, mapsjablonen en Dagelijkse notitie-injectie."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Use {YR} para anos como 26 em nomes de arquivos de exportação, modelos de pasta e na Injeção em Nota Diária."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在导出文件名、文件夹模板和每日笔记注入中，使用 {YR} 表示 26 这样的两位数年份。"}}
      }
    },
