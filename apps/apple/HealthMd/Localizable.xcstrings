    "Try a category like Sleep or a metric like Steps." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Versuche eine Kategorie wie Schlaf oder eine Metrik wie Schritte."}},
        "es" : {"stringUnit":{"state":"translated","value":"Prueba una categoría como Sueño o una métrica como Pasos."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Essayez une catégorie comme Sommeil ou une mesure comme Pas."}},
        "it" : {"stringUnit":{"state":"translated","value":"Prova una categoria come Sonno o una metrica come Passi."}},
        "ja" : {"stringUnit":{"state":"translated","value":"睡眠などのカテゴリや歩数などの指標で検索してください。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"수면 같은 카테고리나 걸음 수 같은 지표로 검색해 보세요."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Probeer een categorie zoals Slaap of een meting zoals Stappen."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Tente uma categoria como Sono ou uma métrica como Passos."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"请尝试搜索“睡眠”等类别或“步数”等指标。"}}
      }
    },
    "Try Again" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erneut versuchen"}},
        "es": {"stringUnit":{"state":"translated","value":"Intentar de nuevo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Réessayer"}},
        "it": {"stringUnit":{"state":"translated","value":"Riprova"}},
        "ja": {"stringUnit":{"state":"translated","value":"もう一度試す"}},
        "ko": {"stringUnit":{"state":"translated","value":"다시 시도"}},
        "nl": {"stringUnit":{"state":"translated","value":"Opnieuw proberen"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Tentar novamente"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"再试一次"}},
        "en": {"stringUnit":{"state":"translated","value":"Try Again"}}
      }
    },
    "Try All Time or another date range. You can also open Apple Health and review Health.md under Profile → Apps and Services. If the device has no matching records, there is nothing to export yet." : {
      "comment" : "Recovery: no health data",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie „Gesamter Zeitraum“ oder wählen Sie einen anderen Datumsbereich. Sie können auch Apple Health öffnen und Health.md unter Profil → Apps und Dienste überprüfen. Wenn auf dem Gerät keine passenden Einträge vorhanden sind, gibt es derzeit nichts zu exportieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try All Time or another date range. You can also open Apple Health and review Health.md under Profile → Apps and Services. If the device has no matching records, there is nothing to export yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruebe «Todo el historial» u otro intervalo de fechas. También puede abrir Apple Health y revisar Health.md en Perfil → Apps y servicios. Si el dispositivo no tiene registros coincidentes, todavía no hay nada que exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez « Depuis toujours » ou une autre plage de dates. Vous pouvez également ouvrir Apple Health et consulter Health.md sous Profil → Apps et services. Si l’appareil ne contient aucun enregistrement correspondant, il n’y a encore rien à exporter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova Tutto o un altro intervallo di date. Puoi anche aprire Apple Health e rivedere Health.md in Profilo → App e servizi. Se il dispositivo non ha record corrispondenti, non c'è ancora nulla da esportare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[すべての期間] または別の日付範囲を試してください。 Apple Health を開いて、[プロフィール] → [アプリとサービス] で Health.md を確認することもできます。デバイスに一致するレコードがない場合、エクスポートするものはまだありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 기간 또는 다른 기간을 사용해 보세요. 프로필 → 앱 및 서비스에서 Apple Health를 열고 Health.md를 검토할 수도 있습니다. 장치에 일치하는 기록이 없으면 아직 내보낼 항목이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer ‘Alle tijd’ of een ander datumbereik. U kunt ook Apple Health openen en Health.md bekijken onder Profiel → Apps en services. Als het apparaat geen overeenkomende records bevat, valt er nog niets te exporteren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente “Todo o Período” ou outro intervalo de datas. Você também pode abrir o Apple Health e revisar o Health.md em Perfil → Apps e Serviços. Se o dispositivo não tiver registros correspondentes, ainda não há nada para exportar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试“所有时间”或其他日期范围。您还可以打开 Apple Health 并在“个人资料”→“应用程序和服务”下查看 Health.md。如果设备没有匹配的记录，则还没有任何可导出的内容。"
          }
        }
      }
    },
    "Try loading purchase options again" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Kaufoptionen erneut laden"}},
        "es": {"stringUnit":{"state":"translated","value":"Volver a cargar las opciones de compra"}},
        "fr": {"stringUnit":{"state":"translated","value":"Réessayer de charger les options d’achat"}},
        "it": {"stringUnit":{"state":"translated","value":"Riprova a caricare le opzioni di acquisto"}},
        "ja": {"stringUnit":{"state":"translated","value":"購入オプションを再読み込み"}},
        "ko": {"stringUnit":{"state":"translated","value":"구매 옵션 다시 불러오기"}},
