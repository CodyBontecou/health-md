    "Set the Obsidian or Files subfolder Health.md writes into." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lege den Unterordner in Obsidian oder Dateien fest, in den Health.md schreibt."}},
        "es": {"stringUnit":{"state":"translated","value":"Define la subcarpeta de Obsidian o Archivos en la que escribe Health.md."}},
        "fr": {"stringUnit":{"state":"translated","value":"Définissez le sous-dossier dans Obsidian ou Fichiers où Health.md écrit les exports."}},
        "it": {"stringUnit":{"state":"translated","value":"Imposta la sottocartella di Obsidian o File in cui Health.md scrive."}},
