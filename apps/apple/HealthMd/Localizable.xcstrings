    "Skip aggregate exports, ZIPs, roll-ups, individual entries, provider sidecars, and the data dictionary. Your other settings are preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt aggregierte Exporte, ZIPs, Zeitraum-Zusammenfassungen, individuelle Einträge, Anbieter-Begleitdateien und das Datenwörterbuch. Ihre übrigen Einstellungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite exportaciones agregadas, ZIP, resúmenes, entradas individuales, archivos auxiliares de proveedores y el diccionario de datos. Se conservan los demás ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorez les exportations agrégées, les fichiers ZIP, les récapitulatifs, les entrées individuelles, les fichiers annexes des fournisseurs et le dictionnaire de données. Vos autres réglages sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora esportazioni aggregate, file ZIP, riepiloghi, voci singole, file accessori dei provider e il dizionario dei dati. Le altre impostazioni vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集計エクスポート、ZIP、ロールアップ、個別エントリ、プロバイダのサイドカーファイル、データ辞書をスキップします。その他の設定は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집계 내보내기, ZIP, 롤업, 개별 항목, 제공자 보조 파일 및 데이터 사전을 건너뜁니다. 다른 설정은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat geaggregeerde exports, ZIPs, periodeoverzichten, individuele vermeldingen, begeleidende providerbestanden en het gegevenswoordenboek over. Je andere instellingen blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore exportações agregadas, arquivos ZIP, resumos consolidados, entradas individuais, arquivos auxiliares de provedores e o dicionário de dados. Suas outras configurações serão preservadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过聚合导出、ZIP 文件、汇总文件、单独条目、提供方辅助文件和数据字典。其他设置会保留。"
          }
        }
      }
    },
    "Skip all additional generated files while preserving their settings." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Alle zusätzlich generierten Dateien überspringen und deren Einstellungen beibehalten."}},
        "es": {"stringUnit":{"state":"translated","value":"Omitir todos los archivos adicionales generados sin perder sus ajustes."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ne générer aucun fichier supplémentaire tout en conservant leurs paramètres."}},
        "it": {"stringUnit":{"state":"translated","value":"Salta tutti i file aggiuntivi generati, mantenendone le impostazioni."}},
        "ja": {"stringUnit":{"state":"translated","value":"設定を保持したまま、追加ファイルの生成をすべてスキップします。"}},
        "ko": {"stringUnit":{"state":"translated","value":"설정을 유지하면서 추가 파일 생성을 모두 건너뜁니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Sla alle extra gegenereerde bestanden over en behoud hun instellingen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Ignorar todos os arquivos adicionais gerados, preservando suas configurações."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"跳过所有额外生成的文件，同时保留其设置。"}}
      }
    },
