          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas opções afetam os valores exibidos nos arquivos exportados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些选项会影响导出文件中显示的值。"
          }
        }
      }
    },
