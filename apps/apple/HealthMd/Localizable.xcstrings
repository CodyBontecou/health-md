        "pt-BR": {"stringUnit":{"state":"translated","value":"Tentar carregar as opções de compra novamente"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"重试加载购买选项"}},
        "en": {"stringUnit":{"state":"translated","value":"Try loading purchase options again"}}
