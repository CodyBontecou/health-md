    "Note: %lld export notes, including %@" : {
      "comment" : "Informational export notes summary prefix; the notes did not reduce the export below full success",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: %1$lld Exportnotizen, einschließlich %2$@"
          }
        },
        "en" : {
