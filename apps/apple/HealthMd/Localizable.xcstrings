    "Point the camera at the QR shown by healthmd. A valid private-network code starts pairing immediately." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Richte die Kamera auf den von healthmd angezeigten QR-Code. Ein gültiger Code für ein privates Netzwerk startet die Kopplung sofort."}},
        "es": {"stringUnit":{"state":"translated","value":"Apunta la cámara al QR que muestra healthmd. Un código válido de red privada inicia el enlace de inmediato."}},
        "fr": {"stringUnit":{"state":"translated","value":"Pointez l’appareil photo vers le code QR affiché par healthmd. Un code de réseau privé valide lance immédiatement le jumelage."}},
        "it": {"stringUnit":{"state":"translated","value":"Punta la fotocamera sul codice QR mostrato da healthmd. Un codice valido per la rete privata avvia subito l'abbinamento."}},
        "ja": {"stringUnit":{"state":"translated","value":"healthmd に表示された QR コードにカメラを向けてください。有効なプライベートネットワーク用コードを読み取ると、すぐにペアリングが始まります。"}},
        "ko": {"stringUnit":{"state":"translated","value":"healthmd에 표시된 QR 코드에 카메라를 맞추세요. 유효한 사설 네트워크 코드가 인식되면 즉시 페어링이 시작됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Richt de camera op de QR-code die healthmd toont. Een geldige code voor een privénetwerk start het koppelen direct."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Aponte a câmera para o QR exibido pelo healthmd. Um código válido de rede privada inicia o emparelhamento imediatamente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"将相机对准 healthmd 显示的二维码。有效的专用网络二维码会立即开始配对。"}}
      }
    },
