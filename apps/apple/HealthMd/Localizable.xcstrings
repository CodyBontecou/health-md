          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vollständige Export verarbeitet täglich %1$lld aggregierte Snapshots"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
