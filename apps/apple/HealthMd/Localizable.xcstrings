    "On your Mac, open Mac Destination, enable Manual IP Connections, and generate a pairing code.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Mac, abre Destino Mac, habilita las conexiones IP manuales y genera un código de emparejamiento."
          }
        },
        "de": {
          "stringUnit": {
