    "Daily Notes Disabled" : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Tägliche Notizen deaktiviert"}},
        "es" : {"stringUnit":{"state":"translated","value":"Notas diarias desactivadas"}},
        "fr" : {"stringUnit":{"state":"translated","value":"Notes quotidiennes désactivées"}},
