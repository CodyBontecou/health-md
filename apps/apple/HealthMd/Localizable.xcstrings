        }
      }
    },
    "Updated %lld and skipped %lld daily note(s); no export files were created.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated %1$lld and skipped %2$lld daily note(s); no export files were created."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld aktualisiert und tägliche Notiz(en) %2$lld übersprungen; Es wurden keine Exportdateien erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
