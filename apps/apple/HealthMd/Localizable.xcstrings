    "Keep both devices nearby on the same network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ambos dispositivos cerca y en la misma red."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie beide Geräte in der Nähe und im selben Netzwerk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les deux appareils à proximité et sur le même réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni entrambi i dispositivi vicini e sulla stessa rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスを近くに置き、同じネットワークに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 기기를 가까이 두고 같은 네트워크에 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd beide apparaten dicht bij elkaar en op hetzelfde netwerk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os dois dispositivos próximos e na mesma rede."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让两台设备保持在附近并连接同一网络。"
          }
        }
      }
    },
    "Keep your Health.md destinations updated with recurring Apple Health exports.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tus destinos de Health.md actualizados con exportaciones periódicas de Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Health.md-Exportziele mit wiederkehrenden Apple Health-Exporten auf dem neuesten Stand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos destinations Health.md à jour grâce à des exportations Apple Health récurrentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni aggiornate le destinazioni di Health.md con esportazioni ricorrenti da Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的なApple Healthのエクスポートで、Health.mdのエクスポート先を最新の状態に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기적인 Apple Health 내보내기로 Health.md의 내보내기 대상을 최신 상태로 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je Health.md-bestemmingen actueel met terugkerende Apple Health-exports."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os destinos do Health.md atualizados com exportações recorrentes do Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过定期导出 Apple Health 数据，让 Health.md 的目标位置保持最新。"
          }
        }
      }
    },
