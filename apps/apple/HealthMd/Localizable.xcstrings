    },
    "Turn on Daily Note Injection to merge selected metrics into the daily notes you already keep in Obsidian." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Aktiviere die tägliche Notizeinfügung, um ausgewählte Metriken in deine vorhandenen täglichen Notizen in Obsidian einzufügen."}},
        "es" : {"stringUnit":{"state":"translated","value":"Activa la inyección en notas diarias para combinar las métricas seleccionadas con tus notas diarias existentes en Obsidian."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Activez l’injection dans les notes quotidiennes pour intégrer les mesures sélectionnées à vos notes quotidiennes existantes dans Obsidian."}},
        "it" : {"stringUnit":{"state":"translated","value":"Attiva l’iniezione nelle note giornaliere per unire le metriche selezionate alle note giornaliere già presenti in Obsidian."}},
        "ja" : {"stringUnit":{"state":"translated","value":"デイリーノート注入を有効にすると、Obsidianの既存のデイリーノートに選択した指標を統合できます。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"일일 노트 주입을 켜서 선택한 항목을 Obsidian에 보관 중인 기존 일일 노트에 병합하세요."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Schakel dagelijkse notitie-injectie in om geselecteerde meetwaarden samen te voegen met je bestaande dagelijkse notities in Obsidian."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Ative a Injeção em Nota Diária para incorporar as métricas selecionadas às notas diárias que você já mantém no Obsidian."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"启用每日笔记注入，将所选指标合并到 Obsidian 中已有的每日笔记。"}}
      }
    },
    "Vault Root Location" : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Stammverzeichnis des Vaults"}},
        "es" : {"stringUnit":{"state":"translated","value":"Ubicación raíz de la bóveda"}},
        "fr" : {"stringUnit":{"state":"translated","value":"Emplacement racine du coffre"}},
        "it" : {"stringUnit":{"state":"translated","value":"Posizione radice del vault"}},
        "ja" : {"stringUnit":{"state":"translated","value":"保管庫のルート位置"}},
        "ko" : {"stringUnit":{"state":"translated","value":"보관함 루트 위치"}},
        "nl" : {"stringUnit":{"state":"translated","value":"Hoofdmap van de kluis"}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Local da raiz do cofre"}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"仓库根目录位置"}}
      }
    },
    "With Folder set to Daily, notes are written to Daily/… at the vault root, not %@/Daily/…." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Wenn der Ordner auf Daily gesetzt ist, werden Notizen unter Daily/… im Stammverzeichnis des Vaults geschrieben, nicht unter %@/Daily/…."}},
        "es" : {"stringUnit":{"state":"translated","value":"Con la carpeta establecida en Daily, las notas se escriben en Daily/… en la raíz de la bóveda, no en %@/Daily/…."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Si le dossier est défini sur Daily, les notes sont écrites dans Daily/… à la racine du coffre, et non dans %@/Daily/…."}},
        "it" : {"stringUnit":{"state":"translated","value":"Con la cartella impostata su Daily, le note vengono scritte in Daily/… alla radice del vault, non in %@/Daily/…."}},
        "ja" : {"stringUnit":{"state":"translated","value":"フォルダをDailyに設定すると、ノートは保管庫のルートのDaily/…に書き込まれます。%@/Daily/…ではありません。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"폴더를 Daily로 설정하면 노트는 보관함 루트의 Daily/…에 기록되며, %@/Daily/…에는 기록되지 않습니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Als de map op Daily staat, worden notities geschreven naar Daily/… in de hoofdmap van de kluis, niet naar %@/Daily/…."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Com a pasta definida como Daily, as notas são gravadas em Daily/… na raiz do cofre, não em %@/Daily/…."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"将文件夹设为 Daily 时，笔记会写入仓库根目录下的 Daily/…，而不是 %@/Daily/…。"}}
      }
    },
    "Enter a vault-relative path, such as Daily or Journal slash Daily. Leave empty for the vault root." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Gib einen Pfad relativ zum Vault ein, etwa Daily oder Journal Schrägstrich Daily. Lass das Feld für das Stammverzeichnis leer."}},
        "es" : {"stringUnit":{"state":"translated","value":"Introduce una ruta relativa a la bóveda, como Daily o Journal barra Daily. Déjala vacía para usar la raíz de la bóveda."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Saisissez un chemin relatif au coffre, comme Daily ou Journal barre oblique Daily. Laissez vide pour la racine du coffre."}},
        "it" : {"stringUnit":{"state":"translated","value":"Inserisci un percorso relativo al vault, come Daily o Journal barra Daily. Lascia vuoto per la radice del vault."}},
        "ja" : {"stringUnit":{"state":"translated","value":"DailyやJournalスラッシュDailyなど、保管庫からの相対パスを入力します。保管庫のルートを使う場合は空欄にします。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"Daily 또는 Journal 슬래시 Daily처럼 보관함을 기준으로 하는 상대 경로를 입력하세요. 보관함 루트를 사용하려면 비워 두세요."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Voer een pad relatief aan de kluis in, zoals Daily of Journal schuine streep Daily. Laat leeg voor de hoofdmap van de kluis."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Digite um caminho relativo ao cofre, como Daily ou Journal barra Daily. Deixe vazio para usar a raiz do cofre."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"输入相对于仓库的路径，例如 Daily 或 Journal 斜杠 Daily。留空表示仓库根目录。"}}
      }
    },
    "Enter the filename pattern without an extension." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Gib das Dateinamenmuster ohne Dateiendung ein."}},
        "es" : {"stringUnit":{"state":"translated","value":"Introduce el patrón del nombre de archivo sin extensión."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Saisissez le modèle de nom de fichier sans extension."}},
        "it" : {"stringUnit":{"state":"translated","value":"Inserisci il modello del nome file senza estensione."}},
        "ja" : {"stringUnit":{"state":"translated","value":"拡張子を付けずにファイル名のパターンを入力します。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"확장자 없이 파일 이름 패턴을 입력하세요."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Voer het bestandsnaampatroon zonder extensie in."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Digite o padrão do nome do arquivo sem extensão."}},
