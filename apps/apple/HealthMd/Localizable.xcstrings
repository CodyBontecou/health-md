    "Inactive while Daily Notes Only is on" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Inaktiv, solange „Nur tägliche Notizen“ aktiviert ist"}},
        "es": {"stringUnit":{"state":"translated","value":"Inactivo mientras esté activado Solo notas diarias"}},
        "fr": {"stringUnit":{"state":"translated","value":"Inactif lorsque le mode Notes quotidiennes uniquement est activé"}},
        "it": {"stringUnit":{"state":"translated","value":"Inattivo quando Solo note giornaliere è attivato"}},
        "ja": {"stringUnit":{"state":"translated","value":"「デイリーノートのみ」がオンの間は無効"}},
        "ko": {"stringUnit":{"state":"translated","value":"일일 노트만 사용이 켜져 있는 동안 비활성"}},
        "nl": {"stringUnit":{"state":"translated","value":"Inactief zolang Alleen dagelijkse notities is ingeschakeld"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Inativo enquanto Somente Notas Diárias estiver ativado"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"开启“仅每日笔记”时不生效"}}
      }
    },
    "Inactive while Daily Notes Only is on. Your individual-entry settings are preserved." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktiv, solange Nur Tagesnotizen aktiviert ist. Ihre Einstellungen für einzelne Einträge bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive while Daily Notes Only is on. Your individual-entry settings are preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactivo mientras esté activado Solo notas diarias. Se conservan sus configuraciones de entrada individual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactif lorsque Notes quotidiennes uniquement est activé. Vos paramètres de saisie individuelle sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inattivo mentre è attivo Solo note giornaliere. Le tue impostazioni di immissione individuale vengono conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デイリーノートのみ」がオンになっている間は無効です。個別エントリの設定は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘일일 노트만’이 켜져 있는 동안에는 비활성화됩니다. 개별 항목 설정은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactief terwijl Alleen dagelijkse notities is ingeschakeld. Uw instellingen voor individuele invoer blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inativo enquanto Somente Notas Diárias estiver ativado. Suas configurações de entrada individual são preservadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当“仅每日笔记”打开时处于非活动状态。您的个人条目设置将被保留。"
          }
        }
      }
    },
