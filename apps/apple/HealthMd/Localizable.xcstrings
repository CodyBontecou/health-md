    "Choose DD.MM.YYYY in Format Customization. Your choice is saved and included in shared setups." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wählen Sie DD.MM.YYYY unter Formatanpassung. Ihre Auswahl wird gespeichert und in geteilte Konfigurationen aufgenommen."}},
        "es": {"stringUnit":{"state":"translated","value":"Elige DD.MM.YYYY en Personalización del formato. Tu elección se guarda y se incluye en las configuraciones compartidas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Choisissez DD.MM.YYYY dans Personnalisation du format. Votre choix est enregistré et inclus dans les configurations partagées."}},
        "it": {"stringUnit":{"state":"translated","value":"Scegli DD.MM.YYYY in Personalizzazione formato. La scelta viene salvata e inclusa nelle configurazioni condivise."}},
        "ja": {"stringUnit":{"state":"translated","value":"「形式のカスタマイズ」でDD.MM.YYYYを選択できます。選択内容は保存され、共有設定にも含まれます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"형식 사용자화에서 DD.MM.YYYY를 선택하세요. 선택 사항은 저장되며 공유 설정에도 포함됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Kies DD.MM.YYYY bij Opmaak aanpassen. Je keuze wordt opgeslagen en opgenomen in gedeelde instellingen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha DD.MM.YYYY em Personalização de formato. Sua escolha é salva e incluída nas configurações compartilhadas."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在“格式自定义”中选择DD.MM.YYYY。您的选择会被保存，并包含在共享设置中。"}}
      }
    },
    "Clearer sleep dates" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Klarere Schlafdaten"}},
        "es": {"stringUnit":{"state":"translated","value":"Fechas de sueño más claras"}},
        "fr": {"stringUnit":{"state":"translated","value":"Des dates de sommeil plus claires"}},
        "it": {"stringUnit":{"state":"translated","value":"Date del sonno più chiare"}},
