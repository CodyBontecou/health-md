    "Not Now" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Nicht jetzt"}},
        "es": {"stringUnit":{"state":"translated","value":"Ahora no"}},
        "fr": {"stringUnit":{"state":"translated","value":"Pas maintenant"}},
        "it": {"stringUnit":{"state":"translated","value":"Non ora"}},
        "ja": {"stringUnit":{"state":"translated","value":"今はしない"}},
        "ko": {"stringUnit":{"state":"translated","value":"나중에"}},
        "nl": {"stringUnit":{"state":"translated","value":"Niet nu"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Agora não"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"暂不"}}
      }
    },
    "Not bound. Refresh shortcuts require a separate authenticated Mac binding." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Nicht gebunden. Aktualisierungskurzbefehle erfordern eine separate Bindung an einen authentifizierten Mac."}},
        "es": {"stringUnit":{"state":"translated","value":"Sin vincular. Los atajos de actualización requieren una vinculación independiente con un Mac autenticado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Aucune association. Les raccourcis d’actualisation nécessitent une association distincte avec un Mac authentifié."}},
        "it": {"stringUnit":{"state":"translated","value":"Non associato. I comandi rapidi di aggiornamento richiedono un’associazione separata con un Mac autenticato."}},
        "ja": {"stringUnit":{"state":"translated","value":"紐付けされていません。更新ショートカットには、認証済みMacとの別途の紐付けが必要です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"연결되지 않았습니다. 새로 고침 단축어에는 인증된 Mac과의 별도 연결이 필요합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Niet gekoppeld. Verversopdrachten vereisen een afzonderlijke koppeling met een geauthenticeerde Mac."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Sem vínculo. Os atalhos de atualização exigem um vínculo separado com um Mac autenticado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"未绑定。刷新快捷指令需要单独绑定一台已认证的 Mac。"}}
      }
    },
    "Nothing blocks setup anymore. After your first real export preview, a single optional screen explains unlimited exports — dismiss it and keep going with your 10 free exports." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Nichts blockiert mehr die Einrichtung. Nach deiner ersten echten Exportvorschau erklärt ein einzelner optionaler Bildschirm unbegrenzte Exporte – schließe ihn und nutze deine 10 kostenlosen Exporte weiter."}},
        "es": {"stringUnit":{"state":"translated","value":"Ya nada bloquea la configuración. Tras la vista previa de tu primera exportación real, una única pantalla opcional explica las exportaciones ilimitadas; ciérrala y continúa con tus 10 exportaciones gratuitas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Plus rien ne bloque la configuration. Après l’aperçu de votre premier export réel, un seul écran facultatif présente les exports illimités : fermez-le et continuez avec vos 10 exports gratuits."}},
        "it": {"stringUnit":{"state":"translated","value":"Ora nulla blocca la configurazione. Dopo la prima anteprima di un’esportazione reale, una sola schermata facoltativa spiega le esportazioni illimitate: chiudila e prosegui con le tue 10 esportazioni gratuite."}},
        "ja": {"stringUnit":{"state":"translated","value":"設定を妨げる画面はなくなりました。初回の実データのエクスポートプレビュー後に、任意の画面1つで無制限エクスポートをご案内します。閉じて、無料エクスポート10回分を引き続き利用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 설정을 가로막는 요소가 없습니다. 첫 실제 내보내기를 미리 본 후, 건너뛸 수 있는 화면 하나에서 무제한 내보내기를 안내합니다. 화면을 닫고 무료 내보내기 10회로 계속 이용하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Niets houdt het instellen nog tegen. Na de voorvertoning van je eerste echte export legt één optioneel scherm onbeperkt exporteren uit. Sluit het en ga verder met je 10 gratis exports."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Nada mais bloqueia a configuração. Após a primeira prévia de uma exportação real, uma única tela opcional explica as exportações ilimitadas — feche-a e continue com suas 10 exportações gratuitas."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"设置流程不再受到阻碍。首次预览真实导出后，会出现一个可选页面，介绍无限次导出；关闭后即可继续使用您的 10 次免费导出。"}}
      }
    },
    "Notification recovery" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wiederherstellung von Mitteilungen"}},
        "es": {"stringUnit":{"state":"translated","value":"Recuperación de notificaciones"}},
        "fr": {"stringUnit":{"state":"translated","value":"Rétablissement des notifications"}},
        "it": {"stringUnit":{"state":"translated","value":"Ripristino delle notifiche"}},
        "ja": {"stringUnit":{"state":"translated","value":"通知の復旧"}},
        "ko": {"stringUnit":{"state":"translated","value":"알림 복구"}},
        "nl": {"stringUnit":{"state":"translated","value":"Meldingsherstel"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Recuperação de notificações"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"通知恢复"}}
      }
    },
    "On iPhone and iPad, Apple Ads campaign identifiers help measure which campaigns lead to purchases. Health data and purchase events are never sent to Apple Ads." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Auf iPhone und iPad helfen Kampagnenkennungen von Apple Ads zu ermitteln, welche Kampagnen zu Käufen führen. Gesundheitsdaten und Kaufereignisse werden niemals an Apple Ads gesendet."}},
        "es": {"stringUnit":{"state":"translated","value":"En iPhone y iPad, los identificadores de campaña de Apple Ads ayudan a medir qué campañas generan compras. Nunca se envían datos de salud ni eventos de compra a Apple Ads."}},
        "fr": {"stringUnit":{"state":"translated","value":"Sur iPhone et iPad, les identifiants de campagne Apple Ads aident à mesurer quelles campagnes génèrent des achats. Les données de santé et les événements d’achat ne sont jamais envoyés à Apple Ads."}},
        "it": {"stringUnit":{"state":"translated","value":"Su iPhone e iPad, gli identificatori delle campagne Apple Ads aiutano a misurare quali campagne generano acquisti. I dati sanitari e gli eventi di acquisto non vengono mai inviati ad Apple Ads."}},
        "ja": {"stringUnit":{"state":"translated","value":"iPhoneとiPadでは、Apple Adsのキャンペーン識別子を使って、どのキャンペーンが購入につながったかを測定します。健康データや購入イベントをApple Adsに送信することはありません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"iPhone 및 iPad에서는 Apple Ads 캠페인 식별자를 사용해 어떤 캠페인이 구매로 이어지는지 측정합니다. 건강 데이터와 구매 이벤트는 Apple Ads로 절대 전송되지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Op iPhone en iPad helpen campagne-ID’s van Apple Ads te meten welke campagnes tot aankopen leiden. Gezondheidsgegevens en aankoopgebeurtenissen worden nooit naar Apple Ads verstuurd."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"No iPhone e no iPad, os identificadores de campanha do Apple Ads ajudam a medir quais campanhas geram compras. Dados de saúde e eventos de compra nunca são enviados ao Apple Ads."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在 iPhone 和 iPad 上，Apple Ads 广告系列标识符用于衡量哪些广告系列促成了购买。健康数据和购买事件绝不会发送至 Apple Ads。"}}
      }
    },
    "Onboarding is now five quick steps. The Obsidian plugin intro moved onto the sample-export screen, and importing a shared setup stays available as a quiet link on the first screen." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Die Einführung besteht jetzt aus fünf kurzen Schritten. Die Vorstellung des Obsidian-Plugins wurde auf den Bildschirm für den Beispielexport verschoben. Der Import einer geteilten Konfiguration bleibt als dezenter Link auf dem ersten Bildschirm verfügbar."}},
        "es": {"stringUnit":{"state":"translated","value":"La configuración inicial ahora consta de cinco pasos rápidos. La introducción al complemento de Obsidian se ha trasladado a la pantalla de exportación de muestra, y la importación de una configuración compartida sigue disponible mediante un enlace discreto en la primera pantalla."}},
        "fr": {"stringUnit":{"state":"translated","value":"La prise en main compte désormais cinq étapes rapides. La présentation du plugin Obsidian a été déplacée vers l’écran d’export d’exemple, et l’importation d’une configuration partagée reste accessible via un lien discret sur le premier écran."}},
        "it": {"stringUnit":{"state":"translated","value":"La configurazione iniziale ora richiede cinque rapidi passaggi. La presentazione del plugin Obsidian è stata spostata nella schermata dell’esportazione di esempio; l’importazione di una configurazione condivisa resta disponibile tramite un link discreto nella prima schermata."}},
        "ja": {"stringUnit":{"state":"translated","value":"初期設定が5つの簡単なステップになりました。Obsidianプラグインの紹介をサンプルエクスポート画面に移動しました。共有された設定の読み込みは、引き続き最初の画面の控えめなリンクから利用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 시작 설정이 간단한 5단계로 진행됩니다. Obsidian 플러그인 소개는 샘플 내보내기 화면으로 이동했으며, 공유된 설정 가져오기는 첫 화면의 간결한 링크로 계속 이용할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De introductie bestaat nu uit vijf snelle stappen. De uitleg over de Obsidian-plugin staat nu op het scherm met de voorbeeldexport. Een gedeelde configuratie importeren kan nog steeds via een subtiele link op het eerste scherm."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A configuração inicial agora tem cinco etapas rápidas. A apresentação do plugin do Obsidian foi movida para a tela de exportação de exemplo, e a importação de uma configuração compartilhada continua disponível em um link discreto na primeira tela."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"初始设置现只需五个简短步骤。Obsidian 插件介绍已移至示例导出页面，首屏仍保留了一个不显眼的链接，用于导入共享设置。"}}
      }
    },
    "One purchase. No subscription. Your exported files stay yours." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ein Kauf. Kein Abo. Deine exportierten Dateien bleiben deine."}},
        "es": {"stringUnit":{"state":"translated","value":"Una sola compra. Sin suscripción. Tus archivos exportados siguen siendo tuyos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Un seul achat. Aucun abonnement. Vos fichiers exportés restent à vous."}},
        "it": {"stringUnit":{"state":"translated","value":"Un solo acquisto. Nessun abbonamento. I file esportati restano tuoi."}},
        "ja": {"stringUnit":{"state":"translated","value":"買い切りです。サブスクリプションはありません。エクスポートしたファイルはずっとあなたのものです。"}},
        "ko": {"stringUnit":{"state":"translated","value":"한 번만 구매하세요. 구독은 없습니다. 내보낸 파일은 계속 본인 소유입니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Eén aankoop. Geen abonnement. Je geëxporteerde bestanden blijven van jou."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Uma única compra. Sem assinatura. Seus arquivos exportados continuam sendo seus."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"一次购买，无需订阅。导出的文件始终归您所有。"}}
      }
    },
    "Only send Apple Health data to gateways you control or trust. Gateway uploads use your selected metrics and Data Detail setting, and always include the JSON daily export." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Sende Apple Health-Daten nur an Gateways, die du kontrollierst oder denen du vertraust. Gateway-Uploads verwenden deine ausgewählten Messwerte und die Einstellung für Datendetails und enthalten immer den täglichen JSON-Export."}},
        "es": {"stringUnit":{"state":"translated","value":"Envía datos de Apple Health solo a pasarelas que controles o en las que confíes. Las subidas a pasarelas usan las métricas y el ajuste de detalle de datos que hayas seleccionado, y siempre incluyen la exportación diaria en JSON."}},
        "fr": {"stringUnit":{"state":"translated","value":"N’envoyez des données Apple Health qu’aux passerelles que vous contrôlez ou auxquelles vous faites confiance. Les envois vers les passerelles utilisent les mesures sélectionnées et votre réglage de détail des données, et incluent toujours l’export quotidien JSON."}},
        "it": {"stringUnit":{"state":"translated","value":"Invia i dati di Apple Health solo a gateway che controlli o di cui ti fidi. I caricamenti sui gateway usano le metriche selezionate e l’impostazione Dettaglio dati e includono sempre l’esportazione giornaliera JSON."}},
        "ja": {"stringUnit":{"state":"translated","value":"Apple Healthのデータは、ご自身で管理しているか、信頼できるゲートウェイにのみ送信してください。ゲートウェイへのアップロードには、選択した指標とデータ詳細設定が使用され、日次JSONエクスポートが必ず含まれます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"직접 관리하거나 신뢰하는 게이트웨이로만 Apple Health 데이터를 전송하세요. 게이트웨이 업로드에는 선택한 지표와 데이터 상세 수준 설정이 적용되며, JSON 일별 내보내기가 항상 포함됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Stuur Apple Health-gegevens alleen naar gateways die je beheert of vertrouwt. Gateway-uploads gebruiken je geselecteerde meetgegevens en instelling voor gegevensdetail en bevatten altijd de dagelijkse JSON-export."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Envie dados do Apple Health apenas para gateways que você controla ou nos quais confia. Os envios ao gateway usam as métricas selecionadas e a configuração de Detalhamento dos dados, e sempre incluem a exportação diária em JSON."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请仅将 Apple Health 数据发送到您控制或信任的网关。网关上传使用您选择的指标和“数据详细程度”设置，并始终包含 JSON 每日导出。"}}
      }
    },
