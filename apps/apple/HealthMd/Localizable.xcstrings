    "Run a manual export or turn on automation to start building history." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Führe einen manuellen Export aus oder aktiviere die Automatisierung, um einen Verlauf aufzubauen."}},
        "es": {"stringUnit":{"state":"translated","value":"Ejecuta una exportación manual o activa la automatización para empezar a crear un historial."}},
        "fr": {"stringUnit":{"state":"translated","value":"Lancez une exportation manuelle ou activez l’automatisation pour commencer à constituer l’historique."}},
        "it": {"stringUnit":{"state":"translated","value":"Esegui un’esportazione manuale o attiva l’automazione per iniziare a creare una cronologia."}},
        "ja": {"stringUnit":{"state":"translated","value":"手動でエクスポートするか、自動化を有効にすると、履歴の記録が始まります。"}},
        "ko": {"stringUnit":{"state":"translated","value":"수동으로 내보내거나 자동화를 켜서 이력을 쌓아 보세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Voer handmatig een export uit of schakel automatisering in om een geschiedenis op te bouwen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Execute uma exportação manual ou ative a automação para começar a criar um histórico."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"手动导出一次或开启自动化，即可开始积累历史记录。"}}
      }
    },
    "Run an export to see status, dates, and file counts here." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Führe einen Export aus, um hier Status, Tage und Dateianzahl zu sehen."}},
        "es": {"stringUnit":{"state":"translated","value":"Ejecuta una exportación para ver aquí el estado, las fechas y la cantidad de archivos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Lancez une exportation pour afficher ici son état, ses dates et le nombre de fichiers."}},
        "it": {"stringUnit":{"state":"translated","value":"Esegui un’esportazione per visualizzare qui stato, date e numero di file."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートを実行すると、ここにステータス、日付、ファイル数が表示されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기를 실행하면 여기에 상태, 날짜, 파일 수가 표시됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Voer een export uit om hier de status, datums en aantallen bestanden te zien."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Execute uma exportação para ver o status, as datas e a quantidade de arquivos aqui."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"执行一次导出，即可在此查看状态、日期和文件数量。"}}
      }
    },
    "Run exports every few days, weeks, or months from a start date, including routines such as every other day or monthly." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Führe Exporte ab einem Startdatum alle paar Tage, Wochen oder Monate aus, etwa jeden zweiten Tag oder monatlich."}},
        "es": {"stringUnit":{"state":"translated","value":"Ejecuta exportaciones cada varios días, semanas o meses a partir de una fecha de inicio, con rutinas como días alternos o una vez al mes."}},
        "fr": {"stringUnit":{"state":"translated","value":"Lancez des exportations à intervalles de plusieurs jours, semaines ou mois à partir d’une date de début, par exemple un jour sur deux ou chaque mois."}},
        "it": {"stringUnit":{"state":"translated","value":"Esegui esportazioni a intervalli di giorni, settimane o mesi da una data iniziale, anche a giorni alterni o ogni mese."}},
        "ja": {"stringUnit":{"state":"translated","value":"開始日を基準に、数日、数週間、数か月ごとにエクスポートを実行します。1日おきや毎月などの繰り返しにも対応します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"시작일부터 며칠, 몇 주 또는 몇 개월 간격으로 내보내기를 실행하세요. 격일이나 매월 같은 주기도 설정할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Voer vanaf een startdatum om de paar dagen, weken of maanden exports uit, bijvoorbeeld om de dag of maandelijks."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Execute exportações em intervalos de dias, semanas ou meses a partir de uma data inicial, incluindo rotinas como dia sim, dia não ou mensalmente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"从起始日期开始，每隔若干天、周或月执行导出，例如隔天或每月导出。"}}
      }
    },
    "Run exports every few days, weeks, or months from a start date." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Führe Exporte ab einem Startdatum alle paar Tage, Wochen oder Monate aus."}},
        "es": {"stringUnit":{"state":"translated","value":"Ejecuta exportaciones cada varios días, semanas o meses a partir de una fecha de inicio."}},
        "fr": {"stringUnit":{"state":"translated","value":"Lancez des exportations à intervalles de plusieurs jours, semaines ou mois à partir d’une date de début."}},
        "it": {"stringUnit":{"state":"translated","value":"Esegui esportazioni a intervalli di giorni, settimane o mesi da una data iniziale."}},
        "ja": {"stringUnit":{"state":"translated","value":"開始日を基準に、数日、数週間、数か月ごとにエクスポートを実行します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"시작일부터 며칠, 몇 주 또는 몇 개월 간격으로 내보내기를 실행하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Voer vanaf een startdatum om de paar dagen, weken of maanden exports uit."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Execute exportações em intervalos de dias, semanas ou meses a partir de uma data inicial."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"从起始日期开始，每隔若干天、周或月执行导出。"}}
      }
    },
