    "This export covers %lld days and updates about %lld daily notes. Exports this large can take a long time to finish." : {
      "comment": "Scale summary in the large export confirmation alert while Daily Notes Only is enabled",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This export covers %1$lld days and updates about %2$lld daily notes. Exports this large can take a long time to finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Export umfasst %lld Tage und aktualisiert etwa %lld tägliche Notizen. Exporte dieser Größe können lange dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exportación abarca %lld días y actualiza unas %lld notas diarias. Las exportaciones de este tamaño pueden tardar mucho en completarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette exportation couvre %lld jours et met à jour environ %lld notes quotidiennes. Les exportations de cette taille peuvent prendre beaucoup de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa esportazione copre %lld giorni e aggiorna circa %lld note giornaliere. Esportazioni così grandi possono richiedere molto tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエクスポートは%lld日分を対象とし、約%lld件のデイリーノートを更新します。この規模のエクスポートは完了まで時間がかかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 내보내기는 %lld일을 포함하며 일일 노트 약 %lld개를 업데이트합니다. 이처럼 큰 내보내기는 완료까지 오래 걸릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze export beslaat %lld dagen en werkt ongeveer %lld dagelijkse notities bij. Zulke grote exports kunnen lang duren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exportação abrange %lld dias e atualiza cerca de %lld notas diárias. Exportações deste tamanho podem levar bastante tempo para terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次导出涵盖 %lld 天，将更新约 %lld 篇每日笔记。如此大规模的导出可能需要较长时间。"
          }
        }
      }
    },
    "This export covers %lld days and writes about %lld files. Exports this large can take a long time to finish." : {
