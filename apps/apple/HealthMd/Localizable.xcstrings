        }
      }
    },
    "Skips daily export files and writes only the enabled roll-up summaries" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Überspringt tägliche Exportdateien und schreibt nur die aktivierten aggregierten Zusammenfassungen"}},
        "es": {"stringUnit":{"state":"translated","value":"Omite los archivos de exportación diarios y escribe solo los resúmenes agregados habilitados"}},
        "fr": {"stringUnit":{"state":"translated","value":"Ne crée pas de fichiers d’exportation quotidiens et écrit uniquement les synthèses agrégées activées"}},
        "it": {"stringUnit":{"state":"translated","value":"Salta i file di esportazione giornalieri e scrive solo i riepiloghi aggregati abilitati"}},
        "ja": {"stringUnit":{"state":"translated","value":"日次エクスポートファイルをスキップし、有効な集計サマリーのみを書き込みます"}},
        "ko": {"stringUnit":{"state":"translated","value":"일일 내보내기 파일을 건너뛰고 활성화된 종합 요약만 작성합니다"}},
        "nl": {"stringUnit":{"state":"translated","value":"Slaat dagelijkse exportbestanden over en schrijft alleen de ingeschakelde geaggregeerde samenvattingen"}},
