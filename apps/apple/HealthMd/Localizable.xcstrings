    },
    "Leave empty for a flat structure, or compose date folders with placeholders." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lass das Feld für eine flache Struktur leer oder erstelle Datumsordner mit Platzhaltern."}},
        "es": {"stringUnit":{"state":"translated","value":"Déjalo vacío para una estructura sin subcarpetas o crea carpetas por fecha con marcadores de posición."}},
        "fr": {"stringUnit":{"state":"translated","value":"Laissez vide pour une structure sans sous-dossiers, ou composez des dossiers par date avec des espaces réservés."}},
        "it": {"stringUnit":{"state":"translated","value":"Lascia vuoto per una struttura senza sottocartelle oppure crea cartelle per data usando i segnaposto."}},
        "ja": {"stringUnit":{"state":"translated","value":"空欄にすると階層なしの構成になります。プレースホルダーを使って日付別フォルダを構成することもできます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"하위 폴더 없이 저장하려면 비워 두고, 날짜별 폴더를 만들려면 자리표시자를 사용하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Laat dit leeg voor een platte structuur of stel datummappen samen met tijdelijke aanduidingen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Deixe em branco para uma estrutura sem subpastas ou crie pastas por data usando marcadores."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"留空以使用平铺结构，或使用占位符构建日期文件夹。"}}
      }
    },
    "Leave empty to export directly into the selected root folder." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lass das Feld leer, um direkt in den ausgewählten Stammordner zu exportieren."}},
        "es": {"stringUnit":{"state":"translated","value":"Déjalo vacío para exportar directamente a la carpeta raíz seleccionada."}},
        "fr": {"stringUnit":{"state":"translated","value":"Laissez vide pour exporter directement dans le dossier racine sélectionné."}},
        "it": {"stringUnit":{"state":"translated","value":"Lascia vuoto per esportare direttamente nella cartella principale selezionata."}},
        "ja": {"stringUnit":{"state":"translated","value":"空欄にすると、選択したルートフォルダに直接エクスポートします。"}},
        "ko": {"stringUnit":{"state":"translated","value":"선택한 최상위 폴더에 바로 내보내려면 비워 두세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Laat dit leeg om rechtstreeks naar de geselecteerde hoofdmap te exporteren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Deixe em branco para exportar diretamente para a pasta raiz selecionada."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"留空以直接导出到所选根文件夹。"}}
