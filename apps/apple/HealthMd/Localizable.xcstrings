        "ko": {"stringUnit":{"state":"translated","value":"%@ 준비 중… (%lld/%lld 완료)"}},
        "nl": {"stringUnit":{"state":"translated","value":"%@ voorbereiden… (%lld/%lld voltooid)"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Preparando %@… (progresso: %lld/%lld)"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"正在准备 %@…（已完成 %lld/%lld）"}}
