    "Cannot access the selected folder. Reconnect the location in Files or re-select the folder.": {
      "comment": "Reviewed macOS display localization",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot access the selected folder. Reconnect the location in Files or re-select the folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den ausgewählten Ordner kann nicht zugegriffen werden. Verbinden Sie den Speicherort unter „Dateien“ erneut oder wählen Sie den Ordner erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a la carpeta seleccionada. Vuelva a conectar la ubicación en Archivos o vuelva a seleccionar la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder au dossier sélectionné. Reconnectez l'emplacement dans Fichiers ou resélectionnez le dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere alla cartella selezionata. Ricollegare la posizione in File o selezionare nuovamente la cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダーにアクセスできません。ファイル内の場所を再接続するか、フォルダーを再選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에 접근할 수 없습니다. 파일에서 위치를 다시 연결하거나 폴더를 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de geselecteerde map. Verbind de locatie opnieuw in Bestanden of selecteer de map opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar a pasta selecionada. Reconecte o local em Arquivos ou selecione novamente a pasta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问选定的文件夹。重新连接“文件”中的位置或重新选择文件夹。"
          }
        }
      }
    },
    "Cannot access the vault folder. Reconnect it in Files or re-select it.": {
      "comment": "Reviewed macOS display localization",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot access the vault folder. Reconnect it in Files or re-select it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den Tresorordner kann nicht zugegriffen werden. Verknüpfen Sie es erneut in den Dateien oder wählen Sie es erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a la carpeta del almacén. Vuelva a conectarlo en Archivos o vuelva a seleccionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder au dossier du coffre-fort. Reconnectez-le dans Fichiers ou resélectionnez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile accedere alla cartella del vault. Riconnettilo in File o riselezionalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボルトフォルダーにアクセスできません。 「ファイル」で再接続するか、再選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault 폴더에 액세스할 수 없습니다. 파일에서 다시 연결하거나 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot de kluismap. Maak opnieuw verbinding in Bestanden of selecteer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar a pasta do vault. Reconecte-o em Arquivos ou selecione-o novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问保管库文件夹。在“文件”中重新连接它或重新选择它。"
          }
        }
      }
    },
