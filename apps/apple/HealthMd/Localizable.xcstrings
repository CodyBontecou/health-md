    "Failed or interrupted connected exports provide better retry behavior and more useful recovery details." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Fehlgeschlagene oder unterbrochene Exporte über Verbindungen lassen sich zuverlässiger wiederholen und liefern hilfreichere Details zur Wiederherstellung."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones conectadas fallidas o interrumpidas ofrecen mejores reintentos y detalles de recuperación más útiles."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exportations connectées ayant échoué ou ayant été interrompues bénéficient de nouvelles tentatives améliorées et de détails de résolution plus utiles."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni connesse non riuscite o interrotte offrono una migliore gestione dei nuovi tentativi e dettagli più utili per il ripristino."}},
        "ja": {"stringUnit":{"state":"translated","value":"接続経由のエクスポートが失敗または中断した際の再試行動作を改善し、より役立つ復旧情報を提供します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"실패하거나 중단된 연결 내보내기의 재시도 방식이 개선되고 더 유용한 복구 정보가 제공됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Mislukte of onderbroken exports via een verbinding kunnen beter opnieuw worden geprobeerd en bieden nuttigere herstelinformatie."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As exportações conectadas que falham ou são interrompidas oferecem novas tentativas aprimoradas e detalhes de recuperação mais úteis."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"通过连接进行的导出在失败或中断后，重试机制更加完善，恢复详情也更有帮助。"}}
      }
    },
    "Failed or Missing Days" : {
