    "Import Undone" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Import rückgängig gemacht"}},
        "es": {"stringUnit":{"state":"translated","value":"Importación deshecha"}},
        "fr": {"stringUnit":{"state":"translated","value":"Importation annulée"}},
        "it": {"stringUnit":{"state":"translated","value":"Importazione annullata"}},
        "ja": {"stringUnit":{"state":"translated","value":"インポートを取り消しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"가져오기 실행 취소됨"}},
        "nl": {"stringUnit":{"state":"translated","value":"Import ongedaan gemaakt"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Importação desfeita"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已撤销导入"}}
      }
    },
    "Imported profile destination rebound" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ziel des importierten Profils neu zugeordnet"}},
        "es": {"stringUnit":{"state":"translated","value":"Destino del perfil importado vuelto a vincular"}},
        "fr": {"stringUnit":{"state":"translated","value":"Destination du profil importé réassociée"}},
        "it": {"stringUnit":{"state":"translated","value":"Destinazione del profilo importato riassociata"}},
        "ja": {"stringUnit":{"state":"translated","value":"インポートしたプロファイルの出力先を再設定しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"가져온 프로필의 대상 다시 연결됨"}},
        "nl": {"stringUnit":{"state":"translated","value":"Bestemming van geïmporteerd profiel opnieuw gekoppeld"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Destino do perfil importado vinculado novamente"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已重新绑定导入配置的目标位置"}}
      }
    },
    "Imported profiles" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Importierte Profile"}},
        "es": {"stringUnit":{"state":"translated","value":"Perfiles importados"}},
        "fr": {"stringUnit":{"state":"translated","value":"Profils importés"}},
        "it": {"stringUnit":{"state":"translated","value":"Profili importati"}},
        "ja": {"stringUnit":{"state":"translated","value":"インポートしたプロファイル"}},
        "ko": {"stringUnit":{"state":"translated","value":"가져온 프로필"}},
        "nl": {"stringUnit":{"state":"translated","value":"Geïmporteerde profielen"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Perfis importados"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"导入的配置"}}
      }
    },
    "Imported profiles are blocked until you rebind each destination on this device. One Undo is available immediately after applying." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Importierte Profile sind gesperrt, bis du jedes Ziel auf diesem Gerät neu zuordnest. Direkt nach dem Anwenden kannst du den Vorgang einmal rückgängig machen."}},
        "es": {"stringUnit":{"state":"translated","value":"Los perfiles importados están bloqueados hasta que vuelvas a vincular cada destino en este dispositivo. Puedes deshacer la operación una vez inmediatamente después de aplicarla."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les profils importés sont bloqués tant que vous n’avez pas réassocié chaque destination sur cet appareil. Une seule annulation est possible immédiatement après l’application."}},
        "it": {"stringUnit":{"state":"translated","value":"I profili importati sono bloccati finché non riassoci ogni destinazione su questo dispositivo. Puoi annullare una sola volta, subito dopo l'applicazione."}},
        "ja": {"stringUnit":{"state":"translated","value":"インポートしたプロファイルは、このデバイスで各出力先を再設定するまで使用できません。適用直後に 1 回だけ取り消せます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 기기에서 각 대상을 다시 연결하기 전까지 가져온 프로필은 차단됩니다. 적용 직후 한 번 실행 취소할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geïmporteerde profielen zijn geblokkeerd totdat je elke bestemming op dit apparaat opnieuw koppelt. Direct na het toepassen kun je dit één keer ongedaan maken."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os perfis importados ficam bloqueados até você vincular novamente cada destino neste dispositivo. É possível desfazer uma vez, imediatamente após aplicar."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"导入的配置在你于此设备上重新绑定各个目标位置前会被阻止使用。应用后可立即撤销一次。"}}
      }
    },
    "Imports the selected profiles. Every imported destination stays unbound and every imported schedule stays disabled." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Importiert die ausgewählten Profile. Alle importierten Ziele bleiben ohne Zuordnung und alle importierten Zeitpläne bleiben deaktiviert."}},
        "es": {"stringUnit":{"state":"translated","value":"Importa los perfiles seleccionados. Todos los destinos importados permanecen sin vincular y todas las programaciones importadas permanecen deshabilitadas."}},
        "fr": {"stringUnit":{"state":"translated","value":"Importe les profils sélectionnés. Chaque destination importée reste non associée et chaque planification importée reste désactivée."}},
        "it": {"stringUnit":{"state":"translated","value":"Importa i profili selezionati. Ogni destinazione importata rimane non associata e ogni pianificazione importata rimane disabilitata."}},
        "ja": {"stringUnit":{"state":"translated","value":"選択したプロファイルをインポートします。インポートした出力先はすべて未設定のまま、スケジュールはすべて無効のままになります。"}},
        "ko": {"stringUnit":{"state":"translated","value":"선택한 프로필을 가져옵니다. 가져온 모든 대상은 연결되지 않은 상태로, 모든 일정은 비활성화된 상태로 유지됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Importeert de geselecteerde profielen. Elke geïmporteerde bestemming blijft ongekoppeld en elk geïmporteerd schema blijft uitgeschakeld."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Importa os perfis selecionados. Todos os destinos importados permanecem sem vínculo e todos os agendamentos importados permanecem desativados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"导入所选配置。所有导入的目标位置均保持未绑定状态，所有导入的计划均保持禁用状态。"}}
      }
    },
    "Improved onboarding guides you from Apple Health and folder setup to a ready-to-run preview." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der verbesserte Einstieg führt dich von Apple Health und der Ordnerauswahl bis zu einer startbereiten Vorschau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio mejorado te guía desde Apple Health y la selección de carpeta hasta una vista previa lista para ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le parcours de démarrage amélioré vous guide d’Apple Health et du choix du dossier jusqu’à un aperçu prêt à être lancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La procedura iniziale migliorata ti guida da Apple Health e dalla scelta della cartella fino a un’anteprima pronta da eseguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改善された初期設定が、Apple Healthとフォルダの設定から、すぐ実行できるプレビューまで案内します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개선된 시작 과정이 Apple Health 및 폴더 설정부터 바로 실행할 수 있는 미리보기까지 안내합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbeterde introductie begeleidt je van Apple Health en de mapkeuze naar een voorvertoning die klaar is om uit te voeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A introdução aprimorada orienta você do Apple Health e da escolha da pasta até uma prévia pronta para executar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改进后的入门流程会从 Apple Health 和文件夹设置引导至可直接运行的预览。"
          }
        }
      }
    },
