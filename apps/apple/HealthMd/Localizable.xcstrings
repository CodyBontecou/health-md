          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したエクスポート フォルダーにアクセスできませんでした。再接続するか、Health.md で再選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 내보내기 폴더에 액세스할 수 없습니다. Health.md에서 다시 연결하거나 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen toegang krijgen tot de geselecteerde exportmap. Maak opnieuw verbinding of selecteer het opnieuw in Health.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
