    "Creates separate timestamped Markdown files for selected health events in addition to your normal daily export.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea archivos Markdown independientes con fecha y hora para los eventos de salud seleccionados, además de la exportación diaria normal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt zusätzlich zu Ihrem normalen täglichen Export separate Markdown-Dateien mit Zeitstempel für ausgewählte Gesundheitsereignisse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des fichiers Markdown horodatés distincts pour les événements de santé sélectionnés, en plus de votre exportation quotidienne habituelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea file Markdown separati con data e ora per gli eventi sanitari selezionati, oltre alla normale esportazione giornaliera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の日次エクスポートに加えて、選択したヘルスイベントごとにタイムスタンプ付きのMarkdownファイルを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 일일 내보내기에 더해 선택한 건강 이벤트마다 타임스탬프가 포함된 별도의 Markdown 파일을 생성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt naast je normale dagelijkse export afzonderlijke Markdown-bestanden met tijdstempel voor geselecteerde gezondheidsgebeurtenissen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria arquivos Markdown separados, com data e hora, para os eventos de saúde selecionados, além da exportação diária normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除常规每日导出外，还会为所选健康事件创建单独的带时间戳 Markdown 文件。"
          }
        }
      }
    },
