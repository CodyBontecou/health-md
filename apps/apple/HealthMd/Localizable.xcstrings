          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De achtergrondexporttaak is door iOS beëindigd voordat deze voltooid was."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
