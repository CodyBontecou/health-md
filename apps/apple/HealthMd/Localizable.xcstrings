    "Medication export requires iOS 26 or later. Other Health metrics can still be exported." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Der Medikamentenexport erfordert iOS 26 oder neuer. Andere Gesundheitsmetriken können weiterhin exportiert werden."}},
        "es" : {"stringUnit":{"state":"translated","value":"La exportación de medicamentos requiere iOS 26 o posterior. Las demás métricas de Salud se pueden seguir exportando."}},
        "fr" : {"stringUnit":{"state":"translated","value":"L’export des médicaments nécessite iOS 26 ou version ultérieure. Les autres mesures de Santé restent exportables."}},
        "it" : {"stringUnit":{"state":"translated","value":"L’esportazione dei farmaci richiede iOS 26 o versioni successive. Le altre metriche di Salute possono ancora essere esportate."}},
        "ja" : {"stringUnit":{"state":"translated","value":"服薬情報の書き出しにはiOS 26以降が必要です。ほかのヘルスケア指標は引き続き書き出せます。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"복약 정보를 내보내려면 iOS 26 이상이 필요합니다. 다른 건강 지표는 계속 내보낼 수 있습니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Medicijnen exporteren vereist iOS 26 of nieuwer. Andere Gezondheid-metingen kunnen nog steeds worden geëxporteerd."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"A exportação de medicamentos requer iOS 26 ou posterior. As outras métricas do Saúde ainda podem ser exportadas."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"导出药物信息需要 iOS 26 或更高版本。其他健康指标仍可导出。"}}
      }
    },
    "Health.md exports only the medications you selected in Apple's permission sheet. You can reopen the selector anytime." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Health.md exportiert nur die Medikamente, die du in Apples Berechtigungsdialog ausgewählt hast. Du kannst die Auswahl jederzeit erneut öffnen."}},
        "es" : {"stringUnit":{"state":"translated","value":"Health.md solo exporta los medicamentos que seleccionaste en el permiso de Apple. Puedes volver a abrir el selector en cualquier momento."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Health.md exporte uniquement les médicaments sélectionnés dans la fenêtre d’autorisation d’Apple. Vous pouvez rouvrir le sélecteur à tout moment."}},
        "it" : {"stringUnit":{"state":"translated","value":"Health.md esporta solo i farmaci selezionati nella schermata di autorizzazione di Apple. Puoi riaprire il selettore in qualsiasi momento."}},
        "ja" : {"stringUnit":{"state":"translated","value":"Health.mdは、Appleの許可画面で選択した薬だけを書き出します。選択画面はいつでも開き直せます。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"Health.md는 Apple 권한 화면에서 선택한 약만 내보냅니다. 언제든지 선택 화면을 다시 열 수 있습니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Health.md exporteert alleen de medicijnen die je in het toestemmingsvenster van Apple hebt geselecteerd. Je kunt de kiezer altijd opnieuw openen."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"O Health.md exporta apenas os medicamentos selecionados na tela de permissão da Apple. Você pode reabrir o seletor a qualquer momento."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"Health.md 只导出你在 Apple 授权界面中选择的药物。你可以随时重新打开选择器。"}}
      }
    },
    "Medications use Apple's per-medication permission sheet instead of the standard Health access prompt." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Medikamente verwenden Apples individuellen Berechtigungsdialog pro Medikament statt der üblichen Health-Zugriffsabfrage."}},
        "es" : {"stringUnit":{"state":"translated","value":"Los medicamentos usan el permiso individual de Apple para cada medicamento en lugar de la solicitud estándar de acceso a Salud."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Les médicaments utilisent une autorisation Apple par médicament plutôt que la demande d’accès standard à Santé."}},
        "it" : {"stringUnit":{"state":"translated","value":"I farmaci utilizzano l’autorizzazione di Apple per ogni singolo farmaco anziché la richiesta standard di accesso a Salute."}},
        "ja" : {"stringUnit":{"state":"translated","value":"服薬情報では、通常のヘルスケアへのアクセス要求ではなく、薬ごとに許可するAppleの画面を使用します。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"복약 정보는 일반적인 건강 접근 권한 요청 대신 약별로 허용하는 Apple의 권한 화면을 사용합니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Medicijnen gebruiken het toestemmingsvenster van Apple per medicijn in plaats van de standaardvraag om toegang tot Gezondheid."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Os medicamentos usam a tela de permissão individual da Apple por medicamento, em vez da solicitação padrão de acesso ao Saúde."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"药物信息使用 Apple 按药物逐一授权的界面，而不是标准的健康访问权限提示。"}}
      }
    },
    "Vision prescription access requires a supported iOS runtime." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Der Zugriff auf Sehhilfenverordnungen erfordert eine unterstützte iOS-Version."}},
        "es" : {"stringUnit":{"state":"translated","value":"El acceso a recetas ópticas requiere una versión de iOS compatible."}},
        "fr" : {"stringUnit":{"state":"translated","value":"L’accès aux ordonnances optiques nécessite une version d’iOS compatible."}},
        "it" : {"stringUnit":{"state":"translated","value":"L’accesso alle prescrizioni oculistiche richiede una versione di iOS supportata."}},
        "ja" : {"stringUnit":{"state":"translated","value":"視力処方箋へのアクセスには、対応するiOSが必要です。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"시력 처방전에 접근하려면 지원되는 iOS 버전이 필요합니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Toegang tot brilrecepten vereist een ondersteunde iOS-versie."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"O acesso a receitas oftalmológicas requer uma versão compatível do iOS."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"访问视力处方需要受支持的 iOS 版本。"}}
      }
    },
    "Apple's vision prescription selector did not complete (%@, code %lld)." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Apples Auswahl für Sehhilfenverordnungen wurde nicht abgeschlossen (%@, Code %lld)."}},
        "es" : {"stringUnit":{"state":"translated","value":"El selector de recetas ópticas de Apple no se completó (%@, código %lld)."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Le sélecteur d’ordonnances optiques d’Apple n’a pas abouti (%@, code %lld)."}},
        "it" : {"stringUnit":{"state":"translated","value":"Il selettore delle prescrizioni oculistiche di Apple non è stato completato (%@, codice %lld)."}},
        "ja" : {"stringUnit":{"state":"translated","value":"Appleの視力処方箋の選択が完了しませんでした（%@、コード%lld）。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"Apple의 시력 처방전 선택이 완료되지 않았습니다(%@, 코드 %lld)."}},
        "nl" : {"stringUnit":{"state":"translated","value":"De brilreceptkiezer van Apple is niet voltooid (%@, code %lld)."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"O seletor de receitas oftalmológicas da Apple não foi concluído (%@, código %lld)."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"Apple 视力处方选择器未完成（%@，代码 %lld）。"}}
      }
    },
    "Medication export requires iOS 26 or later. You can still export all other Health metrics." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Der Medikamentenexport erfordert iOS 26 oder neuer. Alle anderen Gesundheitsmetriken können weiterhin exportiert werden."}},
        "es" : {"stringUnit":{"state":"translated","value":"La exportación de medicamentos requiere iOS 26 o posterior. Puedes seguir exportando todas las demás métricas de Salud."}},
        "fr" : {"stringUnit":{"state":"translated","value":"L’export des médicaments nécessite iOS 26 ou version ultérieure. Vous pouvez toujours exporter toutes les autres mesures de Santé."}},
        "it" : {"stringUnit":{"state":"translated","value":"L’esportazione dei farmaci richiede iOS 26 o versioni successive. Puoi ancora esportare tutte le altre metriche di Salute."}},
        "ja" : {"stringUnit":{"state":"translated","value":"服薬情報の書き出しにはiOS 26以降が必要です。ほかのすべてのヘルスケア指標は引き続き書き出せます。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"복약 정보를 내보내려면 iOS 26 이상이 필요합니다. 다른 모든 건강 지표는 계속 내보낼 수 있습니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Medicijnen exporteren vereist iOS 26 of nieuwer. Je kunt alle andere Gezondheid-metingen nog steeds exporteren."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"A exportação de medicamentos requer iOS 26 ou posterior. Você ainda pode exportar todas as outras métricas do Saúde."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"导出药物信息需要 iOS 26 或更高版本。你仍可导出所有其他健康指标。"}}
      }
    },
