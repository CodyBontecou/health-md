    "Get the Mac App" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Mac-App laden"}},
        "es": {"stringUnit":{"state":"translated","value":"Obtener la app para Mac"}},
        "fr": {"stringUnit":{"state":"translated","value":"Obtenir l’app Mac"}},
        "it": {"stringUnit":{"state":"translated","value":"Scarica l’app per Mac"}},
        "ja": {"stringUnit":{"state":"translated","value":"Macアプリを入手"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac 앱 받기"}},
