    "Waiting for the active direct operation to finish, then Health.md will connect automatically to %@:%@." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Warten auf den Abschluss des aktiven direkten Vorgangs. Danach verbindet sich Health.md automatisch mit %@:%@."}},
