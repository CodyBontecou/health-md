    "Add Gateway…" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Gateway hinzufügen…"}},
        "es": {"stringUnit":{"state":"translated","value":"Añadir pasarela…"}},
        "fr": {"stringUnit":{"state":"translated","value":"Ajouter une passerelle…"}},
        "it": {"stringUnit":{"state":"translated","value":"Aggiungi gateway…"}},
        "ja": {"stringUnit":{"state":"translated","value":"ゲートウェイを追加…"}},
        "ko": {"stringUnit":{"state":"translated","value":"게이트웨이 추가…"}},
        "nl": {"stringUnit":{"state":"translated","value":"Gateway toevoegen…"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Adicionar gateway…"}},
