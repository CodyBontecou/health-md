    "Open the folder in Files to confirm it is available. Then re-select the folder in Health.md and retry." : {
      "comment" : "Recovery: vault access denied",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie den Ordner in „Dateien“, um zu bestätigen, dass er verfügbar ist. Wählen Sie dann den Ordner erneut in Health.md aus und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the folder in Files to confirm it is available. Then re-select the folder in Health.md and retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra la carpeta en Archivos para confirmar que esté disponible. Luego vuelva a seleccionar la carpeta en Health.md y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez le dossier dans Fichiers pour confirmer qu'il est disponible. Resélectionnez ensuite le dossier dans Health.md et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la cartella in File per verificare che sia disponibile. Quindi seleziona nuovamente la cartella in Health.md e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[ファイル] でフォルダーを開いて、利用できることを確認します。次に、Health.md 内のフォルダーを再選択して、再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일에서 폴더를 열어 사용 가능한지 확인하세요. 그런 다음 Health.md에서 폴더를 다시 선택하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de map in Bestanden om te bevestigen dat deze beschikbaar is. Selecteer vervolgens de map in Health.md opnieuw en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a pasta em Arquivos para confirmar que está disponível. Em seguida, selecione novamente a pasta em Health.md e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“文件”中的文件夹以确认其可用。然后重新选择Health.md中的文件夹并重试。"
          }
        }
      }
    },
    "Open the Health app and review Health.md under Profile → Apps and Services. Allow the needed data types, then retry." : {
      "comment" : "Recovery: HealthKit error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie die Health-App und prüfen Sie Health.md unter Profil → Apps und Dienste. Erlauben Sie die benötigten Datentypen und versuchen Sie es anschließend erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Health app and review Health.md under Profile → Apps and Services. Allow the needed data types, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra la aplicación Salud y revise Health.md en Perfil → Aplicaciones y servicios. Permita los tipos de datos necesarios y luego vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l'application Santé et examinez Health.md sous Profil → Applications et services. Autorisez les types de données nécessaires, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
