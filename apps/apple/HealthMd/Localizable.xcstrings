    "Skips aggregate exports, ZIPs, roll-ups, individual entries, provider sidecars, and the data dictionary while preserving their settings": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips aggregate exports, ZIPs, roll-ups, individual entries, provider sidecars, and the data dictionary while preserving their settings"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt aggregierte Exporte, ZIPs, Roll-ups, einzelne Einträge, Anbieter-Sidecars und das Datenwörterbuch, während ihre Einstellungen beibehalten werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite exportaciones agregadas, archivos ZIP, resúmenes, entradas individuales, complementos de proveedores y el diccionario de datos, conservando al mismo tiempo su configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore les exportations globales, les fichiers ZIP, les cumuls, les entrées individuelles, les side-cars du fournisseur et le dictionnaire de données tout en préservant leurs paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta esportazioni aggregate, ZIP, roll-up, voci individuali, sidecar del provider e dizionario dati preservandone le impostazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を維持しながら、集約エクスポート、ZIP、ロールアップ、個々のエントリ、プロバイダー サイドカー、およびデータ ディクショナリをスキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 설정을 유지하면서 집계 내보내기, ZIP, 롤업, 개별 항목, 공급자 사이드카 및 데이터 사전을 건너뜁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat geaggregeerde exports, ZIP-bestanden, roll-ups, afzonderlijke vermeldingen, sidecarbestanden van providers en het gegevenswoordenboek over, maar behoudt de instellingen ervan"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora exportações agregadas, ZIPs, roll-ups, entradas individuais, sidecars de provedores e o dicionário de dados, preservando suas configurações"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过聚合导出、ZIP、汇总、单个条目、提供程序 sidecar 和数据字典，同时保留其设置"
          }
        }
      }
    },
    "Skips daily files and side effects. Health.md still fetches the full touched periods to build the enabled summaries.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skips daily files and side effects. Health.md still fetches the full touched periods to build the enabled summaries."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringt tägliche Dateien und Nebenwirkungen. Health.md ruft weiterhin die vollständig berührten Zeiträume ab, um die aktivierten Zusammenfassungen zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta archivos diarios y efectos secundarios. Health.md todavía recupera todos los períodos tocados para crear los resúmenes habilitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore les fichiers quotidiens et les effets secondaires. Health.md récupère toujours l'intégralité des périodes touchées pour créer les résumés activés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta i file giornalieri e gli effetti collaterali. Health.md recupera comunque tutti i periodi toccati per creare i riepiloghi abilitati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日のファイルと副作用をスキップします。 Health.md は引き続き、タッチされた期間全体を取得して、有効な要約を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 파일과 부작용을 건너뜁니다. Health.md는 활성화된 요약을 작성하기 위해 계속해서 전체 터치 기간을 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat dagelijkse bestanden en bijwerkingen over. Health.md haalt nog steeds de volledig aangeraakte perioden op om de ingeschakelde samenvattingen samen te stellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora arquivos diários e efeitos colaterais. Health.md ainda busca todos os períodos tocados para construir os resumos habilitados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过日常文件和副作用。 Health.md 仍然获取完整的触摸周期来构建启用的摘要。"
          }
        }
      }
    },
