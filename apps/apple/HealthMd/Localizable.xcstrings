    "Range Start" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Beginn des Zeitraums"}},
        "es": {"stringUnit":{"state":"translated","value":"Inicio del intervalo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Début de la plage"}},
