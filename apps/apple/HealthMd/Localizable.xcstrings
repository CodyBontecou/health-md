    "Export, scheduling, formatting, preview, tracking, and Mac destination screens now support nine additional languages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export, Zeitpläne, Formatierung, Vorschau, Tracking und Mac-Ziele unterstützen jetzt neun weitere Sprachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas de exportación, programación, formato, vista previa, seguimiento y destinos Mac ahora admiten nueve idiomas adicionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
