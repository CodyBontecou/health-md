    "Free Export Limit Reached" : {
      "comment": "Notification title when scheduled export quota is exhausted",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit für kostenlose Exporte erreicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de exportaciones gratuitas alcanzado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d’exportations gratuites atteinte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di esportazioni gratuite raggiunto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料エクスポートの上限に達しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 내보내기 한도에 도달함"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiet voor gratis exports bereikt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de exportações gratuitas atingido"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达免费导出上限"
          }
        }
      }
    },
    "Free export limit reached. Scheduled exports use the same %lld-export allowance as manual exports. Unlock Full Access to continue." : {
      "comment": "Message shown when a scheduled export cannot run because free quota is exhausted",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit für kostenlose Exporte erreicht. Geplante und manuelle Exporte teilen sich dasselbe Kontingent von %lld Exporten. Schalte den Vollzugriff frei, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha alcanzado el límite de exportaciones gratuitas. Las exportaciones programadas comparten el mismo cupo de %lld exportaciones que las manuales. Desbloquea el acceso completo para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d’exportations gratuites atteinte. Les exportations planifiées partagent le même quota d’exportations (%lld) que les exportations manuelles. Débloquez l’accès complet pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di esportazioni gratuite raggiunto. Le esportazioni pianificate condividono il limite di %lld esportazioni con quelle manuali. Sblocca l'accesso completo per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料エクスポートの上限に達しました。スケジュールによるエクスポートも、手動エクスポートと同じ%lld回の利用枠を使用します。続けるにはフルアクセスを購入してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 내보내기 한도에 도달했습니다. 예약 내보내기는 수동 내보내기와 동일한 %lld회 한도를 공유합니다. 계속하려면 전체 이용 권한을 잠금 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiet voor gratis exports bereikt. Geplande en handmatige exports delen dezelfde limiet van %lld exports. Ontgrendel volledige toegang om door te gaan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de exportações gratuitas atingido. As exportações agendadas usam a mesma cota de exportações (%lld) das exportações manuais. Desbloqueie o Acesso Completo para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达免费导出上限。计划导出与手动导出共用 %lld 次导出额度。解锁完整访问权限以继续。"
          }
        }
      }
    },
