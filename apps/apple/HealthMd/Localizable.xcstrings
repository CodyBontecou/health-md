    "Showing the newest 100 matching events. The bundle includes the selected snapshot, up to 10,000 events; any truncation is disclosed." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Die neuesten 100 passenden Ereignisse werden angezeigt. Das Paket enthält den ausgewählten Schnappschuss mit bis zu 10.000 Ereignissen; auf Kürzungen wird hingewiesen."}},
        "es": {"stringUnit":{"state":"translated","value":"Se muestran los 100 eventos coincidentes más recientes. El paquete incluye la instantánea seleccionada, con un máximo de 10.000 eventos; se indica cualquier recorte."}},
        "fr": {"stringUnit":{"state":"translated","value":"Affichage des 100 événements correspondants les plus récents. L’archive inclut l’instantané sélectionné, dans la limite de 10 000 événements ; toute troncature est signalée."}},
        "it": {"stringUnit":{"state":"translated","value":"Sono mostrati i 100 eventi corrispondenti più recenti. Il pacchetto include l’istantanea selezionata, fino a 10.000 eventi; eventuali troncamenti vengono segnalati."}},
        "ja": {"stringUnit":{"state":"translated","value":"条件に一致する最新100件のイベントを表示しています。バンドルには、最大10,000件のイベントを含む選択済みのスナップショットが含まれます。件数制限により省略された場合は、その旨が明示されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"조건에 맞는 최신 이벤트 100개를 표시합니다. 번들에는 선택한 스냅샷의 이벤트가 최대 10,000개 포함되며, 잘린 내용이 있으면 명시됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De 100 nieuwste overeenkomende gebeurtenissen worden getoond. De bundel bevat de geselecteerde momentopname met maximaal 10.000 gebeurtenissen; eventuele inkorting wordt vermeld."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Exibindo os 100 eventos correspondentes mais recentes. O pacote inclui o retrato selecionado, com até 10.000 eventos; qualquer truncamento é informado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"显示最新的 100 条匹配事件。诊断包包含所选快照，最多 10,000 条事件；如有截断，会明确说明。"}}
      }
    },
    "Shows instructions for reviewing Health.md access in Apple Health" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Zeigt Anweisungen zum Prüfen des Zugriffs von Health.md in Apple Health"}},
        "es": {"stringUnit":{"state":"translated","value":"Muestra instrucciones para revisar el acceso de Health.md en Apple Health"}},
        "fr": {"stringUnit":{"state":"translated","value":"Affiche les instructions pour vérifier l’accès de Health.md dans Apple Health"}},
        "it": {"stringUnit":{"state":"translated","value":"Mostra le istruzioni per controllare l’accesso di Health.md in Apple Health"}},
        "ja": {"stringUnit":{"state":"translated","value":"Apple HealthでHealth.mdのアクセス権を確認する手順を表示します"}},
        "ko": {"stringUnit":{"state":"translated","value":"Apple Health에서 Health.md 접근 권한을 검토하는 방법을 표시합니다"}},
        "nl": {"stringUnit":{"state":"translated","value":"Toont instructies om de toegang van Health.md in Apple Health te controleren"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Mostra instruções para revisar o acesso do Health.md no Apple Health"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"显示在 Apple Health 中检查 Health.md 访问权限的说明"}}
      }
    },
    "Sleep covers noon on each selected date through noon the next day. For last night's sleep, choose Yesterday." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Schlaf umfasst den Zeitraum von mittags am jeweils ausgewählten Datum bis mittags am Folgetag. Wähle für den Schlaf der letzten Nacht „Gestern“."}},
        "es": {"stringUnit":{"state":"translated","value":"El sueño abarca desde el mediodía de cada fecha seleccionada hasta el mediodía del día siguiente. Para el sueño de anoche, elige Ayer."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le sommeil couvre la période allant de midi le jour sélectionné à midi le lendemain, pour chaque date sélectionnée. Pour le sommeil de la nuit dernière, choisissez Hier."}},
        "it": {"stringUnit":{"state":"translated","value":"Il sonno copre il periodo da mezzogiorno di ogni data selezionata a mezzogiorno del giorno successivo. Per il sonno della scorsa notte, scegli Ieri."}},
        "ja": {"stringUnit":{"state":"translated","value":"睡眠の対象期間は、選択した各日の正午から翌日の正午までです。昨夜の睡眠には「昨日」を選択してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"수면은 선택한 각 날짜의 정오부터 다음 날 정오까지를 포함합니다. 지난밤 수면을 보려면 어제를 선택하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Slaap omvat de periode van 12.00 uur op elke geselecteerde datum tot 12.00 uur de volgende dag. Kies Gisteren voor de slaap van afgelopen nacht."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O sono abrange do meio-dia de cada data selecionada até o meio-dia do dia seguinte. Para o sono da noite passada, escolha Ontem."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"睡眠数据涵盖每个所选日期的中午至次日中午。要查看昨晚的睡眠，请选择“昨天”。"}}
      }
    },
    "Sleep window: %@ to %@ (%@)." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Schlafzeitfenster: %@ bis %@ (%@)."}},
        "es": {"stringUnit":{"state":"translated","value":"Intervalo de sueño: de %@ a %@ (%@)."}},
        "fr": {"stringUnit":{"state":"translated","value":"Plage de sommeil : de %@ à %@ (%@)."}},
        "it": {"stringUnit":{"state":"translated","value":"Intervallo del sonno: da %@ a %@ (%@)."}},
        "ja": {"stringUnit":{"state":"translated","value":"睡眠の対象期間：%@〜%@（%@）。"}},
        "ko": {"stringUnit":{"state":"translated","value":"수면 시간 범위: %@~%@ (%@)."}},
        "nl": {"stringUnit":{"state":"translated","value":"Slaapperiode: %@ tot %@ (%@)."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Período de sono: %@ a %@ (%@)."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"睡眠时段：%@ 至 %@（%@）。"}}
      }
