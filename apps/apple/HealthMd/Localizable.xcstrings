    "Send an email or open a GitHub issue — both include your app version and system info automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie eine E-Mail oder erstellen Sie ein GitHub-Issue — beide enthalten automatisch Ihre App-Version und Systeminformationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an email or open a GitHub issue — both include your app version and system info automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un correo electrónico o abre un issue en GitHub — ambos incluyen la versión de tu aplicación e información del sistema automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un e-mail ou ouvrez un ticket GitHub — les deux incluent automatiquement la version de votre app et les informations système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un'email o apri una segnalazione su GitHub — entrambe includono automaticamente la versione dell'app e le informazioni di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを送信するか、GitHub Issueを開いてください — どちらもアプリのバージョンとシステム情報が自動的に含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일을 보내거나 GitHub 이슈를 열 수 있습니다. 두 가지 모두 앱 버전과 시스템 정보가 자동으로 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur een e-mail of open een GitHub-issue — beide bevatten automatisch je appversie en systeeminformatie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um e-mail ou abra uma issue no GitHub — ambos incluem a versão do app e informações do sistema automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送邮件或在 GitHub 上提交 Issue——两者都会自动包含您的应用版本和系统信息。"
          }
        }
      }
    },
