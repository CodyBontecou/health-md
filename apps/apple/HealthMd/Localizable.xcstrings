    "Keep Markdown, Obsidian Bases, JSON, and CSV in their own folders before date folders when your vault is ready for the new layout." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lege Markdown, Obsidian Bases, JSON und CSV jeweils in eigenen Ordnern oberhalb der Datumsordner ab, wenn dein Vault für die neue Struktur bereit ist."}},
        "es": {"stringUnit":{"state":"translated","value":"Guarda Markdown, Obsidian Bases, JSON y CSV en sus propias carpetas antes de las carpetas de fecha cuando tu bóveda esté lista para la nueva estructura."}},
        "fr": {"stringUnit":{"state":"translated","value":"Placez Markdown, Obsidian Bases, JSON et CSV dans leurs propres dossiers, avant les dossiers de dates, lorsque votre coffre est prêt pour la nouvelle organisation."}},
        "it": {"stringUnit":{"state":"translated","value":"Mantieni Markdown, Obsidian Bases, JSON e CSV in cartelle dedicate, prima delle cartelle per data, quando il tuo vault è pronto per la nuova struttura."}},
        "ja": {"stringUnit":{"state":"translated","value":"保管庫で新しいレイアウトを使う準備ができたら、Markdown、Obsidian Bases、JSON、CSV を、日付フォルダの上位にある形式別フォルダに保存できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"보관함에 새 구조를 적용할 준비가 되면, 날짜 폴더보다 상위에 Markdown, Obsidian Bases, JSON, CSV별 폴더를 두세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Bewaar Markdown, Obsidian Bases, JSON en CSV in eigen mappen boven de datummappen wanneer je kluis klaar is voor de nieuwe indeling."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Mantenha Markdown, Obsidian Bases, JSON e CSV em pastas próprias antes das pastas de datas quando seu cofre estiver pronto para a nova estrutura."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"当你的仓库准备好使用新布局时，将 Markdown、Obsidian Bases、JSON 和 CSV 分别存放在各自的文件夹中，再在其下按日期分文件夹。"}}
      }
    },
    "Keep your Health.md destinations updated with recurring Apple Health exports." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie Ihre Health.md-Exportziele mit wiederkehrenden Apple Health-Exporten auf dem neuesten Stand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén tus destinos de Health.md actualizados con exportaciones periódicas de Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez vos destinations Health.md à jour grâce à des exportations Apple Health récurrentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni aggiornate le destinazioni di Health.md con esportazioni ricorrenti da Apple Health."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定期的なApple Healthのエクスポートで、Health.mdのエクスポート先を最新の状態に保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정기적인 Apple Health 내보내기로 Health.md의 내보내기 대상을 최신 상태로 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je Health.md-bestemmingen actueel met terugkerende Apple Health-exports."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os destinos do Health.md atualizados com exportações recorrentes do Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过定期导出 Apple Health 数据，让 Health.md 的目标位置保持最新。"
          }
        }
      }
    },
    "Keeps export, sync, schedule, folder, and connection settings from being changed by mistake. Manual exports and syncs remain available." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Verhindert versehentliche Änderungen an Export-, Synchronisierungs-, Zeitplan-, Ordner- und Verbindungseinstellungen. Manuelle Exporte und Synchronisierungen bleiben verfügbar."}},
        "es": {"stringUnit":{"state":"translated","value":"Evita cambios accidentales en los ajustes de exportación, sincronización, programación, carpetas y conexión. Las exportaciones y sincronizaciones manuales siguen disponibles."}},
        "fr": {"stringUnit":{"state":"translated","value":"Empêche la modification accidentelle des paramètres d’exportation, de synchronisation, de planification, de dossier et de connexion. Les exportations et synchronisations manuelles restent disponibles."}},
        "it": {"stringUnit":{"state":"translated","value":"Impedisce modifiche accidentali alle impostazioni di esportazione, sincronizzazione, pianificazione, cartelle e connessione. Le esportazioni e le sincronizzazioni manuali restano disponibili."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポート、同期、スケジュール、フォルダ、接続の設定が誤って変更されるのを防ぎます。手動のエクスポートと同期は引き続き利用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기, 동기화, 일정, 폴더 및 연결 설정이 실수로 변경되지 않도록 합니다. 수동 내보내기와 동기화는 계속 사용할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Voorkomt dat export-, synchronisatie-, schema-, map- en verbindingsinstellingen per ongeluk worden gewijzigd. Handmatig exporteren en synchroniseren blijft mogelijk."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Impede alterações acidentais nas configurações de exportação, sincronização, agendamento, pasta e conexão. As exportações e sincronizações manuais continuam disponíveis."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"防止误改导出、同步、计划、文件夹和连接设置。手动导出和同步仍可使用。"}}
      }
    },
