    "Track workouts, symptoms, blood pressure, glucose, mood, and other events as timestamped Markdown entries.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra entrenamientos, síntomas, presión arterial, glucosa, estado de ánimo y otros eventos como entradas de Markdown con fecha y hora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassen Sie Trainings, Symptome, Blutdruck, Glukose, Stimmung und andere Ereignisse als Markdown-Einträge mit Zeitstempel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les entraînements, les symptômes, la tension artérielle, la glycémie, l’humeur et d’autres événements sous forme d’entrées Markdown horodatées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra allenamenti, sintomi, pressione arteriosa, glicemia, umore e altri eventi come voci Markdown con data e ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウト、症状、血圧、血糖値、気分などのイベントを、タイムスタンプ付きのMarkdownエントリとして記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동, 증상, 혈압, 혈당, 기분 및 기타 이벤트를 타임스탬프가 포함된 Markdown 항목으로 기록합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd work-outs, symptomen, bloeddruk, glucose, stemming en andere gebeurtenissen bij als Markdown-vermeldingen met tijdstempel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre treinos, sintomas, pressão arterial, glicose, humor e outros eventos como entradas em Markdown com data e hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将锻炼、症状、血压、血糖、情绪和其他事件记录为带时间戳的 Markdown 条目。"
          }
        }
      }
    },
