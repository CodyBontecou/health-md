        "de": {"stringUnit":{"state":"translated","value":"7 Tage kostenlos, dann %@ pro Jahr. Automatische Verlängerung; jederzeit kündigen."}},
        "es": {"stringUnit":{"state":"translated","value":"7 días gratis, luego %@ por año. Renovación automática; cancelar en cualquier momento."}},
        "fr": {"stringUnit":{"state":"translated","value":"7 jours gratuits, puis %@ par an. Renouvellement automatique ; annuler à tout moment."}},
        "it": {"stringUnit":{"state":"translated","value":"7 giorni gratuiti, poi %@ all'anno. Rinnovo automatico; annullare in qualsiasi momento."}},
        "ja": {"stringUnit":{"state":"translated","value":"7 日間無料、その後は%@ /年当たり。自動更新。いつでもキャンセルできます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"7일 무료, 그 이후에는 연간 %@ . 자동 갱신; 언제든지 취소하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"7 dagen gratis, daarna %@ per jaar. Automatische verlenging; op elk gewenst moment opzeggen."}},
