        "ja": {"stringUnit":{"state":"translated","value":"設定を確認し、設定済みのデフォルト値で初回のプライベートなエクスポートをプレビューしましょう。"}},
        "ko": {"stringUnit":{"state":"translated","value":"설정을 확인한 다음, 이미 구성된 기본값으로 첫 개인 내보내기를 미리 보세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Controleer je instellingen en bekijk vervolgens een voorbeeld van je eerste privé-export met de al ingestelde standaardwaarden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Revise sua configuração e veja uma prévia da sua primeira exportação privada com os padrões já configurados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"检查设置，然后使用已配置的默认选项预览首次私密导出。"}}
      }
    },
    "Save to an iPhone folder now, or connect the Mac app after onboarding to write exports to a Mac folder." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Speichere jetzt in einem iPhone-Ordner oder verbinde nach der Einrichtung die Mac-App, um Exporte in einen Mac-Ordner zu schreiben."}},
        "es": {"stringUnit":{"state":"translated","value":"Guarda en una carpeta del iPhone ahora o conecta la app para Mac después de la configuración inicial para escribir las exportaciones en una carpeta del Mac."}},
        "fr": {"stringUnit":{"state":"translated","value":"Enregistrez dans un dossier de l’iPhone maintenant, ou connectez l’app Mac après la configuration initiale pour écrire les exports dans un dossier du Mac."}},
        "it": {"stringUnit":{"state":"translated","value":"Salva ora in una cartella di iPhone oppure collega l’app per Mac dopo la configurazione iniziale per scrivere le esportazioni in una cartella del Mac."}},
        "ja": {"stringUnit":{"state":"translated","value":"今すぐiPhoneのフォルダに保存するか、初期設定後にMacアプリを接続してMacのフォルダにエクスポートできます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"지금 iPhone 폴더에 저장하거나, 초기 설정 후 Mac 앱을 연결하여 Mac 폴더에 내보내기 파일을 저장하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Sla nu op in een iPhone-map of verbind de Mac-app na de introductie om exports naar een Mac-map te schrijven."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Salve em uma pasta do iPhone agora ou conecte o app para Mac após a configuração inicial para gravar exportações em uma pasta no Mac."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"现在保存到 iPhone 文件夹，或在初始设置后连接 Mac App，将导出文件写入 Mac 文件夹。"}}
      }
    },
