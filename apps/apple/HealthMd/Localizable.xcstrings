    },
    "%@: sample end boundary %@. Earlier starts are preserved." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"%@: Endgrenze der Datenprobe %@. Frühere Startzeitpunkte bleiben erhalten."}},
        "es": {"stringUnit":{"state":"translated","value":"%@: límite final de las muestras %@. Se conservan los inicios anteriores."}},
        "fr": {"stringUnit":{"state":"translated","value":"%@ : limite de fin des échantillons %@. Les débuts antérieurs sont conservés."}},
        "it": {"stringUnit":{"state":"translated","value":"%@: limite finale del campione %@. Gli inizi precedenti vengono mantenuti."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@：サンプルの終了境界は%@。それより前の開始時点は保持されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@: 샘플 종료 경계 %@. 더 이른 시작 시점은 유지됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"%@: eindgrens van meetgegevens %@. Eerdere begintijden blijven behouden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"%@: limite final das amostras %@. Inícios anteriores são preservados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"%@：样本结束边界 %@。保留更早的开始时间。"}}
      }
    },
    "%lld out of 5 stars" : {
