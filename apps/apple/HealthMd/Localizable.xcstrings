    "Off · Enable the range summary to write one summary per format.": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off · Enable the range summary to write one summary per format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus · Aktivieren Sie die Zeitraumzusammenfassung, um eine Zusammenfassung pro Format zu schreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado · Activa el resumen del rango de fechas para escribir un resumen por formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé · Activez le résumé de la plage de dates pour écrire un résumé par format."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato · Attiva il riepilogo dell'intervallo per scrivere un riepilogo per formato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ · 形式ごとに概要を1つ書き出すには、期間の概要を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔 · 형식별로 요약 하나를 작성하려면 날짜 범위 요약을 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit · Schakel de samenvatting van het datumbereik in om één samenvatting per indeling te schrijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado · Ative o resumo do intervalo para gravar um resumo por formato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 · 启用日期范围摘要，以便每种格式写入一份摘要。"
          }
        }
      }
    },
    "Only the range summary will be written for the requested dates.": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the range summary will be written for the requested dates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die angeforderten Daten wird nur die Zeitraumzusammenfassung geschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se escribirá el resumen del rango de fechas solicitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le résumé de la plage de dates demandée sera écrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà scritto solo il riepilogo dell'intervallo di date richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した日付については、期間の概要のみが書き出されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 날짜에 대해서는 날짜 범위 요약만 작성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de gevraagde datums wordt alleen de samenvatting van het datumbereik geschreven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o resumo do intervalo de datas solicitado será gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅写入请求日期的日期范围摘要。"
          }
        }
      }
    },
