    "Undo Duplicate" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Duplizieren rückgängig machen"}},
        "es": {"stringUnit":{"state":"translated","value":"Deshacer duplicación"}},
        "fr": {"stringUnit":{"state":"translated","value":"Annuler la duplication"}},
        "it": {"stringUnit":{"state":"translated","value":"Annulla duplicazione"}},
        "ja": {"stringUnit":{"state":"translated","value":"複製を取り消す"}},
        "ko": {"stringUnit":{"state":"translated","value":"복제 실행 취소"}},
        "nl": {"stringUnit":{"state":"translated","value":"Dupliceren ongedaan maken"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Desfazer duplicação"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"撤销创建副本"}}
      }
    },
    "Undo is one-shot. The previous state was restored, so this import can no longer be undone." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Rückgängigmachen ist nur einmal möglich. Der vorherige Zustand wurde wiederhergestellt. Dieser Import kann daher nicht mehr rückgängig gemacht werden."}},
        "es": {"stringUnit":{"state":"translated","value":"Solo se puede deshacer una vez. Se ha restaurado el estado anterior, por lo que esta importación ya no se puede deshacer."}},
        "fr": {"stringUnit":{"state":"translated","value":"L’annulation n’est possible qu’une fois. L’état précédent a été restauré ; cette importation ne peut donc plus être annulée."}},
        "it": {"stringUnit":{"state":"translated","value":"L’annullamento è disponibile una sola volta. Lo stato precedente è stato ripristinato, quindi questa importazione non può più essere annullata."}},
        "ja": {"stringUnit":{"state":"translated","value":"取り消しは1回限りです。以前の状態に復元されたため、このインポートを再度取り消すことはできません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"실행 취소는 한 번만 가능합니다. 이전 상태가 복원되었으므로 이 가져오기는 더 이상 실행 취소할 수 없습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Ongedaan maken kan maar één keer. De vorige toestand is hersteld, dus deze import kan niet meer ongedaan worden gemaakt."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Só é possível desfazer uma vez. O estado anterior foi restaurado, então esta importação não pode mais ser desfeita."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"撤销只能执行一次。先前状态已恢复，因此无法再次撤销此次导入。"}}
      }
    },
