          }
        }
      }
    },
    "The iPhone sends one configured export job over Wi-Fi": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone sends one configured export job over Wi-Fi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iPhone sendet einen konfigurierten Exportauftrag über Wi-Fi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone envía un trabajo de exportación configurado a través de Wi-Fi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le iPhone envoie une tâche d'exportation configurée via Wi-Fi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone invia un lavoro di esportazione configurato su Wi-Fi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone は、Wi-Fi 経由で 1 つの構成済みエクスポート ジョブを送信します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone는 Wi-Fi를 통해 하나의 구성된 내보내기 작업을 보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iPhone verzendt één geconfigureerde exporttaak via Wi-Fi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone envia um trabalho de exportação configurado por Wi-Fi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 通过 Wi-Fi 发送一项配置的导出作业"
          }
        }
      }
    },
    "The metrics injected into your daily note match exactly what you've enabled in Export Settings → Health Metrics. Change your metric selection there to control what gets injected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die in Ihre tägliche Notiz eingefügten Metriken entsprechen genau den in Exporteinstellungen → Gesundheitsmetriken aktivierten. Ändern Sie dort Ihre Metrikauswahl, um zu steuern, was eingefügt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las métricas inyectadas en tu nota diaria coinciden exactamente con lo que has habilitado en Ajustes de exportación → Métricas de salud. Cambia tu selección de métricas allí para controlar lo que se inyecta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métriques injectées dans votre note quotidienne correspondent exactement à ce que vous avez activé dans Paramètres d'exportation → Métriques de santé. Modifiez votre sélection de métriques là-bas pour contrôler ce qui est injecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le metriche iniettate nella tua nota giornaliera corrispondono esattamente a quelle abilitate in Impostazioni di esportazione → Metriche sanitarie. Modifica la selezione delle metriche lì per controllare cosa viene iniettato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デイリーノートに注入される指標は、エクスポート設定 → ヘルス指標で有効にしたものと完全に一致します。注入される内容を制御するには、そこで指標の選択を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 노트에 주입되는 항목은 내보내기 설정 → 건강 항목에서 활성화한 항목과 정확히 일치합니다. 주입할 항목을 변경하려면 해당 설정에서 항목 선택을 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meetwaarden die in je dagelijkse notitie worden ingevoegd komen exact overeen met wat je hebt ingeschakeld bij Exportinstellingen → Gezondheidsmeetwaarden. Wijzig je meetwaardenselectie daar om te bepalen wat er wordt ingevoegd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As métricas injetadas na sua nota diária correspondem exatamente ao que você ativou em Configurações de Exportação → Métricas de Saúde. Altere sua seleção de métricas lá para controlar o que é injetado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注入每日笔记的指标与您在导出设置 → 健康指标中启用的完全一致。在那里更改指标选择以控制注入的内容。"
          }
        }
      }
    },
    "The sandboxed `healthmd` and `healthmd-mcp` helpers call fixed localhost routes; neither reads HealthKit directly.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sandboxed `healthmd` and `healthmd-mcp` helpers call fixed localhost routes; neither reads HealthKit directly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sandbox-Helfer `healthmd` und `healthmd-mcp` rufen feste Localhost-Routen auf; weder liest HealthKit direkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ayudantes de espacio aislado `healthmd` y `healthmd-mcp` llaman a rutas fijas de localhost; ninguno lee HealthKit directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les assistants `healthmd` et `healthmd-mcp` en bac à sable appellent des routes localhost fixes ; ni l’un ni l’autre ne lit directement HealthKit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli helper `healthmd` e `healthmd-mcp` in modalità sandbox chiamano percorsi localhost fissi; nessuno dei due legge direttamente HealthKit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックス化された `healthmd` および `healthmd-mcp` ヘルパーは、固定ローカルホスト ルートを呼び出します。どちらも HealthKit を直接読み取りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샌드박스 처리된 `healthmd` 및 `healthmd-mcp` 도우미는 고정된 localhost 경로를 호출합니다. HealthKit도 직접 읽지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De in de sandbox geplaatste `healthmd`- en `healthmd-mcp`-helpers roepen vaste localhost-routes aan; noch leest HealthKit rechtstreeks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os auxiliares `healthmd` e `healthmd-mcp` em área restrita chamam rotas de host local fixas; nenhum deles lê HealthKit diretamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙盒 `healthmd` 和 `healthmd-mcp` 帮助程序调用固定的本地主机路由；两者都不直接读取HealthKit。"
          }
        }
      }
    },
    "The saved export folder now resolves to a different location. Health.md stopped before writing any files. Review the location in Files, then re-select the intended folder.": {
      "comment": "Reviewed macOS display localization",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved export folder now resolves to a different location. Health.md stopped before writing any files. Review the location in Files, then re-select the intended folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Exportordner wird nun an einem anderen Speicherort aufgelöst. Health.md wurde vor dem Schreiben von Dateien gestoppt. Überprüfen Sie den Speicherort unter „Dateien“ und wählen Sie dann den gewünschten Ordner erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de exportación guardada ahora se resuelve en una ubicación diferente. Health.md se detuvo antes de escribir ningún archivo. Revise la ubicación en Archivos y luego vuelva a seleccionar la carpeta deseada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier d'exportation enregistré est désormais résolu vers un emplacement différent. Health.md s'est arrêté avant d'écrire des fichiers. Vérifiez l'emplacement dans Fichiers, puis resélectionnez le dossier souhaité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella di esportazione salvata ora si risolve in una posizione diversa. Health.md si è arrestato prima di scrivere qualsiasi file. Controlla la posizione in File, quindi seleziona nuovamente la cartella desiderata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたエクスポート フォルダーは別の場所に解決されるようになりました。 Health.md はファイルを書き込む前に停止しました。ファイル内の場所を確認し、目的のフォルダーを再選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 저장된 내보내기 폴더가 다른 위치로 확인됩니다. Health.md가 파일을 쓰기 전에 중지되었습니다. 파일에서 위치를 검토한 후 원하는 폴더를 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen exportmap wordt nu omgezet naar een andere locatie. Health.md stopte voordat er bestanden werden geschreven. Controleer de locatie in Bestanden en selecteer vervolgens opnieuw de beoogde map."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de exportação salva agora é resolvida em um local diferente. Health.md parou antes de gravar qualquer arquivo. Revise o local em Arquivos e selecione novamente a pasta desejada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的导出文件夹现在解析到不同的位置。 Health.md 在写入任何文件之前停止。查看“文件”中的位置，然后重新选择所需的文件夹。"
          }
        }
      }
    },
    "The selected item is a folder, not a Markdown file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Element ist ein Ordner und keine Markdown-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento seleccionado es una carpeta, no un archivo Markdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément sélectionné est un dossier, pas un fichier Markdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elemento selezionato è una cartella, non un file Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目はMarkdownファイルではなくフォルダです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목은 Markdown 파일이 아니라 폴더입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geselecteerde item is een map, geen Markdown-bestand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item selecionado é uma pasta, não um arquivo Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目是文件夹，而不是 Markdown 文件。"
          }
        }
      }
    },
    "The start date sets the repeating phase. Monthly schedules use the last day when a month is shorter.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start date sets the repeating phase. Monthly schedules use the last day when a month is shorter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Startdatum legt die Wiederholungsphase fest. Bei Monatsplänen wird der letzte Tag verwendet, wenn ein Monat kürzer ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de inicio marca la fase de repetición. Los cronogramas mensuales utilizan el último día cuando un mes es más corto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de début définit la phase de répétition. Les planifications mensuelles utilisent le dernier jour où un mois est plus court."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di inizio imposta la fase di ripetizione. Le pianificazioni mensili utilizzano l'ultimo giorno quando il mese è più breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日によって繰り返しフェーズが設定されます。月間スケジュールでは、1 か月が短い場合は末日を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 날짜는 반복 단계를 설정합니다. 월별 일정은 한 달이 더 짧은 마지막 날을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De startdatum bepaalt de herhalingsfase. Maandschema's gebruiken de laatste dag als een maand korter is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de início define a fase de repetição. As programações mensais usam o último dia quando o mês é mais curto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始日期设置重复阶段。当月份较短时，每月计划使用最后一天。"
          }
        }
      }
    },
    "There is no health data for the selected dates, or no formats are selected.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no health data for the selected dates, or no formats are selected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die ausgewählten Daten sind keine Gesundheitsdaten vorhanden oder es sind keine Formate ausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay datos de salud para las fechas seleccionadas o no se selecciona ningún formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a aucune donnée de santé pour les dates sélectionnées ou aucun format n'est sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono presenti dati sanitari per le date selezionate oppure non è selezionato alcun formato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日付の健康データがないか、形式が選択されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 날짜에 대한 건강 데이터가 없거나 선택한 형식이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen gezondheidsgegevens voor de geselecteerde datums, of er zijn geen formaten geselecteerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há dados de saúde para as datas selecionadas ou nenhum formato foi selecionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选日期没有健康数据，或未选择任何格式。"
          }
        }
      }
    },
    "These choices affect display values in exported files.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas opciones afectan a los valores mostrados en los archivos exportados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Optionen beeinflussen die angezeigten Werte in exportierten Dateien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces choix influent sur les valeurs affichées dans les fichiers exportés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste scelte influiscono sui valori visualizzati nei file esportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの選択は、エクスポートファイルに表示される値に影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
