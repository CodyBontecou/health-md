    "End the selected window today, including today’s incomplete health data." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Den ausgewählten Zeitraum heute beenden, einschließlich der unvollständigen Gesundheitsdaten von heute."}},
        "es": {"stringUnit":{"state":"translated","value":"Finalizar el intervalo seleccionado hoy, incluidos los datos de salud incompletos de hoy."}},
        "fr": {"stringUnit":{"state":"translated","value":"Terminer la période sélectionnée aujourd’hui, en incluant les données de santé incomplètes de la journée."}},
        "it": {"stringUnit":{"state":"translated","value":"Termina l’intervallo selezionato oggi, includendo i dati sanitari incompleti di oggi."}},
        "ja": {"stringUnit":{"state":"translated","value":"今日の未完了のヘルスデータを含め、選択した期間の終了日を今日にします。"}},
        "ko": {"stringUnit":{"state":"translated","value":"오늘의 불완전한 건강 데이터를 포함하여 선택한 기간을 오늘까지로 설정합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Laat de geselecteerde periode vandaag eindigen, inclusief de onvolledige gezondheidsgegevens van vandaag."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Encerre o período selecionado hoje, incluindo os dados de saúde incompletos de hoje."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"将所选时间段的结束日期设为今天，包括今天尚不完整的健康数据。"}}
      }
    },
    "Enter one of these addresses on iPhone. Port: %u" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Gib eine dieser Adressen auf dem iPhone ein. Port: %u"}},
        "es": {"stringUnit":{"state":"translated","value":"Introduce una de estas direcciones en el iPhone. Puerto: %u"}},
        "fr": {"stringUnit":{"state":"translated","value":"Saisissez l’une de ces adresses sur l’iPhone. Port : %u"}},
        "it": {"stringUnit":{"state":"translated","value":"Inserisci uno di questi indirizzi su iPhone. Porta: %u"}},
        "ja": {"stringUnit":{"state":"translated","value":"これらのアドレスのいずれかをiPhoneで入力してください。ポート：%u"}},
        "ko": {"stringUnit":{"state":"translated","value":"iPhone에서 이 주소 중 하나를 입력하세요. 포트: %u"}},
        "nl": {"stringUnit":{"state":"translated","value":"Voer een van deze adressen in op je iPhone. Poort: %u"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Digite um destes endereços no iPhone. Porta: %u"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在 iPhone 上输入以下任一地址。端口：%u"}}
      }
    },
    "Export-profile schedules restore their notifications when you reopen the app and avoid duplicate catch-up attempts." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Zeitpläne von Exportprofilen stellen beim erneuten Öffnen der App ihre Mitteilungen wieder her und vermeiden doppelte Nachholversuche."}},
        "es": {"stringUnit":{"state":"translated","value":"Las programaciones de los perfiles de exportación restauran sus notificaciones al volver a abrir la app y evitan intentos duplicados de recuperar ejecuciones pendientes."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les programmations des profils d’export rétablissent leurs notifications à la réouverture de l’app et évitent les tentatives de rattrapage en double."}},
        "it": {"stringUnit":{"state":"translated","value":"Le programmazioni dei profili di esportazione ripristinano le notifiche quando riapri l’app ed evitano tentativi di recupero duplicati."}},
        "ja": {"stringUnit":{"state":"translated","value":"アプリを再度開くとエクスポートプロファイルのスケジュール通知が復元され、未実行分の重複した再実行を防ぎます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"앱을 다시 열면 내보내기 프로필 일정의 알림이 복원되며, 누락된 실행을 중복으로 시도하지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Schema’s van exportprofielen herstellen hun meldingen wanneer je de app opnieuw opent en voorkomen dubbele inhaalpogingen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os agendamentos dos perfis de exportação restauram suas notificações quando você reabre o app e evitam tentativas duplicadas de recuperar execuções pendentes."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"重新打开 App 时，导出配置的计划会恢复通知，并避免重复尝试补执行。"}}
      }
    },
    "Exports the most recent days of health data, ending yesterday or optionally today." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Exportiert Gesundheitsdaten der letzten Tage bis einschließlich gestern oder optional heute."}},
        "es": {"stringUnit":{"state":"translated","value":"Exporta los días más recientes de datos de salud, hasta ayer u opcionalmente hasta hoy."}},
        "fr": {"stringUnit":{"state":"translated","value":"Exporte les jours les plus récents de données de santé, jusqu’à hier ou, si vous le souhaitez, jusqu’à aujourd’hui."}},
        "it": {"stringUnit":{"state":"translated","value":"Esporta i dati sanitari dei giorni più recenti, fino a ieri o, facoltativamente, a oggi."}},
        "ja": {"stringUnit":{"state":"translated","value":"昨日まで、または任意で今日までの直近の健康データをエクスポートします。"}},
        "ko": {"stringUnit":{"state":"translated","value":"어제까지 또는 선택에 따라 오늘까지의 최근 건강 데이터를 내보냅니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Exporteert gezondheidsgegevens van de meest recente dagen, tot en met gisteren of desgewenst vandaag."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Exporta os dias mais recentes de dados de saúde, até ontem ou, opcionalmente, até hoje."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"导出最近几天的健康数据，截止到昨天，也可选择截止到今天。"}}
      }
    },
    "Finish signing in on myself.md, then sign in with the same account in the myself.md app on iOS or Android." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Schließe die Anmeldung auf myself.md ab und melde dich dann mit demselben Konto in der myself.md-App auf iOS oder Android an."}},
        "es": {"stringUnit":{"state":"translated","value":"Termina de iniciar sesión en myself.md y después inicia sesión con la misma cuenta en la app de myself.md para iOS o Android."}},
        "fr": {"stringUnit":{"state":"translated","value":"Terminez la connexion sur myself.md, puis connectez-vous avec le même compte dans l’app myself.md sur iOS ou Android."}},
        "it": {"stringUnit":{"state":"translated","value":"Completa l’accesso su myself.md, poi accedi con lo stesso account nell’app myself.md su iOS o Android."}},
        "ja": {"stringUnit":{"state":"translated","value":"myself.mdでサインインを完了し、iOSまたはAndroidのmyself.mdアプリで同じアカウントを使ってサインインしてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"myself.md에서 로그인을 완료한 다음, iOS 또는 Android의 myself.md 앱에서 같은 계정으로 로그인하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Rond het inloggen op myself.md af en log daarna met hetzelfde account in bij de myself.md-app op iOS of Android."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Conclua o login no myself.md e depois entre com a mesma conta no app myself.md no iOS ou Android."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在 myself.md 上完成登录，然后在 iOS 或 Android 版 myself.md App 中使用同一账户登录。"}}
      }
    },
