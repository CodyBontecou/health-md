    "Context status is not loaded automatically, so ordinary Mac app use does not access Keychain.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context status is not loaded automatically, so ordinary Mac app use does not access Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontextstatus wird nicht automatisch geladen, sodass bei normaler Verwendung der Mac-App nicht auf Keychain zugegriffen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado del contexto no se carga automáticamente, por lo que el uso normal de la aplicación Mac no accede a Keychain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état du contexte n'est pas chargé automatiquement, donc l'utilisation ordinaire de l'application Mac n'accède pas à Keychain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato del contesto non viene caricato automaticamente, quindi l'utilizzo ordinario dell'app Mac non accede a Keychain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキスト ステータスは自動的に読み込まれないため、通常の Mac アプリの使用では Keychain にアクセスしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨텍스트 상태가 자동으로 로드되지 않으므로 일반적인 Mac 앱 사용은 Keychain에 액세스하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De contextstatus wordt niet automatisch geladen, dus normaal gebruik van de Mac-app heeft geen toegang tot Keychain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O status do contexto não é carregado automaticamente, portanto, o uso comum do aplicativo Mac não acessa Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文状态不会自动加载，因此普通 Mac 应用程序使用不会访问 Keychain。"
          }
        }
      }
    },
