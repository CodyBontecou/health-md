            "state": "translated",
            "value": "Time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure"
          }
        },
        "it": {
