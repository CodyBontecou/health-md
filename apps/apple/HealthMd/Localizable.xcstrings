        "de": {"stringUnit":{"state":"translated","value":"Umfangreiche Exportvorschauen sind zuverlässiger, wenn du vor dem Schreiben der Dateien größere Zeiträume prüfst."}},
        "es": {"stringUnit":{"state":"translated","value":"Las vistas previas de exportaciones extensas son más fiables al revisar intervalos de fechas amplios antes de escribir los archivos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les aperçus d’exportation longs sont plus fiables lorsque vous vérifiez de grandes plages de dates avant d’écrire les fichiers."}},
        "it": {"stringUnit":{"state":"translated","value":"Le anteprime di esportazioni lunghe sono più affidabili quando controlli intervalli di date estesi prima di scrivere i file."}},
        "ja": {"stringUnit":{"state":"translated","value":"ファイルを書き込む前に広い日付範囲を確認する際、長期間のエクスポートプレビューがより安定しました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"파일을 쓰기 전에 넓은 날짜 범위를 확인할 때 긴 내보내기 미리보기가 더 안정적으로 작동합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Lange exportvoorvertoningen zijn betrouwbaarder wanneer je grotere datumbereiken controleert voordat je bestanden schrijft."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Prévias de exportações longas são mais confiáveis ao verificar intervalos de datas maiores antes de gravar arquivos."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在写入文件前检查较大日期范围时，长篇导出预览更加可靠。"}}
      }
    },
