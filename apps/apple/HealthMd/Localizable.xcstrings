      }
    },
    "Temporary Files or cloud-provider errors no longer clear your selected vault, and exports write more safely." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Vorübergehende Fehler in „Dateien“ oder beim Cloud-Anbieter setzen deinen ausgewählten Vault nicht mehr zurück. Exporte werden zudem sicherer geschrieben."}},
        "es": {"stringUnit":{"state":"translated","value":"Los errores temporales de Archivos o del proveedor de la nube ya no borran la selección de tu bóveda, y las exportaciones se guardan de forma más segura."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les erreurs temporaires de Fichiers ou du fournisseur cloud ne réinitialisent plus le coffre sélectionné, et l’écriture des exports est plus sûre."}},
        "it": {"stringUnit":{"state":"translated","value":"Gli errori temporanei di File o del provider cloud non cancellano più la selezione del vault e le esportazioni vengono scritte in modo più sicuro."}},
        "ja": {"stringUnit":{"state":"translated","value":"「ファイル」やクラウドプロバイダの一時的なエラーで選択した保管庫が解除されなくなり、エクスポートの書き込みもより安全になりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"일시적인 파일 앱 또는 클라우드 제공업체 오류로 선택한 보관함이 해제되지 않으며, 내보내기 파일을 더 안전하게 기록합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Tijdelijke fouten in Bestanden of bij cloudproviders wissen je geselecteerde kluis niet meer, en exports worden veiliger weggeschreven."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Erros temporários do app Arquivos ou do provedor de nuvem não removem mais a seleção do seu cofre, e a gravação das exportações está mais segura."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"临时的“文件”或云服务商错误不再清除已选笔记库，导出写入也更安全。"}}
      }
    },
    "Terms" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Nutzungsbedingungen"}},
        "es": {"stringUnit":{"state":"translated","value":"Condiciones"}},
        "fr": {"stringUnit":{"state":"translated","value":"Conditions"}},
        "it": {"stringUnit":{"state":"translated","value":"Termini"}},
        "ja": {"stringUnit":{"state":"translated","value":"利用規約"}},
        "ko": {"stringUnit":{"state":"translated","value":"이용 약관"}},
