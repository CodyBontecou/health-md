          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté par IP manuelle / Tailscale ; vérifiez ci-dessous si la destination est prête"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegato tramite IP manuale / Tailscale; verifica qui sotto se la destinazione è pronta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動IP / Tailscaleで接続済み。以下でエクスポート先の準備状況を確認してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수동 IP / Tailscale로 연결됨. 아래에서 대상 준비 상태를 확인하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
