    "Listening on port %u. Generate a pairing code before connecting from iPhone." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Empfangsbereit auf Port %u. Erstelle einen Kopplungscode, bevor du eine Verbindung vom iPhone herstellst."}},
        "es": {"stringUnit":{"state":"translated","value":"Escuchando en el puerto %u. Genera un código de enlace antes de conectarte desde el iPhone."}},
        "fr": {"stringUnit":{"state":"translated","value":"À l’écoute sur le port %u. Générez un code de jumelage avant de vous connecter depuis l’iPhone."}},
        "it": {"stringUnit":{"state":"translated","value":"In ascolto sulla porta %u. Genera un codice di abbinamento prima di connetterti da iPhone."}},
        "ja": {"stringUnit":{"state":"translated","value":"ポート%uで待機中です。iPhoneから接続する前にペアリングコードを生成してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"포트 %u에서 연결을 기다리는 중입니다. iPhone에서 연결하기 전에 페어링 코드를 생성하세요."}},
