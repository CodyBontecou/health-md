    "Edit the report, then copy it before closing. Nothing is sent automatically. Avoid including private health data." : {
      "comment" : "Local feedback recovery and privacy instructions; reports are not sent or stored automatically",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeiten Sie den Bericht und kopieren Sie ihn, bevor Sie das Fenster schließen. Es wird nichts automatisch gesendet. Vermeiden Sie es, private Gesundheitsdaten einzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit the report, then copy it before closing. Nothing is sent automatically. Avoid including private health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita el informe y cópialo antes de cerrar. No se envía nada automáticamente. Evita incluir datos de salud privados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez le rapport, puis copiez-le avant de fermer. Rien n’est envoyé automatiquement. Évitez d’inclure des données de santé privées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica il resoconto e copialo prima di chiudere. Nulla viene inviato automaticamente. Evita di includere dati sanitari privati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートを編集し、閉じる前にコピーしてください。自動的に送信されることはありません。個人の健康データを含めないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서를 편집한 다음 닫기 전에 복사하세요. 아무것도 자동으로 전송되지 않습니다. 개인 건강 데이터는 포함하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerk het rapport en kopieer het voordat je sluit. Er wordt niets automatisch verzonden. Vermijd het opnemen van privégezondheidsgegevens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite o relatório e copie-o antes de fechar. Nada é enviado automaticamente. Evite incluir dados de saúde privados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑报告，然后在关闭前复制。不会自动发送任何内容。请勿包含私密健康数据。"
          }
        }
      }
    },
