    "Rechecked for this export. Query completion is not proof of full history." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Für diesen Export erneut geprüft. Eine abgeschlossene Abfrage ist kein Nachweis für einen vollständigen Verlauf."}},
        "es": {"stringUnit":{"state":"translated","value":"Se ha vuelto a comprobar para esta exportación. Que la consulta finalice no demuestra que el historial esté completo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Nouvelle vérification effectuée pour cet export. La fin de la requête ne prouve pas que l’historique est complet."}},
        "it": {"stringUnit":{"state":"translated","value":"Controllo ripetuto per questa esportazione. Il completamento della query non dimostra che la cronologia sia completa."}},
        "ja": {"stringUnit":{"state":"translated","value":"このエクスポート向けに再確認しました。クエリの完了は、履歴が完全であることの証明にはなりません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이번 내보내기를 위해 다시 확인했습니다. 쿼리가 완료되었다고 전체 기록이 확인된 것은 아닙니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Opnieuw gecontroleerd voor deze export. Een voltooide query bewijst niet dat de historie volledig is."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Verificado novamente para esta exportação. A conclusão da consulta não comprova que o histórico está completo."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已针对此次导出重新检查。查询完成并不代表历史记录完整。"}}
      }
    },
