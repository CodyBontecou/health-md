        "fr": {"stringUnit":{"state":"translated","value":"Balayez pour parcourir les aperçus des visualisations du module Health.md pour Obsidian"}},
        "it": {"stringUnit":{"state":"translated","value":"Scorri le anteprime delle visualizzazioni del plugin Health.md per Obsidian"}},
        "ja": {"stringUnit":{"state":"translated","value":"スワイプしてHealth.md Obsidianプラグインの可視化プレビューを表示"}},
        "ko": {"stringUnit":{"state":"translated","value":"쓸어넘겨 Health.md Obsidian 플러그인 시각화 미리보기 보기"}},
        "nl": {"stringUnit":{"state":"translated","value":"Veeg door de visualisatievoorbeelden van de Health.md Obsidian-plugin"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Deslize pelas prévias de visualização do plugin do Health.md para Obsidian"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"滑动浏览 Health.md Obsidian 插件的可视化预览"}}
