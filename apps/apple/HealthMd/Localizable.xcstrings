        "it": {"stringUnit":{"state":"translated","value":"Pronto per l’esportazione sul Mac"}},
        "ja": {"stringUnit":{"state":"translated","value":"Macへのエクスポート準備完了"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac으로 내보낼 준비 완료"}},
