    "Scheduled exports, your way" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante Exporte nach deinen Wünschen"}},
        "es": {"stringUnit":{"state":"translated","value":"Exportaciones programadas a tu manera"}},
        "fr": {"stringUnit":{"state":"translated","value":"Des exportations planifiées à votre façon"}},
        "it": {"stringUnit":{"state":"translated","value":"Esportazioni pianificate a modo tuo"}},
        "ja": {"stringUnit":{"state":"translated","value":"自分に合った定期エクスポート"}},
        "ko": {"stringUnit":{"state":"translated","value":"원하는 방식으로 내보내기 예약"}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande exports op jouw manier"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Exportações agendadas do seu jeito"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"按你的方式定时导出"}}
      }
    },
    "Scheduled runs can now write to your iPhone folder, send JSON to your API Endpoint, or deliver files to a connected Mac." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Geplante Durchläufe können jetzt in deinen iPhone-Ordner schreiben, JSON an deinen API-Endpunkt senden oder Dateien an einen verbundenen Mac übertragen."}},
        "es": {"stringUnit":{"state":"translated","value":"Las ejecuciones programadas ahora pueden escribir en tu carpeta del iPhone, enviar JSON a tu endpoint de API o entregar archivos a un Mac conectado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exécutions planifiées peuvent désormais écrire dans votre dossier sur l’iPhone, envoyer du JSON à votre point de terminaison API ou transférer des fichiers vers un Mac connecté."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esecuzioni pianificate ora possono scrivere nella cartella del tuo iPhone, inviare JSON al tuo endpoint API o trasferire file a un Mac connesso."}},
        "ja": {"stringUnit":{"state":"translated","value":"定期実行で、iPhoneのフォルダへの書き込み、APIエンドポイントへのJSON送信、接続済みMacへのファイル転送ができるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 예약 실행으로 iPhone 폴더에 저장하거나, API 엔드포인트로 JSON을 보내거나, 연결된 Mac으로 파일을 전송할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geplande uitvoeringen kunnen nu naar je iPhone-map schrijven, JSON naar je API-endpoint sturen of bestanden naar een verbonden Mac verzenden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As execuções agendadas agora podem gravar na pasta do seu iPhone, enviar JSON ao seu endpoint de API ou entregar arquivos a um Mac conectado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"定时任务现在可以写入你的 iPhone 文件夹、将 JSON 发送到你的 API 端点，或将文件传送到已连接的 Mac。"}}
      }
    },
    "Scheduled Workout Plans" : {
      "comment" : "macOS Health metric picker UI",
      "localizations" : {
