    "Cannot access the selected folder. Reconnect the location in Files or re-select the folder." : {
      "comment" : "Reviewed macOS display localization",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den ausgewählten Ordner kann nicht zugegriffen werden. Verbinden Sie den Speicherort in „Dateien“ erneut oder wählen Sie den Ordner erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot access the selected folder. Reconnect the location in Files or re-select the folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a la carpeta seleccionada. Vuelva a conectar la ubicación en Archivos o vuelva a seleccionar la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'accéder au dossier sélectionné. Reconnectez l'emplacement dans Fichiers ou resélectionnez le dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile accedere alla cartella selezionata. Ricollegare la posizione in File o selezionare nuovamente la cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダーにアクセスできません。ファイル内の場所を再接続するか、フォルダーを再選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더에 접근할 수 없습니다. 파일에서 위치를 다시 연결하거나 폴더를 다시 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen toegang tot de geselecteerde map. Verbind de locatie opnieuw in Bestanden of selecteer de map opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar a pasta selecionada. Reconecte o local em Arquivos ou selecione novamente a pasta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问选定的文件夹。重新连接“文件”中的位置或重新选择文件夹。"
          }
        }
      }
    },
