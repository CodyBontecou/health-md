    },
    "This removes every compact context day and its dedicated Keychain key. Exported files and Apple Health remain unchanged.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every compact context day and its dedicated Keychain key. Exported files and Apple Health remain unchanged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle kompakten Kontexttage und der zugehörige Schlüssel Keychain entfernt. Exportierte Dateien und Apple Health bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina cada día de contexto compacto y su clave Keychain dedicada. Los archivos exportados y Apple Health permanecen sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime chaque jour de contexte compact et sa clé dédiée Keychain. Les fichiers exportés et Apple Health restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimossi tutti i giorni di contesto compatti e la relativa chiave Keychain dedicata. I file esportati e Apple Health rimangono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのコンパクト コンテキスト日とその専用の Keychain キーが削除されます。エクスポートされたファイルと Apple Health は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 모든 컴팩트 컨텍스트 데이와 전용 Keychain 키가 제거됩니다. 내보낸 파일과 Apple Health는 변경되지 않은 상태로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt elke compacte contextdag en de speciale Keychain-sleutel verwijderd. Geëxporteerde bestanden en Apple Health blijven ongewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove todos os dias de contexto compacto e sua chave Keychain dedicada. Os arquivos exportados e Apple Health permanecem inalterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除每个紧凑上下文日及其专用 Keychain 密钥。导出的文件和 Apple Health 保持不变。"
          }
        }
      }
    },
    "This removes recorded iPhone→Mac sync and Mac export events from this Mac. Your synced health data and exported files are not affected.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes recorded iPhone→Mac sync and Mac export events from this Mac. Your synced health data and exported files are not affected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden aufgezeichnete iPhone→Mac-Synchronisierungs- und Mac-Exportereignisse aus diesem Mac entfernt. Ihre synchronisierten Gesundheitsdaten und exportierten Dateien sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la sincronización iPhone→Mac registrada y los eventos de exportación Mac de este Mac. Sus datos de salud sincronizados y archivos exportados no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les événements de synchronisation iPhone → Mac et d'exportation Mac enregistrés de ce Mac. Vos données de santé synchronisées et vos fichiers exportés ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò rimuove gli eventi di sincronizzazione iPhone→Mac registrati e di esportazione Mac da questo Mac. I tuoi dati sanitari sincronizzati e i file esportati non sono interessati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、記録された iPhone→Mac 同期イベントと Mac エクスポート イベントがこの Mac から削除されます。同期された健康データとエクスポートされたファイルは影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 이 Mac에서 기록된 iPhone→Mac 동기화 및 Mac 내보내기 이벤트가 제거됩니다. 동기화된 건강 데이터와 내보낸 파일은 영향을 받지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de opgenomen iPhone → Mac-synchronisatie en Mac-exportgebeurtenissen uit deze Mac verwijderd. Uw gesynchroniseerde gezondheidsgegevens en geëxporteerde bestanden worden niet beïnvloed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove a sincronização iPhone→Mac registrada e os eventos de exportação Mac deste Mac. Seus dados de saúde sincronizados e arquivos exportados não são afetados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从该 Mac 中删除记录的 iPhone→Mac 同步和 Mac 导出事件。您同步的健康数据和导出的文件不受影响。"
          }
        }
      }
    },
