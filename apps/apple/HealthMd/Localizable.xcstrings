      }
    },
    "Access is on. The paired CLI can connect when you run a direct command; no new code is required." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der Zugriff ist aktiviert. Die gekoppelte CLI kann sich verbinden, wenn du einen direkten Befehl ausführst; ein neuer Code ist nicht erforderlich."}},
        "es": {"stringUnit":{"state":"translated","value":"El acceso está activado. La CLI enlazada puede conectarse cuando ejecutes un comando directo; no se necesita un código nuevo."}},
        "fr": {"stringUnit":{"state":"translated","value":"L’accès est activé. La CLI jumelée peut se connecter lorsque vous exécutez une commande directe ; aucun nouveau code n’est nécessaire."}},
        "it": {"stringUnit":{"state":"translated","value":"L’accesso è attivo. La CLI abbinata può connettersi quando esegui un comando diretto; non serve un nuovo codice."}},
        "ja": {"stringUnit":{"state":"translated","value":"アクセスは有効です。直接コマンドを実行すると、ペアリング済みのCLIが接続できます。新しいコードは不要です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"접근이 켜져 있습니다. 직접 명령을 실행하면 페어링된 CLI가 연결할 수 있으며, 새 코드는 필요하지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Toegang is ingeschakeld. De gekoppelde CLI kan verbinding maken wanneer je een directe opdracht uitvoert; er is geen nieuwe code nodig."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O acesso está ativado. A CLI emparelhada pode se conectar quando você executar um comando direto; não é necessário um novo código."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"访问已开启。运行直接命令时，已配对的 CLI 即可连接，无需新的配对码。"}}
      }
    },
    "Choose a destination folder in Health.md on Mac." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wähle in Health.md auf dem Mac einen Zielordner aus."}},
        "es": {"stringUnit":{"state":"translated","value":"Elige una carpeta de destino en Health.md en el Mac."}},
        "fr": {"stringUnit":{"state":"translated","value":"Choisissez un dossier de destination dans Health.md sur Mac."}},
        "it": {"stringUnit":{"state":"translated","value":"Scegli una cartella di destinazione in Health.md sul Mac."}},
        "ja": {"stringUnit":{"state":"translated","value":"MacのHealth.mdで保存先フォルダを選択してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac의 Health.md에서 대상 폴더를 선택하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Kies een doelmap in Health.md op de Mac."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha uma pasta de destino no Health.md no Mac."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在 Mac 上的 Health.md 中选择目标文件夹。"}}
      }
    },
    "Connecting automatically to healthmd at %@:%@. Keep Health.md open until pairing completes." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Automatische Verbindung mit healthmd unter %@:%@ wird hergestellt. Lass Health.md geöffnet, bis die Kopplung abgeschlossen ist."}},
        "es": {"stringUnit":{"state":"translated","value":"Conectando automáticamente con healthmd en %@:%@. Mantén Health.md abierto hasta que termine el enlace."}},
        "fr": {"stringUnit":{"state":"translated","value":"Connexion automatique à healthmd à l’adresse %@:%@. Gardez Health.md ouvert jusqu’à la fin du jumelage."}},
        "it": {"stringUnit":{"state":"translated","value":"Connessione automatica a healthmd su %@:%@. Tieni aperta Health.md fino al completamento dell’abbinamento."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@:%@のhealthmdに自動接続しています。ペアリングが完了するまでHealth.mdを開いたままにしてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@:%@의 healthmd에 자동으로 연결 중입니다. 페어링이 완료될 때까지 Health.md를 열어 두세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Er wordt automatisch verbinding gemaakt met healthmd op %@:%@. Houd Health.md open totdat het koppelen is voltooid."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Conectando automaticamente ao healthmd em %@:%@. Mantenha o Health.md aberto até concluir o emparelhamento."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"正在自动连接到 %@:%@ 上的 healthmd。请保持 Health.md 开启，直到配对完成。"}}
      }
    },
