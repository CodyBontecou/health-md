    "Switch off to disable individual tracking for all enabled Health Metrics.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para detener el seguimiento individual de todas las métricas de salud habilitadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie dies aus, um keine der aktivierten Gesundheitsmetriken mehr einzeln zu erfassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez cette option pour arrêter le suivi individuel de tous les indicateurs de santé activés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa opzione per interrompere il monitoraggio individuale di tutte le metriche sanitarie abilitate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、有効なすべてのヘルス指標の個別トラッキングが無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 활성화된 모든 건강 항목의 개별 추적이 비활성화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel dit uit om het individueel bijhouden van alle ingeschakelde gezondheidsmeetwaarden te stoppen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para interromper o rastreamento individual de todas as Métricas de Saúde ativadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，将停用所有已启用健康指标的单独追踪。"
          }
        }
      }
    },
    "Enable metrics in Health Metrics before choosing individual entries.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilita métricas en Métricas de salud antes de elegir entradas individuales."
          }
        },
        "de": {
