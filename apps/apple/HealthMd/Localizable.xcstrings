    "Mac exports preserve roll-up settings more consistently when your iPhone prepares the data." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Mac-Exporte behalten die Aggregationseinstellungen zuverlässiger bei, wenn dein iPhone die Daten vorbereitet."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones al Mac conservan los ajustes de agregación de forma más coherente cuando el iPhone prepara los datos."}},
