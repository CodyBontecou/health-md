            "value" : "JSON"
          }
        }
      }
    },
    "JSON and CSV preserve the source archive while Markdown and Obsidian Bases remain readable daily summaries." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"JSON und CSV bewahren das Quellarchiv, während Markdown und Obsidian Bases lesbare tägliche Zusammenfassungen bleiben."}},
        "es": {"stringUnit":{"state":"translated","value":"JSON y CSV conservan el archivo de origen, mientras que Markdown y Obsidian Bases siguen ofreciendo resúmenes diarios legibles."}},
        "fr": {"stringUnit":{"state":"translated","value":"JSON et CSV préservent l’archive source, tandis que Markdown et Obsidian Bases restent des synthèses quotidiennes lisibles."}},
        "it": {"stringUnit":{"state":"translated","value":"JSON e CSV conservano l'archivio di origine, mentre Markdown e Obsidian Bases restano riepiloghi giornalieri leggibili."}},
        "ja": {"stringUnit":{"state":"translated","value":"JSON と CSV は元のアーカイブを保持し、Markdown と Obsidian Bases は読みやすい日次サマリーを提供します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"JSON과 CSV는 원본 아카이브를 보존하고, Markdown과 Obsidian Bases는 읽기 쉬운 일별 요약을 유지합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"JSON en CSV behouden het bronarchief, terwijl Markdown en Obsidian Bases leesbare dagelijkse samenvattingen blijven."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"JSON e CSV preservam o arquivo de origem, enquanto Markdown e Obsidian Bases continuam sendo resumos diários fáceis de ler."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"JSON 和 CSV 保留源归档，而 Markdown 和 Obsidian Bases 仍提供易读的每日摘要。"}}
      }
    },
    "JSON exports can include workout metadata, route details, time-series samples, and indoor workout context." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"JSON-Exporte können Trainingsmetadaten, Routendetails, Zeitreihenmesswerte und Kontext zu Indoor-Trainings enthalten."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones JSON pueden incluir metadatos de entrenamientos, detalles de rutas, muestras de series temporales y contexto de entrenamientos en interiores."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exportations JSON peuvent inclure les métadonnées des entraînements, les détails des itinéraires, les échantillons de séries temporelles et le contexte des entraînements en intérieur."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni JSON possono includere metadati degli allenamenti, dettagli dei percorsi, campioni di serie temporali e informazioni sugli allenamenti al chiuso."}},
        "ja": {"stringUnit":{"state":"translated","value":"JSON エクスポートには、ワークアウトのメタデータ、ルートの詳細、時系列サンプル、屋内ワークアウトの関連情報を含められます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"JSON 내보내기에는 운동 메타데이터, 경로 세부 정보, 시계열 샘플 및 실내 운동 맥락 정보가 포함될 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"JSON-exports kunnen work-outmetadata, routedetails, tijdreeksmetingen en context over indoorwork-outs bevatten."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As exportações JSON podem incluir metadados de treinos, detalhes de rotas, amostras de séries temporais e contexto de treinos em ambientes internos."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"JSON 导出可包含训练元数据、路线详情、时间序列样本和室内训练背景信息。"}}
      }
    },
