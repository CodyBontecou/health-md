    "On your Mac, open Mac Destination, enable Manual IP Connections, and generate a pairing code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie auf Ihrem Mac „Mac-Ziel“, aktivieren Sie „Manuelle IP-Verbindungen“ und erzeugen Sie einen Kopplungscode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el Mac, abre Destino Mac, habilita las conexiones IP manuales y genera un código de emparejamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre Mac, ouvrez Destination Mac, activez les connexions IP manuelles et générez un code de jumelage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul Mac, apri Destinazione Mac, abilita Connessioni IP manuali e genera un codice di abbinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macで「Macのエクスポート先」を開き、「手動IP接続」を有効にしてペアリングコードを生成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 Mac 내보내기 대상을 열고 수동 IP 연결을 활성화한 다음 페어링 코드를 생성하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Mac-bestemming op je Mac, schakel Handmatige IP-verbindingen in en genereer een koppelingscode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Mac, abra “Destino no Mac”, ative “Conexões IP manuais” e gere um código de emparelhamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Mac 上，打开“Mac 目标位置”，启用“手动 IP 连接”，并生成配对码。"
          }
        }
      }
    },
