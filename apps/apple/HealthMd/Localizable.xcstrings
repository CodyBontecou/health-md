    "Saved folder access needs to be refreshed. Reconnect or re-select the folder.": {
      "comment": "Reviewed macOS display localization",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved folder access needs to be refreshed. Reconnect or re-select the folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf gespeicherte Ordner muss aktualisiert werden. Stellen Sie die Verbindung wieder her oder wählen Sie den Ordner erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario actualizar el acceso a la carpeta guardada. Vuelva a conectarse o vuelva a seleccionar la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès aux dossiers enregistrés doit être actualisé. Reconnectez ou resélectionnez le dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alle cartelle salvate deve essere aggiornato. Riconnetti o riseleziona la cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたフォルダーへのアクセスを更新する必要があります。再接続するか、フォルダーを再選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 폴더 액세스를 새로 고쳐야 합니다. 폴더를 다시 연결하거나 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot opgeslagen mappen moet worden vernieuwd. Maak opnieuw verbinding of selecteer de map opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à pasta salva precisa ser atualizado. Reconecte ou selecione novamente a pasta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的文件夹访问需要刷新。重新连接或重新选择文件夹。"
          }
        }
      }
    },
    "Saved folder unavailable. Reconnect the location in Files or re-select the folder.": {
      "comment": "Reviewed macOS display localization",
