    "iOS determines the optimal background task timing. Make sure Background App Refresh is enabled for Health.md in Settings." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"iOS bestimmt den optimalen Zeitpunkt für Hintergrundaufgaben. Stelle sicher, dass die Hintergrundaktualisierung für Health.md in den Einstellungen aktiviert ist."}},
        "es": {"stringUnit":{"state":"translated","value":"iOS determina el momento óptimo para las tareas en segundo plano. Asegúrate de que la actualización en segundo plano esté activada para Health.md en Ajustes."}},
        "fr": {"stringUnit":{"state":"translated","value":"iOS détermine le moment optimal pour les tâches en arrière-plan. Vérifiez que l’actualisation en arrière-plan est activée pour Health.md dans Réglages."}},
        "it": {"stringUnit":{"state":"translated","value":"iOS determina il momento ottimale per le attività in background. Assicurati che Aggiorna app in background sia abilitato per Health.md nelle Impostazioni."}},
        "ja": {"stringUnit":{"state":"translated","value":"バックグラウンドタスクの最適な実行タイミングは iOS が決定します。「設定」で Health.md の「アプリのバックグラウンド更新」が有効になっていることを確認してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"iOS가 최적의 백그라운드 작업 시점을 결정합니다. 설정에서 Health.md의 백그라운드 앱 새로 고침이 활성화되어 있는지 확인하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"iOS bepaalt het optimale tijdstip voor achtergrondtaken. Zorg dat Ververs op achtergrond is ingeschakeld voor Health.md in Instellingen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O iOS determina o melhor momento para tarefas em segundo plano. Verifique se a Atualização em 2º Plano está ativada para o Health.md nos Ajustes."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"iOS 会决定后台任务的最佳执行时间。请确保已在“设置”中为 Health.md 启用“后台 App 刷新”。"}}
      }
    },
    "iOS determines the optimal background task timing. Make sure background refresh is enabled for Health.md in Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS bestimmt den optimalen Zeitpunkt für Hintergrundaufgaben. Stellen Sie sicher, dass die Hintergrundaktualisierung für Health.md in den Einstellungen aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS determines the optimal background task timing. Make sure background refresh is enabled for Health.md in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS determina el momento óptimo para las tareas en segundo plano. Asegúrate de que la actualización en segundo plano esté activada para Health.md en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS détermine le moment optimal pour les tâches en arrière-plan. Assurez-vous que l'actualisation en arrière-plan est activée pour Health.md dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS determina il momento ottimale per le attività in background. Assicurati che l'aggiornamento in background sia abilitato per Health.md nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSが最適なバックグラウンドタスクのタイミングを決定します。設定でHealth.mdのAppのバックグラウンド更新が有効になっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 최적의 백그라운드 작업 시점을 결정합니다. 설정에서 Health.md의 백그라운드 앱 새로고침이 활성화되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS bepaalt het optimale moment voor achtergrondtaken. Zorg dat achtergrondvernieuwing is ingeschakeld voor Health.md in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS determina o momento ideal para tarefas em segundo plano. Certifique-se de que a atualização em segundo plano esteja ativada para o Health.md nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 会自动确定最佳的后台任务执行时间。请确保在设置中为 Health.md 启用了后台应用刷新。"
          }
        }
      }
    },
    "iOS ended the background export before Health.md could finish writing all requested dates." : {
      "comment" : "Detailed error: task expired",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat den Hintergrundexport beendet, bevor Health.md alle angeforderten Daten schreiben konnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ended the background export before Health.md could finish writing all requested dates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS finalizó la exportación en segundo plano antes de que Health.md pudiera terminar de escribir todas las fechas solicitadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a mis fin à l'exportation en arrière-plan avant que Health.md ne puisse terminer l'écriture de toutes les dates demandées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ha terminato l'esportazione in background prima che Health.md potesse finire di scrivere tutte le date richieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md が要求されたすべての日付の書き込みを完了する前に、iOS はバックグラウンド エクスポートを終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 Health.md가 요청된 모든 날짜 쓰기를 완료하기 전에 백그라운드 내보내기를 종료했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS beëindigde de export op de achtergrond voordat Health.md het schrijven van alle gevraagde datums kon voltooien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS encerrou a exportação em segundo plano antes que Health.md pudesse terminar de gravar todas as datas solicitadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 在 Health.md 完成写入所有请求的日期之前结束了后台导出。"
          }
        }
      }
    },
    "iOS protected your health data because the iPhone was locked when Health.md tried to read it." : {
      "comment" : "Detailed error: device locked",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat Ihre Gesundheitsdaten geschützt, weil das iPhone gesperrt war, als Health.md versucht hat, darauf zuzugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS protected your health data because the iPhone was locked when Health.md tried to read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS protegió sus datos de salud porque el iPhone estaba bloqueado cuando Health.md intentó leerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a protégé vos données de santé car le iPhone était verrouillé lorsque le Health.md a tenté de le lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ha protetto i tuoi dati sanitari perché iPhone era bloccato quando Health.md ha provato a leggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md が読み取ろうとしたときに iPhone がロックされていたため、iOS はあなたの健康データを保護しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md가 건강 데이터를 읽으려고 할 때 iPhone가 잠겨 있었기 때문에 iOS는 건강 데이터를 보호했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS beschermde uw gezondheidsgegevens omdat de iPhone vergrendeld was toen Health.md deze probeerde te lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS protegeu seus dados de saúde porque o iPhone foi bloqueado quando Health.md tentou lê-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 保护了您的健康数据，因为当 Health.md 尝试读取 iPhone 时，iPhone 已被锁定。"
          }
        }
      }
    },
    "iOS uses this as the target time for background scheduling." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"iOS verwendet dies als Zielzeit für die Hintergrundplanung."}},
        "es": {"stringUnit":{"state":"translated","value":"iOS usa esta hora como objetivo para la programación en segundo plano."}},
        "fr": {"stringUnit":{"state":"translated","value":"iOS utilise cette heure comme cible pour la planification en arrière-plan."}},
        "it": {"stringUnit":{"state":"translated","value":"iOS usa questo orario come riferimento per la pianificazione in background."}},
        "ja": {"stringUnit":{"state":"translated","value":"iOS はこの時刻をバックグラウンド実行の目標時刻として使用します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"iOS는 이 시간을 백그라운드 작업 예약의 목표 시각으로 사용합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"iOS gebruikt dit als streeftijd voor de achtergrondplanning."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O iOS usa este horário como referência para o agendamento em segundo plano."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"iOS 将此时间用作后台调度的目标时间。"}}
      }
    },
