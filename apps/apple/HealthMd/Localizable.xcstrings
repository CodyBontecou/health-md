    "Every %lld days starting %@. Monthly schedules use the last day when a month is shorter." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Intervall in Tagen: %lld, Beginn: %@. Bei monatlichen Zeitplänen wird in kürzeren Monaten der letzte Tag verwendet."}},
        "es": {"stringUnit":{"state":"translated","value":"Cada %lld días a partir de %@. Las programaciones mensuales usan el último día cuando el mes es más corto."}},
        "fr": {"stringUnit":{"state":"translated","value":"Tous les %lld jours à partir du %@. Les programmations mensuelles utilisent le dernier jour lorsque le mois est plus court."}},
        "it": {"stringUnit":{"state":"translated","value":"Intervallo in giorni: %lld, a partire da %@. Per le programmazioni mensili, nei mesi più corti viene usato l’ultimo giorno."}},
        "ja": {"stringUnit":{"state":"translated","value":"%lld日ごと、%@から開始。月単位のスケジュールでは、該当日がない月は月末を使用します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%lld일마다, %@부터 시작합니다. 월간 일정에서 해당 날짜가 없는 달에는 그달의 마지막 날을 사용합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Elke %lld dagen vanaf %@. Bij maandelijkse schema's wordt de laatste dag gebruikt als een maand korter is."}},
