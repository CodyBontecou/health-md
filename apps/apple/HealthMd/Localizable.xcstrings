    "Context status is not loaded automatically, so ordinary Mac app use does not access Keychain." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kontextstatus wird nicht automatisch geladen, daher greift die normale Nutzung der Mac-App nicht auf den Schlüsselbund zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context status is not loaded automatically, so ordinary Mac app use does not access Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estado del contexto no se carga automáticamente, por lo que el uso normal de la aplicación Mac no accede a Keychain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'état du contexte n'est pas chargé automatiquement, donc l'utilisation ordinaire de l'application Mac n'accède pas à Keychain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stato del contesto non viene caricato automaticamente, quindi l'utilizzo ordinario dell'app Mac non accede a Keychain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキスト ステータスは自動的に読み込まれないため、通常の Mac アプリの使用では Keychain にアクセスしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
