    "Your existing purchase includes complimentary lifetime access to myself.md." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dein bestehender Kauf umfasst kostenlosen lebenslangen Zugriff auf myself.md."}},
