    "Improved onboarding guides you from Apple Health and folder setup to a ready-to-run preview.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verbesserte Einstieg führt dich von Apple Health und der Ordnerauswahl bis zu einer startbereiten Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio mejorado te guía desde Apple Health y la selección de carpeta hasta una vista previa lista para ejecutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parcours de démarrage amélioré vous guide d’Apple Health et du choix du dossier jusqu’à un aperçu prêt à être lancé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La procedura iniziale migliorata ti guida da Apple Health e dalla scelta della cartella fino a un’anteprima pronta da eseguire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改善された初期設定が、Apple Healthとフォルダの設定から、すぐ実行できるプレビューまで案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개선된 시작 과정이 Apple 건강 및 폴더 설정부터 바로 실행할 수 있는 미리보기까지 안내합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbeterde introductie begeleidt je van Apple Health en de mapkeuze naar een voorvertoning die klaar is om uit te voeren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A introdução aprimorada orienta você do Apple Health e da escolha da pasta até uma prévia pronta para executar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改进后的入门流程会从 Apple 健康和文件夹设置引导至可直接运行的预览。"
