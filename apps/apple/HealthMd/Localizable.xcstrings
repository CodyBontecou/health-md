    "Health.md has not requested %@ on this device yet. Apple Health will not list new data types until Health.md requests them." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md hat %1$@ auf diesem Gerät noch nicht angefordert. Apple Health listet neue Datentypen erst auf, wenn Health.md sie anfordert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md has not requested %1$@ on this device yet. Apple Health will not list new data types until Health.md requests them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md aún no ha solicitado %1$@ en este dispositivo. Apple Health no enumerará nuevos tipos de datos hasta que Health.md los solicite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md n’a pas encore demandé %1$@ sur cet appareil. Apple Health ne répertoriera pas les nouveaux types de données tant que Health.md ne les demandera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md non ha ancora richiesto %1$@ su questo dispositivo. Apple Health non elencherà i nuovi tipi di dati finché Health.md non li richiederà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md は、このデバイスで %1$@ をまだリクエストしていません。 Apple Health は、Health.md が要求するまで、新しいデータ型をリストしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md는 아직 이 장치에서 %1$@를 요청하지 않았습니다. Apple Health는 Health.md가 요청할 때까지 새 데이터 유형을 나열하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md heeft %1$@ nog niet aangevraagd op dit apparaat. Apple Health geeft geen nieuwe gegevenstypen weer totdat Health.md deze opvraagt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md ainda não solicitou %1$@ neste dispositivo. Apple Health não listará novos tipos de dados até que Health.md os solicite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md 尚未在此设备上请求 %1$@。在 Health.md 请求之前，Apple Health 不会列出新数据类型。"
          }
        }
      }
    },
