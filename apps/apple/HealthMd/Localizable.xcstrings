        "es": {"stringUnit":{"state":"translated","value":"Solo notas diarias está activado. Se conservan los formatos elegidos, pero no se generarán archivos agregados."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le mode Notes quotidiennes uniquement est actif. Les choix de format sont conservés, mais aucun fichier agrégé ne sera généré."}},
        "it": {"stringUnit":{"state":"translated","value":"La modalità Solo note giornaliere è attiva. Le scelte di formato vengono mantenute, ma non verranno generati file aggregati."}},
        "ja": {"stringUnit":{"state":"translated","value":"「デイリーノートのみ」が有効です。形式の選択は維持されますが、集約ファイルは生成されません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"일일 노트만 모드가 활성화되어 있습니다. 형식 선택은 유지되지만 통합 파일은 생성되지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Alleen dagelijkse notities is actief. Formaatkeuzes blijven behouden, maar er worden geen geaggregeerde bestanden gegenereerd."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Somente Notas Diárias está ativo. As opções de formato são preservadas, mas nenhum arquivo agregado será gerado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已启用“仅每日笔记”。格式选择会保留，但不会生成汇总文件。"}}
      }
    },
    "Daily Notes Only is active. Format choices are saved but aggregate files are skipped." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur tägliche Notizen ist aktiv. Die Formatauswahl wird gespeichert, die Aggregatdateien werden jedoch übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Notes Only is active. Format choices are saved but aggregate files are skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo notas diarias está activo. Las opciones de formato se guardan pero se omiten los archivos agregados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes quotidiennes uniquement est actif. Les choix de format sont enregistrés mais les fichiers agrégés sont ignorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È attivo solo gli appunti giornalieri. Le scelte del formato vengono salvate ma i file aggregati vengono saltati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「デイリーノートのみ」が有効です。形式の選択は保存されますが、集約ファイルはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘일일 노트만’이 활성화되어 있습니다. 형식 선택 사항은 저장되지만 집계 파일은 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen dagelijkse notities is actief. Formaatkeuzes worden opgeslagen, maar verzamelde bestanden worden overgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente notas diárias está ativo. As opções de formato são salvas, mas os arquivos agregados são ignorados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅每日笔记处于活动状态。格式选择将被保存，但聚合文件将被跳过。"
          }
        }
      }
    },
    "Daily Notes Only is active. Format choices are saved but no aggregate files will be generated." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"„Nur tägliche Notizen“ ist aktiv. Die Formatauswahl wird gespeichert, es werden jedoch keine aggregierten Dateien erstellt."}},
        "es": {"stringUnit":{"state":"translated","value":"Solo notas diarias está activado. Se guardan los formatos elegidos, pero no se generarán archivos agregados."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le mode Notes quotidiennes uniquement est actif. Les choix de format sont enregistrés, mais aucun fichier agrégé ne sera généré."}},
        "it": {"stringUnit":{"state":"translated","value":"La modalità Solo note giornaliere è attiva. Le scelte di formato vengono salvate, ma non verranno generati file aggregati."}},
        "ja": {"stringUnit":{"state":"translated","value":"「デイリーノートのみ」が有効です。形式の選択は保存されますが、集約ファイルは生成されません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"일일 노트만 모드가 활성화되어 있습니다. 형식 선택은 저장되지만 통합 파일은 생성되지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Alleen dagelijkse notities is actief. Formaatkeuzes worden opgeslagen, maar er worden geen geaggregeerde bestanden gegenereerd."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Somente Notas Diárias está ativo. As opções de formato são salvas, mas nenhum arquivo agregado será gerado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已启用“仅每日笔记”。格式选择已保存，但不会生成汇总文件。"}}
      }
    },
    "Daily Notes Only updates or creates your Obsidian daily notes while keeping aggregate files, ZIPs, roll-ups, individual entries, and provider sidecars out of the vault." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"„Nur tägliche Notizen“ aktualisiert oder erstellt deine täglichen Obsidian-Notizen, ohne aggregierte Dateien, ZIPs, Zusammenfassungen, Einzeleinträge oder Anbieter-Begleitdateien im Vault abzulegen."}},
        "es": {"stringUnit":{"state":"translated","value":"Solo notas diarias actualiza o crea tus notas diarias de Obsidian sin incluir en la bóveda archivos agregados, ZIP, resúmenes acumulados, entradas individuales ni archivos auxiliares de proveedores."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le mode Notes quotidiennes uniquement met à jour ou crée vos notes quotidiennes Obsidian sans ajouter au coffre de fichiers agrégés, de ZIP, de récapitulatifs, d’entrées individuelles ni de fichiers annexes des fournisseurs."}},
        "it": {"stringUnit":{"state":"translated","value":"Solo note giornaliere aggiorna o crea le note giornaliere di Obsidian senza inserire nel vault file aggregati, ZIP, riepiloghi, singole voci o file ausiliari dei provider."}},
        "ja": {"stringUnit":{"state":"translated","value":"「デイリーノートのみ」はObsidianのデイリーノートを更新または作成します。集約ファイル、ZIP、ロールアップ、個別エントリ、プロバイダーのサイドカーファイルは保管庫に保存しません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"일일 노트만 모드는 Obsidian 일일 노트를 업데이트하거나 생성하며, 통합 파일, ZIP, 집계 요약, 개별 항목, 제공업체 보조 파일은 보관함에 저장하지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Alleen dagelijkse notities werkt je dagelijkse Obsidian-notities bij of maakt ze aan, zonder geaggregeerde bestanden, ZIP-bestanden, samenvattingen, afzonderlijke items en aanvullende providerbestanden in de kluis te plaatsen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Somente Notas Diárias atualiza ou cria suas notas diárias do Obsidian, mantendo arquivos agregados, ZIPs, consolidações, entradas individuais e arquivos auxiliares de provedores fora do cofre."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"“仅每日笔记”会更新或创建您的 Obsidian 每日笔记，但不会在库中生成汇总文件、ZIP、汇总统计、单独条目或提供方附属文件。"}}
      }
    },
    "Daily Notes Only, custom schedules, and interrupted connected jobs preserve their intended destination and export dates more consistently." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"„Nur tägliche Notizen“, eigene Zeitpläne und unterbrochene Aufträge über eine Verbindung behalten ihr vorgesehenes Ziel und ihre Exportdaten zuverlässiger bei."}},
        "es": {"stringUnit":{"state":"translated","value":"Solo notas diarias, las programaciones personalizadas y las tareas mediante conexión interrumpidas conservan con mayor coherencia el destino y las fechas de exportación previstos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le mode Notes quotidiennes uniquement, les planifications personnalisées et les tâches connectées interrompues conservent plus systématiquement la destination et les dates d’exportation prévues."}},
        "it": {"stringUnit":{"state":"translated","value":"Solo note giornaliere, le pianificazioni personalizzate e le operazioni connesse interrotte mantengono in modo più coerente la destinazione e le date di esportazione previste."}},
        "ja": {"stringUnit":{"state":"translated","value":"「デイリーノートのみ」、カスタムスケジュール、中断された接続ジョブで、指定の保存先とエクスポート日がより確実に維持されるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"일일 노트만 모드, 사용자 지정 일정, 중단된 연결 작업에서 지정된 대상과 내보내기 날짜가 더 일관되게 유지됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Alleen dagelijkse notities, aangepaste schema's en onderbroken taken via een verbinding behouden hun beoogde bestemming en exportdatums consistenter."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Somente Notas Diárias, agendamentos personalizados e tarefas conectadas interrompidas preservam o destino e as datas de exportação previstos de forma mais consistente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"“仅每日笔记”、自定义计划和中断的连接任务现在能更一致地保留预定目标位置和导出日期。"}}
      }
    },
