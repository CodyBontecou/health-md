    "Previewing %@ with data. The full export will run on every selected date." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschau von %1$@ mit Daten. Der vollständige Export wird an jedem ausgewählten Datum ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previewing %1$@ with data. The full export will run on every selected date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa de %1$@ con datos. La exportación completa se ejecutará en cada fecha seleccionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu de %1$@ avec des données. L'exportation complète s'exécutera à chaque date sélectionnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima di %1$@ con dati. L'esportazione completa verrà eseguita in ogni data selezionata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを含む %1$@ をプレビューしています。完全なエクスポートは、選択した日付ごとに実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터가 포함된 %1$@ 미리보기. 전체 내보내기는 선택한 날짜마다 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorbeeld van %1$@ met gegevens. De volledige export wordt op elke geselecteerde datum uitgevoerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizando %1$@ com dados. A exportação completa será executada em todas as datas selecionadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用数据预览 %1$@。完整导出将在每个选定的日期运行。"
          }
        }
      }
    },
    "Previewing %@ with data. The full summary-only export processes %lld source days across the complete touched roll-up windows. Estimated output does not represent that processing work." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschau von %1$@ mit Daten. Der vollständige, nur zusammenfassende Export verarbeitet %2$lld Quelltage über die gesamten berührten Rollup-Fenster. Die geschätzte Ausgabe stellt diesen Verarbeitungsaufwand nicht dar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previewing %1$@ with data. The full summary-only export processes %2$lld source days across the complete touched roll-up windows. Estimated output does not represent that processing work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa de %1$@ con datos. La exportación completa de solo resumen procesa los días de origen %2$lld en todas las ventanas acumulativas tocadas. La producción estimada no representa ese trabajo de procesamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu de %1$@ avec des données. L'exportation de résumé complet traite uniquement les jours source %2$lld sur l'ensemble des fenêtres de cumul touchées. La production estimée ne représente pas ce travail de transformation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima di %1$@ con dati. L'esportazione del solo riepilogo completo elabora i giorni di origine %2$lld attraverso tutte le finestre di roll-up toccate. La produzione stimata non rappresenta il lavoro di elaborazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを含む %1$@ をプレビューしています。完全なサマリーのみのエクスポートは、完全なタッチされたロールアップ ウィンドウ全体で %2$lld ソース日を処理します。推定出力はその処理作業を表すものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터가 포함된 %1$@ 미리보기. 전체 요약 전용 내보내기는 전체 터치 롤업 창에서 %2$lld 소스 날짜를 처리합니다. 예상 출력은 해당 처리 작업을 나타내지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorbeeld van %1$@ met gegevens. De export met alleen het volledige overzicht verwerkt de %2$lld-brondagen over de volledige aangeraakte overzichtsvensters. De geschatte output weerspiegelt niet dat verwerkingswerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizando %1$@ com dados. A exportação completa apenas de resumo processa dias de origem %2$lld em todas as janelas de roll-up tocadas. A produção estimada não representa esse trabalho de processamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用数据预览 %1$@。完整的仅摘要导出在完整的触摸汇总窗口中处理 %2$lld 源天数。估计输出并不代表处理工作。"
          }
        }
      }
    },
    "Previewing %@ with data. The full summary-only export will fetch the complete touched roll-up windows." : {
