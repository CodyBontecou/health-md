    "Format folders are off by default for compatibility with existing plugins and shortcuts." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Formatordner sind standardmäßig deaktiviert, um die Kompatibilität mit bestehenden Plugins und Kurzbefehlen zu gewährleisten."}},
        "es": {"stringUnit":{"state":"translated","value":"Las carpetas por formato están desactivadas de forma predeterminada para mantener la compatibilidad con los complementos y atajos existentes."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les dossiers par format sont désactivés par défaut pour assurer la compatibilité avec les plugins et raccourcis existants."}},
        "it": {"stringUnit":{"state":"translated","value":"Le cartelle per formato sono disattivate per impostazione predefinita per garantire la compatibilità con i plugin e i comandi rapidi esistenti."}},
        "ja": {"stringUnit":{"state":"translated","value":"既存のプラグインやショートカットとの互換性を保つため、形式別フォルダはデフォルトでオフになっています。"}},
        "ko": {"stringUnit":{"state":"translated","value":"기존 플러그인 및 단축어와의 호환성을 위해 형식별 폴더는 기본적으로 꺼져 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Indelingsmappen zijn standaard uitgeschakeld voor compatibiliteit met bestaande plugins en opdrachten."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As pastas por formato ficam desativadas por padrão para manter a compatibilidade com plugins e atalhos existentes."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"格式文件夹默认关闭，以兼容现有插件和快捷指令。"}}
      }
    },
