        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufoptionen sind nicht verfügbar. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de compra no están disponibles. Inténtalo de nuevo más tarde."
