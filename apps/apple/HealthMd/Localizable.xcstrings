    "Create a durable copy of sleep, HRV, workouts, vitals, medications, and more." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erstelle eine dauerhafte Kopie von Schlafdaten, HRV, Trainings, Vitalwerten, Medikamenten und mehr."}},
        "es": {"stringUnit":{"state":"translated","value":"Crea una copia duradera de tus datos de sueño, VFC, entrenamientos, constantes vitales, medicamentos y más."}},
        "fr": {"stringUnit":{"state":"translated","value":"Créez une copie durable de vos données de sommeil, de VFC, d’entraînement, de constantes vitales, de médicaments et plus encore."}},
        "it": {"stringUnit":{"state":"translated","value":"Crea una copia duratura di sonno, HRV, allenamenti, parametri vitali, farmaci e altro."}},
        "ja": {"stringUnit":{"state":"translated","value":"睡眠、HRV、ワークアウト、バイタル、服薬などのデータを長期保存できるコピーとして作成します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"수면, HRV, 운동, 활력 징후, 복약 등의 데이터를 오래 보관할 사본으로 만드세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Maak een blijvende kopie van slaap, HRV, work-outs, vitale functies, medicatie en meer."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Crie uma cópia duradoura de dados de sono, HRV, treinos, sinais vitais, medicamentos e muito mais."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"为睡眠、HRV、体能训练、生命体征、用药等数据创建可长期保存的副本。"}}
      }
    },
