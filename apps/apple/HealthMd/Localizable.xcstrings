    "Tip: include JSON when you want the most complete backup for automation or future re-imports.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: include JSON when you want the most complete backup for automation or future re-imports."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Fügen Sie JSON hinzu, wenn Sie eine möglichst vollständige Sicherung für die Automatisierung oder zukünftige Re-Importe wünschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: incluya JSON cuando desee la copia de seguridad más completa para automatización o futuras reimportaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : incluez JSON lorsque vous souhaitez la sauvegarde la plus complète pour l'automatisation ou les réimportations futures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: includi JSON quando desideri il backup più completo per l'automazione o le future reimportazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント: 自動化または将来の再インポートのために最も完全なバックアップが必要な場合は、JSON を含めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 자동화 또는 향후 다시 가져오기를 위해 가장 완벽한 백업을 원할 경우 JSON를 포함하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: voeg JSON toe als u de meest complete back-up wilt voor automatisering of toekomstige herimporten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: inclua JSON quando desejar o backup mais completo para automação ou reimportações futuras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：当您需要最完整的备份以便自动化或将来重新导入时，请包括 JSON。"
          }
        }
      }
    },
