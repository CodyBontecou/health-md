      }
    },
    "Close other apps using the camera, then try again. Manual IP and pairing-code entry remain available." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Schließe andere Apps, die die Kamera verwenden, und versuche es erneut. IP-Adresse und Kopplungscode können weiterhin manuell eingegeben werden."}},
        "es": {"stringUnit":{"state":"translated","value":"Cierra las otras apps que usen la cámara y vuelve a intentarlo. Puedes seguir introduciendo manualmente la IP y el código de enlace."}},
        "fr": {"stringUnit":{"state":"translated","value":"Fermez les autres apps utilisant la caméra, puis réessayez. La saisie manuelle de l’adresse IP et du code de jumelage reste disponible."}},
        "it": {"stringUnit":{"state":"translated","value":"Chiudi le altre app che usano la fotocamera, poi riprova. Puoi comunque inserire manualmente l'indirizzo IP e il codice di abbinamento."}},
        "ja": {"stringUnit":{"state":"translated","value":"カメラを使用している他のアプリを閉じてから、もう一度お試しください。IPとペアリングコードの手動入力は引き続き利用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"카메라를 사용 중인 다른 앱을 닫고 다시 시도하세요. IP와 페어링 코드는 계속 직접 입력할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Sluit andere apps die de camera gebruiken en probeer het opnieuw. Je kunt het IP-adres en de koppelcode nog steeds handmatig invoeren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Feche outros apps que estejam usando a câmera e tente novamente. A inserção manual do IP e do código de pareamento continua disponível."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请关闭其他正在使用相机的 App，然后重试。您仍可手动输入 IP 和配对码。"}}
      }
    },
