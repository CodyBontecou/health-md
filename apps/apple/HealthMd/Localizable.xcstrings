    "Continued without a completed history assessment. History remains unverified." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ohne abgeschlossene Verlaufsprüfung fortgefahren. Der Verlauf bleibt ungeprüft."}},
        "es": {"stringUnit":{"state":"translated","value":"Se ha continuado sin completar la evaluación del historial. El historial sigue sin verificar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Poursuite sans évaluation complète de l’historique. L’historique reste non vérifié."}},
        "it": {"stringUnit":{"state":"translated","value":"Proseguimento senza una valutazione completa della cronologia. La cronologia resta non verificata."}},
        "ja": {"stringUnit":{"state":"translated","value":"履歴の評価が完了しないまま続行しました。履歴は未確認のままです。"}},
        "ko": {"stringUnit":{"state":"translated","value":"기록 평가를 완료하지 않고 계속했습니다. 기록은 여전히 확인되지 않은 상태입니다."}},
