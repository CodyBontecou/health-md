    "Control the folders Health.md creates before writing each export file." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Lege fest, welche Ordner Health.md vor dem Schreiben jeder Exportdatei erstellt."}},
        "es": {"stringUnit":{"state":"translated","value":"Controla las carpetas que Health.md crea antes de escribir cada archivo de exportación."}},
        "fr": {"stringUnit":{"state":"translated","value":"Définissez les dossiers que Health.md crée avant d’écrire chaque fichier exporté."}},
        "it": {"stringUnit":{"state":"translated","value":"Definisci le cartelle che Health.md crea prima di scrivere ogni file di esportazione."}},
        "ja": {"stringUnit":{"state":"translated","value":"各エクスポートファイルの書き込み前にHealth.mdが作成するフォルダを設定します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Health.md가 각 내보내기 파일을 저장하기 전에 생성할 폴더를 설정하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Bepaal welke mappen Health.md aanmaakt voordat elk exportbestand wordt geschreven."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Controle as pastas que o Health.md cria antes de gravar cada arquivo de exportação."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"设置 Health.md 在写入每个导出文件前创建的文件夹。"}}
      }
    },
