    "Try All Time or another date range. You can also open Apple Health and review Health.md under Profile → Apps and Services. If the device has no matching records, there is nothing to export yet.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try All Time or another date range. You can also open Apple Health and review Health.md under Profile → Apps and Services. If the device has no matching records, there is nothing to export yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es mit „Gesamter Zeitraum“ oder einem anderen Datumsbereich. Sie können auch Apple Health öffnen und Health.md unter Profil → Apps und Dienste überprüfen. Wenn das Gerät keine passenden Datensätze enthält, gibt es noch nichts zu exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebe «Todo el historial» u otro intervalo de fechas. También puede abrir Apple Health y revisar Health.md en Perfil → Apps y servicios. Si el dispositivo no tiene registros coincidentes, todavía no hay nada que exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez « Depuis toujours » ou une autre plage de dates. Vous pouvez également ouvrir Apple Health et consulter Health.md sous Profil → Apps et services. Si l’appareil ne contient aucun enregistrement correspondant, il n’y a encore rien à exporter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Tutto o un altro intervallo di date. Puoi anche aprire Apple Health e rivedere Health.md in Profilo → App e servizi. Se il dispositivo non ha record corrispondenti, non c'è ancora nulla da esportare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[すべての期間] または別の日付範囲を試してください。 Apple Health を開いて、[プロフィール] → [アプリとサービス] で Health.md を確認することもできます。デバイスに一致するレコードがない場合、エクスポートするものはまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 기간 또는 다른 기간을 사용해 보세요. 프로필 → 앱 및 서비스에서 Apple Health를 열고 Health.md를 검토할 수도 있습니다. 장치에 일치하는 기록이 없으면 아직 내보낼 항목이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer ‘Alle tijd’ of een ander datumbereik. U kunt ook Apple Health openen en Health.md bekijken onder Profiel → Apps en services. Als het apparaat geen overeenkomende records bevat, valt er nog niets te exporteren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente “Todo o Período” ou outro intervalo de datas. Você também pode abrir o Apple Health e revisar o Health.md em Perfil → Apps e Serviços. Se o dispositivo não tiver registros correspondentes, ainda não há nada para exportar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试“所有时间”或其他日期范围。您还可以打开 Apple Health 并在“个人资料”→“应用程序和服务”下查看 Health.md。如果设备没有匹配的记录，则还没有任何可导出的内容。"
          }
        }
      }
    },
    "Tune presentation settings without changing Health.md’s export schema.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la presentación sin cambiar el esquema de exportación de Health.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Darstellung an, ohne das Exportschema von Health.md zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez les réglages de présentation sans modifier le schéma d’exportation de Health.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola le impostazioni di presentazione senza modificare lo schema di esportazione di Health.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdのエクスポートスキーマを変更せずに表示設定を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md의 내보내기 스키마를 변경하지 않고 표시 설정을 조정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de weergave aan zonder het exportschema van Health.md te wijzigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste as configurações de apresentação sem alterar o esquema de exportação do Health.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整呈现设置，而不更改 Health.md 的导出数据结构。"
          }
        }
      }
    },
    "Turn off to keep generated output free of %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para no incluir %@ en los archivos generados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren Sie dies, damit die generierte Ausgabe frei von %@ bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez cette option pour exclure %@ de la sortie générée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa opzione per escludere %@ dall’output generato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を含まない出力を生成するにはオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 없이 출력을 생성하려면 끄세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel dit uit om de gegenereerde uitvoer vrij van %@ te houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para que a saída gerada não inclua %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，生成的输出中将不包含 %@。"
          }
        }
      }
    },
    "Turn this on to create one timestamped Markdown file per selected event when you run an export.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo para crear un archivo Markdown con fecha y hora por cada evento seleccionado al exportar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie dies, um bei einem Export für jedes ausgewählte Ereignis eine Markdown-Datei mit Zeitstempel zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option pour créer un fichier Markdown horodaté par événement sélectionné lors d’une exportation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva questa opzione per creare un file Markdown con data e ora per ogni evento selezionato quando esegui un’esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、エクスポート実行時に選択したイベントごとにタイムスタンプ付きのMarkdownファイルを1つ作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 켜면 내보내기를 실행할 때 선택한 이벤트마다 타임스탬프가 포함된 Markdown 파일을 하나씩 생성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel dit in om bij een export één Markdown-bestand met tijdstempel per geselecteerde gebeurtenis aan te maken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative esta opção para criar um arquivo Markdown com data e hora para cada evento selecionado ao executar uma exportação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启此选项后，每次运行导出时都会为每个所选事件创建一个带时间戳的 Markdown 文件。"
          }
        }
      }
    },
    "Turn this on to make the Mac app available as an export target.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo para que la app del Mac esté disponible como destino de exportación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie dies, damit die Mac-App als Exportziel verfügbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option pour rendre l’app pour Mac disponible comme destination d’exportation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva questa opzione per rendere l’app per Mac disponibile come destinazione di esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、Macアプリをエクスポート先として使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 켜면 Mac 앱을 내보내기 대상으로 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel dit in om de Mac-app beschikbaar te maken als exportbestemming."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative esta opção para disponibilizar o app para Mac como destino de exportação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启此选项后，可将 Mac 应用用作导出目标。"
          }
        }
      }
    },
