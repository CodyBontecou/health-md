            "state": "translated",
            "value": "Aktivieren Sie unter „Gesundheitsmetriken“ Metriken, bevor Sie individuelle Einträge auswählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez des indicateurs dans Indicateurs de santé avant de choisir des entrées individuelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita le metriche in Metriche sanitarie prima di scegliere le voci singole."
          }
        },
        "ja": {
