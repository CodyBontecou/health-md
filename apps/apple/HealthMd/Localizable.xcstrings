        "it": {"stringUnit":{"state":"translated","value":"Aiuto con WHOOP"}},
        "ja": {"stringUnit":{"state":"translated","value":"WHOOPのヘルプ"}},
        "ko": {"stringUnit":{"state":"translated","value":"WHOOP 도움말"}},
        "nl": {"stringUnit":{"state":"translated","value":"Hulp bij WHOOP"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Ajuda com o WHOOP"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"WHOOP 帮助"}}
      }
    },
    "History access details" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Details zum Verlaufszugriff"}},
        "es": {"stringUnit":{"state":"translated","value":"Detalles del acceso al historial"}},
        "fr": {"stringUnit":{"state":"translated","value":"Détails de l’accès à l’historique"}},
        "it": {"stringUnit":{"state":"translated","value":"Dettagli di accesso alla cronologia"}},
        "ja": {"stringUnit":{"state":"translated","value":"履歴アクセスの詳細"}},
        "ko": {"stringUnit":{"state":"translated","value":"기록 접근 세부 정보"}},
        "nl": {"stringUnit":{"state":"translated","value":"Details over toegang tot de historie"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Detalhes do acesso ao histórico"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"历史访问详情"}}
      }
    },
    "How many days to export, ending yesterday or today when Include Today is on." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Anzahl der zu exportierenden Tage bis einschließlich gestern oder heute, wenn „Heute einschließen“ aktiviert ist."}},
        "es": {"stringUnit":{"state":"translated","value":"Cuántos días exportar, hasta ayer o hasta hoy si Incluir hoy está activado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Nombre de jours à exporter, jusqu’à hier ou jusqu’à aujourd’hui si l’option Inclure aujourd’hui est activée."}},
        "it": {"stringUnit":{"state":"translated","value":"Numero di giorni da esportare, fino a ieri oppure a oggi se Includi oggi è attivo."}},
        "ja": {"stringUnit":{"state":"translated","value":"昨日までの何日分をエクスポートするかを指定します。「今日を含める」がオンの場合は今日までが対象です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"어제까지 내보낼 일수입니다. 오늘 포함을 켜면 오늘까지 내보냅니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Het aantal te exporteren dagen, tot en met gisteren of vandaag als Vandaag meenemen is ingeschakeld."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Quantidade de dias a exportar, até ontem ou até hoje quando Incluir hoje estiver ativado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"要导出的天数，截止到昨天；开启“包含今天”时则截止到今天。"}}
      }
    },
    "I Reviewed the Files I Want to Share" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Ich habe die Dateien geprüft, die ich teilen möchte"}},
        "es": {"stringUnit":{"state":"translated","value":"He revisado los archivos que quiero compartir"}},
        "fr": {"stringUnit":{"state":"translated","value":"J’ai vérifié les fichiers que je souhaite partager"}},
        "it": {"stringUnit":{"state":"translated","value":"Ho controllato i file che voglio condividere"}},
        "ja": {"stringUnit":{"state":"translated","value":"共有するファイルを確認しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"공유할 파일을 검토했습니다"}},
        "nl": {"stringUnit":{"state":"translated","value":"Ik heb de bestanden die ik wil delen gecontroleerd"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Revisei os arquivos que quero compartilhar"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"我已检查要共享的文件"}}
      }
    },
    "If data is missing, WHOOP may not have scored the day yet, a permission may be missing, or WHOOP may be rate limiting requests. Reconnect after revoked or missing access, then retry the export later." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Falls Daten fehlen, hat WHOOP den Tag möglicherweise noch nicht bewertet, eine Berechtigung fehlt oder WHOOP begrenzt die Anfragerate. Verbinde dich bei widerrufenem oder fehlendem Zugriff erneut und versuche den Export später noch einmal."}},
        "es": {"stringUnit":{"state":"translated","value":"Si faltan datos, puede que WHOOP aún no haya puntuado el día, que falte algún permiso o que WHOOP esté limitando la frecuencia de las solicitudes. Vuelve a conectar si el acceso se ha revocado o falta y, después, vuelve a intentar la exportación más tarde."}},
        "fr": {"stringUnit":{"state":"translated","value":"Si des données manquent, WHOOP n’a peut-être pas encore évalué la journée, une autorisation peut manquer ou WHOOP peut limiter la fréquence des requêtes. Reconnectez-vous si l’accès a été révoqué ou n’est pas accordé, puis réessayez l’export plus tard."}},
        "it": {"stringUnit":{"state":"translated","value":"Se mancano dati, WHOOP potrebbe non aver ancora calcolato il punteggio della giornata, potrebbe mancare un’autorizzazione oppure WHOOP potrebbe limitare la frequenza delle richieste. Se l’accesso è stato revocato o manca, riconnetti e riprova l’esportazione più tardi."}},
        "ja": {"stringUnit":{"state":"translated","value":"データがない場合、WHOOPがその日のスコアをまだ算出していない、権限が不足している、またはWHOOPがリクエスト数を制限している可能性があります。アクセス権が取り消された、または不足している場合は再接続し、後でエクスポートを再試行してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"데이터가 누락된 경우 WHOOP이 아직 해당 날짜의 점수를 산출하지 않았거나, 권한이 없거나, WHOOP이 요청 빈도를 제한하고 있을 수 있습니다. 접근 권한이 취소되었거나 없는 경우 다시 연결한 후 나중에 내보내기를 다시 시도하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Als gegevens ontbreken, heeft WHOOP de dag mogelijk nog niet beoordeeld, ontbreekt er een machtiging of beperkt WHOOP het aantal verzoeken. Maak opnieuw verbinding als toegang is ingetrokken of ontbreekt en probeer de export later opnieuw."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Se faltarem dados, o WHOOP pode ainda não ter calculado a pontuação do dia, pode faltar uma permissão ou o WHOOP pode estar limitando a frequência das solicitações. Reconecte se o acesso tiver sido revogado ou estiver ausente e tente exportar novamente mais tarde."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"如果缺少数据，可能是 WHOOP 尚未完成当天评分、缺少权限，或 WHOOP 正在限制请求频率。如果访问权限已被撤销或缺失，请重新连接，然后稍后重试导出。"}}
      }
    },
    "If sleep is missing, try the preceding date. Morning sleep can appear in that date's summary even when its raw records are dated today. Query failures are listed separately; an empty result can also mean read access is unavailable." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wenn Schlafdaten fehlen, versuche es mit dem Vortag. Schlaf am Morgen kann in der Zusammenfassung dieses Datums erscheinen, auch wenn die Rohdaten auf heute datiert sind. Abfragefehler werden separat aufgeführt; ein leeres Ergebnis kann auch bedeuten, dass kein Lesezugriff verfügbar ist."}},
        "es": {"stringUnit":{"state":"translated","value":"Si faltan datos de sueño, prueba con la fecha anterior. El sueño de la mañana puede aparecer en el resumen de esa fecha aunque sus registros sin procesar tengan fecha de hoy. Los errores de consulta se muestran por separado; un resultado vacío también puede indicar que no hay acceso de lectura."}},
        "fr": {"stringUnit":{"state":"translated","value":"Si le sommeil est absent, essayez la date précédente. Le sommeil du matin peut apparaître dans le résumé de cette date même si ses enregistrements bruts sont datés d’aujourd’hui. Les échecs de requête sont répertoriés séparément ; un résultat vide peut aussi signifier que l’accès en lecture est indisponible."}},
        "it": {"stringUnit":{"state":"translated","value":"Se mancano i dati sul sonno, prova la data precedente. Il sonno del mattino può apparire nel riepilogo di quella data anche se i dati grezzi riportano la data di oggi. Gli errori delle query sono elencati separatamente; un risultato vuoto può anche indicare che l’accesso in lettura non è disponibile."}},
        "ja": {"stringUnit":{"state":"translated","value":"睡眠が見つからない場合は、前日をお試しください。朝の睡眠は、元の記録の日付が今日でも、前日のサマリーに表示されることがあります。クエリの失敗は別途表示されます。結果が空の場合、読み取りアクセスが利用できない可能性もあります。"}},
        "ko": {"stringUnit":{"state":"translated","value":"수면 데이터가 없다면 이전 날짜를 확인해 보세요. 아침 수면은 원본 기록의 날짜가 오늘이더라도 이전 날짜의 요약에 표시될 수 있습니다. 조회 실패는 별도로 표시됩니다. 결과가 비어 있으면 읽기 권한을 사용할 수 없다는 의미일 수도 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Ontbreken slaapgegevens? Probeer dan de voorgaande datum. Ochtendslaap kan in het overzicht van die datum staan, ook als de ruwe gegevens op vandaag zijn gedateerd. Mislukte gegevensopvragen worden apart vermeld; een leeg resultaat kan ook betekenen dat leestoegang niet beschikbaar is."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Se os dados de sono não aparecerem, tente a data anterior. O sono da manhã pode aparecer no resumo dessa data mesmo quando seus registros brutos têm a data de hoje. As falhas de consulta são listadas separadamente; um resultado vazio também pode significar que o acesso de leitura está indisponível."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"如果缺少睡眠数据，请尝试前一天的日期。即使原始记录的日期是今天，清晨的睡眠也可能出现在前一天的摘要中。查询失败会单独列出；结果为空也可能表示没有读取权限。"}}
      }
    },
    "Improved export history, connection recovery, and the export file browser." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Verbesserter Exportverlauf, Wiederherstellung von Verbindungen und Dateibrowser für Exporte."}},
        "es": {"stringUnit":{"state":"translated","value":"Mejoras en el historial de exportaciones, la recuperación de la conexión y el explorador de archivos exportados."}},
        "fr": {"stringUnit":{"state":"translated","value":"Amélioration de l’historique d’export, du rétablissement de la connexion et du navigateur de fichiers exportés."}},
        "it": {"stringUnit":{"state":"translated","value":"Migliorati la cronologia delle esportazioni, il ripristino della connessione e il browser dei file esportati."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポート履歴、接続の復旧、エクスポートファイルのブラウザを改善しました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기 기록, 연결 복구 및 내보낸 파일 탐색기가 개선되었습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Verbeterde exportgeschiedenis, verbindingsherstel en bestandsbrowser voor exports."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Melhorias no histórico de exportações, na recuperação da conexão e no navegador de arquivos exportados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"改进了导出历史、连接恢复和导出文件浏览器。"}}
      }
    },
    "Improved scheduled notification setup and recovery after temporary delivery errors." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Verbesserte Einrichtung geplanter Mitteilungen und Wiederherstellung nach vorübergehenden Zustellfehlern."}},
        "es": {"stringUnit":{"state":"translated","value":"Mejoras en la configuración de notificaciones programadas y en su recuperación tras errores temporales de entrega."}},
        "fr": {"stringUnit":{"state":"translated","value":"Amélioration de la configuration des notifications programmées et de leur rétablissement après des erreurs temporaires de distribution."}},
        "it": {"stringUnit":{"state":"translated","value":"Migliorati la configurazione delle notifiche programmate e il ripristino dopo errori temporanei di consegna."}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュール通知の設定と、一時的な配信エラー後の復旧を改善しました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 알림 설정과 일시적인 전송 오류 후 복구가 개선되었습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Verbeterde instelling van geplande meldingen en herstel na tijdelijke bezorgfouten."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Melhorias na configuração de notificações agendadas e na recuperação após erros temporários de entrega."}},
