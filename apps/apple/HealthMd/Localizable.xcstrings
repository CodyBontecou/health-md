    "Choose the naming template Health.md applies to every exported file." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wähle die Namensvorlage, die Health.md für jede exportierte Datei verwendet."}},
        "es": {"stringUnit":{"state":"translated","value":"Elige la plantilla de nombres que Health.md aplica a cada archivo exportado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Choisissez le modèle de nom que Health.md applique à chaque fichier exporté."}},
        "it": {"stringUnit":{"state":"translated","value":"Scegli il modello di nome che Health.md applica a ogni file esportato."}},
        "ja": {"stringUnit":{"state":"translated","value":"Health.mdがすべてのエクスポートファイルに適用する命名テンプレートを選択します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Health.md가 내보내는 모든 파일에 적용할 이름 템플릿을 선택하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Kies het naamsjabloon dat Health.md voor elk geëxporteerd bestand gebruikt."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha o modelo de nome que o Health.md aplica a cada arquivo exportado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"选择 Health.md 用于每个导出文件的命名模板。"}}
      }
    },
