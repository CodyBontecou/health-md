        "pt-BR": {"stringUnit":{"state":"translated","value":"Obter o app para Mac"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"获取 Mac App"}}
      }
    },
    "Grant read access for the categories you want to export. You can adjust this later in the Health app." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erlaube den Lesezugriff auf die Kategorien, die du exportieren möchtest. Du kannst dies später in der Health-App anpassen."}},
        "es": {"stringUnit":{"state":"translated","value":"Concede acceso de lectura a las categorías que quieras exportar. Puedes cambiarlo más tarde en la app Salud."}},
        "fr": {"stringUnit":{"state":"translated","value":"Autorisez la lecture des catégories à exporter. Vous pourrez modifier ces autorisations plus tard dans l’app Santé."}},
        "it": {"stringUnit":{"state":"translated","value":"Consenti l’accesso in lettura alle categorie che vuoi esportare. Puoi modificarlo in seguito nell’app Salute."}},
        "ja": {"stringUnit":{"state":"translated","value":"エクスポートしたいカテゴリの読み取りを許可してください。後でヘルスケアアプリから変更できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보낼 카테고리의 읽기 권한을 허용하세요. 나중에 건강 앱에서 변경할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Geef leestoegang tot de categorieën die je wilt exporteren. Je kunt dit later aanpassen in de Gezondheid-app."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Permita a leitura das categorias que deseja exportar. Você pode ajustar isso depois no app Saúde."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"授予要导出的类别的读取权限。你可以稍后在“健康”App 中调整。"}}
      }
    },
    "Health.md does not need a server account to export local files." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Health.md benötigt kein Serverkonto, um lokale Dateien zu exportieren."}},
        "es": {"stringUnit":{"state":"translated","value":"Health.md no necesita una cuenta de servidor para exportar archivos locales."}},
        "fr": {"stringUnit":{"state":"translated","value":"Health.md n’a pas besoin de compte serveur pour exporter des fichiers locaux."}},
        "it": {"stringUnit":{"state":"translated","value":"Health.md non richiede un account su un server per esportare file locali."}},
        "ja": {"stringUnit":{"state":"translated","value":"Health.mdでローカルファイルにエクスポートする際、サーバーアカウントは不要です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Health.md는 로컬 파일을 내보내는 데 서버 계정이 필요하지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Health.md heeft geen serveraccount nodig om lokale bestanden te exporteren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O Health.md não precisa de uma conta em servidor para exportar arquivos locais."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Health.md 导出本地文件无需服务器账户。"}}
      }
    },
    "Health.md will write exports directly into this folder." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Health.md schreibt Exporte direkt in diesen Ordner."}},
        "es": {"stringUnit":{"state":"translated","value":"Health.md escribirá las exportaciones directamente en esta carpeta."}},
        "fr": {"stringUnit":{"state":"translated","value":"Health.md écrira les exports directement dans ce dossier."}},
        "it": {"stringUnit":{"state":"translated","value":"Health.md scriverà le esportazioni direttamente in questa cartella."}},
        "ja": {"stringUnit":{"state":"translated","value":"Health.mdはエクスポートをこのフォルダに直接書き込みます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Health.md가 내보내기 파일을 이 폴더에 직접 저장합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Health.md schrijft exports rechtstreeks naar deze map."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O Health.md gravará as exportações diretamente nesta pasta."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Health.md 会将导出文件直接写入此文件夹。"}}
      }
    },
    "Install the Mac app later to send iPhone-configured exports to a Mac folder." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Installiere die Mac-App später, um auf dem iPhone konfigurierte Exporte an einen Mac-Ordner zu senden."}},
        "es": {"stringUnit":{"state":"translated","value":"Instala la app para Mac más tarde para enviar las exportaciones configuradas en el iPhone a una carpeta del Mac."}},
        "fr": {"stringUnit":{"state":"translated","value":"Installez l’app Mac plus tard pour envoyer les exports configurés sur l’iPhone vers un dossier du Mac."}},
        "it": {"stringUnit":{"state":"translated","value":"Installa l’app per Mac in seguito per inviare le esportazioni configurate su iPhone a una cartella del Mac."}},
        "ja": {"stringUnit":{"state":"translated","value":"後でMacアプリをインストールすると、iPhoneで設定したエクスポートをMacのフォルダに送信できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"나중에 Mac 앱을 설치하면 iPhone에서 설정한 내보내기를 Mac 폴더로 보낼 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Installeer de Mac-app later om exports die je op je iPhone hebt geconfigureerd naar een Mac-map te sturen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Instale o app para Mac depois para enviar exportações configuradas no iPhone para uma pasta no Mac."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"稍后安装 Mac App，即可将在 iPhone 上配置的导出内容发送到 Mac 文件夹。"}}
      }
    },
    "Install the companion app before using Mac destinations." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Installiere die Begleit-App, bevor du Mac-Ziele verwendest."}},
        "es": {"stringUnit":{"state":"translated","value":"Instala la app complementaria antes de usar destinos del Mac."}},
        "fr": {"stringUnit":{"state":"translated","value":"Installez l’application complémentaire avant d’utiliser les destinations Mac."}},
        "it": {"stringUnit":{"state":"translated","value":"Installa l’app complementare prima di usare le destinazioni sul Mac."}},
        "ja": {"stringUnit":{"state":"translated","value":"Macの保存先を使うには、先にコンパニオンアプリをインストールしてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac 저장 위치를 사용하려면 먼저 연동 앱을 설치하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Installeer de bijbehorende app voordat je Mac-bestemmingen gebruikt."}},
