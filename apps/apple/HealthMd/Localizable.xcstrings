            "state" : "translated",
            "value" : "µS"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "µS"
          }
        }
      }
    },
    "%@: history assessment failed; readable data may still be available." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"%@: Verlaufsprüfung fehlgeschlagen; lesbare Daten können dennoch verfügbar sein."}},
        "es": {"stringUnit":{"state":"translated","value":"%@: ha fallado la evaluación del historial; puede que aún haya datos disponibles para leer."}},
        "fr": {"stringUnit":{"state":"translated","value":"%@ : échec de l’évaluation de l’historique ; des données lisibles peuvent rester disponibles."}},
        "it": {"stringUnit":{"state":"translated","value":"%@: valutazione della cronologia non riuscita; potrebbero essere comunque disponibili dati leggibili."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@：履歴の評価に失敗しました。読み取り可能なデータが存在する場合があります。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@: 기록 평가에 실패했습니다. 읽을 수 있는 데이터가 여전히 있을 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"%@: beoordeling van de historie mislukt; leesbare gegevens kunnen nog beschikbaar zijn."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"%@: a avaliação do histórico falhou; dados legíveis ainda podem estar disponíveis."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"%@：历史评估失败；仍可能有可读取的数据。"}}
      }
    },
    "%@: history assessment requires OS 27. This does not mean health data is unavailable." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"%@: Die Verlaufsprüfung erfordert OS 27. Das bedeutet nicht, dass keine Gesundheitsdaten verfügbar sind."}},
        "es": {"stringUnit":{"state":"translated","value":"%@: la evaluación del historial requiere OS 27. Esto no significa que los datos de salud no estén disponibles."}},
        "fr": {"stringUnit":{"state":"translated","value":"%@ : l’évaluation de l’historique nécessite OS 27. Cela ne signifie pas que les données de santé sont indisponibles."}},
        "it": {"stringUnit":{"state":"translated","value":"%@: la valutazione della cronologia richiede OS 27. Questo non significa che i dati sanitari non siano disponibili."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@：履歴の評価にはOS 27が必要です。健康データが利用できないという意味ではありません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@: 기록 평가에는 OS 27이 필요합니다. 건강 데이터를 사용할 수 없다는 뜻은 아닙니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"%@: beoordeling van de historie vereist OS 27. Dit betekent niet dat gezondheidsgegevens niet beschikbaar zijn."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"%@: a avaliação do histórico requer OS 27. Isso não significa que os dados de saúde estejam indisponíveis."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"%@：历史评估需要 OS 27。这并不表示健康数据不可用。"}}
      }
    },
    "%@: no authorization boundary returned; history access is unknown." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"%@: Keine Berechtigungsgrenze zurückgegeben; der Zugriff auf den Verlauf ist unbekannt."}},
        "es": {"stringUnit":{"state":"translated","value":"%@: no se ha devuelto ningún límite de autorización; se desconoce el acceso al historial."}},
        "fr": {"stringUnit":{"state":"translated","value":"%@ : aucune limite d’autorisation renvoyée ; l’accès à l’historique est inconnu."}},
        "it": {"stringUnit":{"state":"translated","value":"%@: nessun limite di autorizzazione restituito; l’accesso alla cronologia è sconosciuto."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@：認可の境界が返されませんでした。履歴へのアクセス可否は不明です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@: 권한 경계가 반환되지 않았습니다. 기록 접근 가능 여부를 알 수 없습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"%@: geen autorisatiegrens geretourneerd; toegang tot de historie is onbekend."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"%@: nenhum limite de autorização retornado; o acesso ao histórico é desconhecido."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"%@：未返回授权边界；历史访问权限未知。"}}
      }
    },
    "%@: not assessed (%@)." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"%@: nicht geprüft (%@)."}},
        "es": {"stringUnit":{"state":"translated","value":"%@: sin evaluar (%@)."}},
        "fr": {"stringUnit":{"state":"translated","value":"%@ : non évalué (%@)."}},
        "it": {"stringUnit":{"state":"translated","value":"%@: valutazione non effettuata (%@)."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@：未評価（%@）。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@: 평가되지 않음(%@)."}},
        "nl": {"stringUnit":{"state":"translated","value":"%@: niet beoordeeld (%@)."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"%@: sem avaliação (%@)."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"%@：未评估（%@）。"}}
