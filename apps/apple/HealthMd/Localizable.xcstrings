    "New commands require Health.md to be open. An active export can continue briefly in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Befehle erfordern, dass Health.md geöffnet ist. Ein aktiver Export kann kurzzeitig im Hintergrund fortgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comandos nuevos requieren que Health.md esté abierta. Una exportación activa puede continuar brevemente en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md doit être ouvert pour recevoir de nouvelles commandes. Une exportation en cours peut continuer brièvement en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health.md deve rimanere aperto per ricevere nuovi comandi. Un’esportazione attiva può continuare brevemente in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいコマンドを実行するにはHealth.mdを開いておく必要があります。進行中のエクスポートは、バックグラウンドでも短時間継続できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 명령을 사용하려면 Health.md가 열려 있어야 합니다. 진행 중인 내보내기는 백그라운드에서 잠시 계속될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor nieuwe opdrachten moet Health.md geopend zijn. Een actieve export kan nog korte tijd op de achtergrond doorgaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos comandos exigem que o Health.md esteja aberto. Uma exportação ativa pode continuar por pouco tempo em segundo plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新命令要求 Health.md 保持打开。正在进行的导出可在后台短暂继续。"
          }
        }
      }
    },
    "New Endpoint" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Neuer Endpunkt"}},
        "es": {"stringUnit":{"state":"translated","value":"Nuevo endpoint"}},
        "fr": {"stringUnit":{"state":"translated","value":"Nouveau point de terminaison"}},
        "it": {"stringUnit":{"state":"translated","value":"Nuovo endpoint"}},
        "ja": {"stringUnit":{"state":"translated","value":"新規エンドポイント"}},
        "ko": {"stringUnit":{"state":"translated","value":"새 엔드포인트"}},
        "nl": {"stringUnit":{"state":"translated","value":"Nieuw eindpunt"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Novo endpoint"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"新建端点"}}
      }
    },
    "New installs begin with summary-only exports. Lossless Health Records remains available when you need the complete canonical source archive." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Neue Installationen beginnen mit Exporten, die nur Zusammenfassungen enthalten. Verlustfreie Gesundheitsdatensätze bleiben verfügbar, wenn du das vollständige kanonische Quellarchiv benötigst."}},
        "es": {"stringUnit":{"state":"translated","value":"Las instalaciones nuevas comienzan con exportaciones solo de resúmenes. Registros de salud sin pérdida sigue disponible cuando necesites el archivo de origen canónico completo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les nouvelles installations commencent par des exportations limitées aux synthèses. Les données de santé sans perte restent disponibles lorsque vous avez besoin de l’archive source canonique complète."}},
        "it": {"stringUnit":{"state":"translated","value":"Le nuove installazioni iniziano con esportazioni solo riepilogative. Lossless Health Records resta disponibile quando serve l'archivio completo e canonico dei dati originali."}},
        "ja": {"stringUnit":{"state":"translated","value":"新規インストール時は、概要のみのエクスポートから始まります。完全な正規ソースアーカイブが必要な場合は、引き続き Lossless Health Records を利用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"새로 설치하면 요약만 내보내도록 설정됩니다. 완전한 정본 원본 아카이브가 필요할 때는 무손실 건강 기록을 계속 사용할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Nieuwe installaties beginnen met exports met alleen samenvattingen. Lossless Health Records blijft beschikbaar als je het volledige canonieke bronarchief nodig hebt."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Novas instalações começam com exportações apenas de resumos. Lossless Health Records continua disponível quando você precisar do arquivo-fonte canônico completo."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"全新安装默认仅导出摘要。当你需要完整的规范源数据存档时，仍可使用无损健康记录。"}}
      }
    },
    "New local API endpoint credential" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Neue lokale Zugangsdaten für den API-Endpunkt"}},
        "es": {"stringUnit":{"state":"translated","value":"Nueva credencial local para el endpoint de API"}},
        "fr": {"stringUnit":{"state":"translated","value":"Nouvelles informations d’authentification locales pour le point de terminaison API"}},
        "it": {"stringUnit":{"state":"translated","value":"Nuova credenziale locale per l'endpoint API"}},
        "ja": {"stringUnit":{"state":"translated","value":"新しいローカル API エンドポイント認証情報"}},
        "ko": {"stringUnit":{"state":"translated","value":"새 로컬 API 엔드포인트 인증 정보"}},
        "nl": {"stringUnit":{"state":"translated","value":"Nieuw lokaal toegangsgegeven voor API-eindpunt"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Nova credencial local do endpoint da API"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"新的本地 API 端点凭据"}}
      }
    },
    "New Mac-targeted exports are built on iPhone and sent directly to the selected folder. This cache is only for the old manual sync flow." : {
      "comment" : "macOS production UI",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue für den Mac bestimmte Exporte werden auf dem iPhone erstellt und direkt in den ausgewählten Ordner gesendet. Dieser Cache wird nur für den alten manuellen Synchronisationsablauf verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Mac-targeted exports are built on iPhone and sent directly to the selected folder. This cache is only for the old manual sync flow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas exportaciones orientadas a Mac se crean en iPhone y se envían directamente a la carpeta seleccionada. Este caché es solo para el antiguo flujo de sincronización manual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles exportations ciblées sur Mac sont créées sur iPhone et envoyées directement vers le dossier sélectionné. Ce cache est uniquement destiné à l'ancien flux de synchronisation manuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove esportazioni mirate a Mac sono basate su iPhone e inviate direttamente alla cartella selezionata. Questa cache è solo per il vecchio flusso di sincronizzazione manuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい Mac を対象としたエクスポートは、iPhone に基づいて構築され、選択したフォルダーに直接送信されます。このキャッシュは古い手動同期フロー専用です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 Mac 대상 내보내기는 iPhone에 구축되어 선택한 폴더로 직접 전송됩니다. 이 캐시는 이전 수동 동기화 흐름에만 사용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe Mac-gerichte exports zijn gebouwd op iPhone en rechtstreeks naar de geselecteerde map verzonden. Deze cache is alleen bedoeld voor de oude handmatige synchronisatiestroom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas exportações direcionadas a Mac são criadas em iPhone e enviadas diretamente para a pasta selecionada. Este cache é apenas para o antigo fluxo de sincronização manual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的针对 Mac 的导出基于 iPhone 构建，并直接发送到选定的文件夹。此缓存仅适用于旧的手动同步流程。"
          }
        }
      }
    },
