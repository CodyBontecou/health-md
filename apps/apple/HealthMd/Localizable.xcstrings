    "This version does not collect custom usage analytics or advertising attribution." : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This version does not collect custom usage analytics or advertising attribution."}},"de":{"stringUnit":{"state":"translated","value":"Diese Version erfasst keine eigenen Nutzungsanalysen oder Werbezuordnungen."}},"es":{"stringUnit":{"state":"translated","value":"Esta versión no recopila análisis de uso propios ni atribución publicitaria."}},"fr":{"stringUnit":{"state":"translated","value":"Cette version ne collecte aucune analyse d’utilisation interne ni donnée d’attribution publicitaire."}},"it":{"stringUnit":{"state":"translated","value":"Questa versione non raccoglie analisi di utilizzo proprietarie né dati di attribuzione pubblicitaria."}},"ja":{"stringUnit":{"state":"translated","value":"このバージョンは独自の利用状況分析データや広告アトリビューションデータを収集しません。"}},"ko":{"stringUnit":{"state":"translated","value":"이 버전은 자체 사용 분석이나 광고 기여도 데이터를 수집하지 않습니다."}},"nl":{"stringUnit":{"state":"translated","value":"Deze versie verzamelt geen eigen gebruiksanalyses of advertentietoewijzing."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esta versão não coleta análises de uso próprias nem dados de atribuição de publicidade."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此版本不收集自定义使用情况分析或广告归因数据。"}}}},
