          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para estrutura plana, ou use os espaços reservados abaixo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空表示平面结构，或使用下方的占位符"
          }
        }
      }
    },
    "Leave off if another plugin or template creates daily notes for you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo desactivado si otro plugin o plantilla crea tus notas diarias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie dies deaktiviert, wenn ein anderes Plugin oder eine Vorlage Ihre täglichen Notizen erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez cette option désactivée si une autre extension ou un autre modèle crée vos notes quotidiennes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia questa opzione disattivata se un altro plugin o modello crea le note giornaliere per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のプラグインやテンプレートでデイリーノートを作成する場合は、オフのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 플러그인이나 템플릿에서 일일 노트를 생성하는 경우 이 옵션을 꺼 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat dit uit als een andere plugin of sjabloon je dagelijkse notities aanmaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe desativado se outro plugin ou modelo criar suas notas diárias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果由其他插件或模板创建每日笔记，请保持关闭。"
          }
        }
      }
    },
    "Leave this off if you create your daily notes manually or via a template.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie dies deaktiviert, wenn Sie Ihre täglichen Notizen manuell oder über eine Vorlage erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja esto desactivado si creas tus notas diarias manualmente o mediante una plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez cette option désactivée si vous créez vos notes quotidiennes manuellement ou via un modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia disattivato se crei le tue note giornaliere manualmente o tramite un modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デイリーノートを手動またはテンプレートで作成している場合はオフのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일일 노트를 수동으로 또는 템플릿을 통해 만드는 경우 이 기능을 끄세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat dit uit als je dagelijkse notities handmatig of via een sjabloon aanmaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe desativado se você cria suas notas diárias manualmente ou por meio de um modelo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您手动或通过模板创建每日笔记，请保持关闭。"
          }
        }
      }
    },
