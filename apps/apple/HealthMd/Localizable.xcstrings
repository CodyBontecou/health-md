    "Schedules can include the past 1–30 complete days, and retries keep the same dates and destination if iOS delays a run." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Zeitpläne können die letzten 1–30 vollständigen Tage umfassen. Verzögert iOS einen Durchlauf, behalten Wiederholungsversuche dieselben Tage und dasselbe Ziel bei."}},
        "es": {"stringUnit":{"state":"translated","value":"Las programaciones pueden incluir entre 1 y 30 días completos anteriores, y los reintentos conservan las mismas fechas y el mismo destino si iOS retrasa una ejecución."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les planifications peuvent inclure les 1 à 30 derniers jours complets, et les nouvelles tentatives conservent les mêmes dates et la même destination si iOS retarde une exécution."}},
        "it": {"stringUnit":{"state":"translated","value":"Le pianificazioni possono includere da 1 a 30 giorni completi precedenti e i nuovi tentativi mantengono le stesse date e la stessa destinazione se iOS ritarda un’esecuzione."}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュールには、過去の完了した1〜30日分を含められます。iOSによって実行が遅れた場合も、再試行では同じ日付と出力先が保持されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 내보내기에는 오늘을 제외한 지난 1~30일의 데이터를 포함할 수 있으며, iOS가 실행을 지연하더라도 재시도 시 동일한 날짜와 대상을 유지합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Planningen kunnen de afgelopen 1–30 volledige dagen omvatten. Nieuwe pogingen behouden dezelfde datums en bestemming als iOS een uitvoering uitstelt."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os agendamentos podem incluir os últimos 1–30 dias completos, e as novas tentativas mantêm as mesmas datas e o mesmo destino se o iOS atrasar uma execução."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划可涵盖过去 1–30 个完整日；如果 iOS 延迟运行，重试时仍会保留相同的日期和目标位置。"}}
      }
    },
    "Schedules keep their intent" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Zeitpläne bleiben ihrer Vorgabe treu"}},
        "es": {"stringUnit":{"state":"translated","value":"Las programaciones conservan lo previsto"}},
        "fr": {"stringUnit":{"state":"translated","value":"Des planifications qui respectent vos choix"}},
        "it": {"stringUnit":{"state":"translated","value":"Le pianificazioni rispettano le tue scelte"}},
        "ja": {"stringUnit":{"state":"translated","value":"スケジュールの意図を保持"}},
        "ko": {"stringUnit":{"state":"translated","value":"예약 의도 그대로 유지"}},
        "nl": {"stringUnit":{"state":"translated","value":"Planningen blijven werken zoals bedoeld"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Agendamentos preservam o que você definiu"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"计划始终按原定设置执行"}}
      }
