        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaat dagelijkse bestanden en bijwerkingen over. Health.md haalt nog steeds de volledig aangeraakte perioden op om de ingeschakelde samenvattingen samen te stellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora arquivos diários e efeitos colaterais. Health.md ainda busca todos os períodos tocados para construir os resumos habilitados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
