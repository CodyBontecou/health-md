        "ja": {"stringUnit":{"state":"translated","value":"上で選択したフォルダにエクスポートします。必要に応じてサブフォルダやファイルの整理方法を設定できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"위에서 선택한 폴더로 내보냅니다. 하위 폴더와 파일 정리 방식을 선택할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Exporteert naar de hierboven geselecteerde map, met optionele submappen en bestandsordening."}},
