    "History remembers each destination" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der Verlauf merkt sich jedes Ziel"}},
        "es": {"stringUnit":{"state":"translated","value":"El historial recuerda cada destino"}},
        "fr": {"stringUnit":{"state":"translated","value":"L’historique mémorise chaque destination"}},
        "it": {"stringUnit":{"state":"translated","value":"La cronologia ricorda ogni destinazione"}},
        "ja": {"stringUnit":{"state":"translated","value":"履歴に各出力先を記録"}},
        "ko": {"stringUnit":{"state":"translated","value":"대상별로 기록 유지"}},
        "nl": {"stringUnit":{"state":"translated","value":"Geschiedenis onthoudt elke bestemming"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O histórico lembra cada destino"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"历史记录保留各个目标位置"}}
      }
    },
    "History stores request scope and counts only. Exported health values are not saved in this history." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der Verlauf speichert nur den Umfang der Anfragen und Anzahlen. Exportierte Gesundheitswerte werden nicht in diesem Verlauf gespeichert."}},
        "es": {"stringUnit":{"state":"translated","value":"El historial solo guarda el alcance de las solicitudes y los recuentos. Los valores de salud exportados no se guardan en este historial."}},
        "fr": {"stringUnit":{"state":"translated","value":"L’historique conserve uniquement le périmètre des requêtes et les décomptes. Les valeurs de santé exportées ne sont pas enregistrées dans cet historique."}},
        "it": {"stringUnit":{"state":"translated","value":"La cronologia conserva solo l'ambito delle richieste e i conteggi. I valori sanitari esportati non vengono salvati in questa cronologia."}},
        "ja": {"stringUnit":{"state":"translated","value":"履歴にはリクエストの対象範囲と件数のみが保存されます。エクスポートしたヘルスデータの値は、この履歴には保存されません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"기록에는 요청 범위와 개수만 저장됩니다. 내보낸 건강 수치는 이 기록에 저장되지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De geschiedenis bewaart alleen de reikwijdte van aanvragen en aantallen. Geëxporteerde gezondheidswaarden worden niet in deze geschiedenis opgeslagen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O histórico armazena apenas o escopo e as contagens das solicitações. Os valores de saúde exportados não são salvos neste histórico."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"历史记录仅存储请求范围和数量，不保存导出的健康数值。"}}
      }
    },
