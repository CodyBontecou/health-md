    "Close" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Schließen"}},
        "es": {"stringUnit":{"state":"translated","value":"Cerrar"}},
        "fr": {"stringUnit":{"state":"translated","value":"Fermer"}},
        "it": {"stringUnit":{"state":"translated","value":"Chiudi"}},
        "ja": {"stringUnit":{"state":"translated","value":"閉じる"}},
        "ko": {"stringUnit":{"state":"translated","value":"닫기"}},
        "nl": {"stringUnit":{"state":"translated","value":"Sluiten"}},
