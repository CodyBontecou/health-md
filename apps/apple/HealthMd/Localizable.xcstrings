    "Pin focused Health.md metrics to supported watch faces for faster daily check-ins." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Hefte gezielt Health.md-Metriken an unterstützte Zifferblätter, um sie täglich schneller im Blick zu haben."}},
        "es": {"stringUnit":{"state":"translated","value":"Fija métricas específicas de Health.md en esferas de reloj compatibles para consultarlas más rápido cada día."}},
        "fr": {"stringUnit":{"state":"translated","value":"Épinglez des indicateurs Health.md ciblés sur les cadrans compatibles pour un suivi quotidien plus rapide."}},
        "it": {"stringUnit":{"state":"translated","value":"Fissa le metriche Health.md che ti interessano sui quadranti supportati per controllarle più rapidamente ogni giorno."}},
        "ja": {"stringUnit":{"state":"translated","value":"注目する Health.md の指標を対応する文字盤に固定して、毎日の確認をすばやく行えます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"지원되는 시계 페이스에 주요 Health.md 항목을 고정하여 매일 더 빠르게 확인하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Zet specifieke Health.md-meetwaarden vast op ondersteunde wijzerplaten om ze dagelijks sneller te bekijken."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Fixe métricas específicas do Health.md em mostradores compatíveis para consultas diárias mais rápidas."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"将关注的 Health.md 指标固定到支持的表盘，更快查看每日状况。"}}
      }
    },
