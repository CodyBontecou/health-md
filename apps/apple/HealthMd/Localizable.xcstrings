    "clinician_report_warning_read_failure": {
      "comment": "Clinician Report V1 localized vocabulary. Managed by scripts/validate-clinician-report-localizations.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige ausgewählte Gesundheitsdaten konnten nicht gelesen werden. Leere Abschnitte können auf fehlenden Zugriff oder darauf zurückzuführen sein, dass keine Datensätze zurückgegeben wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some selected health data could not be read. Empty sections may reflect unavailable access or no records returned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer algunos datos de salud seleccionados. Las secciones vacías pueden deberse a que el acceso no está disponible o a que no se devolvieron registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données de santé sélectionnées n’ont pas pu être lues. Les sections vides peuvent indiquer un accès indisponible ou l’absence d’enregistrements renvoyés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere alcuni dati sanitari selezionati. Le sezioni vuote possono indicare un accesso non disponibile o l’assenza di record restituiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した健康データの一部を読み取れませんでした。空欄のセクションは、アクセスできないか、記録が返されなかったことを示す場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 건강 데이터 중 일부를 읽을 수 없습니다. 빈 섹션은 접근할 수 없거나 반환된 기록이 없음을 나타낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige geselecteerde gezondheidsgegevens konden niet worden gelezen. Lege secties kunnen het gevolg zijn van ontbrekende toegang of het ontbreken van geretourneerde records."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler alguns dados de saúde selecionados. Seções vazias podem indicar acesso indisponível ou nenhum registro retornado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分所选健康数据无法读取。空白部分可能表示无法访问或未返回任何记录。"
          }
        }
      }
    },
