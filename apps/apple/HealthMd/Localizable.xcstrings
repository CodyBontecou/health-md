    "Completes setup and opens a preview of your first export" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Schließt die Einrichtung ab und öffnet eine Vorschau deines ersten Exports"}},
        "es": {"stringUnit":{"state":"translated","value":"Completa la configuración y abre una vista previa de tu primera exportación"}},
        "fr": {"stringUnit":{"state":"translated","value":"Termine la configuration et ouvre un aperçu de votre premier export"}},
        "it": {"stringUnit":{"state":"translated","value":"Completa la configurazione e apre un’anteprima della tua prima esportazione"}},
        "ja": {"stringUnit":{"state":"translated","value":"設定を完了し、初回エクスポートのプレビューを開きます"}},
        "ko": {"stringUnit":{"state":"translated","value":"설정을 완료하고 첫 내보내기 미리보기를 엽니다"}},
        "nl": {"stringUnit":{"state":"translated","value":"Rondt de configuratie af en opent een voorbeeld van je eerste export"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Conclui a configuração e abre uma prévia da sua primeira exportação"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"完成设置并打开首次导出的预览"}}
      }
    },
    "Connect to preview your health data" : {
