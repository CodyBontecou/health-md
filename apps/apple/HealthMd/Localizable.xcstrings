    "Health.md listens only on localhost and owns iPhone connection state.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md listens only on localhost and owns iPhone connection state."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md überwacht nur den lokalen Host und besitzt den Verbindungsstatus iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md escucha solo en el host local y posee el estado de conexión iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md écoute uniquement sur localhost et possède l'état de connexion iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md ascolta solo su localhost e possiede lo stato di connessione iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md はローカルホストでのみリッスンし、iPhone 接続状態を所有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 localhost에서만 수신 대기하며 iPhone 연결 상태를 소유합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md luistert alleen op localhost en is eigenaar van de iPhone-verbindingsstatus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md escuta apenas no host local e possui o estado de conexão iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 仅在本地主机上侦听并拥有 iPhone 连接状态。"
          }
        }
      }
    },
    "Health.md on iPhone reads Apple Health, applies your selected formats and settings, then sends export jobs to this Mac over the local network — nothing is uploaded to the cloud.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md on iPhone reads Apple Health, applies your selected formats and settings, then sends export jobs to this Mac over the local network — nothing is uploaded to the cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md auf iPhone liest Apple Health, wendet Ihre ausgewählten Formate und Einstellungen an und sendet dann Exportaufträge über das lokale Netzwerk an diesen Mac – es wird nichts in die Cloud hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md en iPhone lee Apple Health, aplica los formatos y configuraciones seleccionados y luego envía trabajos de exportación a este Mac a través de la red local; no se carga nada en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md sur iPhone lit Apple Health, applique les formats et paramètres sélectionnés, puis envoie les tâches d'exportation à ce Mac via le réseau local — rien n'est téléchargé sur le cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md su iPhone legge Apple Health, applica i formati e le impostazioni selezionati, quindi invia processi di esportazione a questo Mac sulla rete locale: nulla viene caricato sul cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の Health.md は、Apple Health を読み取り、選択した形式と設定を適用して、ローカル ネットワーク経由でこの Mac にエクスポート ジョブを送信します。クラウドには何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Health.md는 Apple Health를 읽고 선택한 형식과 설정을 적용한 다음 로컬 네트워크를 통해 이 Mac에 내보내기 작업을 보냅니다. 클라우드에는 아무것도 업로드되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md op iPhone leest Apple Health, past de door u geselecteerde formaten en instellingen toe en verzendt vervolgens exporttaken naar deze Mac via het lokale netwerk – er wordt niets naar de cloud geüpload."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md em iPhone lê Apple Health, aplica os formatos e configurações selecionados e, em seguida, envia trabalhos de exportação para este Mac pela rede local – nada é carregado na nuvem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的 Health.md 读取 Apple Health，应用您选择的格式和设置，然后通过本地网络将导出作业发送到此 Mac — 不会将任何内容上传到云端。"
          }
        }
      }
    },
    "Health.md reached the export destination but could not create or update one or more files.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md reached the export destination but could not create or update one or more files."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md hat das Exportziel erreicht, konnte jedoch eine oder mehrere Dateien nicht erstellen oder aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md llegó al destino de exportación pero no pudo crear ni actualizar uno o más archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md a atteint la destination d'exportation mais n'a pas pu créer ou mettre à jour un ou plusieurs fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md ha raggiunto la destinazione di esportazione ma non è riuscito a creare o aggiornare uno o più file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md はエクスポート先に到達しましたが、1 つ以上のファイルを作成または更新できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md가 내보내기 대상에 도달했지만 하나 이상의 파일을 생성하거나 업데이트할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md heeft de exportbestemming bereikt, maar kan een of meer bestanden niet maken of bijwerken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md atingiu o destino de exportação, mas não conseguiu criar ou atualizar um ou mais arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 已到达导出目的地，但无法创建或更新一个或多个文件。"
          }
        }
      }
    },
    "Health.md reads your Apple Health data locally on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md liest Ihre Apple Health-Daten lokal auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md reads your Apple Health data locally on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md lee tus datos de Apple Health localmente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md lit vos données Apple Health localement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md legge i tuoi dati di Apple Health localmente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdはこのデバイス上でローカルにApple Healthデータを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 이 기기에서 로컬로 Apple Health 데이터를 읽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md leest je Apple Health-gegevens lokaal op dit apparaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md lê seus dados do Apple Health localmente neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 在此设备上本地读取您的 Apple Health 数据。"
          }
        }
      }
    },
    "Health.md runs in the menu bar to perform scheduled exports. Enable \"Launch at Login\" so exports happen automatically when your Mac starts.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md runs in the menu bar to perform scheduled exports. Enable \"Launch at Login\" so exports happen automatically when your Mac starts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md wird in der Menüleiste ausgeführt, um geplante Exporte durchzuführen. Aktivieren Sie „Beim Anmelden starten“, damit Exporte automatisch erfolgen, wenn Ihr Mac startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md se ejecuta en la barra de menú para realizar exportaciones programadas. Habilite \"Iniciar al iniciar sesión\" para que las exportaciones se realicen automáticamente cuando se inicie su Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md s'exécute dans la barre de menus pour effectuer des exportations planifiées. Activez « Lancer à la connexion » pour que les exportations se produisent automatiquement au démarrage de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md viene eseguito nella barra dei menu per eseguire esportazioni pianificate. Abilita \"Avvia all'accesso\" in modo che le esportazioni avvengano automaticamente all'avvio del tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md はメニュー バーで実行され、スケジュールされたエクスポートを実行します。 「ログイン時に起動」を有効にすると、Mac の起動時にエクスポートが自動的に行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 메뉴 표시줄에서 실행되어 예약된 내보내기를 수행합니다. \"로그인 시 실행\"을 활성화하면 Mac가 시작될 때 내보내기가 자동으로 수행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md wordt in de menubalk uitgevoerd om geplande exports uit te voeren. Schakel 'Starten bij inloggen' in, zodat exporten automatisch plaatsvinden wanneer uw Mac start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md é executado na barra de menu para realizar exportações agendadas. Habilite \"Iniciar no login\" para que as exportações aconteçam automaticamente quando seu Mac for iniciado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 在菜单栏中运行以执行计划的导出。启用“登录时启动”，以便在 Mac 启动时自动进行导出。"
          }
        }
      }
    },
    "Health.md will automatically export your health data on the schedule below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md exportiert Ihre Gesundheitsdaten automatisch gemäß dem folgenden Zeitplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md will automatically export your health data on the schedule below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md exportará automáticamente tus datos de salud según la programación a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md exportera automatiquement vos données de santé selon la planification ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md esporterà automaticamente i tuoi dati sanitari secondo la pianificazione seguente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdは以下のスケジュールでヘルスデータを自動的にエクスポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md가 아래 예약에 따라 자동으로 건강 데이터를 내보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md exporteert je gezondheidsgegevens automatisch volgens onderstaand schema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md exportará automaticamente seus dados de saúde conforme o agendamento abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 将按照以下计划自动导出您的健康数据。"
          }
        }
      }
    },
