      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie diese Mac-App als lokales Ziel für Exporte, die von Health.md auf dem iPhone gestartet wurden. Die Mac-App verkauft nichts und beschränkt den Zugriff nicht."
          }
        },
