    "Choose whether to include the Health.md data dictionary, and use the same free allowance for manual or scheduled exports.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, ob das Health.md-Datenwörterbuch enthalten ist, und nutze dasselbe kostenlose Kontingent für manuelle oder geplante Exporte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres incluir el diccionario de datos de Health.md y usa el mismo límite gratuito para exportaciones manuales o programadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’inclure ou non le dictionnaire de données Health.md et utilisez le même quota gratuit pour les exports manuels ou planifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se includere il dizionario dati di Health.md e usa lo stesso limite gratuito per le esportazioni manuali o pianificate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.mdデータ辞書を含めるか選択でき、手動とスケジュール書き出しで同じ無料枠を利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 데이터 사전을 포함할지 선택하고 수동 또는 예약 내보내기에 동일한 무료 한도를 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of je het Health.md-gegevenswoordenboek wilt opnemen en gebruik dezelfde gratis limiet voor handmatige of geplande exports."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se deseja incluir o dicionário de dados do Health.md e use o mesmo limite gratuito para exportações manuais ou agendadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以选择是否包含 Health.md 数据字典，并让手动导出和计划导出共享同一免费额度。"
          }
        }
      }
    },
    "Clear privacy details": {
