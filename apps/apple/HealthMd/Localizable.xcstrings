        "zh-Hans": {"stringUnit":{"state":"translated","value":"正在加载购买选项"}}
      }
    },
    "Read a saved context refresh receipt and request an updated status from its original authenticated computer. Disconnection is not completion." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Einen gespeicherten Beleg zur Kontextaktualisierung lesen und einen aktualisierten Status vom ursprünglichen authentifizierten Computer anfordern. Eine getrennte Verbindung bedeutet keinen Abschluss."}},
        "es": {"stringUnit":{"state":"translated","value":"Lee un comprobante guardado de actualización del contexto y solicita un estado actualizado al ordenador autenticado original. La desconexión no significa que haya finalizado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Consultez un reçu d’actualisation du contexte enregistré et demandez un état actualisé à l’ordinateur authentifié d’origine. Une déconnexion ne signifie pas que l’opération est terminée."}},
        "it": {"stringUnit":{"state":"translated","value":"Leggi una ricevuta salvata di aggiornamento del contesto e richiedi uno stato aggiornato al computer autenticato originale. La disconnessione non indica il completamento."}},
        "ja": {"stringUnit":{"state":"translated","value":"保存済みのコンテキスト更新の受領記録を読み取り、元の認証済みコンピュータに最新の状況を要求します。接続が切れても完了したことにはなりません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"저장된 컨텍스트 새로고침 확인서를 읽고 원래 인증된 컴퓨터에 최신 상태를 요청합니다. 연결이 끊어졌다고 완료된 것은 아닙니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Lees een opgeslagen bevestiging van contextvernieuwing en vraag een bijgewerkte status op bij de oorspronkelijke geauthenticeerde computer. Een verbroken verbinding betekent niet dat het proces voltooid is."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Leia um comprovante salvo de atualização do contexto e solicite um status atualizado ao computador autenticado original. Desconexão não significa conclusão."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"读取已保存的上下文刷新回执，并向原先通过身份验证的电脑请求更新状态。连接断开不代表已完成。"}}
      }
    },
    "Read full reviews on the App Store" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Vollständige Rezensionen im App Store lesen"}},
        "es": {"stringUnit":{"state":"translated","value":"Leer las reseñas completas en el App Store"}},
