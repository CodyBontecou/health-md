    "Ready now. Keep the Mac awake with Health.md open at schedule time." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Jetzt bereit. Lass den Mac zur geplanten Zeit eingeschaltet, ohne Ruhezustand, und Health.md geöffnet."}},
        "es": {"stringUnit":{"state":"translated","value":"Todo listo. Mantén el Mac activo con Health.md abierto a la hora programada."}},
