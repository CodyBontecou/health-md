    "Update or create Obsidian daily notes without adding aggregate files, ZIPs, roll-ups, individual entries, or provider sidecars." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Aktualisiere oder erstelle tägliche Obsidian-Notizen, ohne Aggregatdateien, ZIPs, Zusammenfassungen, Einzeleinträge oder Anbieter-Begleitdateien hinzuzufügen."}},
        "es": {"stringUnit":{"state":"translated","value":"Actualiza o crea notas diarias de Obsidian sin añadir archivos agregados, ZIP, resúmenes por periodo, entradas individuales ni archivos auxiliares del proveedor."}},
        "fr": {"stringUnit":{"state":"translated","value":"Mettez à jour ou créez des notes quotidiennes Obsidian sans ajouter de fichiers agrégés, de ZIP, de synthèses, d’entrées individuelles ni de fichiers annexes du fournisseur."}},
        "it": {"stringUnit":{"state":"translated","value":"Aggiorna o crea note giornaliere Obsidian senza aggiungere file aggregati, ZIP, riepiloghi, singole voci o file ausiliari dei provider."}},
        "ja": {"stringUnit":{"state":"translated","value":"集計ファイル、ZIP、期間別集計、個別エントリ、プロバイダのサイドカーファイルを追加せずに、Obsidianのデイリーノートを更新または作成します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"집계 파일, ZIP, 기간별 집계, 개별 항목 또는 제공업체 사이드카 파일을 추가하지 않고 Obsidian 일일 노트를 업데이트하거나 생성합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Werk dagelijkse Obsidian-notities bij of maak ze aan zonder aggregatiebestanden, ZIP-bestanden, periodeoverzichten, afzonderlijke registraties of aanvullende providerbestanden toe te voegen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Atualize ou crie notas diárias do Obsidian sem adicionar arquivos agregados, ZIPs, consolidações, registros individuais ou arquivos auxiliares de provedores."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更新或创建 Obsidian 每日笔记，不添加聚合文件、ZIP、汇总、单独条目或提供方附属文件。"}}
      }
    },
