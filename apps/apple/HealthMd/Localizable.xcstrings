    "Preview and Export Data stay visible, and empty Apple Health libraries now show clear date-range and permission guidance instead of a generic error." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"„Vorschau“ und „Daten exportieren“ bleiben sichtbar. Bei leeren Apple Health-Datenbeständen werden jetzt klare Hinweise zu Datumsbereich und Berechtigungen statt einer allgemeinen Fehlermeldung angezeigt."}},
        "es": {"stringUnit":{"state":"translated","value":"Vista previa y Exportar datos permanecen visibles, y las bibliotecas vacías de Apple Health ahora muestran indicaciones claras sobre el intervalo de fechas y los permisos en lugar de un error genérico."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les commandes Aperçu et Exporter les données restent visibles, et les bibliothèques Apple Health vides affichent désormais des indications claires sur la plage de dates et les autorisations plutôt qu’une erreur générique."}},
        "it": {"stringUnit":{"state":"translated","value":"Anteprima ed Esporta dati restano visibili e le librerie Apple Health vuote ora mostrano indicazioni chiare sull'intervallo di date e sulle autorizzazioni anziché un errore generico."}},
        "ja": {"stringUnit":{"state":"translated","value":"「プレビュー」と「データをエクスポート」は常に表示されます。Apple Health ライブラリが空の場合は、一般的なエラーの代わりに、日付範囲とアクセス許可に関する明確な案内が表示されるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"미리보기와 데이터 내보내기가 계속 표시되며, Apple Health 보관함이 비어 있으면 일반적인 오류 대신 날짜 범위와 권한에 대한 명확한 안내가 표시됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Voorvertoning en Gegevens exporteren blijven zichtbaar. Lege Apple Health-bibliotheken tonen nu duidelijke aanwijzingen over datumbereiken en machtigingen in plaats van een algemene foutmelding."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Prévia e Exportar dados permanecem visíveis, e bibliotecas vazias do Apple Health agora mostram orientações claras sobre intervalo de datas e permissões, em vez de um erro genérico."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"“预览”和“导出数据”始终可见；Apple Health 资料库为空时，现在会显示清晰的日期范围和权限指引，而不是笼统的错误信息。"}}
      }
    },
