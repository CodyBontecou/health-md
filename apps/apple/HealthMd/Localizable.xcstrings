          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 无法从 Apple Health 读取一种或多种请求的数据类型。"
          }
        }
      }
    },
    "Health.md could not read the query-context encryption key from Keychain.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md could not read the query-context encryption key from Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md konnte den Abfragekontext-Verschlüsselungsschlüssel von Keychain nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md no pudo leer la clave de cifrado del contexto de consulta de Keychain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md n'a pas pu lire la clé de chiffrement du contexte de requête à partir de Keychain."
          }
        },
        "it": {
