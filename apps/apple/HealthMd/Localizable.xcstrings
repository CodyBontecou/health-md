          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md no pudo generar una clave de cifrado de contexto de consulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md n'a pas pu générer de clé de chiffrement de contexte de requête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md non è riuscito a generare una chiave di crittografia del contesto della query."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md はクエリ コンテキスト暗号化キーを生成できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 쿼리 컨텍스트 암호화 키를 생성할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kan geen coderingssleutel voor de querycontext genereren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md não pôde gerar uma chave de criptografia de contexto de consulta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 无法生成查询上下文加密密钥。"
          }
        }
      }
    },
    "Health.md could not open the selected export folder. The Files, iCloud Drive, or network location may be offline, or the saved folder permission may have expired.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md could not open the selected export folder. The Files, iCloud Drive, or network location may be offline, or the saved folder permission may have expired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md konnte den ausgewählten Exportordner nicht öffnen. Die Dateien, das iCloud-Laufwerk oder der Netzwerkspeicherort sind möglicherweise offline oder die Berechtigung zum Speichern des Ordners ist möglicherweise abgelaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md no pudo abrir la carpeta de exportación seleccionada. Es posible que Archivos, iCloud Drive o la ubicación de red estén desconectados o que el permiso de la carpeta guardada haya caducado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md n'a pas pu ouvrir le dossier d'exportation sélectionné. Les fichiers, iCloud Drive ou l'emplacement réseau peuvent être hors ligne ou l'autorisation du dossier enregistré a peut-être expiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md non è riuscito ad aprire la cartella di esportazione selezionata. I file, iCloud Drive o il percorso di rete potrebbero essere offline oppure l'autorizzazione per la cartella salvata potrebbe essere scaduta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md は、選択したエクスポート フォルダーを開けませんでした。ファイル、iCloud Drive、またはネットワークの場所がオフラインであるか、保存されたフォルダーのアクセス許可が期限切れになっている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 선택한 내보내기 폴더를 열 수 없습니다. 파일, iCloud Drive 또는 네트워크 위치가 오프라인이거나 저장된 폴더 권한이 만료되었을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kan de geselecteerde exportmap niet openen. De bestanden, iCloud Drive of netwerklocatie zijn mogelijk offline of de machtiging voor de opgeslagen map is mogelijk verlopen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md não pôde abrir a pasta de exportação selecionada. Os Arquivos, o iCloud Drive ou o local de rede podem estar off-line ou a permissão da pasta salva pode ter expirado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 无法打开选定的导出文件夹。文件、iCloud 驱动器或网络位置可能处于离线状态，或者保存的文件夹权限可能已过期。"
          }
        }
      }
    },
    "Health.md could not read one or more requested data types from Apple Health.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
