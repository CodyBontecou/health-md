    "Adds detailed time-series and the canonical HealthKit source archive with identities, provenance, metadata, and relationships. Files may be much larger." : {
      "comment" : "Export data-detail preset description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt detaillierte Zeitreihen und das kanonische HealthKit-Quellarchiv mit Identitäten, Herkunft, Metadaten und Beziehungen hinzu. Die Dateien können deutlich größer sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds detailed time-series and the canonical HealthKit source archive with identities, provenance, metadata, and relationships. Files may be much larger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade series temporales detalladas y el archivo de origen canónico de HealthKit con identidades, procedencia, metadatos y relaciones. Los archivos pueden ser mucho más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des séries chronologiques détaillées et l’archive source HealthKit canonique avec les identités, la provenance, les métadonnées et les relations. Les fichiers peuvent être beaucoup plus volumineux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge serie temporali dettagliate e l’archivio sorgente HealthKit canonico con identità, provenienza, metadati e relazioni. I file possono essere molto più grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細な時系列に加え、ID、出所、メタデータ、関連性を保持する正規HealthKitソースアーカイブを追加します。ファイルが大幅に大きくなる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상세 시계열과 함께 ID, 출처, 메타데이터 및 관계를 포함하는 표준 HealthKit 소스 아카이브를 추가합니다. 파일이 훨씬 커질 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt gedetailleerde tijdreeksen en het canonieke HealthKit-bronarchief met identiteiten, herkomst, metadata en relaties toe. Bestanden kunnen veel groter worden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona séries temporais detalhadas e o arquivo de origem canônico do HealthKit com identidades, procedência, metadados e relações. Os arquivos podem ficar muito maiores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加详细时间序列以及包含身份、来源、元数据和关系的规范 HealthKit 源归档。文件可能会大得多。"
          }
        }
      }
    },
    "Adds selected timestamped samples such as heart rate, HRV, blood oxygen, respiratory rate, and sleep stages without the canonical source archive." : {
      "comment" : "Export data-detail preset description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt ausgewählte, zeitlich markierte Messwerte wie Herzfrequenz, HRV, Blutsauerstoff, Atemfrequenz und Schlafphasen ohne das kanonische Quellarchiv hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds selected timestamped samples such as heart rate, HRV, blood oxygen, respiratory rate, and sleep stages without the canonical source archive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade muestras seleccionadas con marca de tiempo, como frecuencia cardíaca, VFC, oxígeno en sangre, frecuencia respiratoria y fases del sueño, sin el archivo de origen canónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des mesures horodatées sélectionnées, comme la fréquence cardiaque, la VFC, l’oxygène sanguin, la fréquence respiratoire et les phases de sommeil, sans l’archive source canonique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge campioni selezionati con data e ora, come frequenza cardiaca, HRV, ossigeno nel sangue, frequenza respiratoria e fasi del sonno, senza l’archivio sorgente canonico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数、HRV、血中酸素、呼吸数、睡眠ステージなど、選択したタイムスタンプ付きサンプルを、正規ソースアーカイブなしで追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표준 소스 아카이브 없이 심박수, HRV, 혈중 산소, 호흡수, 수면 단계 등의 선택된 타임스탬프 샘플을 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt geselecteerde metingen met tijdstempel toe, zoals hartslag, HRV, zuurstofsaturatie, ademhalingsfrequentie en slaapfasen, zonder het canonieke bronarchief."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona amostras selecionadas com data e hora, como frequência cardíaca, VFC, oxigênio no sangue, frequência respiratória e estágios do sono, sem o arquivo de origem canônico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加所选的带时间戳样本，例如心率、HRV、血氧、呼吸频率和睡眠阶段，而不包含规范源归档。"
          }
        }
      }
    },
