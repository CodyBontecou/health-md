    "Apple Health has years of signal. Health.md turns it into private files you can keep, search, and link from Obsidian." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Apple Health enthält Gesundheitsdaten aus vielen Jahren. Health.md macht daraus private Dateien, die du aufbewahren, durchsuchen und aus Obsidian verlinken kannst."}},
        "es": {"stringUnit":{"state":"translated","value":"Apple Health contiene años de datos. Health.md los convierte en archivos privados que puedes conservar, buscar y enlazar desde Obsidian."}},
        "fr": {"stringUnit":{"state":"translated","value":"Apple Health contient des années de données. Health.md les transforme en fichiers privés que vous pouvez conserver, dans lesquels vous pouvez effectuer des recherches et vers lesquels vous pouvez créer des liens depuis Obsidian."}},
        "it": {"stringUnit":{"state":"translated","value":"Apple Health contiene anni di dati. Health.md li trasforma in file privati che puoi conservare, cercare e collegare da Obsidian."}},
        "ja": {"stringUnit":{"state":"translated","value":"Apple Healthには長年の健康データが蓄積されています。Health.mdはそれを、自分で保管・検索でき、Obsidianからリンクできるプライベートなファイルに変換します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Apple Health에는 수년간의 건강 기록이 담겨 있습니다. Health.md는 이를 보관하고 검색하며 Obsidian에서 연결할 수 있는 개인 파일로 만듭니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Apple Health bevat jaren aan waardevolle gegevens. Health.md zet ze om in privébestanden die je kunt bewaren, doorzoeken en koppelen vanuit Obsidian."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O Apple Health reúne anos de dados. O Health.md os transforma em arquivos privados que você pode guardar, pesquisar e vincular no Obsidian."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Apple Health 积累了多年的健康数据。Health.md 将其转为私密文件，供你保存、搜索，并从 Obsidian 中链接。"}}
      }
    },
