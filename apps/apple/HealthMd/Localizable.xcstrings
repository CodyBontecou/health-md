    },
    "Swipe to preview activity, heart, and workout dashboards rendered from your local Health.md files." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Wische, um Aktivitäts-, Herz- und Trainingsdashboards aus deinen lokalen Health.md-Dateien anzusehen."}},
        "es": {"stringUnit":{"state":"translated","value":"Desliza para previsualizar paneles de actividad, corazón y entrenamientos generados a partir de tus archivos locales de Health.md."}},
        "fr": {"stringUnit":{"state":"translated","value":"Balayez pour prévisualiser les tableaux de bord d’activité, de santé cardiaque et d’entraînement générés à partir de vos fichiers Health.md locaux."}},
        "it": {"stringUnit":{"state":"translated","value":"Scorri per vedere in anteprima i pannelli di attività, cuore e allenamenti generati dai tuoi file Health.md locali."}},
        "ja": {"stringUnit":{"state":"translated","value":"スワイプすると、ローカルのHealth.mdファイルから生成されたアクティビティ、心臓、ワークアウトのダッシュボードをプレビューできます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"쓸어넘겨 로컬 Health.md 파일로 표시한 활동, 심장 및 운동 대시보드를 미리 보세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Veeg voor voorbeelden van activiteits-, hart- en trainingsdashboards op basis van je lokale Health.md-bestanden."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Deslize para visualizar painéis de atividade, coração e treinos gerados a partir dos seus arquivos locais do Health.md."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"滑动预览根据本地 Health.md 文件呈现的活动、心脏和体能训练仪表盘。"}}
      }
    },
    "Switch off to disable individual tracking for all enabled Health Metrics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie dies aus, um keine der aktivierten Gesundheitsmetriken mehr einzeln zu erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo para detener el seguimiento individual de todas las métricas de salud habilitadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez cette option pour arrêter le suivi individuel de tous les indicateurs de santé activés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva questa opzione per interrompere il monitoraggio individuale di tutte le metriche sanitarie abilitate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、有効なすべてのヘルス指標の個別トラッキングが無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 활성화된 모든 건강 항목의 개별 추적이 비활성화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel dit uit om het individueel bijhouden van alle ingeschakelde gezondheidsmeetwaarden te stoppen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative para interromper o rastreamento individual de todas as Métricas de Saúde ativadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，将停用所有已启用健康指标的单独追踪。"
          }
        }
      }
    },
