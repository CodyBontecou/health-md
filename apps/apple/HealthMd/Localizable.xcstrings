    "Saved folder access needs to be refreshed. Reconnect or re-select the folder." : {
      "comment" : "Reviewed macOS display localization",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf den gespeicherten Ordner muss aktualisiert werden. Verbinden Sie den Ordner erneut oder wählen Sie ihn erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved folder access needs to be refreshed. Reconnect or re-select the folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es necesario actualizar el acceso a la carpeta guardada. Vuelva a conectarse o vuelva a seleccionar la carpeta."
          }
        },
        "fr" : {
