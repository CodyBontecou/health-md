{
  "sourceLanguage": "en",
  "strings": {
    "Generate one summary for the requested date range in every selected export format.": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate one summary for the requested date range in every selected export format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt in jedem ausgewählten Exportformat eine Zusammenfassung für den angeforderten Zeitraum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un resumen del rango de fechas solicitado en cada formato de exportación seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez un résumé de la plage de dates demandée dans chaque format d’exportation sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un riepilogo dell'intervallo di date richiesto in ogni formato di esportazione selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した各エクスポート形式で、指定した期間の概要を1つ生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 각 내보내기 형식으로 요청한 날짜 범위의 요약을 하나 생성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereer voor elke geselecteerde exportindeling één samenvatting van het gevraagde datumbereik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere um resumo do intervalo de datas solicitado em cada formato de exportação selecionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为请求的日期范围按每种所选导出格式生成一份摘要。"
          }
        }
      }
    },
    "Generated once per selected format for the requested date range.": {
      "comment": "Apple range-summary UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated once per selected format for the requested date range."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für den angeforderten Zeitraum einmal pro ausgewähltem Format erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se genera una vez por cada formato seleccionado para el rango de fechas solicitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généré une fois par format sélectionné pour la plage de dates demandée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generato una volta per ogni formato selezionato per l'intervallo di date richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した期間について、選択した形式ごとに1回生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 날짜 범위에 대해 선택한 형식별로 한 번 생성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt voor het gevraagde datumbereik eenmaal per geselecteerde indeling gegenereerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerado uma vez por formato selecionado para o intervalo de datas solicitado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对请求的日期范围，按每种所选格式生成一次。"
          }
        }
      }
    },
