    "Include recovery, strain, sleep, and workout data in your exports." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Nehmen Sie Erholungs-, Belastungs-, Schlaf- und Trainingsdaten in Ihre Exporte auf."}},
        "es": {"stringUnit":{"state":"translated","value":"Incluye datos de recuperación, esfuerzo, sueño y entrenamientos en tus exportaciones."}},
        "fr": {"stringUnit":{"state":"translated","value":"Incluez les données de récupération, d’effort, de sommeil et d’entraînement dans vos exports."}},
        "it": {"stringUnit":{"state":"translated","value":"Includi i dati di recupero, sforzo, sonno e allenamento nelle esportazioni."}},
        "ja": {"stringUnit":{"state":"translated","value":"回復、負荷、睡眠、ワークアウトのデータをエクスポートに含められます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"내보내기에 회복, 운동 부하, 수면 및 운동 데이터를 포함하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Neem herstel-, inspannings-, slaap- en trainingsgegevens op in je exports."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Inclua dados de recuperação, esforço, sono e treinos nas exportações."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在导出中包含恢复、运动负荷、睡眠和锻炼数据。"}}
      }
    },
    "More connections and date formats" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Mehr Verbindungen und Datumsformate"}},
        "es": {"stringUnit":{"state":"translated","value":"Más conexiones y formatos de fecha"}},
        "fr": {"stringUnit":{"state":"translated","value":"Plus de connexions et de formats de date"}},
        "it": {"stringUnit":{"state":"translated","value":"Più connessioni e formati di data"}},
        "ja": {"stringUnit":{"state":"translated","value":"接続と日付形式の選択肢を追加"}},
        "ko": {"stringUnit":{"state":"translated","value":"더 다양한 연결 및 날짜 형식"}},
        "nl": {"stringUnit":{"state":"translated","value":"Meer verbindingen en datumnotaties"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Mais conexões e formatos de data"}},
