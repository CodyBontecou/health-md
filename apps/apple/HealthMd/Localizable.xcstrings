    "Health.md can still export the rest of your data, but iOS did not allow access to Blood Pressure, so systolic and diastolic values are skipped.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md can still export the rest of your data, but iOS did not allow access to Blood Pressure, so systolic and diastolic values are skipped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kann weiterhin den Rest Ihrer Daten exportieren, aber iOS erlaubte keinen Zugriff auf den Blutdruck, daher werden systolische und diastolische Werte übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md aún puede exportar el resto de sus datos, pero iOS no permitió el acceso a la presión arterial, por lo que se omiten los valores sistólicos y diastólicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md peut toujours exporter le reste de vos données, mais iOS n'autorise pas l'accès à la pression artérielle, les valeurs systoliques et diastoliques sont donc ignorées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md può comunque esportare il resto dei dati, ma iOS non consente l'accesso alla pressione sanguigna, quindi i valori sistolici e diastolici vengono saltati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md は残りのデータをエクスポートできますが、iOS では血圧へのアクセスが許可されていなかったため、収縮期値と拡張期値はスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 여전히 나머지 데이터를 내보낼 수 있지만 iOS는 혈압에 대한 액세스를 허용하지 않으므로 수축기 및 확장기 값을 건너뜁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kan nog steeds de rest van uw gegevens exporteren, maar iOS staat geen toegang tot de bloeddruk toe, dus de systolische en diastolische waarden worden overgeslagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md ainda pode exportar o restante dos seus dados, mas o iOS não permitiu o acesso à pressão arterial, portanto os valores sistólicos e diastólicos são ignorados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 仍然可以导出其余数据，但 iOS 不允许访问血压，因此会跳过收缩压和舒张压值。"
          }
        }
      }
    },
    "Health.md cannot verify the saved export folder. Re-select the intended folder before exporting.": {
      "comment": "Reviewed macOS display localization",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md cannot verify the saved export folder. Re-select the intended folder before exporting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kann den gespeicherten Exportordner nicht überprüfen. Wählen Sie vor dem Exportieren erneut den gewünschten Ordner aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md no puede verificar la carpeta de exportación guardada. Vuelva a seleccionar la carpeta deseada antes de exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md ne peut pas vérifier le dossier d'exportation enregistré. Resélectionnez le dossier souhaité avant d’exporter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md non riesce a verificare la cartella di esportazione salvata. Riselezionare la cartella desiderata prima dell'esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md は、保存されたエクスポート フォルダーを確認できません。エクスポートする前に、目的のフォルダーを再選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 저장된 내보내기 폴더를 확인할 수 없습니다. 내보내기 전에 원하는 폴더를 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kan de opgeslagen exportmap niet verifiëren. Selecteer de beoogde map opnieuw voordat u gaat exporteren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md não pode verificar a pasta de exportação salva. Selecione novamente a pasta pretendida antes de exportar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 无法验证保存的导出文件夹。导出前重新选择目标文件夹。"
          }
        }
      }
    },
    "Health.md collects limited product events using a random app-install identifier for setup, export-shape, and purchase-flow analytics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md erfasst begrenzte Produktereignisse mit einer zufälligen App-Installations-ID für Einrichtung, grobe Exportmerkmale und Kaufablaufanalysen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md recopila eventos limitados del producto mediante un identificador aleatorio de instalación para la configuración, las características generales de exportación y el flujo de compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md collecte des événements produit limités à l’aide d’un identifiant aléatoire d’installation pour la configuration, les caractéristiques générales des exports et le parcours d’achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md raccoglie eventi di prodotto limitati usando un identificatore casuale di installazione per configurazione, caratteristiche generali delle esportazioni e flusso di acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md は、セットアップ、エクスポート形式の概要、購入フローの分析のために、ランダムなアプリインストール ID を使って限定的な製品イベントを収集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 설정, 대략적인 내보내기 형태 및 구매 흐름 분석을 위해 무작위 앱 설치 ID로 제한된 제품 이벤트를 수집합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md verzamelt beperkte productgebeurtenissen met een willekeurige app-installatie-ID voor configuratie, globale exportkenmerken en aankoopstromen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Health.md coleta eventos limitados do produto usando um identificador aleatório de instalação para configuração, características gerais de exportação e fluxo de compra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 使用随机应用安装 ID 收集有限的产品事件，用于了解设置、粗略的导出形式和购买流程。"
          }
        }
      }
    },
    "Health.md could not allocate an immutable query-context generation.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md could not allocate an immutable query-context generation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md konnte keine unveränderliche Abfragekontextgenerierung zuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md no pudo asignar una generación de contexto de consulta inmutable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md n'a pas pu allouer une génération de contexte de requête immuable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md non è stato in grado di allocare una generazione di contesto di query immutabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md は、不変のクエリ コンテキスト生成を割り当てることができませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md는 변경할 수 없는 쿼리 컨텍스트 생성을 할당할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md kan geen onveranderlijke generatie van querycontext toewijzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md não pôde alocar uma geração de contexto de consulta imutável."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md 无法分配不可变的查询上下文生成。"
          }
        }
      }
    },
    "Health.md could not generate a query-context encryption key.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md could not generate a query-context encryption key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
