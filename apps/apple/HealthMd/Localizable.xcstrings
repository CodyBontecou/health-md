    "Sleep-date guidance explains which night each export covers." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Die Hinweise zum Schlafdatum erklären, welche Nacht jeder Export abdeckt."}},
        "es": {"stringUnit":{"state":"translated","value":"Las indicaciones sobre las fechas de sueño explican qué noche abarca cada exportación."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les indications sur les dates de sommeil précisent la nuit couverte par chaque export."}},
        "it": {"stringUnit":{"state":"translated","value":"Le indicazioni sulle date del sonno spiegano a quale notte si riferisce ogni esportazione."}},
        "ja": {"stringUnit":{"state":"translated","value":"睡眠の日付に関する案内で、各エクスポートがどの夜を対象とするかを確認できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"수면 날짜 안내에서 각 내보내기가 어느 날 밤의 수면을 포함하는지 설명합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De uitleg over slaapdatums geeft aan op welke nacht elke export betrekking heeft."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As orientações sobre as datas de sono explicam a qual noite cada exportação se refere."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"睡眠日期说明会解释每次导出涵盖哪一晚的睡眠。"}}
      }
