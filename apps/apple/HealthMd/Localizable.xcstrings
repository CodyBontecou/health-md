    "Please try again later. You can close this screen and keep using Health.md." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Bitte versuche es später erneut. Du kannst diesen Bildschirm schließen und Health.md weiter nutzen."}},
        "es": {"stringUnit":{"state":"translated","value":"Inténtalo de nuevo más tarde. Puedes cerrar esta pantalla y seguir usando Health.md."}},
        "fr": {"stringUnit":{"state":"translated","value":"Veuillez réessayer plus tard. Vous pouvez fermer cet écran et continuer à utiliser Health.md."}},
        "it": {"stringUnit":{"state":"translated","value":"Riprova più tardi. Puoi chiudere questa schermata e continuare a usare Health.md."}},
        "ja": {"stringUnit":{"state":"translated","value":"しばらくしてからもう一度お試しください。この画面を閉じてもHealth.mdを引き続き使用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"나중에 다시 시도해 주세요. 이 화면을 닫고 Health.md를 계속 사용할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Probeer het later opnieuw. Je kunt dit scherm sluiten en Health.md blijven gebruiken."}},
