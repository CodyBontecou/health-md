    "Canonical source records" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Kanonische Quelldatensätze"}},
        "es": {"stringUnit":{"state":"translated","value":"Registros de origen canónicos"}},
        "fr": {"stringUnit":{"state":"translated","value":"Enregistrements sources canoniques"}},
        "it": {"stringUnit":{"state":"translated","value":"Record di origine canonici"}},
        "ja": {"stringUnit":{"state":"translated","value":"正規のソースレコード"}},
        "ko": {"stringUnit":{"state":"translated","value":"정본 원본 기록"}},
        "nl": {"stringUnit":{"state":"translated","value":"Canonieke bronrecords"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Registros de origem canônicos"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"规范化源记录"}}
      }
    },
    "Capture original samples and their sources, devices, timestamps, metadata, relationships, and available attachments—not only daily totals." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erfasse ursprüngliche Messwerte und ihre Quellen, Geräte, Zeitstempel, Metadaten, Beziehungen und verfügbaren Anhänge — nicht nur Tagessummen."}},
        "es": {"stringUnit":{"state":"translated","value":"Captura las muestras originales y sus fuentes, dispositivos, marcas de tiempo, metadatos, relaciones y archivos adjuntos disponibles, no solo los totales diarios."}},
        "fr": {"stringUnit":{"state":"translated","value":"Capturez les échantillons d’origine ainsi que leurs sources, appareils, horodatages, métadonnées, relations et pièces jointes disponibles — pas seulement les totaux quotidiens."}},
        "it": {"stringUnit":{"state":"translated","value":"Acquisisci i campioni originali con le relative fonti, dispositivi, date e ore, metadati, relazioni e allegati disponibili, non solo i totali giornalieri."}},
        "ja": {"stringUnit":{"state":"translated","value":"日ごとの合計だけでなく、元のサンプルと、そのソース、デバイス、タイムスタンプ、メタデータ、関連情報、利用可能な添付ファイルを取得します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"일일 합계뿐 아니라 원본 샘플과 해당 출처, 기기, 타임스탬프, 메타데이터, 관계, 사용 가능한 첨부 파일도 수집하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Leg oorspronkelijke metingen vast, samen met hun bronnen, apparaten, tijdstempels, metadata, relaties en beschikbare bijlagen — niet alleen dagtotalen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Capture amostras originais e suas fontes, dispositivos, registros de data e hora, metadados, relações e anexos disponíveis — não apenas totais diários."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"采集原始样本及其来源、设备、时间戳、元数据、关联关系和可用附件，而不仅是每日总计。"}}
      }
    },
    "Capture results and warnings make missing permissions, unavailable records, and partial exports clear." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Erfassungsergebnisse und Warnungen machen fehlende Berechtigungen, nicht verfügbare Datensätze und unvollständige Exporte deutlich."}},
        "es": {"stringUnit":{"state":"translated","value":"Los resultados y las advertencias de captura indican claramente los permisos que faltan, los registros no disponibles y las exportaciones parciales."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les résultats et avertissements de capture signalent clairement les autorisations manquantes, les enregistrements indisponibles et les exportations partielles."}},
        "it": {"stringUnit":{"state":"translated","value":"I risultati e gli avvisi di acquisizione evidenziano le autorizzazioni mancanti, i record non disponibili e le esportazioni parziali."}},
        "ja": {"stringUnit":{"state":"translated","value":"取得結果と警告により、不足している権限、利用できないレコード、一部のみのエクスポートを明確に示します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"수집 결과와 경고를 통해 누락된 권한, 사용할 수 없는 기록, 부분 내보내기를 명확히 확인할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Vastleggingsresultaten en waarschuwingen maken ontbrekende toegangsrechten, niet-beschikbare records en gedeeltelijke exports inzichtelijk."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os resultados e avisos da captura deixam claras as permissões ausentes, os registros indisponíveis e as exportações parciais."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"采集结果和警告会清楚说明缺失的权限、不可用的记录以及未完整完成的导出。"}}
      }
    },
