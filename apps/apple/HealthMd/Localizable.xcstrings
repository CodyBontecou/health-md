    "Purchase options are loading" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Kaufoptionen werden geladen"}},
        "es": {"stringUnit":{"state":"translated","value":"Cargando las opciones de compra"}},
