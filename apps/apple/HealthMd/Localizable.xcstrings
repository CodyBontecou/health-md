    "Pending recovery could not be fully cleared. Please try again. Your profile and credentials were not removed." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Die ausstehende Wiederherstellung konnte nicht vollständig gelöscht werden. Bitte versuche es erneut. Dein Profil und deine Zugangsdaten wurden nicht entfernt."}},
        "es": {"stringUnit":{"state":"translated","value":"No se ha podido borrar por completo la recuperación pendiente. Inténtalo de nuevo. No se han eliminado tu perfil ni tus credenciales."}},
        "fr": {"stringUnit":{"state":"translated","value":"La récupération en attente n’a pas pu être entièrement effacée. Réessayez. Votre profil et vos identifiants n’ont pas été supprimés."}},
        "it": {"stringUnit":{"state":"translated","value":"Non è stato possibile eliminare completamente il recupero in sospeso. Riprova. Il profilo e le credenziali non sono stati rimossi."}},
        "ja": {"stringUnit":{"state":"translated","value":"保留中の復旧を完全に消去できませんでした。もう一度お試しください。プロファイルと認証情報は削除されていません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"대기 중인 복구를 완전히 삭제하지 못했습니다. 다시 시도해 주세요. 프로필과 인증 정보는 삭제되지 않았습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Openstaand herstel kon niet volledig worden gewist. Probeer het opnieuw. Je profiel en inloggegevens zijn niet verwijderd."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível limpar totalmente a recuperação pendente. Tente novamente. Seu perfil e suas credenciais não foram removidos."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"未能完全清除待恢复任务。请重试。您的配置和凭据未被移除。"}}
      }
    },
    "Permissions needed" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Berechtigungen erforderlich"}},
        "es": {"stringUnit":{"state":"translated","value":"Se necesitan permisos"}},
        "fr": {"stringUnit":{"state":"translated","value":"Autorisations nécessaires"}},
        "it": {"stringUnit":{"state":"translated","value":"Autorizzazioni necessarie"}},
        "ja": {"stringUnit":{"state":"translated","value":"権限が必要です"}},
        "ko": {"stringUnit":{"state":"translated","value":"권한 필요"}},
        "nl": {"stringUnit":{"state":"translated","value":"Machtigingen nodig"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Permissões necessárias"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"需要权限"}}
      }
    },
    "Physical Export Lab" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Exportlabor auf echtem Gerät"}},
        "es": {"stringUnit":{"state":"translated","value":"Laboratorio de exportación en dispositivo físico"}},
        "fr": {"stringUnit":{"state":"translated","value":"Laboratoire d’export sur appareil physique"}},
        "it": {"stringUnit":{"state":"translated","value":"Laboratorio di esportazione su dispositivo fisico"}},
        "ja": {"stringUnit":{"state":"translated","value":"実機エクスポートラボ"}},
