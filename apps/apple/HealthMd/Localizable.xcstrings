    "Markdown, CSV, JSON, and Obsidian Bases exports now share safer distance unit handling across metric and imperial settings." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Exporte in Markdown, CSV, JSON und Obsidian Bases verwenden jetzt eine einheitliche, sicherere Verarbeitung von Entfernungseinheiten bei metrischen und imperialen Einstellungen."}},
        "es": {"stringUnit":{"state":"translated","value":"Las exportaciones Markdown, CSV, JSON y Obsidian Bases ahora comparten una gestión más segura de las unidades de distancia en las configuraciones métrica e imperial."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les exportations Markdown, CSV, JSON et Obsidian Bases partagent désormais une gestion plus sûre des unités de distance, pour les systèmes métrique et impérial."}},
        "it": {"stringUnit":{"state":"translated","value":"Le esportazioni Markdown, CSV, JSON e Obsidian Bases ora condividono una gestione più sicura delle unità di distanza nelle impostazioni metriche e imperiali."}},
        "ja": {"stringUnit":{"state":"translated","value":"Markdown、CSV、JSON、Obsidian Bases のエクスポートで、メートル法とヤード・ポンド法の距離単位が共通のより安全な方法で処理されるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 Markdown, CSV, JSON 및 Obsidian Bases 내보내기는 미터법과 영미식 설정 전반에서 더 안전한 거리 단위 처리를 공통으로 사용합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Exports naar Markdown, CSV, JSON en Obsidian Bases gebruiken nu dezelfde veiligere verwerking van afstandseenheden bij metrische en imperiale instellingen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"As exportações Markdown, CSV, JSON e Obsidian Bases agora usam um tratamento mais seguro das unidades de distância nas configurações métricas e imperiais."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Markdown、CSV、JSON 和 Obsidian Bases 导出现在采用统一且更安全的距离单位处理方式，兼顾公制和英制设置。"}}
      }
    },
    "Markdown, Obsidian Bases, JSON, and CSV now identify schema v2 for the richer medication archive format." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON und CSV kennzeichnen jetzt schema v2 für das umfangreichere Medikamentenarchivformat."}},
        "es": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON y CSV ahora indican el esquema v2 para el formato ampliado del archivo de medicación."}},
        "fr": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON et CSV indiquent désormais le schéma v2 pour le format enrichi d’archive des médicaments."}},
        "it": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON e CSV ora indicano lo schema v2 per il formato più completo dell'archivio dei farmaci."}},
        "ja": {"stringUnit":{"state":"translated","value":"Markdown、Obsidian Bases、JSON、CSV で、より充実した服薬アーカイブ形式を示すスキーマ v2 が明記されるようになりました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 Markdown, Obsidian Bases, JSON 및 CSV는 더 풍부한 복약 아카이브 형식에 스키마 v2를 명시합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON en CSV vermelden nu schema v2 voor het uitgebreidere medicatiearchiefformaat."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON e CSV agora identificam o esquema v2 para o formato mais completo do arquivo de medicamentos."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Markdown、Obsidian Bases、JSON 和 CSV 现在标明 schema v2，以支持更丰富的用药归档格式。"}}
      }
    },
    "Markdown, Obsidian Bases, JSON, and CSV now preserve readable activity names, stable sport values, HealthKit cases, and original raw values—including Rolling and future unknown types." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON und CSV bewahren jetzt lesbare Aktivitätsnamen, stabile Sportartwerte, HealthKit-Fälle und ursprüngliche Rohwerte – einschließlich Rolling und künftiger unbekannter Typen."}},
        "es": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON y CSV ahora conservan nombres de actividad legibles, valores de deporte estables, casos de HealthKit y valores originales sin procesar, incluidos Rolling y futuros tipos desconocidos."}},
        "fr": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON et CSV préservent désormais les noms d’activité lisibles, les valeurs de sport stables, les cas HealthKit et les valeurs brutes d’origine, y compris Rolling et les futurs types inconnus."}},
        "it": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON e CSV ora conservano nomi di attività leggibili, valori sportivi stabili, casi HealthKit e valori grezzi originali, inclusi Rolling e futuri tipi sconosciuti."}},
        "ja": {"stringUnit":{"state":"translated","value":"Markdown、Obsidian Bases、JSON、CSV で、読みやすいアクティビティ名、安定したスポーツ値、HealthKit のケース、元の生の値が保持されるようになりました。Rolling や今後追加される未知の種類も含まれます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이제 Markdown, Obsidian Bases, JSON 및 CSV는 읽기 쉬운 활동 이름, 일관된 스포츠 값, HealthKit 케이스 및 원래의 원시 값을 보존하며, Rolling과 향후 알 수 없는 유형도 포함합니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON en CSV behouden nu leesbare activiteitsnamen, stabiele sportwaarden, HealthKit-cases en oorspronkelijke ruwe waarden, waaronder Rolling en toekomstige onbekende typen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Markdown, Obsidian Bases, JSON e CSV agora preservam nomes de atividades legíveis, valores estáveis de esportes, casos do HealthKit e valores brutos originais, incluindo Rolling e futuros tipos desconhecidos."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Markdown、Obsidian Bases、JSON 和 CSV 现在保留易读的活动名称、稳定的运动值、HealthKit 枚举项和原始值，包括 Rolling 及未来的未知类型。"}}
      }
    },
