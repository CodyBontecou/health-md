    "Overlaps %@: later runs overwrite earlier ones. Choose a different folder or filename template to keep them separate." : {
      "comment": "Live editor warning that the profile's output files overlap other profiles; the interpolated value is a comma-separated profile name list",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschneidung mit %@: Spätere Durchläufe überschreiben frühere. Wähle einen anderen Ordner oder eine andere Dateinamenvorlage, um sie getrennt zu halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solapa con %@: las ejecuciones posteriores sobrescriben las anteriores. Elige otra carpeta o plantilla de nombre de archivo para mantenerlas separadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflit avec %@ : les exécutions suivantes écrasent les précédentes. Choisissez un autre dossier ou modèle de nom de fichier pour les séparer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sovrappone a %@: le esecuzioni successive sovrascrivono quelle precedenti. Scegli una cartella o un modello di nome file diverso per mantenerle separate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ と重複しています。後の実行で前の出力が上書きされます。別々に保存するには、異なるフォルダまたはファイル名テンプレートを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@와 중복됩니다. 나중에 실행된 내보내기가 이전 내보내기를 덮어씁니다. 별도로 유지하려면 다른 폴더나 파일 이름 템플릿을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlapt met %@: latere uitvoeringen overschrijven eerdere. Kies een andere map of bestandsnaamsjabloon om ze gescheiden te houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe %@: execuções posteriores sobrescrevem as anteriores. Escolha outra pasta ou modelo de nome de arquivo para mantê-las separadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 %@ 重叠：后续运行会覆盖先前的结果。请选择不同的文件夹或文件名模板以将其分开。"
          }
        }
      }
    },
