    "Some dates had no synced data and other dates remain. Open Health.md to retry.": {
      "comment": "macOS production UI",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some dates had no synced data and other dates remain. Open Health.md to retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einige Daten wurden keine Daten synchronisiert, andere Daten bleiben bestehen. Öffnen Sie Health.md, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas fechas no tenían datos sincronizados y otras fechas permanecen. Abra Health.md para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines dates n'avaient pas de données synchronisées et d'autres restent. Ouvrez Health.md pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune date non avevano dati sincronizzati mentre altre date rimangono. Apri Health.md per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の日付にはデータが同期されておらず、他の日付はそのまま残っています。 Health.md を開いて再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 날짜에는 동기화된 데이터가 없었고 다른 날짜는 남아 있습니다. Health.md를 열어 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige datums hadden geen gesynchroniseerde gegevens en andere datums blijven bestaan. Open Health.md om het opnieuw te proberen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas datas não tinham dados sincronizados e outras datas permanecem. Abra Health.md para tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某些日期没有同步数据，而其他日期仍然存在。打开Health.md重试。"
          }
        }
      }
    },
