    "clinician_report_coverage": {
      "comment": "Clinician Report V1 localized vocabulary. Managed by scripts/validate-clinician-report-localizations.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten für %1$d von %2$d Tagen verfügbar. Für die verbleibenden %3$d Tage waren in Health.md keine Daten verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data available on %1$d of %2$d days. No data was available to Health.md for the remaining %3$d days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay datos disponibles para %1$d de %2$d días. Health.md no dispuso de datos para los %3$d días restantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données disponibles pour %1$d jours sur %2$d. Health.md ne disposait d’aucune donnée pour les %3$d jours restants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati disponibili per %1$d giorni su %2$d. Health.md non disponeva di dati per i restanti %3$d giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データがある日は%1$d日（全%2$d日）です。残りの%3$d日について、Health.md で利用可能なデータはありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 있는 날은 %1$d일(전체 %2$d일)입니다. 나머지 %3$d일은 Health.md에서 사용할 수 있는 데이터가 없었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens beschikbaar op %1$d van %2$d dagen. Voor de resterende %3$d dagen waren geen gegevens beschikbaar voor Health.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há dados disponíveis em %1$d de %2$d dias. O Health.md não teve dados disponíveis nos %3$d dias restantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
