    "7 days free, then %@ per week. Auto-renews; cancel anytime." : {
      "localizations" : {
        "en": {"stringUnit":{"state":"translated","value":"7 days free, then %@ per week. Auto-renews; cancel anytime."}},
        "de": {"stringUnit":{"state":"translated","value":"7 Tage kostenlos, dann %@ pro Woche. Automatische Verlängerung; jederzeit kündigen."}},
        "es": {"stringUnit":{"state":"translated","value":"7 días gratis, luego %@ por semana. Renovación automática; cancelar en cualquier momento."}},
        "fr": {"stringUnit":{"state":"translated","value":"7 jours gratuits, puis %@ par semaine. Renouvellement automatique ; annuler à tout moment."}},
        "it": {"stringUnit":{"state":"translated","value":"7 giorni gratis, poi %@ a settimana. Rinnovo automatico; annullare in qualsiasi momento."}},
        "ja": {"stringUnit":{"state":"translated","value":"7 日間無料、その後は 1 週間ごとに%@ 。自動更新。いつでもキャンセルできます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"7일 무료, 이후 매주 %@ . 자동 갱신; 언제든지 취소하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"7 dagen gratis, daarna %@ per week. Automatische verlenging; op elk gewenst moment opzeggen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"7 dias grátis e depois %@ por semana. Renovação automática; cancele a qualquer momento."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"7 天免费，然后每周%@ 。自动续订；随时取消。"}}
      }
    },
    "7 days free, then %@ per year. Auto-renews; cancel anytime." : {
      "localizations" : {
