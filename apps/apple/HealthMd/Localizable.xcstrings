    "Share" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Teilen"}},
        "es": {"stringUnit":{"state":"translated","value":"Compartir"}},
        "fr": {"stringUnit":{"state":"translated","value":"Partager"}},
        "it": {"stringUnit":{"state":"translated","value":"Condividi"}},
        "ja": {"stringUnit":{"state":"translated","value":"共有"}},
        "ko": {"stringUnit":{"state":"translated","value":"공유"}},
        "nl": {"stringUnit":{"state":"translated","value":"Delen"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Compartilhar"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"分享"}}
      }
    },
    "Share a clearer health story" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Teile ein klareres Bild deiner Gesundheit"}},
        "es": {"stringUnit":{"state":"translated","value":"Comparte una visión más clara de tu salud"}},
        "fr": {"stringUnit":{"state":"translated","value":"Partagez une vue plus claire de votre santé"}},
        "it": {"stringUnit":{"state":"translated","value":"Condividi un quadro più chiaro della tua salute"}},
        "ja": {"stringUnit":{"state":"translated","value":"健康の状況をよりわかりやすく共有"}},
        "ko": {"stringUnit":{"state":"translated","value":"건강 정보를 더 명확하게 공유"}},
        "nl": {"stringUnit":{"state":"translated","value":"Deel een duidelijker beeld van je gezondheid"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Compartilhe um panorama mais claro da sua saúde"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更清晰地分享健康状况"}}
      }
    },
    "Share export preferences—not health data, permissions, credentials, purchases, or device access. Custom Markdown, frontmatter values, and endpoint host/path are copied verbatim, so review them for personal, tenant, routing, or secret text before sending." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Teile Exporteinstellungen – keine Gesundheitsdaten, Berechtigungen, Zugangsdaten, Käufe oder Gerätezugriffe. Benutzerdefiniertes Markdown, Frontmatter-Werte sowie Host/Pfad des Endpunkts werden unverändert kopiert. Prüfe sie daher vor dem Senden auf persönliche Angaben, Mandanten- oder Routinginformationen und geheime Inhalte."}},
        "es": {"stringUnit":{"state":"translated","value":"Comparte las preferencias de exportación, no datos de salud, permisos, credenciales, compras ni acceso al dispositivo. El Markdown personalizado, los valores de frontmatter y el host y la ruta del endpoint se copian literalmente; revísalos antes de enviarlos por si contienen información personal, de la organización, de enrutamiento o secreta."}},
        "fr": {"stringUnit":{"state":"translated","value":"Partagez les préférences d’exportation, et non les données de santé, autorisations, identifiants, achats ou accès à l’appareil. Le Markdown personnalisé, les valeurs du frontmatter ainsi que l’hôte et le chemin du point de terminaison sont copiés tels quels : vérifiez qu’ils ne contiennent pas de texte personnel, propre à un locataire, de routage ou secret avant l’envoi."}},
        "it": {"stringUnit":{"state":"translated","value":"Condividi le preferenze di esportazione, non dati sanitari, autorizzazioni, credenziali, acquisti o accesso al dispositivo. Il Markdown personalizzato, i valori del frontmatter e l’host e il percorso dell’endpoint vengono copiati senza modifiche: prima dell’invio, controlla che non contengano informazioni personali, sul tenant, sull’instradamento o riservate."}},
        "ja": {"stringUnit":{"state":"translated","value":"共有するのはエクスポート設定のみで、健康データ、権限、認証情報、購入情報、デバイスへのアクセス権は共有されません。カスタムMarkdown、フロントマターの値、エンドポイントのホストとパスはそのままコピーされるため、送信前に個人情報、テナント情報、ルーティング情報、秘密情報が含まれていないか確認してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"건강 데이터, 권한, 자격 증명, 구매 내역, 기기 접근 권한이 아닌 내보내기 환경설정을 공유합니다. 사용자 지정 Markdown, frontmatter 값, 엔드포인트 호스트/경로는 그대로 복사되므로 보내기 전에 개인정보, 테넌트 정보, 라우팅 정보 또는 비밀 정보가 포함되어 있는지 검토하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Deel exportvoorkeuren — geen gezondheidsgegevens, machtigingen, inloggegevens, aankopen of apparaattoegang. Aangepaste Markdown, frontmatter-waarden en de host en het pad van endpoints worden letterlijk gekopieerd. Controleer ze daarom vóór verzending op persoonlijke informatie, tenantgegevens, routeringsinformatie of geheime tekst."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Compartilhe preferências de exportação — não dados de saúde, permissões, credenciais, compras ou acesso ao dispositivo. O Markdown personalizado, os valores de frontmatter e o host/caminho do endpoint são copiados sem alterações. Por isso, revise-os antes de enviar para identificar informações pessoais, de locatário, de roteamento ou sigilosas."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"分享的是导出偏好设置，而非健康数据、权限、凭据、购买记录或设备访问权限。自定义 Markdown、frontmatter 值以及端点主机/路径会原样复制，因此发送前请检查其中是否包含个人信息、租户信息、路由信息或机密文本。"}}
      }
    },
