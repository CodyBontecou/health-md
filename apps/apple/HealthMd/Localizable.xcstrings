    "Paired with %@ via %@. Commands connect on demand while access is enabled." : {
      "localizations" : {
        "en": {"stringUnit":{"state":"new","value":"Paired with %1$@ via %2$@. Commands connect on demand while access is enabled."}},
        "de": {"stringUnit":{"state":"translated","value":"Mit %@ über %@ gekoppelt. Befehle stellen bei Bedarf eine Verbindung her, solange der Zugriff aktiviert ist."}},
        "es": {"stringUnit":{"state":"translated","value":"Enlazado con %@ mediante %@. Los comandos se conectan cuando es necesario mientras el acceso está activado."}},
        "fr": {"stringUnit":{"state":"translated","value":"Jumelé avec %@ via %@. Les commandes se connectent à la demande tant que l’accès est activé."}},
        "it": {"stringUnit":{"state":"translated","value":"Abbinato a %@ tramite %@. I comandi si connettono su richiesta mentre l'accesso è attivato."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@ と %@ 経由でペアリング済みです。アクセスが有効な間、コマンドは必要に応じて接続します。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@와 %@을(를) 통해 페어링되었습니다. 접근이 활성화되어 있는 동안 명령 실행 시 필요에 따라 연결됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Gekoppeld met %@ via %@. Opdrachten maken zo nodig verbinding zolang toegang is ingeschakeld."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Emparelhado com %@ via %@. Os comandos se conectam sob demanda enquanto o acesso estiver ativado."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已与 %@ 配对，连接方式为 %@。启用访问时，命令会按需连接。"}}
      }
    },
    "Paired with %@. The connection is saved; no pairing code is required." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Mit %@ gekoppelt. Die Verbindung ist gespeichert; ein Kopplungscode ist nicht erforderlich."}},
        "es": {"stringUnit":{"state":"translated","value":"Enlazado con %@. La conexión está guardada; no se necesita código de enlace."}},
        "fr": {"stringUnit":{"state":"translated","value":"Jumelé avec %@. La connexion est enregistrée ; aucun code de jumelage n’est requis."}},
        "it": {"stringUnit":{"state":"translated","value":"Abbinato a %@. La connessione è salvata; non è necessario un codice di abbinamento."}},
        "ja": {"stringUnit":{"state":"translated","value":"%@ とペアリング済みです。接続は保存されており、ペアリングコードは不要です。"}},
        "ko": {"stringUnit":{"state":"translated","value":"%@와 페어링되었습니다. 연결이 저장되어 페어링 코드가 필요하지 않습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Gekoppeld met %@. De verbinding is opgeslagen; er is geen koppelcode nodig."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Emparelhado com %@. A conexão está salva; nenhum código de emparelhamento é necessário."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已与 %@ 配对。连接已保存，无需配对码。"}}
      }
    },
