    "The imported endpoint identity is no longer available. Configure the endpoint in this profile's export settings." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Die importierte Endpunktidentität ist nicht mehr verfügbar. Konfiguriere den Endpunkt in den Exporteinstellungen dieses Profils."}},
        "es": {"stringUnit":{"state":"translated","value":"La identidad del endpoint importado ya no está disponible. Configura el endpoint en los ajustes de exportación de este perfil."}},
        "fr": {"stringUnit":{"state":"translated","value":"L’identité du point de terminaison importé n’est plus disponible. Configurez le point de terminaison dans les paramètres d’exportation de ce profil."}},
        "it": {"stringUnit":{"state":"translated","value":"L’identità dell’endpoint importata non è più disponibile. Configura l’endpoint nelle impostazioni di esportazione di questo profilo."}},
        "ja": {"stringUnit":{"state":"translated","value":"インポートされたエンドポイントの識別情報は利用できなくなりました。このプロファイルのエクスポート設定でエンドポイントを設定してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"가져온 엔드포인트 식별 정보를 더 이상 사용할 수 없습니다. 이 프로필의 내보내기 설정에서 엔드포인트를 구성하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"De geïmporteerde eindpuntidentiteit is niet meer beschikbaar. Configureer het eindpunt in de exportinstellingen van dit profiel."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A identidade do endpoint importado não está mais disponível. Configure o endpoint nas configurações de exportação deste perfil."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"导入的端点身份已不可用。请在此配置的导出设置中配置端点。"}}
      }
