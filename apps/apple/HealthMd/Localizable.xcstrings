          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Health.md no pudo leer uno o más tipos de datos solicitados de Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
