{
  "sourceLanguage" : "en",
  "strings" : {
    "Double tap to disable individual entry tracking" : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Doppeltippen, um die Verfolgung von Einzeleinträgen zu deaktivieren"}},
      "es":{"stringUnit":{"state":"translated","value":"Toca dos veces para desactivar el registro de entradas individuales"}},
      "fr":{"stringUnit":{"state":"translated","value":"Touchez deux fois pour désactiver le suivi des entrées individuelles"}},
      "it":{"stringUnit":{"state":"translated","value":"Tocca due volte per disattivare il monitoraggio delle voci individuali"}},
      "ja":{"stringUnit":{"state":"translated","value":"ダブルタップして個別エントリの追跡を無効にします"}},
      "ko":{"stringUnit":{"state":"translated","value":"이중 탭하여 개별 항목 추적을 비활성화합니다"}},
      "nl":{"stringUnit":{"state":"translated","value":"Tik dubbel om het bijhouden van afzonderlijke items uit te schakelen"}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Toque duas vezes para desativar o monitoramento de entradas individuais"}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"轻点两下以停用单条记录跟踪"}}
    }},
    "Double tap to enable individual entry tracking" : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Doppeltippen, um die Verfolgung von Einzeleinträgen zu aktivieren"}},
      "es":{"stringUnit":{"state":"translated","value":"Toca dos veces para activar el registro de entradas individuales"}},
      "fr":{"stringUnit":{"state":"translated","value":"Touchez deux fois pour activer le suivi des entrées individuelles"}},
      "it":{"stringUnit":{"state":"translated","value":"Tocca due volte per attivare il monitoraggio delle voci individuali"}},
      "ja":{"stringUnit":{"state":"translated","value":"ダブルタップして個別エントリの追跡を有効にします"}},
      "ko":{"stringUnit":{"state":"translated","value":"이중 탭하여 개별 항목 추적을 활성화합니다"}},
      "nl":{"stringUnit":{"state":"translated","value":"Tik dubbel om het bijhouden van afzonderlijke items in te schakelen"}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Toque duas vezes para ativar o monitoramento de entradas individuais"}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"轻点两下以启用单条记录跟踪"}}
    }},
    "Double tap to disable all individual tracking." : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Doppeltippen, um die gesamte Einzelverfolgung zu deaktivieren."}},
      "es":{"stringUnit":{"state":"translated","value":"Toca dos veces para desactivar todo el registro individual."}},
      "fr":{"stringUnit":{"state":"translated","value":"Touchez deux fois pour désactiver tout suivi individuel."}},
      "it":{"stringUnit":{"state":"translated","value":"Tocca due volte per disattivare tutto il monitoraggio individuale."}},
      "ja":{"stringUnit":{"state":"translated","value":"ダブルタップしてすべての個別追跡を無効にします。"}},
      "ko":{"stringUnit":{"state":"translated","value":"이중 탭하여 모든 개별 추적을 비활성화합니다."}},
      "nl":{"stringUnit":{"state":"translated","value":"Tik dubbel om het bijhouden van alle afzonderlijke items uit te schakelen."}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Toque duas vezes para desativar todo o monitoramento individual."}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"轻点两下以停用所有单条记录跟踪。"}}
    }},
    "Double tap to track all enabled metrics individually." : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Doppeltippen, um alle aktivierten Metriken einzeln zu verfolgen."}},
      "es":{"stringUnit":{"state":"translated","value":"Toca dos veces para registrar individualmente todas las métricas activadas."}},
      "fr":{"stringUnit":{"state":"translated","value":"Touchez deux fois pour suivre individuellement tous les indicateurs activés."}},
      "it":{"stringUnit":{"state":"translated","value":"Tocca due volte per monitorare singolarmente tutte le metriche attivate."}},
      "ja":{"stringUnit":{"state":"translated","value":"ダブルタップして有効なすべての指標を個別に追跡します。"}},
      "ko":{"stringUnit":{"state":"translated","value":"이중 탭하여 활성화된 모든 항목을 개별적으로 추적합니다."}},
      "nl":{"stringUnit":{"state":"translated","value":"Tik dubbel om alle ingeschakelde meetwaarden afzonderlijk bij te houden."}},
      "pt-BR":{"stringUnit":{"state":"translated","value":"Toque duas vezes para monitorar individualmente todas as métricas ativadas."}},
      "zh-Hans":{"stringUnit":{"state":"translated","value":"轻点两下以单独跟踪所有已启用的指标。"}}
    }},
    "Metrics currently enabled in Health Metrics: %lld." : {"localizations":{
      "de":{"stringUnit":{"state":"translated","value":"Derzeit unter Gesundheitsmetriken aktiviert: %lld."}},
      "es":{"stringUnit":{"state":"translated","value":"Métricas activadas actualmente en Métricas de salud: %lld."}},
