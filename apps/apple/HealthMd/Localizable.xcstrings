    "Daily Note Injection target conflicts with export output: %@. Change Output folder/filename or Daily Note Injection folder/filename." : {
      "comment" : "Reviewed macOS display localization",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Daily Note-Injection-Ziel steht in Konflikt mit der Exportausgabe: %1$@. Ändern Sie den Ausgabeordner/-dateinamen oder den Daily Note-Injection-Ordner/-dateinamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Note Injection target conflicts with export output: %1$@. Change Output folder/filename or Daily Note Injection folder/filename."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El objetivo de inyección de notas diarias entra en conflicto con la salida de exportación: %1$@. Cambie la carpeta/nombre de archivo de salida o la carpeta/nombre de archivo de inyección diaria de notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible d’injection de notes quotidiennes est en conflit avec la sortie d’exportation : %1$@. Modifiez le dossier/nom de fichier de sortie ou le dossier/nom de fichier d’injection de notes quotidiennes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destinazione dell'inserimento di note giornaliere è in conflitto con l'output di esportazione: %1$@. Cambia la cartella/nome file di output o la cartella/nome file di Daily Note Injection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daily Note Injection ターゲットはエクスポート出力と競合します: %1$@。出力フォルダー/ファイル名または Daily Note Injection フォルダー/ファイル名を変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일일 노트 주입 대상이 내보내기 출력: %1$@와 충돌합니다. 출력 폴더/파일 이름 또는 Daily Note 주입 폴더/파일 이름을 변경합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Injectiedoel voor dagelijkse notitie conflicteert met exportuitvoer: %1$@. Wijzig de map/bestandsnaam van de uitvoer of de map/bestandsnaam van Daily Note Injection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observação diária O destino da injeção entra em conflito com a saída de exportação: %1$@. Altere a pasta/nome do arquivo de saída ou a pasta/nome do arquivo de injeção de notas diárias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日注释注入目标与导出输出冲突：%1$@。更改输出文件夹/文件名或每日笔记注入文件夹/文件名。"
          }
        }
      }
    },
