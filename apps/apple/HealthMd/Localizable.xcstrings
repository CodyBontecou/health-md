    "Templates accept {date}, {year}, {month}, {day}, {weekday}, {monthName}, and {quarter}." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Vorlagen unterstützen {date}, {year}, {month}, {day}, {weekday}, {monthName} und {quarter}."}},
        "es": {"stringUnit":{"state":"translated","value":"Las plantillas admiten {date}, {year}, {month}, {day}, {weekday}, {monthName} y {quarter}."}},
        "fr": {"stringUnit":{"state":"translated","value":"Les modèles acceptent {date}, {year}, {month}, {day}, {weekday}, {monthName} et {quarter}."}},
        "it": {"stringUnit":{"state":"translated","value":"I modelli accettano {date}, {year}, {month}, {day}, {weekday}, {monthName} e {quarter}."}},
        "ja": {"stringUnit":{"state":"translated","value":"テンプレートには{date}、{year}、{month}、{day}、{weekday}、{monthName}、{quarter}を使用できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"템플릿에서 {date}, {year}, {month}, {day}, {weekday}, {monthName}, {quarter}를 사용할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Sjablonen ondersteunen {date}, {year}, {month}, {day}, {weekday}, {monthName} en {quarter}."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os modelos aceitam {date}, {year}, {month}, {day}, {weekday}, {monthName} e {quarter}."}},
