    "Double tap to disable standard health metrics. Medications require a separate permission step." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Doppeltippen, um Standard-Gesundheitsmetriken zu deaktivieren. Medikamente erfordern einen separaten Berechtigungsschritt."}},
        "es" : {"stringUnit":{"state":"translated","value":"Toca dos veces para desactivar las métricas de salud estándar. Los medicamentos requieren un paso de permiso aparte."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Touchez deux fois pour désactiver les mesures de santé standard. Les médicaments nécessitent une autorisation distincte."}},
        "it" : {"stringUnit":{"state":"translated","value":"Tocca due volte per disattivare le metriche sanitarie standard. I farmaci richiedono un’autorizzazione separata."}},
        "ja" : {"stringUnit":{"state":"translated","value":"ダブルタップして標準の健康指標を無効にします。服薬情報には別途許可が必要です。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이중 탭하여 기본 건강 지표를 비활성화합니다. 복약 정보는 별도의 권한 허용 단계가 필요합니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Tik dubbel om standaardgezondheidsmetingen uit te schakelen. Voor medicijnen is een aparte toestemmingsstap nodig."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Toque duas vezes para desativar as métricas de saúde padrão. Os medicamentos exigem uma etapa de permissão separada."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"轻点两下以停用标准健康指标。药物信息需要单独授权。"}}
      }
    },
    "Double tap to enable standard health metrics. Medications require a separate permission step." : {
      "localizations" : {
        "de" : {"stringUnit":{"state":"translated","value":"Doppeltippen, um Standard-Gesundheitsmetriken zu aktivieren. Medikamente erfordern einen separaten Berechtigungsschritt."}},
        "es" : {"stringUnit":{"state":"translated","value":"Toca dos veces para activar las métricas de salud estándar. Los medicamentos requieren un paso de permiso aparte."}},
        "fr" : {"stringUnit":{"state":"translated","value":"Touchez deux fois pour activer les mesures de santé standard. Les médicaments nécessitent une autorisation distincte."}},
        "it" : {"stringUnit":{"state":"translated","value":"Tocca due volte per attivare le metriche sanitarie standard. I farmaci richiedono un’autorizzazione separata."}},
        "ja" : {"stringUnit":{"state":"translated","value":"ダブルタップして標準の健康指標を有効にします。服薬情報には別途許可が必要です。"}},
        "ko" : {"stringUnit":{"state":"translated","value":"이중 탭하여 기본 건강 지표를 활성화합니다. 복약 정보는 별도의 권한 허용 단계가 필요합니다."}},
        "nl" : {"stringUnit":{"state":"translated","value":"Tik dubbel om standaardgezondheidsmetingen in te schakelen. Voor medicijnen is een aparte toestemmingsstap nodig."}},
        "pt-BR" : {"stringUnit":{"state":"translated","value":"Toque duas vezes para ativar as métricas de saúde padrão. Os medicamentos exigem uma etapa de permissão separada."}},
        "zh-Hans" : {"stringUnit":{"state":"translated","value":"轻点两下以启用标准健康指标。药物信息需要单独授权。"}}
