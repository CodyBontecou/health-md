    "Saved Mac destination %@ needs access. Re-select it in Health.md on Mac." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Das gespeicherte Mac-Exportziel %@ benötigt eine Zugriffsberechtigung. Wähle es in Health.md auf dem Mac erneut aus."}},
        "es": {"stringUnit":{"state":"translated","value":"Se necesita permiso de acceso al destino guardado %@ en el Mac. Vuelve a seleccionarlo en Health.md en el Mac."}},
        "fr": {"stringUnit":{"state":"translated","value":"La destination Mac enregistrée %@ nécessite une autorisation d’accès. Sélectionnez-la à nouveau dans Health.md sur Mac."}},
        "it": {"stringUnit":{"state":"translated","value":"La destinazione Mac salvata %@ richiede l’autorizzazione di accesso. Selezionala di nuovo in Health.md sul Mac."}},
        "ja": {"stringUnit":{"state":"translated","value":"保存済みのMacの保存先%@にはアクセス許可が必要です。MacのHealth.mdで再選択してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"저장된 Mac 대상 %@에 대한 접근 권한이 필요합니다. Mac의 Health.md에서 다시 선택하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Opgeslagen Mac-bestemming %@ vereist toegang. Selecteer deze opnieuw in Health.md op de Mac."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O destino %@ salvo no Mac precisa de permissão de acesso. Selecione-o novamente no Health.md no Mac."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已保存的 Mac 目标 %@ 需要访问权限。请在 Mac 上的 Health.md 中重新选择。"}}
      }
    },
    "Saved Mac destination %@ needs access. Re-select it on Mac." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Das gespeicherte Mac-Exportziel %@ benötigt eine Zugriffsberechtigung. Wähle es auf dem Mac erneut aus."}},
        "es": {"stringUnit":{"state":"translated","value":"Se necesita permiso de acceso al destino guardado %@ en el Mac. Vuelve a seleccionarlo en el Mac."}},
        "fr": {"stringUnit":{"state":"translated","value":"La destination Mac enregistrée %@ nécessite une autorisation d’accès. Sélectionnez-la à nouveau sur Mac."}},
        "it": {"stringUnit":{"state":"translated","value":"La destinazione Mac salvata %@ richiede l’autorizzazione di accesso. Selezionala di nuovo sul Mac."}},
        "ja": {"stringUnit":{"state":"translated","value":"保存済みのMacの保存先%@にはアクセス許可が必要です。Macで再選択してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"저장된 Mac 대상 %@에 대한 접근 권한이 필요합니다. Mac에서 다시 선택하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Opgeslagen Mac-bestemming %@ vereist toegang. Selecteer deze opnieuw op de Mac."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O destino %@ salvo no Mac precisa de permissão de acesso. Selecione-o novamente no Mac."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已保存的 Mac 目标 %@ 需要访问权限。请在 Mac 上重新选择。"}}
      }
    },
    "Saved folder changed. Review it in Files, then re-select the intended folder." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Der gespeicherte Ordner hat sich geändert. Prüfe ihn in „Dateien“ und wähle dann den gewünschten Ordner erneut aus."}},
        "es": {"stringUnit":{"state":"translated","value":"La carpeta guardada ha cambiado. Revísala en Archivos y vuelve a seleccionar la carpeta que quieras usar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le dossier enregistré a changé. Vérifiez-le dans Fichiers, puis sélectionnez à nouveau le dossier souhaité."}},
        "it": {"stringUnit":{"state":"translated","value":"La cartella salvata è cambiata. Controllala in File, poi seleziona di nuovo la cartella desiderata."}},
        "ja": {"stringUnit":{"state":"translated","value":"保存済みのフォルダが変更されました。「ファイル」で確認し、目的のフォルダを再選択してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"저장된 폴더가 변경되었습니다. 파일 앱에서 확인한 후 원하는 폴더를 다시 선택하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Opgeslagen map gewijzigd. Controleer deze in Bestanden en selecteer daarna de bedoelde map opnieuw."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A pasta salva mudou. Confira no app Arquivos e selecione novamente a pasta desejada."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已保存的文件夹已更改。请在“文件”中查看，然后重新选择所需文件夹。"}}
      }
    },
    "Saved folder unavailable. Reconnect it in Files or tap to re-select." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Gespeicherter Ordner nicht verfügbar. Verbinde ihn in „Dateien“ erneut oder tippe, um ihn erneut auszuwählen."}},
        "es": {"stringUnit":{"state":"translated","value":"La carpeta guardada no está disponible. Vuelve a conectarla en Archivos o toca para seleccionarla de nuevo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Dossier enregistré indisponible. Reconnectez-le dans Fichiers ou touchez pour le sélectionner à nouveau."}},
        "it": {"stringUnit":{"state":"translated","value":"Cartella salvata non disponibile. Ricollegala in File o tocca per selezionarla di nuovo."}},
        "ja": {"stringUnit":{"state":"translated","value":"保存済みのフォルダを利用できません。「ファイル」で再接続するか、タップして再選択してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"저장된 폴더를 사용할 수 없습니다. 파일 앱에서 다시 연결하거나 탭하여 다시 선택하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Opgeslagen map niet beschikbaar. Verbind deze opnieuw in Bestanden of tik om opnieuw te selecteren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Pasta salva indisponível. Reconecte-a no app Arquivos ou toque para selecioná-la novamente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已保存的文件夹不可用。请在“文件”中重新连接，或轻点以重新选择。"}}
      }
    },
    "Scan a fresh QR from healthmd above, or choose the same transport and enter its one-time code manually." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Scanne oben einen neuen QR-Code von healthmd oder wähle denselben Übertragungsweg und gib den zugehörigen Einmalcode manuell ein."}},
        "es": {"stringUnit":{"state":"translated","value":"Escanea arriba un QR nuevo de healthmd o elige el mismo transporte e introduce manualmente su código de un solo uso."}},
        "fr": {"stringUnit":{"state":"translated","value":"Scannez ci-dessus un nouveau code QR fourni par healthmd, ou choisissez le même mode de transport et saisissez manuellement son code à usage unique."}},
        "it": {"stringUnit":{"state":"translated","value":"Scansiona un nuovo codice QR da healthmd qui sopra, oppure scegli lo stesso metodo di trasporto e inserisci manualmente il relativo codice monouso."}},
        "ja": {"stringUnit":{"state":"translated","value":"上のhealthmdで新しく生成したQRコードをスキャンするか、同じ通信方式を選択してワンタイムコードを手動で入力してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"위의 healthmd에서 새 QR 코드를 스캔하거나, 동일한 전송 방식을 선택하고 일회용 코드를 직접 입력하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Scan hierboven een nieuwe QR-code van healthmd, of kies dezelfde verbindingsmethode en voer de bijbehorende eenmalige code handmatig in."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Escaneie um novo QR do healthmd acima ou escolha o mesmo transporte e insira manualmente o código de uso único."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"扫描上方 healthmd 提供的新二维码，或选择相同的传输方式并手动输入其一次性代码。"}}
      }
    },
    "Scanning this QR inside Health.md authorizes a one-time connection to healthmd at %@:%@." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Durch Scannen dieses QR-Codes in Health.md autorisierst du eine einmalige Verbindung mit healthmd unter %@:%@."}},
        "es": {"stringUnit":{"state":"translated","value":"Escanear este QR dentro de Health.md autoriza una conexión de un solo uso con healthmd en %@:%@."}},
        "fr": {"stringUnit":{"state":"translated","value":"Scanner ce code QR dans Health.md autorise une connexion unique à healthmd à l’adresse %@:%@."}},
        "it": {"stringUnit":{"state":"translated","value":"La scansione di questo codice QR in Health.md autorizza una connessione singola a healthmd su %@:%@."}},
        "ja": {"stringUnit":{"state":"translated","value":"Health.md内でこのQRコードをスキャンすると、%@:%@のhealthmdへの1回限りの接続が許可されます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Health.md에서 이 QR 코드를 스캔하면 %@:%@의 healthmd에 대한 일회성 연결이 승인됩니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Door deze QR-code in Health.md te scannen, geef je toestemming voor een eenmalige verbinding met healthmd op %@:%@."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Escanear este QR no Health.md autoriza uma conexão única ao healthmd em %@:%@."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在 Health.md 内扫描此二维码，即可授权与 %@:%@ 上的 healthmd 建立一次性连接。"}}
      }
    },
    "The authenticated CLI can request status, raw data, or generated export files." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Die authentifizierte CLI kann den Status, Rohdaten oder erstellte Exportdateien anfordern."}},
        "es": {"stringUnit":{"state":"translated","value":"La CLI autenticada puede solicitar el estado, datos sin procesar o archivos de exportación generados."}},
        "fr": {"stringUnit":{"state":"translated","value":"La CLI authentifiée peut demander l’état, les données brutes ou les fichiers d’export générés."}},
        "it": {"stringUnit":{"state":"translated","value":"La CLI autenticata può richiedere lo stato, i dati grezzi o i file di esportazione generati."}},
        "ja": {"stringUnit":{"state":"translated","value":"認証済みのCLIは、ステータス、未加工データ、生成済みのエクスポートファイルを要求できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"인증된 CLI는 상태, 원시 데이터 또는 생성된 내보내기 파일을 요청할 수 있습니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"De geauthenticeerde CLI kan de status, onbewerkte gegevens of gegenereerde exportbestanden opvragen."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A CLI autenticada pode solicitar status, dados brutos ou arquivos de exportação gerados."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"经过身份验证的 CLI 可以请求状态、原始数据或生成的导出文件。"}}
      }
    },
    "Today Refresh rewrites today's export while the day is still in progress.\n\n%@\n\n%@ is relative to your Preferred Time (%@). Health.md targets %@, then repeats at that interval until midnight. If you enable it after a target time has passed, the next future slot is used.\n\nAutomatic background exports depend on iOS. If Health.md needs your attention, unlock your device and tap the notification to run the pending export." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Die Aktualisierung für heute schreibt den heutigen Export neu, solange der Tag noch läuft.\n\n%@\n\n%@ bezieht sich auf deine bevorzugte Uhrzeit (%@). Health.md plant die Ausführung für %@ und wiederholt sie dann in diesem Intervall bis Mitternacht. Wenn du die Funktion nach einer geplanten Uhrzeit aktivierst, wird der nächste zukünftige Termin verwendet.\n\nAutomatische Hintergrundexporte hängen von iOS ab. Wenn Health.md deine Aufmerksamkeit benötigt, entsperre dein Gerät und tippe auf die Mitteilung, um den ausstehenden Export auszuführen."}},
        "es": {"stringUnit":{"state":"translated","value":"La actualización de hoy reescribe la exportación de hoy mientras el día sigue en curso.\n\n%@\n\n%@ es relativo a tu hora preferida (%@). Health.md programa la ejecución para %@ y luego la repite con ese intervalo hasta medianoche. Si la activas después de una hora programada, se usa la siguiente hora futura.\n\nLas exportaciones automáticas en segundo plano dependen de iOS. Si Health.md necesita tu atención, desbloquea el dispositivo y toca la notificación para ejecutar la exportación pendiente."}},
        "fr": {"stringUnit":{"state":"translated","value":"L’actualisation du jour réécrit l’export d’aujourd’hui tant que la journée est en cours.\n\n%@\n\n%@ est relatif à votre heure préférée (%@). Health.md vise %@, puis répète l’opération à cet intervalle jusqu’à minuit. Si vous l’activez après une heure cible, le prochain créneau à venir est utilisé.\n\nLes exports automatiques en arrière-plan dépendent d’iOS. Si Health.md nécessite votre attention, déverrouillez votre appareil et touchez la notification pour lancer l’export en attente."}},
        "it": {"stringUnit":{"state":"translated","value":"L’aggiornamento odierno riscrive l’esportazione di oggi mentre la giornata è ancora in corso.\n\n%@\n\n%@ è relativo al tuo orario preferito (%@). Health.md punta a %@, poi ripete l’operazione a quell’intervallo fino a mezzanotte. Se lo attivi dopo che un orario previsto è trascorso, viene usato il successivo orario disponibile.\n\nLe esportazioni automatiche in background dipendono da iOS. Se Health.md richiede la tua attenzione, sblocca il dispositivo e tocca la notifica per eseguire l’esportazione in attesa."}},
        "ja": {"stringUnit":{"state":"translated","value":"「今日の更新」は、その日が終わるまで今日のエクスポートを書き直します。\n\n%@\n\n%@は、希望時刻（%@）を基準にしています。Health.mdは%@を目標時刻とし、その後は午前0時までその間隔で繰り返します。目標時刻を過ぎてから有効にした場合は、次の予定時刻に実行します。\n\nバックグラウンドでの自動エクスポートはiOSに依存します。Health.mdで操作が必要になった場合は、デバイスのロックを解除して通知をタップし、保留中のエクスポートを実行してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"오늘 새로 고침은 하루가 끝나기 전까지 오늘의 내보내기를 다시 작성합니다.\n\n%@\n\n%@은(는) 선호 시간(%@)을 기준으로 합니다. Health.md는 %@에 실행한 다음 자정까지 해당 간격으로 반복합니다. 목표 시간이 지난 후 활성화하면 다음 예정 시간에 실행됩니다.\n\n자동 백그라운드 내보내기는 iOS에 따라 달라집니다. Health.md에 사용자 조치가 필요한 경우 기기의 잠금을 해제하고 알림을 탭하여 대기 중인 내보내기를 실행하세요."}},
        "nl": {"stringUnit":{"state":"translated","value":"Vandaag vernieuwen herschrijft de export van vandaag zolang de dag nog bezig is.\n\n%@\n\n%@ is relatief aan je voorkeurstijd (%@). Health.md richt zich op %@ en herhaalt dit vervolgens met dat interval tot middernacht. Als je dit inschakelt nadat een gepland tijdstip is verstreken, wordt het eerstvolgende tijdstip gebruikt.\n\nAutomatische exports op de achtergrond zijn afhankelijk van iOS. Als Health.md je aandacht nodig heeft, ontgrendel je je apparaat en tik je op de melding om de wachtende export uit te voeren."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A Atualização de hoje regrava a exportação de hoje enquanto o dia ainda está em andamento.\n\n%@\n\n%@ é relativo ao seu Horário preferido (%@). O Health.md usa %@ como horário inicial e repete nesse intervalo até a meia-noite. Se você ativar o recurso após um horário previsto, será usado o próximo horário futuro.\n\nAs exportações automáticas em segundo plano dependem do iOS. Se o Health.md precisar da sua atenção, desbloqueie o dispositivo e toque na notificação para executar a exportação pendente."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"今日刷新会在当天结束前重写当天的导出。\n\n%@\n\n%@ 相对于您的首选时间（%@）计算。Health.md 以 %@ 为目标时间，随后按该间隔重复执行，直到午夜。如果启用时某个目标时间已过，则使用下一个尚未到来的时段。\n\n后台自动导出取决于 iOS。如果 Health.md 需要您处理，请解锁设备并轻点通知，以运行待执行的导出。"}}
      }
    },
    "Update Health.md on Mac" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Health.md auf dem Mac aktualisieren"}},
        "es": {"stringUnit":{"state":"translated","value":"Actualiza Health.md en el Mac"}},
        "fr": {"stringUnit":{"state":"translated","value":"Mettre à jour Health.md sur Mac"}},
        "it": {"stringUnit":{"state":"translated","value":"Aggiorna Health.md sul Mac"}},
        "ja": {"stringUnit":{"state":"translated","value":"MacのHealth.mdをアップデート"}},
        "ko": {"stringUnit":{"state":"translated","value":"Mac의 Health.md 업데이트"}},
        "nl": {"stringUnit":{"state":"translated","value":"Werk Health.md op de Mac bij"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Atualize o Health.md no Mac"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更新 Mac 上的 Health.md"}}
      }
    },
    "Update Health.md on Mac to export Lossless Health Records" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Aktualisiere Health.md auf dem Mac, um verlustfreie Gesundheitsdatensätze zu exportieren"}},
        "es": {"stringUnit":{"state":"translated","value":"Actualiza Health.md en el Mac para exportar registros de salud sin pérdida"}},
        "fr": {"stringUnit":{"state":"translated","value":"Mettez à jour Health.md sur Mac pour exporter les données de santé sans perte"}},
        "it": {"stringUnit":{"state":"translated","value":"Aggiorna Health.md sul Mac per esportare i dati sanitari senza perdita di informazioni"}},
        "ja": {"stringUnit":{"state":"translated","value":"ロスレスのヘルスケアレコードをエクスポートするには、MacのHealth.mdをアップデートしてください"}},
        "ko": {"stringUnit":{"state":"translated","value":"무손실 건강 기록을 내보내려면 Mac의 Health.md를 업데이트하세요"}},
        "nl": {"stringUnit":{"state":"translated","value":"Werk Health.md op de Mac bij om gezondheidsdossiers zonder gegevensverlies te exporteren"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Atualize o Health.md no Mac para exportar Registros de saúde sem perdas"}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"更新 Mac 上的 Health.md 以导出无损健康记录"}}
      }
    },
    "Update Health.md on Mac to export range summaries" : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Aktualisiere Health.md auf dem Mac, um Zeitraumzusammenfassungen zu exportieren"}},
        "es": {"stringUnit":{"state":"translated","value":"Actualiza Health.md en el Mac para exportar resúmenes por intervalo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Mettez à jour Health.md sur Mac pour exporter les résumés par période"}},
        "it": {"stringUnit":{"state":"translated","value":"Aggiorna Health.md sul Mac per esportare i riepiloghi per intervallo"}},
        "ja": {"stringUnit":{"state":"translated","value":"期間サマリーをエクスポートするには、MacのHealth.mdをアップデートしてください"}},
        "ko": {"stringUnit":{"state":"translated","value":"기간 요약을 내보내려면 Mac의 Health.md를 업데이트하세요"}},
        "nl": {"stringUnit":{"state":"translated","value":"Werk Health.md op de Mac bij om samenvattingen per periode te exporteren"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Atualize o Health.md no Mac para exportar resumos por período"}},
