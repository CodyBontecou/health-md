    "This folder will be created inside your selected export location. Empty names export directly to the root folder." : {
      "localizations" : {
        "de": {"stringUnit":{"state":"translated","value":"Dieser Ordner wird am ausgewählten Exportort erstellt. Bei leerem Namen wird direkt in den Stammordner exportiert."}},
        "es": {"stringUnit":{"state":"translated","value":"Esta carpeta se creará dentro de la ubicación de exportación seleccionada. Si el nombre está vacío, se exportará directamente a la carpeta raíz."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ce dossier sera créé dans l’emplacement d’exportation sélectionné. Si le nom est vide, l’exportation se fait directement dans le dossier racine."}},
        "it": {"stringUnit":{"state":"translated","value":"Questa cartella verrà creata nella posizione di esportazione selezionata. Lasciando il nome vuoto, l’esportazione avviene direttamente nella cartella radice."}},
        "ja": {"stringUnit":{"state":"translated","value":"このフォルダは選択したエクスポート先の中に作成されます。名前が空の場合はルートフォルダに直接エクスポートされます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 폴더는 선택한 내보내기 위치 안에 생성됩니다. 이름을 비워 두면 루트 폴더로 바로 내보냅니다."}},
        "nl": {"stringUnit":{"state":"translated","value":"Deze map wordt aangemaakt binnen je geselecteerde exportlocatie. Bij een lege naam wordt rechtstreeks naar de hoofdmap geëxporteerd."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Esta pasta será criada no local de exportação selecionado. Nomes vazios exportam diretamente para a pasta raiz."}},
        "zh-Hans": {"stringUnit":{"state":"translated","value":"此文件夹将在所选导出位置内创建。名称留空时，直接导出到根文件夹。"}}
      }
    },
    "This folder will be created inside your selected export location. Leave empty to export directly to the root folder." : {
