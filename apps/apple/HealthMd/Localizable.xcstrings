      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege unter „Exportieren“ → „API-Endpunkt“ eine gültige HTTP(S)-Endpunkt-URL fest oder deaktiviere den Zeitplan des Profils, das dieses Ziel verwendet."
