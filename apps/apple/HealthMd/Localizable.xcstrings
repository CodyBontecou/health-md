    "clinician_report_entry_subtitle": {
      "comment": "Clinician Report V1 localized vocabulary. Managed by scripts/validate-clinician-report-localizations.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine private PDF-Gesundheitsübersicht, die Sie mit medizinischem Fachpersonal teilen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a private health summary PDF to share with a clinician."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree un PDF privado con un resumen de salud para compartirlo con un profesional sanitario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un PDF privé récapitulant vos données de santé pour le partager avec un professionnel de santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un PDF privato con un riepilogo dei dati sanitari da condividere con un professionista sanitario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療従事者と共有する非公開の健康サマリー PDF を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
