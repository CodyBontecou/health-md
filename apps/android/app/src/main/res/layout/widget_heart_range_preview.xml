<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_semibold"
        android:text="@string/widget_heart_range_name"
        android:textColor="@color/widget_preview_heart"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/geist_mono_medium"
        android:text="@string/widget_preview_heart_value"
        android:textColor="@color/widget_preview_primary"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/geist_regular"
        android:text="@string/widget_preview_heart_detail"
        android:textColor="@color/widget_preview_secondary"
        android:textSize="12sp" />
</LinearLayout>
