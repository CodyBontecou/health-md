<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".presentation.MainActivity" android:launchMode="singleTop" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="healthmd" android:host="myself" android:path="/claim" />
            </intent-filter>
        </activity>
        <!-- OAuth redirect callback for direct cloud health providers. -->
        <activity
            android:name=".presentation.oauth.OAuthCallbackActivity"
            android:exported="true"
            android:theme="@style/Theme.HealthMd">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="healthmd"
                    android:host="oauth2redirect" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="healthmd" android:host="oauth" android:path="/callback" />
            </intent-filter>
        </activity>
    </application>

    <queries>
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.huawei.health" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="com.ouraring.oura" />
        <package android:name="fi.polar.polarflow" />
        <package android:name="com.whoop.android" />
    </queries>
</manifest>
