    <string name="health_provider_samsung_health_summary">Samsung 手机、Galaxy Watch、睡眠、步数、锻炼和生命体征。</string>
    <string name="health_provider_samsung_health_setup_description">打开 Samsung Health 并启用与 Health Connect 共享。如果今后需要 Health Connect 之外经合作伙伴批准的数据，可添加 Samsung 的 Health Data SDK 直连支持。</string>
    <string name="health_provider_huawei_health_summary">Huawei 设备及 HMS/AppGallery 市场。</string>
    <string name="health_provider_huawei_health_setup_description">支持 Huawei 需要注册 HMS Health Kit 应用并使用启用 HMS 的版本。此目录会保留 Huawei 选项，同时不向 Play 版本添加 HMS 依赖项。</string>
    <string name="health_provider_fitbit_summary">Fitbit 追踪器、Pixel Watch Fitbit 数据、睡眠、活动和心脏数据。</string>
    <string name="health_provider_fitbit_setup_description">Fitbit 直接导入通过 OAuth 范围和刷新令牌使用 Fitbit Web API。配置应用凭据前，请在可用时通过 Health Connect 导出 Fitbit 数据。</string>
    <string name="health_provider_garmin_summary">Garmin 手表、训练、活动、睡眠和身体电量类指标。</string>
    <string name="health_provider_garmin_setup_description">Garmin 正式环境导入需要 Garmin Health API 合作伙伴批准，通常还需要后端/Webhook 同步路径。Health.md 按设计不使用 Google Fit 回退方案。</string>
    <string name="health_provider_withings_summary">Withings 体重秤、手表、血压计和睡眠垫。</string>
    <string name="health_provider_withings_setup_description">Withings 直接导入使用 OAuth 2.0 和 Withings 公共 API。启用实时云端读取前，请配置客户端凭据。</string>
    <string name="health_provider_oura_summary">Oura Ring 的睡眠、准备度、活动、心率和 HRV。</string>
    <string name="health_provider_oura_setup_description">Oura 直接导入通过 OAuth 2.0 使用 Oura Cloud API。启用实时云端读取前，请配置客户端凭据。</string>
    <string name="health_provider_polar_summary">Polar 训练、心率设备，以及通过 AccessLink 获取的睡眠/活动数据。</string>
    <string name="health_provider_polar_setup_description">Polar 历史数据导入应使用 Polar AccessLink OAuth。BLE 传感器支持是未来单独提供的实时会话功能，不能替代历史记录导出。</string>
    <string name="health_provider_whoop_summary">WHOOP 恢复、负荷、睡眠、锻炼和生理数据。</string>
    <string name="health_provider_whoop_setup_description">WHOOP 直接导入使用 WHOOP API，并请求周期、恢复、睡眠、锻炼和个人资料数据的 OAuth 范围。</string>
