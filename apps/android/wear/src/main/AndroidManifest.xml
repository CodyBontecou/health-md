<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".WearHealthMdApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_healthmd"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/WearTheme">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Play services dispatches this exported listener only for signature-matched Data Layer traffic. -->
        <provider
            android:name=".sync.WearDiagnosticsProvider"
            android:authorities="com.healthmd.android.wear.diagnostics"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="android.permission.DUMP" />
        <service android:name=".sync.WearDataLayerService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/healthmd/wear" />
            </intent-filter>
        </service>
        <receiver android:name=".surface.WearSurfaceInvalidationReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
        <service android:name=".surface.DailyActivityTileService" android:exported="true" android:label="@string/wear_activity" android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" /></intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/wear_preview_activity" />
        </service>
        <service android:name=".surface.RecoveryTileService" android:exported="true" android:label="@string/wear_recovery" android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter><action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" /></intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@drawable/wear_preview_recovery" />
        </service>

        <service android:name=".surface.DailyActivityComplicationService" android:exported="true" android:label="@string/wear_activity" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.RecoveryComplicationService" android:exported="true" android:label="@string/wear_recovery" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.StepsComplicationService" android:exported="true" android:label="@string/wear_steps" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.MoveComplicationService" android:exported="true" android:label="@string/wear_move" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.ExerciseComplicationService" android:exported="true" android:label="@string/wear_exercise" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.SleepComplicationService" android:exported="true" android:label="@string/wear_sleep" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.RestingHeartRateComplicationService" android:exported="true" android:label="@string/wear_resting_hr" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.AverageHeartRateComplicationService" android:exported="true" android:label="@string/wear_average_hr" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.HrvComplicationService" android:exported="true" android:label="@string/wear_hrv" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
        <service android:name=".surface.BloodOxygenComplicationService" android:exported="true" android:label="@string/wear_blood_oxygen" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER"><intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" /></intent-filter><meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE"/><meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="0"/></service>
    </application>
</manifest>
