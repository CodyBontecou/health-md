{
  "schema": "healthmd.account_auth.synthetic_security_vectors",
  "schema_version": 1,
  "synthetic_only": true,
  "description": "Template-expanded callback strings and symbolic principals/families only; no actual credentials, health data, registration or runtime authority.",
  "callback_vectors": [
    {"id": "valid_code", "uri": "{callback}?code={code}&state={state}&iss={issuer}", "expected": "accept_code"},
    {"id": "valid_query_order", "uri": "{callback}?iss={issuer}&state={state}&code={code}", "expected": "accept_code"},
    {"id": "consent_denied", "uri": "{callback}?error=access_denied&state={state}&iss={issuer}", "expected": "accept_denial"},
    {"id": "wrong_host", "uri": "https://evil.example/apple-ios/return?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "callback_prefix", "uri": "{callback}/extra?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "trailing_slash", "uri": "{callback}/?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "encoded_path", "uri": "{callback}%2f?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "userinfo", "uri": "https://synthetic@callbacks.account-sync.example/apple-ios/return?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "explicit_default_port", "uri": "https://callbacks.account-sync.example:443/apple-ios/return?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "uppercase_host", "uri": "https://CALLBACKS.account-sync.example/apple-ios/return?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "wrong_state", "uri": "{callback}?code={code}&state=synthetic-wrong-state&iss={issuer}", "expected": "deny"},
    {"id": "missing_state", "uri": "{callback}?code={code}&iss={issuer}", "expected": "deny"},
    {"id": "duplicate_state", "uri": "{callback}?code={code}&state={state}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "duplicate_code", "uri": "{callback}?code={code}&code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "encoded_parameter_alias", "uri": "{callback}?%63ode={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "fragment_token", "uri": "{callback}?code={code}&state={state}&iss={issuer}#access_token=synthetic-forbidden", "expected": "deny"},
    {"id": "query_access_token", "uri": "{callback}?code={code}&state={state}&iss={issuer}&access_token=synthetic-forbidden", "expected": "deny"},
    {"id": "query_refresh_token", "uri": "{callback}?code={code}&state={state}&iss={issuer}&refresh_token=synthetic-forbidden", "expected": "deny"},
    {"id": "query_account_id", "uri": "{callback}?code={code}&state={state}&iss={issuer}&account_id=synthetic-account-a", "expected": "deny"},
    {"id": "wrong_issuer", "uri": "{callback}?code={code}&state={state}&iss=https://account-auth.staging.example", "expected": "deny"},
    {"id": "missing_issuer", "uri": "{callback}?code={code}&state={state}", "expected": "deny"},
    {"id": "encoded_issuer", "uri": "{callback}?code={code}&state={state}&iss=https%3A%2F%2Faccount-auth.synthetic.example", "expected": "deny"},
    {"id": "code_error_mix", "uri": "{callback}?code={code}&error=access_denied&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "unknown_error", "uri": "{callback}?error=synthetic-reflected-message&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "refresh_as_code", "uri": "{callback}?code={refresh}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "health_request_code", "uri": "healthmd://cloud/requests?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "static_health_request", "uri": "healthmd://cloud/requests", "expected": "deny"},
    {"id": "custom_scheme", "uri": "healthmd://account/callback?code={code}&state={state}&iss={issuer}", "expected": "deny"},
    {"id": "cancelled_attempt", "uri": "{callback}?code={code}&state={state}&iss={issuer}", "context": {"pending": false}, "expected": "deny"},
    {"id": "account_switch_callback", "uri": "{callback}?code={code}&state={state}&iss={issuer}", "context": {"generation_matches": false}, "expected": "deny"},
    {"id": "unregistered_production", "uri": "{callback}?code={code}&state={state}&iss={issuer}", "context": {"environment": "production"}, "expected": "deny"},
    {"id": "wrong_public_client", "uri": "{callback}?code={code}&state={state}&iss={issuer}", "context": {"client_id": "synthetic-android-play"}, "expected": "deny"}
  ],
  "authorization_vectors": [
    {"id": "valid_s256_query", "patch": {}, "expected": "allow"},
    {"id": "pkce_plain", "patch": {"code_challenge_method": "plain"}, "expected": "deny"},
    {"id": "implicit_access_response", "patch": {"response_type": "token"}, "expected": "deny"},
    {"id": "openid_requested", "patch": {"scope": "openid"}, "expected": "deny"},
    {"id": "health_upload_scope", "patch": {"scope": "config:profiles:read health:upload"}, "expected": "deny"},
    {"id": "write_without_read", "patch": {"scope": "config:profiles:write"}, "expected": "deny"},
    {"id": "duplicate_scope", "patch": {"scope": "config:profiles:read config:profiles:read"}, "expected": "deny"},
    {"id": "noncanonical_scope_order", "patch": {"scope": "config:profiles:write config:profiles:read"}, "expected": "deny"},
    {"id": "wrong_environment_audience", "patch": {"audience": "urn:healthmd:account-config:staging:v1"}, "expected": "deny"},
    {"id": "callback_substitution", "patch": {"redirect_uri": "https://evil.example/return"}, "expected": "deny"},
    {"id": "callback_health_link", "patch": {"redirect_uri": "healthmd://cloud/requests"}, "expected": "deny"},
    {"id": "unknown_client", "patch": {"client_id": "synthetic-provider-client"}, "expected": "deny"},
    {"id": "client_secret", "patch": {"client_secret": "synthetic-forbidden"}, "expected": "deny"},
    {"id": "short_state", "patch": {"state": "short"}, "expected": "deny"},
    {"id": "missing_challenge", "remove": ["code_challenge"], "expected": "deny"}
  ],
  "authority_vectors": [
    {"id": "native_read", "route": "config_read", "expected": "allow"},
    {"id": "native_write", "route": "config_write", "expected": "allow"},
    {"id": "read_only_mutation", "route": "config_write", "principal": {"scopes": ["config:profiles:read"]}, "expected": "deny"},
    {"id": "wrong_audience", "route": "config_read", "principal": {"audience": "urn:healthmd:health-read:synthetic:v1"}, "expected": "deny"},
    {"id": "wrong_environment", "route": "config_read", "principal": {"environment": "staging"}, "expected": "deny"},
    {"id": "wrong_issuer", "route": "config_read", "principal": {"issuer": "https://account-auth.other.example"}, "expected": "deny"},
    {"id": "cross_account", "route": "config_read", "request": {"target_account": "synthetic-account-b"}, "expected": "deny"},
    {"id": "revoked_access", "route": "config_read", "principal": {"revoked": true}, "expected": "deny"},
    {"id": "disabled_account", "route": "config_read", "principal": {"account_active": false}, "expected": "deny"},
    {"id": "expired_access_at_equality", "route": "config_read", "principal": {"expires_at": 100}, "expected": "deny"},
    {"id": "unregistered_access_client", "route": "config_read", "principal": {"client_id": "synthetic-other-client"}, "expected": "deny"},
    {"id": "unapproved_native_scope", "route": "config_read", "principal": {"scopes": ["config:profiles:read", "health:upload"]}, "expected": "deny"},
    {"id": "refresh_cannot_read", "route": "config_read", "principal": {"kind": "native_refresh"}, "expected": "deny"},
    {"id": "code_cannot_write", "route": "config_write", "principal": {"kind": "authorization_code"}, "expected": "deny"},
    {"id": "ingest_cannot_read", "route": "config_read", "principal": {"kind": "ingest_token"}, "expected": "deny"},
    {"id": "mcp_cannot_write", "route": "config_write", "principal": {"kind": "mcp_read_full_export"}, "expected": "deny"},
    {"id": "device_cannot_read", "route": "config_read", "principal": {"kind": "repair_device"}, "expected": "deny"},
    {"id": "native_current_inventory", "route": "sessions", "expected": "allow"},
    {"id": "native_other_inventory", "route": "sessions", "request": {"target_session": "synthetic-other-session"}, "expected": "deny"},
    {"id": "native_self_revoke", "route": "revoke", "expected": "allow"},
    {"id": "native_other_revoke", "route": "revoke", "request": {"target_session": "synthetic-other-session"}, "expected": "deny"},
    {"id": "refresh_self_revoke_only", "route": "revoke", "principal": {"kind": "native_refresh"}, "expected": "allow"},
    {"id": "refresh_other_revoke", "route": "revoke", "principal": {"kind": "native_refresh"}, "request": {"target_session": "synthetic-other-session"}, "expected": "deny"},
    {"id": "profile_opt_in_absent", "route": "config_read", "request": {"config_opt_in": false}, "expected": "deny"},
    {"id": "privacy_adapter_absent", "route": "config_write", "request": {"privacy_policy_present": false}, "expected": "deny"},
    {"id": "auth_disabled", "route": "sessions", "request": {"auth_enabled": false}, "expected": "deny"},
    {"id": "sync_disabled", "route": "config_read", "request": {"sync_enabled": false}, "expected": "deny"},
    {"id": "production_no_registration", "route": "config_read", "request": {"environment": "production"}, "expected": "deny"},
    {"id": "ingest_service", "route": "config_read", "request": {"service_profile": "ingest"}, "expected": "deny"},
    {"id": "mixed_cookie_bearer", "route": "config_read", "request": {"mixed_credentials": true}, "expected": "deny"},
    {"id": "browser_explicit_config", "route": "config_read", "principal": {"kind": "browser_session"}, "expected": "allow"},
    {"id": "browser_origin_absent", "route": "config_write", "principal": {"kind": "browser_session"}, "request": {"origin": null}, "expected": "deny"},
    {"id": "browser_origin_wrong", "route": "config_write", "principal": {"kind": "browser_session"}, "request": {"origin": "https://website.example"}, "expected": "deny"},
    {"id": "browser_csrf_absent", "route": "decision", "principal": {"kind": "browser_session"}, "request": {"csrf_verified": false}, "expected": "deny"},
    {"id": "browser_other_revoke_no_reauth", "route": "revoke", "principal": {"kind": "browser_session"}, "request": {"target_session": "synthetic-other-session", "recent_reauthentication": false}, "expected": "deny"},
    {"id": "native_wrong_method", "route": "config_read", "request": {"method": "GET"}, "expected": "deny"},
    {"id": "native_path_alias", "route": "config_read", "request": {"path": "/api/profile-sync/v1/read/"}, "expected": "deny"},
    {"id": "native_token_query", "route": "config_read", "request": {"query": "token=synthetic-forbidden"}, "expected": "deny"}
  ],
  "exchange_vectors": [
    {"id": "valid_exchange_binding", "patch": {}, "expected": "allow"},
    {"id": "wrong_verifier", "patch": {"verifier_matches": false}, "expected": "deny"},
    {"id": "wrong_exchange_client", "patch": {"client_matches": false}, "expected": "deny"},
    {"id": "wrong_exchange_callback", "patch": {"callback_matches": false}, "expected": "deny"},
    {"id": "wrong_exchange_environment", "patch": {"environment_matches": false}, "expected": "deny"},
    {"id": "wrong_exchange_audience", "patch": {"audience_matches": false}, "expected": "deny"},
    {"id": "code_consumed", "patch": {"code_unused": false}, "expected": "deny"},
    {"id": "expired_code_at_equality", "patch": {"expires_at": 100}, "expected": "deny"},
    {"id": "account_deleted_during_exchange", "patch": {"account_active": false}, "expected": "deny"},
    {"id": "browser_switched_after_review", "patch": {"consent_account_matches": false}, "expected": "deny"},
    {"id": "empty_installation_label", "patch": {"installation_present": false}, "expected": "deny"}
  ],
  "lifecycle_vectors": [
    {"id": "code_one_use", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "exchange", "expected": "invalid_grant"}]},
    {"id": "rotation_reuse_kills_winner", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "refresh", "token": "parent", "expected": "rotated"}, {"op": "access", "expected": "allow"}, {"op": "refresh", "token": "parent", "expected": "reuse_family_revoked"}, {"op": "access", "expected": "deny"}, {"op": "refresh", "token": "child", "expected": "invalid_grant"}]},
    {"id": "concurrent_refresh_loser", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "refresh", "token": "parent", "expected": "rotated"}, {"op": "refresh", "token": "parent", "expected": "reuse_family_revoked"}]},
    {"id": "lost_exchange_commit_proof", "steps": [{"op": "exchange", "verified": false, "expected": "verification_pending_no_secret"}, {"op": "exchange", "expected": "invalid_grant"}]},
    {"id": "lost_refresh_response", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "refresh", "token": "parent", "verified": false, "expected": "verification_pending_no_secret"}, {"op": "refresh", "token": "parent", "expected": "reuse_family_revoked"}]},
    {"id": "unverified_revoke_never_success", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "revoke", "verified": false, "expected": "revocation_pending"}, {"op": "access", "expected": "deny"}, {"op": "revoke", "expected": "revoked"}]},
    {"id": "account_disable_wins", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "disable_account", "expected": "disabled"}, {"op": "access", "expected": "deny"}, {"op": "refresh", "token": "parent", "expected": "invalid_grant"}]},
    {"id": "late_refresh_after_signout", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "switch_generation", "expected": "local_signed_out_remote_pending"}, {"op": "apply_response", "expected": "deny"}]},
    {"id": "wrong_installation_refresh", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "refresh", "token": "parent", "installation_matches": false, "expected": "invalid_grant"}, {"op": "refresh", "token": "parent", "expected": "rotated"}]},
    {"id": "refresh_scope_escalation", "steps": [{"op": "exchange", "expected": "issued"}, {"op": "refresh", "token": "parent", "scope_expansion": true, "expected": "invalid_grant"}, {"op": "refresh", "token": "parent", "expected": "rotated"}]}
  ],
  "profile_guard_vectors": [
    {"id": "verified_foreign_source", "operation": "publish", "expected": "allow"},
    {"id": "apple_empty_foreign_map_read_failure", "operation": "publish", "patch": {"foreign_provenance_verified": false}, "expected": "deny"},
    {"id": "missing_native_cloud_mapping", "operation": "publish", "patch": {"mapping_verified": false}, "expected": "deny"},
    {"id": "protected_publish", "operation": "publish", "patch": {"configuration_protected": true}, "expected": "deny"},
    {"id": "same_id_cleared_import_bit_remote_revision", "operation": "execute", "patch": {"fetched_revision": 2, "fetched_hash": "synthetic-new-hash"}, "expected": "deny"},
    {"id": "pending_remote_does_not_replace_accepted_snapshot", "operation": "execute", "patch": {"fetched_revision": 2, "fetched_hash": "synthetic-new-hash", "requested_snapshot": "accepted"}, "expected": "allow"},
    {"id": "approved_revision_still_needs_binding", "operation": "execute", "patch": {"binding_verified": false}, "expected": "deny"},
    {"id": "approved_revision_still_needs_os_grants", "operation": "execute", "patch": {"local_execution_grants": false}, "expected": "deny"},
    {"id": "new_cloud_adoption_blocked", "operation": "execute", "patch": {"import_blocked": true}, "expected": "deny"},
    {"id": "matching_revision_local_authority", "operation": "execute", "expected": "allow"}
  ]
}
