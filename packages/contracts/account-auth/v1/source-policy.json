{
  "schema": "healthmd.account_auth.source_policy",
  "schema_version": 1,
  "status": "proposed_synthetic_only",
  "activation_default": false,
  "profile_sync_default": false,
  "live_approval": null,
  "environments": {
    "synthetic": {
      "issuer": "https://account-auth.synthetic.example",
      "audience": "urn:healthmd:account-config:synthetic:v1",
      "clients": [
        {"client_id": "synthetic-apple-ios", "platform": "apple", "callback": "https://callbacks.account-sync.example/apple-ios/return"},
        {"client_id": "synthetic-apple-ipados", "platform": "apple", "callback": "https://callbacks.account-sync.example/apple-ipados/return"},
        {"client_id": "synthetic-apple-macos", "platform": "apple", "callback": "https://callbacks.account-sync.example/apple-macos/return"},
        {"client_id": "synthetic-android-play", "platform": "android", "callback": "https://callbacks.account-sync.example/android-play/return"},
        {"client_id": "synthetic-android-fdroid", "platform": "android", "callback": "https://callbacks.account-sync.example/android-fdroid/return"}
      ]
    },
    "development": null,
    "staging": null,
    "production": null
  },
  "scopes": [
    "account:sessions:read",
    "account:sessions:revoke:self",
    "config:profiles:read",
    "config:profiles:write"
  ],
  "credential_kinds": [
    "none", "browser_session", "authorization_code", "native_access", "native_refresh",
    "ingest_token", "repair_device", "mcp_read_aggregates", "mcp_read_full_export",
    "provider_oauth", "direct_pairing", "store_purchase", "shared_setup_artifact", "deletion_receipt"
  ],
  "token_prefixes": {
    "authorization_code": "hmd_acode_",
    "native_access": "hmd_nac_",
    "native_refresh": "hmd_nrf_"
  },
  "bounds": {
    "authorization_uri_bytes": 4096,
    "callback_uri_bytes": 4096,
    "auth_body_bytes": 8192,
    "pending_authorization_seconds": 300,
    "code_seconds": 120,
    "access_seconds": 300,
    "refresh_absolute_seconds": 2592000,
    "refresh_idle_seconds": 604800,
    "pending_per_account_client": 5,
    "sessions_per_account": 20
  },
  "authorization_query_keys": [
    "client_id", "redirect_uri", "response_type", "scope", "state", "code_challenge", "code_challenge_method", "audience"
  ],
  "callback_success_keys": ["code", "state", "iss"],
  "callback_error_keys": ["error", "state", "iss"],
  "code_request_keys": ["grant_type", "client_id", "redirect_uri", "code", "code_verifier", "installation_id"],
  "refresh_request_keys": ["grant_type", "client_id", "installation_id", "refresh_token"],
  "token_success_keys": [
    "token_type", "access_token", "expires_in", "refresh_token", "session_id", "scope",
    "issuer", "environment", "audience", "client_id", "installation_id", "account_id", "session_generation"
  ],
  "native_account_binding": {
    "namespace": ["issuer", "environment", "account_id"],
    "subject_source": "authoritative_account_and_grant_records",
    "subject_is_authority": false,
    "credential_bindings": ["audience", "client_id", "installation_id", "session_id", "session_generation"],
    "server_generation_is_local_account_generation": false,
    "sign_in_sets_sync_opt_in": false,
    "native_wire_and_secure_storage_qualified": false
  },
  "routes": [
    {"id": "authorize_page", "method": "GET", "path": "/account/authorize", "credential_kinds": ["none", "browser_session"], "native_scopes": [], "gate": "auth", "public_reference_only": true},
    {"id": "decision", "method": "POST", "path": "/api/account-auth/v1/decision", "credential_kinds": ["browser_session"], "native_scopes": [], "gate": "auth", "browser_csrf": true},
    {"id": "code_exchange", "method": "POST", "path": "/api/account-auth/v1/token", "grant_type": "authorization_code", "credential_kinds": ["authorization_code"], "native_scopes": [], "gate": "auth"},
    {"id": "refresh", "method": "POST", "path": "/api/account-auth/v1/token", "grant_type": "refresh_token", "credential_kinds": ["native_refresh"], "native_scopes": [], "gate": "auth"},
    {"id": "sessions", "method": "GET", "path": "/api/account-auth/v1/sessions", "credential_kinds": ["browser_session", "native_access"], "native_scopes": ["account:sessions:read"], "gate": "auth", "native_target": "self"},
    {"id": "revoke", "method": "POST", "path": "/api/account-auth/v1/revoke", "credential_kinds": ["browser_session", "native_access", "native_refresh"], "native_scopes": ["account:sessions:revoke:self"], "gate": "auth", "native_target": "self", "browser_csrf": true, "browser_other_reauthentication": true},
    {"id": "config_read", "method": "POST", "path": "/api/profile-sync/v1/read", "credential_kinds": ["browser_session", "native_access"], "native_scopes": ["config:profiles:read"], "gate": "profile_sync", "browser_csrf": true},
    {"id": "config_write", "method": "POST", "path": "/api/profile-sync/v1/mutate", "credential_kinds": ["browser_session", "native_access"], "native_scopes": ["config:profiles:read", "config:profiles:write"], "gate": "profile_sync", "browser_csrf": true}
  ],
  "native_denied_operations": [
    {"method": "GET", "path": "/api/account", "authority": "browser_retained_account"},
    {"method": "GET", "path": "/api/exports", "authority": "browser_retained_health"},
    {"method": "GET", "path": "/api/dashboard/trends", "authority": "browser_retained_health"},
    {"method": "GET", "path": "/api/account/export/page/1", "authority": "browser_portability"},
    {"method": "POST", "path": "/api/explore/node", "authority": "browser_retained_health"},
    {"method": "POST", "path": "/api/account/delete", "authority": "browser_destructive_account"},
    {"method": "POST", "path": "/api/ingest-tokens", "authority": "browser_health_credential_issuance"},
    {"method": "POST", "path": "/api/agent-tokens", "authority": "pilot_browser_mcp_consent"},
    {"method": "POST", "path": "/api/v1/exports", "authority": "write_only_ingest"},
    {"method": "POST", "path": "/api/repair/device/enroll", "authority": "separate_request_enrollment"},
    {"method": "GET", "path": "/api/repair/devices", "authority": "browser_request_admin"},
    {"method": "POST", "path": "/api/repair/dispatch", "authority": "browser_request_admin"},
    {"method": "POST", "path": "/api/repair/device/claim", "authority": "request_only_device"},
    {"method": "POST", "path": "/api/repair/device/resume", "authority": "request_only_device"},
    {"method": "POST", "path": "/api/repair/device/decline", "authority": "request_only_device"},
    {"method": "POST", "path": "/api/repair/supplements", "authority": "browser_retained_health"},
    {"method": "POST", "path": "/mcp", "authority": "separate_cloud_reader"}
  ],
  "new_route_service_profiles": ["account"],
  "denied_service_profiles": ["ingest", "maintenance", "mcp", "website", "practice", "wake", "provider_oauth_broker", "combined"],
  "forbidden_side_effects": [
    "read_os_health", "upload_export", "mint_ingest_token", "mint_mcp_token", "mint_repair_device_grant",
    "bind_destination", "activate_profile", "enable_schedule", "change_purchase", "query_provider",
    "change_chart_precedence", "link_accounts", "recover_account", "open_signup"
  ],
  "rotation_policy": "single_child_strict_reuse_revokes_family_no_grace",
  "unverified_commit_result": "verification_pending_no_secret",
  "evidence": [
    "apps/cloud/src/auth.ts", "apps/cloud/src/password.ts", "apps/cloud/src/account-worker.ts",
    "apps/cloud/src/ingest-worker.ts", "apps/cloud/src/index.ts", "apps/cloud/vm/server.ts",
    "apps/cloud/mcp/auth.ts", "packages/contracts/cloud-repair/v1/contract.md"
  ]
}
