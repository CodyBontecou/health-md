{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health.md/contracts/rollup-summary/v9/rollup-summary.schema.json",
  "title": "Health.md range roll-up summary v9",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "schema_version", "type", "rollup_period", "period_id", "start_date", "end_date", "days_expected", "days_counted", "coverage_percent", "source_schema", "source_schema_version", "rollup_rules_version", "generated_at", "source_dates", "metrics"],
  "properties": {
    "schema": {"const": "healthmd.rollup_summary"},
    "schema_version": {"const": 9},
    "type": {"const": "health_rollup"},
    "rollup_period": {"const": "range"},
    "period_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_to_[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "start_date": {"type": "string", "format": "date"},
    "end_date": {"type": "string", "format": "date"},
    "days_expected": {"type": "integer", "minimum": 1, "maximum": 400},
    "days_counted": {"type": "integer", "minimum": 0, "maximum": 400},
    "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "source_schema": {"const": "healthmd.health_data"},
    "source_schema_version": {"const": 8},
    "rollup_rules_version": {"const": 8},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_dates": {"type": "array", "uniqueItems": true, "maxItems": 400, "items": {"type": "string", "format": "date"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["key", "canonical_key", "display_name", "category", "unit", "rule", "primary_value", "days_counted", "statistics"]}}
  }
}
