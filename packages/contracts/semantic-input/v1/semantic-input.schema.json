{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://health.md/contracts/semantic-input/v1/semantic-input.schema.json",
  "title": "Health.md semantic input v1",
  "$defs": {
    "canonicalUnsigned": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "canonicalSigned": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_seconds",
        "nanoseconds",
        "source_utc_offset_seconds",
        "calendar_utc_offset_seconds"
      ],
      "properties": {
        "epoch_seconds": {
          "$ref": "#/$defs/canonicalSigned"
        },
        "nanoseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "source_utc_offset_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -64800,
          "maximum": 64800
        },
        "calendar_utc_offset_seconds": {
          "type": "integer",
          "minimum": -64800,
          "maximum": 64800
        }
      }
    },
    "number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "representation",
            "bits"
          ],
          "properties": {
            "representation": {
              "const": "binary64"
            },
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "representation",
            "decimal"
          ],
          "properties": {
            "representation": {
              "const": "signed_integer"
            },
            "decimal": {
              "$ref": "#/$defs/canonicalSigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "representation",
            "decimal"
          ],
          "properties": {
            "representation": {
              "const": "unsigned_integer"
            },
            "decimal": {
              "$ref": "#/$defs/canonicalUnsigned"
            }
          }
        }
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "unitless",
        "count",
        "second",
        "minute",
        "hour",
        "meter",
        "kilometer",
        "mile",
        "meter_per_second",
        "kilometer_per_hour",
        "mile_per_hour",
        "centimeter",
        "inch",
        "kilogram",
        "pound",
        "kilogram_per_square_meter",
        "gram",
        "milligram",
        "microgram",
        "liter",
        "fluid_ounce",
        "kilocalorie",
        "kilocalorie_per_hour_kilogram",
        "beat_per_minute",
        "breath_per_minute",
        "millisecond",
        "ratio_0_1",
        "percent_0_100",
        "degree_celsius",
        "degree_fahrenheit",
        "millimeter_hg",
        "milligram_per_deciliter",
        "international_unit",
        "watt",
        "revolution_per_minute",
        "step_per_minute",
        "decibel",
        "microsiemens",
        "liter_per_minute",
        "milliliter_per_kilogram_minute",
        "time_of_day_minute"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_type",
            "number",
            "unit"
          ],
          "properties": {
            "value_type": {
              "const": "number"
            },
            "number": {
              "$ref": "#/$defs/number"
            },
            "unit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/unit"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_type",
            "text"
          ],
          "properties": {
            "value_type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 8192
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_type",
            "boolean"
          ],
          "properties": {
            "value_type": {
              "const": "boolean"
            },
            "boolean": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_type",
            "items"
          ],
          "properties": {
            "value_type": {
              "const": "text_list"
            },
            "items": {
              "type": "array",
              "maxItems": 512,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "version",
        "retention_token",
        "selection_ids"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "retention_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "selection_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "source_ordinal",
        "owner_date",
        "semantic_id",
        "selection_ids",
        "attribution",
        "kind",
        "output_key",
        "aggregation",
        "start",
        "end",
        "value",
        "weight",
        "attributes",
        "extensions"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_ordinal": {
          "$ref": "#/$defs/canonicalUnsigned"
        },
        "owner_date": {
          "type": "string",
          "format": "date"
        },
        "semantic_id": {
          "$ref": "#/$defs/identifier"
        },
        "selection_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "attribution": {
          "enum": [
            "direct",
            "dependency"
          ]
        },
        "kind": {
          "enum": [
            "observation",
            "sdk_aggregate",
            "workout",
            "state_of_mind",
            "category",
            "extension_ref"
          ]
        },
        "output_key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "aggregation": {
          "enum": [
            "pass_through",
            "sum",
            "average",
            "minimum",
            "maximum",
            "latest",
            "count",
            "duration_sum",
            "weighted_average",
            "union",
            "histogram",
            "time_of_day"
          ]
        },
        "start": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "weight": {
          "oneOf": [
            {
              "$ref": "#/$defs/number"
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "extensions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/extension"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "semantic_input_version",
        "canonical_model_version",
        "registry_version",
        "registry_sha256",
        "profile_revision",
        "session_id",
        "profile",
        "calendar_time_zone",
        "selected_selection_ids",
        "disabled_output_keys",
        "retain_platform_extensions",
        "rollup_periods"
      ],
      "properties": {
        "schema": {
          "const": "healthmd.semantic_session_config"
        },
        "semantic_input_version": {
          "const": 1
        },
        "canonical_model_version": {
          "const": 1
        },
        "registry_version": {
          "const": 1
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_revision": {
          "enum": [
            1,
            2
          ]
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "profile": {
          "enum": [
            "apple_health_data_v8",
            "android_frozen_v4",
            "android_analytical_v5"
          ]
        },
        "calendar_time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "selected_selection_ids": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "disabled_output_keys": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "retain_platform_extensions": {
          "type": "boolean"
        },
        "rollup_periods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "iso_week",
              "calendar_month",
              "calendar_year",
              "range"
            ]
          }
        },
        "rollup_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_date",
            "end_date"
          ],
          "properties": {
            "start_date": {
              "type": "string",
              "format": "date"
            },
            "end_date": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rollup_periods": {
                "contains": {
                  "const": "range"
                }
              }
            }
          },
          "then": {
            "required": [
              "rollup_range"
            ],
            "properties": {
              "semantic_input_version": {
                "const": 1
              },
              "profile": {
                "const": "apple_health_data_v8"
              },
              "profile_revision": {
                "const": 2
              },
              "rollup_periods": {
                "maxItems": 1
              }
            }
          },
          "else": {
            "allOf": [
              {
                "not": {
                  "required": [
                    "rollup_range"
                  ]
                }
              },
              {
                "properties": {
                  "profile_revision": {
                    "const": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "profile": {
                "enum": [
                  "android_frozen_v4",
                  "android_analytical_v5"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "rollup_periods": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "semantic_input_version",
        "session_id",
        "batch_index",
        "final_batch",
        "owner_dates",
        "records"
      ],
      "properties": {
        "schema": {
          "const": "healthmd.semantic_input"
        },
        "semantic_input_version": {
          "const": 1
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "batch_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "final_batch": {
          "type": "boolean"
        },
        "owner_dates": {
          "type": "array",
          "maxItems": 400,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "records": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    }
  ]
}
