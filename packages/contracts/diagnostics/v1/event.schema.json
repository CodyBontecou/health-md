            "invalid"
          ]
        },
        "file_count": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "day_count": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "ready": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "pending_only": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "operation_id": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "peer_alias": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "peer_name": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
