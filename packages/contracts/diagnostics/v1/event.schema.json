{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:healthmd:diagnostic-event:v1",
  "title": "Health.md diagnostic event v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "timestamp",
    "session_id",
    "sequence",
    "monotonic_ms",
    "platform",
    "event_id",
    "subsystem",
    "severity",
    "source",
    "fields",
    "omitted_fields"
  ],
  "properties": {
    "schema": {
      "const": "healthmd.diagnostic_event"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "monotonic_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "platform": {
      "enum": [
        "ios",
        "macos",
        "android"
      ]
    },
    "event_id": {
      "enum": [
        "app.started",
        "app.native_lifecycle",
        "sync.advertising_started",
        "sync.advertising_stopped",
        "sync.browsing_started",
        "sync.browsing_stopped",
        "sync.peer_discovered",
        "sync.peer_lost",
        "sync.invitation_sent",
        "sync.invitation_received",
        "sync.invitation_timeout",
        "sync.connection_changed",
        "sync.capabilities_received",
        "sync.destination_changed",
        "sync.message_sent",
        "sync.message_received",
        "sync.transport_error",
        "export.result",
        "schedule.request_queued",
        "schedule.attempt_started",
        "schedule.attempt_finished",
        "schedule.background_expired",
        "schedule.trigger_received",
        "schedule.worker_result",
        "notification.requested",
        "notification.cancelled",
        "notification.tapped",
        "notification.request_failed",
        "diagnostics.recording_started",
        "diagnostics.recording_stopped"
      ]
    },
    "subsystem": {
      "enum": [
        "connection",
        "diagnostics",
        "export",
        "lifecycle",
        "notification",
        "schedule"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "debug",
        "trace",
        "warning",
        "error"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+/[A-Za-z0-9_+.-]+\\.(swift|kt):[0-9]+$"
    },
    "fields": {
      "type": "object",
      "properties": {
        "native_callback": {
          "type": "string",
          "enum": [
            "ios_application_did_become_active",
            "ios_scene_phase_active",
            "ios_scene_phase_inactive",
            "ios_scene_phase_background",
            "macos_application_did_become_active",
            "macos_application_did_resign_active",
            "android_activity_resumed",
            "android_activity_paused"
          ],
          "x-privacy": "operational"
        },
        "state": {
          "type": "string",
          "enum": [
            "disconnected",
            "connecting",
            "connected",
            "pairing",
            "transferring",
            "completed",
            "failed",
            "unknown"
          ],
          "x-privacy": "operational"
        },
        "transport": {
          "type": "string",
          "enum": [
            "nearby",
            "manual_ip"
          ],
          "x-privacy": "operational"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "app_open",
            "silent_push",
            "background_task",
            "notification",
            "handshake",
            "schedule",
            "manual"
          ],
          "x-privacy": "operational"
        },
        "reason": {
          "type": "string",
          "enum": [
            "success",
            "partial",
            "failure",
            "cancelled",
            "timeout",
            "suspended",
            "retry",
            "unknown"
          ],
          "x-privacy": "operational"
        },
        "error_domain": {
          "type": "string",
          "enum": [
            "NSPOSIXErrorDomain",
            "NSCocoaErrorDomain",
            "NSURLErrorDomain",
            "MCErrorDomain",
            "HKErrorDomain",
            "IOException",
            "SecurityException",
            "unknown"
          ],
          "x-privacy": "operational"
        },
        "error_code": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "x-privacy": "operational"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-privacy": "operational"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-privacy": "operational"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-privacy": "operational"
        },
        "day_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-privacy": "operational"
        },
        "ready": {
          "type": "boolean",
          "x-privacy": "operational"
        },
        "pending_only": {
          "type": "boolean",
          "x-privacy": "operational"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "x-privacy": "operational"
        },
        "peer_alias": {
          "type": "string",
          "pattern": "^peer_[0-9]{1,3}$",
          "x-privacy": "operational"
        },
        "peer_name": {
          "type": "string",
          "maxLength": 512,
          "x-max-utf8-bytes": 512,
          "x-privacy": "private_context"
        }
      },
      "additionalProperties": false
    },
    "omitted_fields": {
      "type": "object",
      "properties": {
        "native_callback": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "state": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "transport": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "trigger": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "reason": {
          "enum": [
            "not_recorded",
            "redacted",
            "unavailable",
            "truncated",
            "invalid"
          ]
        },
        "error_domain": {
          "enum": [
