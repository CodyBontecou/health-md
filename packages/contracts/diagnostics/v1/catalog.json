{
  "schema": "healthmd.diagnostic_catalog",
  "schema_version": 1,
  "events": {
    "app_started": ["app.started", "lifecycle", "info"],
    "native_lifecycle": ["app.native_lifecycle", "lifecycle", "info"],
    "advertising_started": ["sync.advertising_started", "connection", "debug"],
    "advertising_stopped": ["sync.advertising_stopped", "connection", "debug"],
    "browsing_started": ["sync.browsing_started", "connection", "debug"],
    "browsing_stopped": ["sync.browsing_stopped", "connection", "debug"],
    "peer_discovered": ["sync.peer_discovered", "connection", "debug"],
    "peer_lost": ["sync.peer_lost", "connection", "debug"],
    "invitation_sent": ["sync.invitation_sent", "connection", "debug"],
    "invitation_received": ["sync.invitation_received", "connection", "debug"],
    "invitation_timeout": ["sync.invitation_timeout", "connection", "warning"],
    "connection_changed": ["sync.connection_changed", "connection", "info"],
    "capabilities_received": ["sync.capabilities_received", "connection", "debug"],
    "destination_changed": ["sync.destination_changed", "connection", "debug"],
    "message_sent": ["sync.message_sent", "connection", "trace"],
    "message_received": ["sync.message_received", "connection", "trace"],
    "transport_error": ["sync.transport_error", "connection", "error"],
    "export_result": ["export.result", "export", "info"],
    "request_queued": ["schedule.request_queued", "schedule", "info"],
    "attempt_started": ["schedule.attempt_started", "schedule", "info"],
    "attempt_finished": ["schedule.attempt_finished", "schedule", "info"],
    "background_expired": ["schedule.background_expired", "schedule", "warning"],
    "trigger_received": ["schedule.trigger_received", "schedule", "debug"],
    "worker_result": ["schedule.worker_result", "schedule", "info"],
    "notification_requested": ["notification.requested", "notification", "info"],
    "notification_cancelled": ["notification.cancelled", "notification", "debug"],
    "notification_tapped": ["notification.tapped", "notification", "info"],
    "notification_failed": ["notification.request_failed", "notification", "error"],
    "recording_started": ["diagnostics.recording_started", "diagnostics", "info"],
    "recording_stopped": ["diagnostics.recording_stopped", "diagnostics", "info"]
  },
  "fields": {
    "native_callback": {"privacy": "operational", "type": "enum", "values": ["ios_application_did_become_active", "ios_scene_phase_active", "ios_scene_phase_inactive", "ios_scene_phase_background", "macos_application_did_become_active", "macos_application_did_resign_active", "android_activity_resumed", "android_activity_paused"]},
    "state": {"privacy": "operational", "type": "enum", "values": ["disconnected", "connecting", "connected", "pairing", "transferring", "completed", "failed", "unknown"]},
    "transport": {"privacy": "operational", "type": "enum", "values": ["nearby", "manual_ip"]},
    "trigger": {"privacy": "operational", "type": "enum", "values": ["app_open", "silent_push", "background_task", "notification", "handshake", "schedule", "manual"]},
    "reason": {"privacy": "operational", "type": "enum", "values": ["success", "partial", "failure", "cancelled", "timeout", "suspended", "retry", "unknown"]},
    "error_domain": {"privacy": "operational", "type": "enum", "values": ["NSPOSIXErrorDomain", "NSCocoaErrorDomain", "NSURLErrorDomain", "MCErrorDomain", "HKErrorDomain", "IOException", "SecurityException", "unknown"]},
    "error_code": {"privacy": "operational", "type": "integer"},
    "duration_ms": {"privacy": "operational", "type": "count"},
    "byte_count": {"privacy": "operational", "type": "count"},
    "file_count": {"privacy": "operational", "type": "count"},
    "day_count": {"privacy": "operational", "type": "count"},
    "ready": {"privacy": "operational", "type": "boolean"},
    "pending_only": {"privacy": "operational", "type": "boolean"},
    "operation_id": {"privacy": "operational", "type": "uuid"},
    "peer_alias": {"privacy": "operational", "type": "alias"},
    "peer_name": {"privacy": "private_context", "type": "text"}
  }
}
